-- ============================================================
-- FUNZIONE: melee_buttonBaseClick(obj, slot, player_color, alt_click)
-- Apre/chiude il pannello 3D info sulla base capitana: dati
-- della sola unità di appartenenza. Alt-click chiude.
-- ============================================================
function melee_buttonBaseClick(obj, slot, player_color, alt_click)

    if alt_click then
        melee_infoCloseUnit(main_getUnitKey(obj))
        return
    end

    local player = Player[player_color]
    local unitKey = main_getUnitKey(obj)

    -- Sfondamento in attesa (IMPETO): il click sulla base lo apre
    if IEF_MELEE_BREAKTHROUGH[unitKey] then
        local bt, motivo = melee_breakthroughFor(unitKey)
        if bt then
            if engine_subOpen("SFONDAMENTO", bt.slot, { key = unitKey, slot = bt.slot, nemico = bt.nemico, player = player_color }, "melee_btDone") then
                return
            end
        elseif motivo then
            warningToColor(motivo, player, "Yellow", 5, true)
            return
        end
    end

    if IEF_MELEE_INFO_HOST[unitKey] then
        melee_infoCloseUnit(unitKey)
        return
    end

    local gruppo = melee_getGroupOfUnit(unitKey)
    if not gruppo then
        warningToColor("Questa unità non è in mischia", player, "Yellow", 5, true)
        return
    end

    local slotCamera = obj.hasTag("Army1") and 1 or 2
    melee_cameraToGroup(player, slotCamera, gruppo)

    local calc = melee_computeGroup(gruppo)

    local righe = {}
    local info = calc.unita[unitKey]
    if info then
        local det = info.dettaglio
        local nemici = {}
        for enemyKey, _ in pairs(info.verso) do
            table.insert(nemici, main_decodeExtendedUnitLabel(enemyKey))
        end
        table.sort(nemici)
        table.insert(righe, { testo = string.format("%s - %s - %s",
            ARMY[info.slot].name, main_decodeExtendedUnitLabel(unitKey), main_getCohesion(unitKey)), titolo = true, colore = ARMY[info.slot].color })
        table.insert(righe, { testo = "In mischia contro: " .. table.concat(nemici, ", ") })
        table.insert(righe, { testo = string.format("%s%s",
            det.primoTurno and "Primo turno di mischia" or "Turno di mischia successivo",
            det.fianco and " - caricata sul fianco: non combatte" or "") })
        table.insert(righe, { testo = string.format("Basi in contatto %d - ranghi posteriori %d - overlap %d",
            det.contatto, det.posteriori, det.overlap) })
        if det.picca > 0 then table.insert(righe, { testo = string.format("Picca: %d basi di 3° e 4° rango", det.picca) }) end
        if det.perDue then table.insert(righe, { testo = "1D6 ogni 2 basi (FL/CL contro questo nemico)" }) end
        if det.elefanti then table.insert(righe, { testo = "Elefanti: 2D6 per base in primo rango" }) end
        local motivi = {}
        if det.mista then table.insert(motivi, "mista") end
        if det.dimezzati then table.insert(motivi, "disordinata") end
        table.insert(righe, { testo = (#motivi > 0)
            and string.format("Dadi: %d (%s: %d dimezzati)", info.dadi, table.concat(motivi, " e "), det.dadiGrezzi)
            or  string.format("Dadi: %d", info.dadi) })
        local marcate = #(IEF_MELEE_MARKED[unitKey] or {})
        if marcate > 0 then
            table.insert(righe, { testo = string.format("Basi perse in questa fase: %d (rimosse a fine fase)", marcate) })
        end
    end

    if info then
        local base = main_getMeleeThreshold() or 5
        local parti = {}
        for _, v in ipairs(info.modVoci or {}) do table.insert(parti, v[1] .. " " .. v[2]) end
        table.insert(righe, { testo = string.format("Per colpire: %d+%s", base,
            (#parti > 0) and (" - " .. table.concat(parti, ", ")) or " (nessun modificatore)") })
    end

    local testi = ""
    for _, r in ipairs(righe) do
        testi = testi .. string.format(
            '<Text text="%s" font="warforge_font" fontSize="%d" fontStyle="%s" color="%s" alignment="MiddleLeft" width="660" height="30"/>',
            r.testo, r.titolo and 18 or 15, r.titolo and "Bold" or "Normal", r.colore or "White")
    end

    local bases = main_getUnitBases(unitKey)
    local x, y, z = main_calcolaPosizionePannello(main_detectFormation(bases), #bases)

    obj.UI.setXml(string.format([[
        <Panel id="panelMeleeInfo_%s" active="true" color="rgba(0,0,0,0.95)" width="700" height="%d" offsetXY="0 300" position="%f %f %f" rotation="-90 0 0">
            <VerticalLayout spacing="6" padding="20 20 20 20" childAlignment="UpperLeft"> %s</VerticalLayout>
        </Panel>
    ]], unitKey, 90 + 36 * #righe, x, y, z, testi, unitKey))

    IEF_MELEE_INFO_HOST[unitKey] = obj
end

-- ============================================================
-- FUNZIONE: melee_currentTurn()
-- ============================================================
function melee_currentTurn()
    return (ENGINE and ENGINE.turn) or 1
end

-- ============================================================
-- FUNZIONE: melee_initiativeSlot()
-- Esercito che ha vinto l'iniziativa (sceglie l'ordine delle
-- mischie). nil se non ancora tirata.
-- ============================================================
function melee_initiativeSlot()
    return DICE_CONTEST and DICE_CONTEST.winner or nil
end

-- ============================================================
-- HELPER SIMMETRICI: melee_elementoX(elemento, slot)
-- Stesso principio di charge_elementoX: nessun "attaccante"
-- fisso, ogni campo è duplicato per Army1/Army2.
-- ============================================================
function melee_elementoUnitKey(elemento, slot)
    return slot == 1 and elemento.unitArmy1Key or elemento.unitArmy2Key
end

function melee_elementoOtherKey(elemento, slot)
    return slot == 1 and elemento.unitArmy2Key or elemento.unitArmy1Key
end

function melee_elementoOtherSlot(slot)
    return slot == 1 and 2 or 1
end

function melee_elementoCharged(elemento, slot)
    if slot == 1 then return elemento.chargedArmy1 end
    return elemento.chargedArmy2
end

function melee_elementoFlanked(elemento, slot)
    if slot == 1 then return elemento.flankedArmy1 end
    return elemento.flankedArmy2
end

function melee_elementoIsFirstTurn(elemento)
    return elemento.turnStart == melee_currentTurn()
end

-- ============================================================
-- FUNZIONE: melee_findElement(unitArmy1Key, unitArmy2Key)
-- ============================================================
function melee_findElement(unitArmy1Key, unitArmy2Key)
    for _, e in ipairs(IEF_MELEE_LIST) do
        if e.unitArmy1Key == unitArmy1Key and e.unitArmy2Key == unitArmy2Key then
            return e
        end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: melee_findOrCreateElement(unitArmy1Key, unitArmy2Key)
-- Deduplica per coppia. Ritorna: elemento, creato (bool)
-- ============================================================
function melee_findOrCreateElement(unitArmy1Key, unitArmy2Key)
    local e = melee_findElement(unitArmy1Key, unitArmy2Key)
    if e then return e, false end

    IEF_MELEE_NEXT_ID = IEF_MELEE_NEXT_ID + 1
    e = {
        id           = IEF_MELEE_NEXT_ID,
        unitArmy1Key = unitArmy1Key,
        unitArmy2Key = unitArmy2Key,
        turnStart    = melee_currentTurn(),
        chargedArmy1 = false,
        chargedArmy2 = false,
        flankedArmy1 = false,
        flankedArmy2 = false,
        resolvedTurn = nil,
    }
    table.insert(IEF_MELEE_LIST, e)
    return e, true
end

-- ============================================================
-- FUNZIONE: melee_importFromCharges()
-- IEF_CHARGE_QUEUE è SOLO sorgente: ogni carica chiusa con
-- esito OK diventa (o ritrova) una coppia in IEF_MELEE_LIST.
-- "In carica" = ha dichiarato la carica o ha contro-caricato.
-- Il fianco (flankedArmyX) arriva dall'elemento di carica.
-- ============================================================
function melee_importFromCharges()
    for _, c in ipairs(IEF_CHARGE_QUEUE or {}) do
        if c.step == CHARGE_STEP.CLO and c.outcome == CHARGE_OUTCOME.OK
           and c.unitArmy1Key and c.unitArmy2Key then

            local e, creato = melee_findOrCreateElement(c.unitArmy1Key, c.unitArmy2Key)
            if creato then
                for slot = 1, 2 do
                    local inCarica = charge_elementoRequest(c, slot)
                                  or charge_elementoResponse(c, slot) == REACTION_TYPE.COC
                    if slot == 1 then e.chargedArmy1 = inCarica and true or false
                    else              e.chargedArmy2 = inCarica and true or false end
                end
                -- Fianco calcolato in 4_charge (charge_resolveConflicts /
                -- charge_applyFlankContact): primo turno senza dadi.
                e.flankedArmy1 = c.flankedArmy1 == true
                e.flankedArmy2 = c.flankedArmy2 == true
                printToAll(string.format("[MISCHIA] Nuova mischia: %s contro %s",
                    main_decodeExtendedUnitLabel(e.unitArmy1Key),
                    main_decodeExtendedUnitLabel(e.unitArmy2Key)), {r=1,g=0.8,b=0.3})
            end
        end
    end
end

-- ============================================================
-- FUNZIONE: melee_pruneList()
-- Toglie le coppie in cui un'unità non ha più basi, è in ROTTA
-- o le due unità non sono più a contatto (in nessuna delle due
-- direzioni). Le altre proseguono nel turno (regolamento: "se
-- nessuno va in rotta, la mischia continua nel turno successivo").
-- ============================================================
function melee_pruneList()
    for i = #IEF_MELEE_LIST, 1, -1 do
        local e = IEF_MELEE_LIST[i]
        local basi1 = main_getUnitBases(e.unitArmy1Key)
        local basi2 = main_getUnitBases(e.unitArmy2Key)
        local togli = (#basi1 == 0 or #basi2 == 0)
            or main_getCohesion(e.unitArmy1Key) == COHESION.ROT
            or main_getCohesion(e.unitArmy2Key) == COHESION.ROT
        if not togli then
            local contatto = #melee_contactBases(e.unitArmy1Key, basi2) > 0
                          or #melee_contactBases(e.unitArmy2Key, basi1) > 0
            togli = not contatto
        end
        if togli then
            printToAll(string.format("[MISCHIA] Fine mischia: %s / %s",
                main_decodeExtendedUnitLabel(e.unitArmy1Key),
                main_decodeExtendedUnitLabel(e.unitArmy2Key)), {r=1,g=0.8,b=0.3})
            table.remove(IEF_MELEE_LIST, i)
        end
    end
end

-- ============================================================
-- FUNZIONE: melee_getGroups()
-- Gruppi = componenti connesse delle coppie (due coppie sono
-- nello stesso gruppo se condividono un'unità). Calcolati al
-- volo, mai salvati.
-- Ritorna lista ordinata per id:
-- { id = <id minimo delle coppie>, elementi = {...},
--   unita = { [unitKey] = slot } }
-- ============================================================
function melee_getGroups()
    local visitato = {}
    local gruppi = {}

    local ordinati = {}
    for _, e in ipairs(IEF_MELEE_LIST) do table.insert(ordinati, e) end
    table.sort(ordinati, function(a, b) return a.id < b.id end)

    for _, start in ipairs(ordinati) do
        if not visitato[start.id] then
            local g = { id = start.id, elementi = {}, unita = {} }
            local daVisitare = { start }
            visitato[start.id] = true

            while #daVisitare > 0 do
                local e = table.remove(daVisitare)
                table.insert(g.elementi, e)
                g.unita[e.unitArmy1Key] = 1
                g.unita[e.unitArmy2Key] = 2
                if e.id < g.id then g.id = e.id end

                for _, altro in ipairs(ordinati) do
                    if not visitato[altro.id] and (
                        altro.unitArmy1Key == e.unitArmy1Key or
                        altro.unitArmy2Key == e.unitArmy2Key) then
                        visitato[altro.id] = true
                        table.insert(daVisitare, altro)
                    end
                end
            end

            table.sort(g.elementi, function(a, b) return a.id < b.id end)
            table.insert(gruppi, g)
        end
    end

    table.sort(gruppi, function(a, b) return a.id < b.id end)
    return gruppi
end

-- ============================================================
-- FUNZIONE: melee_getGroupById(groupId)
-- ============================================================
function melee_getGroupById(groupId)
    for _, g in ipairs(melee_getGroups()) do
        if g.id == groupId then return g end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: melee_getGroupOfUnit(unitKey)
-- ============================================================
function melee_getGroupOfUnit(unitKey)
    for _, g in ipairs(melee_getGroups()) do
        if g.unita[unitKey] then return g end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: melee_groupIsPending(gruppo)
-- Pendente = almeno una coppia non risolta in questo turno.
-- ============================================================
function melee_groupIsPending(gruppo)
    local turno = melee_currentTurn()
    for _, e in ipairs(gruppo.elementi) do
        if e.resolvedTurn ~= turno then return true end
    end
    return false
end

-- ============================================================
-- FUNZIONE: melee_listHasPending()
-- ============================================================
function melee_listHasPending()
    for _, g in ipairs(melee_getGroups()) do
        if melee_groupIsPending(g) then return true end
    end
    return false
end

-- ============================================================
-- FUNZIONE: melee_groupUnitsOfSlot(gruppo, slot)
-- unitKey del gruppo appartenenti a slot, ordinate.
-- ============================================================
function melee_groupUnitsOfSlot(gruppo, slot)
    local out = {}
    for key, s in pairs(gruppo.unita) do
        if s == slot then table.insert(out, key) end
    end
    table.sort(out)
    return out
end

-- ============================================================
-- FUNZIONE: melee_groupLabel(gruppo, slot)
-- "La A, la B contro la C" dal punto di vista di slot.
-- ============================================================
function melee_groupLabel(gruppo, slot)
    local function elenco(keys)
        local parti = {}
        for i, k in ipairs(keys) do
            table.insert(parti, (i == 1 and "La " or "la ") .. main_decodeExtendedUnitLabel(k))
        end
        return table.concat(parti, ", ")
    end
    local mie   = melee_groupUnitsOfSlot(gruppo, slot)
    local altre = melee_groupUnitsOfSlot(gruppo, melee_elementoOtherSlot(slot))
    local nemici = elenco(altre):gsub("^La ", "la ")
    return elenco(mie) .. " contro " .. nemici
end

-- ============================================================
-- FUNZIONE: melee_groupCenter(gruppo)
-- Baricentro di tutte le basi del gruppo (per la camera).
-- ============================================================
function melee_groupCenter(gruppo)
    local sx, sy, sz, n = 0, 0, 0, 0
    for key, _ in pairs(gruppo.unita) do
        for _, obj in ipairs(main_getUnitBases(key)) do
            local p = obj.getPosition()
            sx, sy, sz, n = sx + p.x, sy + p.y, sz + p.z, n + 1
        end
    end
    if n == 0 then return nil end
    return Vector(sx / n, sy / n, sz / n)
end
-- ============================================================
-- FUNZIONE: melee_rowInCorso(groupId)
-- Vero se MELEE_RESOLVE è aperta su questo gruppo.
-- ============================================================
function melee_rowInCorso(groupId)
    local sh = engine_subShared()
    return sh ~= nil and sh.name == "MELEE_RESOLVE" and sh.ctx and sh.ctx.groupId == groupId
end

-- ============================================================
-- FUNZIONE: melee_rowText(gruppo, slot)
-- Testo e colore della riga della lista mischie: gialla con
-- " - in corso" mentre la mischia è aperta.
-- ============================================================
function melee_rowText(gruppo, slot)
    if melee_rowInCorso(gruppo.id) then
        return melee_groupLabel(gruppo, slot) .. " - in corso", "#FFD833"
    end
    return melee_groupLabel(gruppo, slot), "White"
end

-- ============================================================
-- FUNZIONE: melee_rowRefresh(gruppo)
-- Aggiorna le righe del gruppo nelle liste dei due eserciti.
-- ============================================================
function melee_rowRefresh(gruppo)
    for slot = 1, 2 do
        local id = string.format("melee_row_%d_%s", slot, gruppo.id)
        local testo, colore = melee_rowText(gruppo, slot)
        UI.setAttribute(id, "text", "  " .. testo)
        Wait.frames(function()
            UI.setAttribute(id, "textColor", colore)
        end, 1)
    end
end
-- ============================================================
-- FUNZIONE: melee_getListPanelXml(slot)
-- Lista di TUTTE le mischie dal punto di vista di slot. Solo
-- il vincitore dell'iniziativa può aprirne una; l'altro
-- giocatore col click inquadra soltanto.
-- ============================================================
function melee_getListPanelXml(slot)
    local gruppi = melee_getGroups()
    local attivo = (ENGINE.phase == PHASE.MELEE and #gruppi > 0) and "true" or "false"

    local righe = {}
    for _, g in ipairs(gruppi) do
        local testo, coloreTesto = melee_rowText(g, slot)
        table.insert(righe, {
            id      = string.format("melee_row_%d_%s", slot, g.id),
            testo   = testo,
            colore  = coloreTesto,
            onClick = "melee_rowClick",
        })
    end

    return ui_listPanelXml({
        id         = "melee_list_army" .. slot,
        titleId    = "melee_list_title_army" .. slot,
        titolo     = "MISCHIE - " .. ARMY[slot].name,
        nota       = "Clicca una riga: il vincitore dell'iniziativa sceglie la mischia",
        visibility = ARMY[slot] and ARMY[slot].color or "",
        attivo     = attivo,
        righe      = righe,
        vuoto      = "Nessuna mischia",
        offsetXY   = "-10 -330",
    })
end
-- ============================================================
-- FUNZIONE: melee_cameraToGroup(player, slot, gruppo)
-- ============================================================
function melee_cameraToGroup(player, slot, gruppo)
    local centro = melee_groupCenter(gruppo)
    if not centro then return end
    local yaw = (slot == 1) and 0 or 180
    engine_diceCamera(player, centro, 40, yaw, 15)
end

-- ============================================================
-- FUNZIONE: melee_rowClick(player, value, id)
-- Inquadra il gruppo; al vincitore dell'iniziativa, se il
-- gruppo è da risolvere, apre il popup Attacca/Annulla.
-- ============================================================
function melee_rowClick(player, value, id)
    local slotStr, groupStr = id:match("^melee_row_btn_(%d)_(%d+)$")
    if not slotStr then
        slotStr, groupStr = id:match("^melee_row_(%d)_(%d+)$")
    end
    if not slotStr then return end
    local slot = tonumber(slotStr)
    local groupId = tonumber(groupStr)

    local aperta = engine_subShared()
    if aperta then
        -- Mischia già aperta dall'avversario su questo gruppo:
        -- questo giocatore entra (riga -> sottofase -> dadi)
        if aperta.name == "MELEE_RESOLVE" and aperta.ctx.groupId == groupId then
            local gruppo = melee_getGroupById(groupId)
            if gruppo then melee_cameraToGroup(player, slot, gruppo) end
            aperta.ctx["entrato" .. slot] = true
            engine_subRedraw()
            return
        end
        local def = SUBPHASES[aperta.name]
        warningToColor("Completa prima: " .. ((def and def.title ~= "" and def.title) or "azione in corso"), player, "Yellow", 5, true)
        return
    end

    local gruppo = melee_getGroupById(groupId)
    if not gruppo then return end

    melee_cameraToGroup(player, slot, gruppo)

    if ENGINE.phase ~= PHASE.MELEE then return end

    if not melee_groupIsPending(gruppo) then
        warningToColor("Questa mischia è già stata risolta in questo turno", player, "Yellow", 5, true)
        return
    end

    local ctx = { groupId = gruppo.id, attackerSlot = slot }
    ctx["entrato" .. slot] = true
    if engine_subOpen("MELEE_RESOLVE", nil, ctx, "melee_resolveDone") then
        melee_rowRefresh(gruppo)
    end
end
-- ============================================================
-- FUNZIONE: melee_unitDims(unitKey)
-- Ritorna larghezza e profondità base in unità TTS.
-- ============================================================
function melee_unitDims(unitKey)
    local bases = main_getUnitBases(unitKey)
    local meta = bases[1] and main_getUnitMeta(bases[1])
    local ut = meta and meta.unitType and main_getUnitType(meta.unitType)
    local w = ((ut and ut.base_width_cm) or 4) * CM_TO_TTS
    local d = ((ut and tonumber(ut.base_depth_cm)) or 3) * CM_TO_TTS
    return w, d
end

-- ============================================================
-- FUNZIONE: melee_contactBases(myKey, enemyBases)
-- Basi di myKey che toccano frontalmente una base di
-- enemyBases (Physics.cast, robusto a qualsiasi angolo).
-- ============================================================
function melee_contactBases(myKey, enemyBases)
    local result = {}
    local nemico = {}
    for _, n in ipairs(enemyBases) do nemico[n] = true end

    local w = melee_unitDims(myKey)

    for _, obj in ipairs(main_getUnitBases(myKey)) do
        local fwd = obj.getTransformForward()
        local hits = Physics.cast({
            origin       = obj.getPosition(),
            direction    = Vector(fwd.x, 0, fwd.z):normalized(),
            type         = 3,
            size         = Vector(w * 0.7, obj.getBounds().size.y, 0.1),
            max_distance = 1.23,
            orientation  = obj.getRotation()
        })
        for _, hit in ipairs(hits) do
            if hit.hit_object and nemico[hit.hit_object] then
                table.insert(result, obj)
                break
            end
        end
    end
    return result
end

-- ============================================================
-- FUNZIONE: melee_rearBase(baseObj, myBases, w, d)
-- Base nello stesso file immediatamente dietro a baseObj.
-- ============================================================
function melee_rearBase(baseObj, myBases, w, d)
    local posA    = baseObj.getPosition()
    local fwd     = baseObj.getTransformForward()
    local fwdXZ   = Vector(fwd.x, 0, fwd.z):normalized()
    local rightXZ = Vector(-fwdXZ.z, 0, fwdXZ.x)

    local projFrontA = posA.x * fwdXZ.x   + posA.z * fwdXZ.z
    local projRightA = posA.x * rightXZ.x + posA.z * rightXZ.z

    local migliore, miglioreProf = nil, nil
    for _, obj in ipairs(myBases) do
        if obj ~= baseObj then
            local p = obj.getPosition()
            local diffLateral = math.abs((p.x * rightXZ.x + p.z * rightXZ.z) - projRightA)
            local diffForward = projFrontA - (p.x * fwdXZ.x + p.z * fwdXZ.z)
            if diffLateral <= w * 0.5 and diffForward > d * 0.3 then
                if miglioreProf == nil or diffForward < miglioreProf then
                    miglioreProf = diffForward
                    migliore = obj
                end
            end
        end
    end
    return migliore
end

-- ============================================================
-- FUNZIONE: melee_overlapBases(contactBases, myBases, w, d)
-- Prima base in overlap per lato (max 1 sx + 1 dx) sul rango
-- delle basi in contatto. Solo dal secondo turno (lo decide
-- il chiamante).
-- ============================================================
function melee_overlapBases(contactBases, myBases, w, d)
    if #contactBases == 0 then return {} end

    local inContatto = {}
    for _, bc in ipairs(contactBases) do inContatto[bc] = true end

    local fwd     = contactBases[1].getTransformForward()
    local fwdXZ   = Vector(fwd.x, 0, fwd.z):normalized()
    local rightXZ = Vector(-fwdXZ.z, 0, fwdXZ.x)

    local minRight, maxRight, sumFront = math.huge, -math.huge, 0
    for _, bc in ipairs(contactBases) do
        local p = bc.getPosition()
        local r = p.x * rightXZ.x + p.z * rightXZ.z
        if r < minRight then minRight = r end
        if r > maxRight then maxRight = r end
        sumFront = sumFront + (p.x * fwdXZ.x + p.z * fwdXZ.z)
    end
    minRight = minRight - w * 0.5
    maxRight = maxRight + w * 0.5
    local avgFront = sumFront / #contactBases

    local sx, dx, distSx, distDx = nil, nil, nil, nil
    for _, obj in ipairs(myBases) do
        if not inContatto[obj] then
            local p = obj.getPosition()
            local f = p.x * fwdXZ.x + p.z * fwdXZ.z
            local r = p.x * rightXZ.x + p.z * rightXZ.z
            if math.abs(f - avgFront) <= d * 0.8 then
                if r < minRight and (not distSx or (minRight - r) < distSx) then sx, distSx = obj, minRight - r end
                if r > maxRight and (not distDx or (r - maxRight) < distDx) then dx, distDx = obj, r - maxRight end
            end
        end
    end

    local out = {}
    if sx then table.insert(out, sx) end
    if dx then table.insert(out, dx) end
    return out
end

-- ============================================================
-- FUNZIONE: melee_distribuisci(totale, pesi)
-- Ripartisce un intero su chiavi proporzionalmente ai pesi
-- (metodo dei resti maggiori). pesi = { [chiave] = n }
-- ============================================================
function melee_distribuisci(totale, pesi)
    local out, somma = {}, 0
    for _, p in pairs(pesi) do somma = somma + p end
    if somma <= 0 or totale <= 0 then
        for k, _ in pairs(pesi) do out[k] = 0 end
        return out
    end

    local resti, assegnati = {}, 0
    for k, p in pairs(pesi) do
        local quota = totale * p / somma
        out[k] = math.floor(quota)
        assegnati = assegnati + out[k]
        table.insert(resti, { k = k, r = quota - out[k] })
    end
    table.sort(resti, function(a, b)
        if a.r ~= b.r then return a.r > b.r end
        return tostring(a.k) < tostring(b.k)
    end)
    for i = 1, totale - assegnati do
        out[resti[i].k] = out[resti[i].k] + 1
    end
    return out
end

-- ============================================================
-- FUNZIONE: melee_computeGroup(gruppo)
-- Dadi per unità e per bersaglio. Per ogni coppia: basi in
-- contatto + loro ranghi posteriori; dal secondo turno anche
-- overlap + posteriori. Caricata sul fianco al primo turno:
-- 0 dadi. Disordinata: metà dadi per difetto.
-- Soglia 5+ (modificatori: passo successivo).
-- Ritorna:
-- { [slot] = { dadi, soglia },
--   unita = { [unitKey] = { slot, dadi, verso = { [enemyKey] = n },
--             dettaglio = { contatto, posteriori, overlap, fianco,
--                           primoTurno, dimezzati, dadiGrezzi } } } }
-- ============================================================
function melee_computeGroup(gruppo)
    local base = main_getMeleeThreshold() or 5
    local calc = { [1] = { dadi = 0, soglia = base, base = base, mod = 0, voci = {} },
                   [2] = { dadi = 0, soglia = base, base = base, mod = 0, voci = {} }, unita = {} }

    for key, slot in pairs(gruppo.unita) do
        calc.unita[key] = { slot = slot, dadi = 0, verso = {} }
    end

    for key, info in pairs(calc.unita) do
        local myBases = main_getUnitBases(key)
        local w, d = melee_unitDims(key)
        local usate = {}
        local grezzi = {}
        local det = { contatto = 0, posteriori = 0, overlap = 0, picca = 0, fianco = false, primoTurno = false, dimezzati = false }

        local function aggiungi(b, categoria)
            if b and not usate[b] then
                usate[b] = true
                det[categoria] = det[categoria] + 1
                return 1
            end
            return 0
        end

        local myProf = melee_unitProfile(key, info.slot)
        local myTipo = myProf.tipo
        det.picca, det.perDue, det.elefanti = 0, false, false

        for _, e in ipairs(gruppo.elementi) do
            if melee_elementoUnitKey(e, info.slot) == key then
                local enemyKey = melee_elementoOtherKey(e, info.slot)
                local primo = melee_elementoIsFirstTurn(e)
                local fianco = primo and melee_elementoFlanked(e, info.slot)
                if primo then det.primoTurno = true end
                if fianco then det.fianco = true end
                local n = 0

                -- Modificatori della coppia (unità -> questo nemico)
                local tot, voci = melee_pairModifiers(e, info.slot, key, enemyKey, primo)
                info.mods = info.mods or {}
                info.mods[enemyKey] = { tot = tot, voci = voci }

                if not fianco then
                    local enemyBases = main_getUnitBases(enemyKey)
                    local enemyMeta = enemyBases[1] and main_getUnitMeta(enemyBases[1])
                    local enemyTipo = enemyMeta and enemyMeta.unitType

                    local contatto = melee_contactBases(key, enemyBases)
                    local overlap = primo and {} or melee_overlapBases(contatto, myBases, w, d)
                    local primoRango, secondo, terzoQuarto = 0, 0, 0
                    local rango1 = {}
                    for _, b in ipairs(contatto) do
                        local k = aggiungi(b, "contatto"); primoRango = primoRango + k
                        if k > 0 then table.insert(rango1, b) end
                    end
                    for _, b in ipairs(overlap) do
                        local k = aggiungi(b, "overlap"); primoRango = primoRango + k
                        if k > 0 then table.insert(rango1, b) end
                    end
                    for _, b in ipairs(rango1) do
                        local r2 = melee_rearBase(b, myBases, w, d)
                        secondo = secondo + aggiungi(r2, "posteriori")
                        -- PICCA: anche 3° e 4° rango
                        if r2 and myProf.armi["PICCA"] then
                            local r3 = melee_rearBase(r2, myBases, w, d)
                            local r4 = r3 and melee_rearBase(r3, myBases, w, d)
                            terzoQuarto = terzoQuarto + aggiungi(r3, "picca") + aggiungi(r4, "picca")
                        end
                    end

                    -- Dadi per tipo (regolamento, COME SI COMBATTE)
                    if myTipo == "EL" then
                        -- 2D6 per ogni base in primo rango
                        n = primoRango * 2
                        det.elefanti = true
                    else
                        n = primoRango + secondo + terzoQuarto
                        if (myTipo == "FL" and enemyTipo ~= "FL" and enemyTipo ~= "EL")
                           or (myTipo == "CL" and enemyTipo ~= "CL" and enemyTipo ~= "FL") then
                            n = math.floor(n / 2)
                            det.perDue = true
                        end
                    end
                end
                grezzi[enemyKey] = (grezzi[enemyKey] or 0) + n
            end
        end

        local totale = 0
        for _, n in pairs(grezzi) do totale = totale + n end
        det.dadiGrezzi = totale
        local ridotti = false
        if main_isMista(key) then
            det.mista = true
            totale = math.floor(totale / 2)
            ridotti = true
        end
        if main_getCohesion(key) == COHESION.DIS then
            det.dimezzati = true
            totale = math.floor(totale / 2)
            ridotti = true
        end
        if ridotti then
            grezzi = melee_distribuisci(totale, grezzi)
        end

        info.verso = grezzi
        info.dadi  = totale
        info.dettaglio = det

        -- Modificatore dell'unità: quello verso il bersaglio con più
        -- dadi (uno contro uno: l'unico bersaglio).
        local scelto, maxDadi = nil, -1
        for enemyKey, m in pairs(info.mods or {}) do
            local nd = grezzi[enemyKey] or 0
            if nd > maxDadi or (nd == maxDadi and scelto and enemyKey < scelto) then
                scelto, maxDadi = enemyKey, nd
            end
        end
        local m = scelto and info.mods[scelto] or { tot = 0, voci = {} }
        info.modTot, info.modVoci = m.tot, m.voci
        for _, altro in pairs(info.mods or {}) do
            if altro.tot ~= m.tot then info.modDiversi = true end
        end

        calc[info.slot].dadi = calc[info.slot].dadi + totale
    end

    -- Soglia dell'esercito (un tiro per esercito): quella dell'unità
    -- con più dadi. Soglie diverse fra unità/bersagli dello stesso
    -- esercito: segnalate (tiri separati per bersaglio: passo
    -- successivo).
    for slot = 1, 2 do
        local scelta, maxDadi = nil, -1
        for key, info in pairs(calc.unita) do
            if info.slot == slot and (info.dadi > maxDadi or (info.dadi == maxDadi and scelta and key < scelta)) then
                scelta, maxDadi = key, info.dadi
            end
        end
        local c = calc[slot]
        if scelta then
            local info = calc.unita[scelta]
            c.mod, c.voci = info.modTot or 0, info.modVoci or {}
            for _, altra in pairs(calc.unita) do
                if altra.slot == slot and (altra.modDiversi or (altra.modTot or 0) ~= c.mod) then
                    c.soglieDiverse = true
                end
            end
        end
        c.soglia = c.base - c.mod
    end

    -- Tiri separati per bersaglio (regolamento, mischie multiple:
    -- "i lanci dei dadi per ogni unità vanno divisi sulle unità
    -- avversarie"): un tiro per ogni coppia unità -> nemico con
    -- dadi, ognuno con la sua soglia. Ordine stabile per chiave.
    for slot = 1, 2 do
        local tiri = {}
        local chiavi = {}
        for key, info in pairs(calc.unita) do
            if info.slot == slot then table.insert(chiavi, key) end
        end
        table.sort(chiavi)
        for _, key in ipairs(chiavi) do
            local info = calc.unita[key]
            local nemici = {}
            for enemyKey, n in pairs(info.verso or {}) do
                if n > 0 then table.insert(nemici, enemyKey) end
            end
            table.sort(nemici)
            for _, enemyKey in ipairs(nemici) do
                local m = (info.mods or {})[enemyKey] or { tot = 0, voci = {} }
                table.insert(tiri, {
                    unita  = key,
                    nemico = enemyKey,
                    dadi   = info.verso[enemyKey],
                    base   = calc[slot].base,
                    mod    = m.tot,
                    soglia = calc[slot].base - m.tot,
                    voci   = m.voci,
                })
            end
        end
        calc[slot].tiri = tiri
    end

    return calc
end

-- ============================================================
-- FUNZIONE: melee_unitProfile(unitKey, slot)
-- Dati dell'unità per i modificatori di mischia: tipo, armi,
-- capacità (DISORDINATA: solo SPADA), scudo, Generale aggregato.
-- ============================================================
function melee_unitProfile(unitKey, slot)
    local b = main_getUnitBases(unitKey)[1]
    local meta = (b and main_getUnitMeta(b)) or {}
    local p = { tipo = meta.unitType, armi = {}, capacita = {}, scudo = false,
                generale = main_generalAttachedTo(unitKey) ~= nil }
    for _, a in ipairs(meta.armi or {}) do
        p.armi[a] = true
        if a == "SCUDO" then p.scudo = true end
    end
    local disordinata = main_getCohesion(unitKey) == COHESION.DIS
    for _, c in ipairs(meta.capabilities or {}) do
        -- Regolamento: le disordinate perdono le capacità tranne SPADA
        if not disordinata or c == "SPADA" then p.capacita[c] = true end
    end
    return p
end

-- ============================================================
-- FUNZIONE: melee_specMatch(spec, p)
-- Vero se il profilo p soddisfa tutte le condizioni di spec
-- (melee_modifiers.json): liste = basta un elemento, booleani =
-- devono coincidere.
-- ============================================================
function melee_specMatch(spec, p)
    if not spec then return true end
    local function lista(campo, set)
        local l = spec[campo]
        if not l then return true end
        for _, v in ipairs(l) do
            if set[v] then return true end
        end
        return false
    end
    if spec.tipi then
        local ok = false
        for _, t in ipairs(spec.tipi) do if t == p.tipo then ok = true end end
        if not ok then return false end
    end
    if not lista("armi", p.armi) then return false end
    if not lista("capacita", p.capacita) then return false end
    for _, campo in ipairs({ "inCarica", "generale", "scudo", "piuAlto" }) do
        if spec[campo] ~= nil and (p[campo] and true or false) ~= spec[campo] then return false end
    end
    return true
end

-- ============================================================
-- FUNZIONE: melee_pairModifiers(e, slot, key, enemyKey, primo)
-- Modificatori per colpire dell'unità key contro enemyKey
-- (tabella "modifiers" di melee_modifiers.json).
-- Ritorna: totale, voci { { "etichetta", "+1 al dado" }, ... }
-- ============================================================
function melee_pairModifiers(e, slot, key, enemyKey, primo)
    local data = IEF_DATA.melee and IEF_DATA.melee.melee or {}
    local lista = data.modifiers or {}
    local otherSlot = melee_elementoOtherSlot(slot)

    local me = melee_unitProfile(key, slot)
    local lui = melee_unitProfile(enemyKey, otherSlot)
    me.inCarica  = melee_elementoCharged(e, slot) and true or false
    lui.inCarica = melee_elementoCharged(e, otherSlot) and true or false

    -- Posizione più alta: quota media delle basi in contatto
    local function quota(basi)
        if #basi == 0 then return nil end
        local y = 0
        for _, b in ipairs(basi) do y = y + b.getPosition().y end
        return y / #basi
    end
    local yMe  = quota(melee_contactBases(key, main_getUnitBases(enemyKey)))
    local yLui = quota(melee_contactBases(enemyKey, main_getUnitBases(key)))
    local tol = data.height_tolerance or 0.2
    me.piuAlto  = (yMe and yLui and yMe > yLui + tol) and true or false
    lui.piuAlto = (yMe and yLui and yLui > yMe + tol) and true or false

    local tot, voci = 0, {}
    for _, m in ipairs(lista) do
        local turnoOk = (m.turno == "tutti") or (primo and m.turno == "primo") or (not primo and m.turno == "successivi")
        if turnoOk and melee_specMatch(m.chi, me) and melee_specMatch(m.contro, lui) then
            local escluso = false
            for _, t in ipairs(m.tranne or {}) do
                if melee_specMatch(t, lui) then escluso = true; break end
            end
            if not escluso then
                local v = tonumber(m.valore) or 0
                tot = tot + v
                table.insert(voci, { m.label or m.id, string.format("%+d al dado", v) })
            end
        end
    end
    return tot, voci
end
-- ============================================================
-- FUNZIONE: melee_markLosses(unitKey, hits)
-- Perdite di mischia MARCATE (evidenziate, non rimosse): la
-- rimozione avviene a fine fase MELEE (melee_removeMarkedLosses).
-- Ordine di rimozione: main_lossOrder (rango posteriore, da
-- destra), saltando le basi già marcate. Colpi in eccesso persi.
-- Ritorna: basi marcate ora
-- ============================================================
function melee_markLosses(unitKey, hits)
    if not hits or hits <= 0 then return 0 end

    local ordinate, fpb = main_lossOrder(unitKey)
    if not fpb or fpb <= 0 then return 0 end

    IEF_MELEE_MARKED[unitKey] = IEF_MELEE_MARKED[unitKey] or {}
    local giaMarcate = {}
    for _, guid in ipairs(IEF_MELEE_MARKED[unitKey]) do giaMarcate[guid] = true end

    local n = math.floor(hits / fpb)
    local marcate = 0
    for _, obj in ipairs(ordinate) do
        if marcate >= n then break end
        local guid = obj.getGUID()
        if not giaMarcate[guid] then
            table.insert(IEF_MELEE_MARKED[unitKey], guid)
            obj.setColorTint(LOSS_HIGHLIGHT_COLOR)
            marcate = marcate + 1
        end
    end

    printToAll(string.format("[PERDITE] %s: %d colpi -> %d basi perse (rimosse a fine fase)",
        main_decodeExtendedUnitLabel(unitKey), hits, marcate), {r=1,g=0.4,b=0.4})
    if marcate > 0 then main_generalRisk(unitKey, 12, "l'unita' ha perso una base") end
    return marcate
end

-- ============================================================
-- FUNZIONE: melee_removeMarkedLosses()
-- Fine fase MELEE: rimuove tutte le basi marcate.
-- ============================================================
function melee_removeMarkedLosses()
    for unitKey, guids in pairs(IEF_MELEE_MARKED) do
        local objs = {}
        for _, guid in ipairs(guids) do
            local obj = getObjectFromGUID(guid)
            if obj then
                obj.highlightOff()
                table.insert(objs, obj)
            end
        end
        main_removeBases(unitKey, objs)
    end
    IEF_MELEE_MARKED = {}
end

-- ============================================================
-- FUNZIONE: melee_onRout(cur, unitKey, slot)
-- Unità appena andata in ROTTA in mischia: conseguenze comuni
-- (main_onRout: test delle amiche, elenco rotte); i test nati
-- qui passano da melee_queueTest.
-- ============================================================
function melee_onRout(cur, unitKey, slot)
    main_onRout(unitKey, slot, function(item, quando)
        melee_queueTest(cur, item, quando)
    end)
end
-- ============================================================
-- FUNZIONE: melee_queueTest(ctx, item, quando)
-- Test di morale nato dalla mischia. IMMEDIATO -> pannello morale
-- del proprietario (main_requestMoraleRoll, onDone per nome);
-- se ctx (MELEE_RESOLVE aperta) la sottofase resta nello step
-- MORALE finché i suoi test non sono tutti tirati.
-- FINE_FASE -> IEF_MORALE_END_QUEUE (dopo tutte le mischie).
-- item = { key, slot, motivo, effetto }
-- ============================================================
function melee_queueTest(ctx, item, quando)
    if quando == "FINE_FASE" then
        for _, it in ipairs(IEF_MORALE_END_QUEUE) do
            if it.key == item.key and it.motivo == item.motivo then return end
        end
        table.insert(IEF_MORALE_END_QUEUE, item)
        return
    end

    if ctx then
        ctx.testInCorso = (ctx.testInCorso or 0) + 1
    end
    main_requestMoraleRoll(item.key, item.slot, item.effetto or "altre_situazioni", nil, item.motivo,
        "melee_moraleTestDone", { groupId = ctx and ctx.groupId, key = item.key, slot = item.slot })
end
-- ============================================================
-- FUNZIONE: melee_lowerAndCheckRout(cur, unitKey, slot)
-- Abbassa la coesione; se l'unità arriva ora in ROTTA applica
-- le conseguenze (melee_onRout).
-- ============================================================
function melee_lowerAndCheckRout(cur, unitKey, slot)
    local prima = main_getCohesion(unitKey)
    local dopo = main_lowerCohesion(unitKey)
    if prima ~= COHESION.ROT and dopo == COHESION.ROT then
        melee_onRout(cur, unitKey, slot)
    end
end
function melee_resolveOutcome(ctx)
    if not ctx then return end
    local unita = ctx.unita or {}

    local ricevuti, inflitti = {}, {}
    for key, _ in pairs(unita) do
        ricevuti[key] = 0
        inflitti[key] = 0
    end

    for slot = 1, 2 do
      local tiri = ctx["tiri" .. slot]
      if tiri then
        -- Colpi esatti per coppia: ogni tiro è di un'unità contro un nemico
        for _, t in ipairs(tiri) do
            local colpi = t.colpi or 0
            inflitti[t.unita]  = (inflitti[t.unita] or 0) + colpi
            ricevuti[t.nemico] = (ricevuti[t.nemico] or 0) + colpi
        end
      else
        local pesiUnita, pesiBersagli = {}, {}
        for key, info in pairs(unita) do
            if info.slot == slot then
                pesiUnita[key] = info.dadi
                for enemyKey, n in pairs(info.verso or {}) do
                    pesiBersagli[enemyKey] = (pesiBersagli[enemyKey] or 0) + n
                end
            end
        end
        local successi = ctx["successi" .. slot] or 0
        for key, n in pairs(melee_distribuisci(successi, pesiUnita)) do
            inflitti[key] = n
        end
        for enemyKey, n in pairs(melee_distribuisci(successi, pesiBersagli)) do
            ricevuti[enemyKey] = (ricevuti[enemyKey] or 0) + n
        end
      end
    end

    local chiavi = {}
    for key, _ in pairs(unita) do table.insert(chiavi, key) end
    table.sort(chiavi)

    ctx.testInCorso = 0
    local perse = {}

    for _, key in ipairs(chiavi) do
        printToAll(string.format("[MISCHIA] %s: inflitti %d, ricevuti %d",
            main_decodeExtendedUnitLabel(key), inflitti[key], ricevuti[key]), {r=1,g=0.8,b=0.3})
        perse[key] = melee_markLosses(key, ricevuti[key])
    end

    -- IMPETO (primo turno): chi infligge al nemico almeno il doppio
    -- dei colpi ricevuti da lui lo manda direttamente in ROTTA,
    -- salvo MURO DI SCUDI (capacità effettive: le disordinate le
    -- perdono, tranne SPADA).
    local travolte = melee_impetoRouts(ctx)

    for _, key in ipairs(chiavi) do
        local vincitore = travolte[key]
        if vincitore and main_getCohesion(key) ~= COHESION.ROT then
            printToAll(string.format("[MISCHIA] IMPETO: la %s infligge il doppio dei colpi, la %s va in ROTTA",
                main_decodeExtendedUnitLabel(vincitore), main_decodeExtendedUnitLabel(key)), {r=1,g=0.3,b=0.3})
            main_setCohesion(key, COHESION.ROT)
            melee_onRout(ctx, key, unita[key].slot)
            main_generalRisk(key, 11, "unita' sfondata dall'IMPETO")
            melee_offerBreakthrough(vincitore, unita[vincitore].slot, key)
        elseif ricevuti[key] > inflitti[key] then
            printToAll("[MISCHIA] Sconfitta: " .. main_decodeExtendedUnitLabel(key), {r=1,g=0.4,b=0.4})
            melee_lowerAndCheckRout(ctx, key, unita[key].slot)
        end
    end

    for _, key in ipairs(chiavi) do
        local basi = #main_getUnitBases(key)
        local marcate = #(IEF_MELEE_MARKED[key] or {})
        if perse[key] > 0 and marcate < basi and main_getCohesion(key) ~= COHESION.ROT then
            local meta = main_getUnitMeta(main_getUnitBases(key)[1])
            for _, sit in ipairs(main_moraleSituationsFor("LOSS", { tipo = meta and meta.unitType })) do
                if sit.def.testa == "VITTIMA" then
                    melee_queueTest(ctx, { key = key, slot = unita[key].slot, motivo = sit.nome, effetto = sit.def.effetto }, sit.def.quando)
                end
            end
        end
    end

    engine_subStep("MELEE_RESOLVE", nil, (ctx.testInCorso > 0) and "MORALE" or "ESCI")
end
-- ============================================================
-- FUNZIONE: melee_startEndOfPhaseTests(player)
-- Dopo tutte le mischie: test di morale con quando = FINE_FASE
-- (es. amiche entro 6" da un'unità in rotta), uno alla volta nel
-- pannello morale (main_runMoraleQueue). Il bottone di fase resta
-- bloccato finché il pannello non è vuoto (main_moraleBlocksPhase).
-- Ritorna true se ha avviato i test.
-- ============================================================
function melee_startEndOfPhaseTests(player)
    if #IEF_MORALE_END_QUEUE == 0 then return false end
    local coda = IEF_MORALE_END_QUEUE
    IEF_MORALE_END_QUEUE = {}
    main_runMoraleQueue(coda, nil, true)
    warningToColor("Test di morale di fine fase: tirali dal pannello, poi chiudi la fase", player, "Yellow", 5, true)
    return true
end
-- ============================================================
-- FUNZIONE: melee_infoClose(player, value, id)
-- ============================================================
function melee_infoClose(player, value, id)
    local unitKey = id:match("^btn_(.+)_MeleeInfoClose$")
    if unitKey then melee_infoCloseUnit(unitKey) end
end

-- ============================================================
-- FUNZIONE: melee_infoCloseUnit(unitKey)
-- ============================================================
function melee_infoCloseUnit(unitKey)
    local obj = IEF_MELEE_INFO_HOST[unitKey]
    IEF_MELEE_INFO_HOST[unitKey] = nil
    if obj and not obj.isDestroyed() then obj.UI.setXml("") end
end

-- ============================================================
-- FUNZIONE: melee_infoCloseAll()
-- ============================================================
function melee_infoCloseAll()
    local chiavi = {}
    for k, _ in pairs(IEF_MELEE_INFO_HOST) do table.insert(chiavi, k) end
    for _, k in ipairs(chiavi) do melee_infoCloseUnit(k) end
end

-- ============================================================
-- FUNZIONE: melee_hasCap(unitKey, nome)
-- Capacità effettiva (disordinata: solo SPADA).
-- ============================================================
function melee_hasCap(unitKey, nome)
    for _, c in ipairs(main_capabilitiesOf(unitKey)) do
        if c == nome then return true end
    end
    return false
end

-- ============================================================
-- FUNZIONE: melee_impetoRouts(ctx)
-- Regolamento, EFFETTI DELL'IMPETO: "Unità con capacità IMPETO,
-- che nel primo turno di mischia infliggano il doppio dei colpi
-- ricevuti all'unità nemica, la mandano direttamente in ROTTA".
-- "La capacità IMPETO viene annullata dalla capacità MURO DI
-- SCUDI". Confronto per coppia (colpi esatti dei tiri separati),
-- solo coppie al primo turno. Ritorna { [nemicoTravolto] = vincitore }.
-- ============================================================
function melee_impetoRouts(ctx)
    local out = {}
    local colpi = {}
    for slot = 1, 2 do
        for _, t in ipairs(ctx["tiri" .. slot] or {}) do
            colpi[t.unita] = colpi[t.unita] or {}
            colpi[t.unita][t.nemico] = (colpi[t.unita][t.nemico] or 0) + (t.colpi or 0)
        end
    end

    local gruppo = melee_getGroupById(ctx.groupId)
    if not gruppo then return out end
    for _, e in ipairs(gruppo.elementi) do
        if melee_elementoIsFirstTurn(e) then
            for slot = 1, 2 do
                local a = melee_elementoUnitKey(e, slot)
                local b = melee_elementoOtherKey(e, slot)
                if melee_hasCap(a, "IMPETO") and not melee_hasCap(b, "MURO_DI_SCUDI") then
                    local inflitti = (colpi[a] or {})[b] or 0
                    local ricevuti = (colpi[b] or {})[a] or 0
                    if inflitti > 0 and inflitti >= 2 * ricevuti and not out[b] then
                        out[b] = a
                    end
                end
            end
        end
    end
    return out
end

-- ============================================================
-- SFONDAMENTO (regolamento, EFFETTI DELL'IMPETO)
-- "L'unità vincitrice può eseguire un ulteriore movimento come
-- sfondamento e se è in grado di raggiungere (effettuando, se
-- necessario, un perno di massimo 2 pollici) altre unità nemiche,
-- può effettuare una nuova carica, la mischia derivante verrà
-- subito risolta applicando i fattori di primo turno; se invece
-- raggiunge l'unità in ROTTA in fuga, la distruggerà
-- immediatamente. Qualsiasi unità può effettuare un solo
-- sfondamento per turno."
-- Si apre cliccando una base del vincitore in fase MISCHIA,
-- dopo il movimento di rotta del nemico travolto.
-- ============================================================
function melee_offerBreakthrough(vincitore, slot, travolta)
    local turno = melee_currentTurn()
    if IEF_MELEE_BREAKTHROUGH_DONE[vincitore] == turno then return end
    IEF_MELEE_BREAKTHROUGH[vincitore] = { slot = slot, nemico = travolta, turno = turno }
    printToAll(string.format("[MISCHIA] La %s può fare lo SFONDAMENTO: dopo la rotta della %s clicca una sua base",
        main_decodeExtendedUnitLabel(vincitore), main_decodeExtendedUnitLabel(travolta)), {r=1,g=0.8,b=0.3})
end

-- Sfondamento disponibile ora per l'unità (o nil + motivo)
function melee_breakthroughFor(unitKey)
    local bt = IEF_MELEE_BREAKTHROUGH[unitKey]
    if not bt or bt.turno ~= melee_currentTurn() then return nil end
    if melee_getGroupOfUnit(unitKey) then
        return nil, "L'unità è ancora in mischia: niente sfondamento"
    end
    for _, item in ipairs(IEF_ROUT_PENDING[melee_elementoOtherSlot(bt.slot)] or {}) do
        if item.key == bt.nemico then
            return nil, string.format("Prima esegui il movimento di rotta della %s", main_decodeExtendedUnitLabel(bt.nemico))
        end
    end
    return bt
end

-- Corridoio del possibile sfondamento (stesse regole della carica)
function melee_btRedraw(ctx)
    local targetKey, _, _, frontLeft, sL, sR, eL, eR = charge_findLineTarget(ctx.key, ctx.slot)
    charge_drawCorridor(frontLeft, sL, sR, eL, eR)
    ctx.bersaglio = targetKey
    if ctx.player then
        warningToColor(targetKey and ("Sfondamento: raggiunge la " .. main_decodeExtendedUnitLabel(targetKey))
            or "Sfondamento: nessun nemico raggiungibile", Player[ctx.player], "Yellow", 4, true)
    end
end

function melee_btEnter(ctx, slot, rec)
    ctx.pivotUsed = ctx.pivotUsed or 0
    melee_btRedraw(ctx)
end

function melee_btClear(ctx)
    local basi = main_getUnitBases(ctx.key)
    if #basi > 0 then
        local _, _, frontLeft = charge_getFrontLine(basi)
        if frontLeft then frontLeft.setVectorLines({}) end
    end
end

function melee_btPivot(ctx, direzione, player)
    local basi = main_getUnitBases(ctx.key)
    local residuo = 2 - (ctx.pivotUsed or 0)
    if residuo <= 0.001 then
        warningToColor("Perno massimo (2\") già usato", player, "Yellow", 4, true); return
    end
    if #basi < 2 then
        warningToColor("Unità a base singola: perno non applicabile", player, "Yellow", 4, true); return
    end
    melee_btClear(ctx)
    local dist = math.min(1, residuo)
    local _, _, frontLeft, frontRight = charge_getFrontLine(basi)
    local p1, p2 = frontLeft.getPosition(), frontRight.getPosition()
    local radius = Vector(p2.x - p1.x, 0, p2.z - p1.z):magnitude()
    if radius <= 0.01 then return end
    local segno = (direzione == "left") and -1 or 1
    charge_applyPivot(basi, (direzione == "left") and frontLeft or frontRight, segno * (dist * INCH_TO_TTS) / radius)
    ctx.pivotUsed = (ctx.pivotUsed or 0) + dist
    melee_btRedraw(ctx)
end

function melee_btTranslate(basi, distInch)
    if distInch <= 0 then return end
    local fwd = charge_getFrontLine(basi)
    local delta = distInch * INCH_TO_TTS
    for _, o in ipairs(basi) do
        local p = o.getPosition()
        main_setPositionOnGround(o, p.x + fwd.x * delta, p.z + fwd.z * delta)
    end
    main_syncGeneralsOfBases(basi)
end

function melee_btGo(ctx, player)
    local key, slot = ctx.key, ctx.slot
    local basi = main_getUnitBases(key)
    melee_btClear(ctx)
    local targetKey, _, dist = charge_findLineTarget(key, slot)
    local turno = melee_currentTurn()
    IEF_MELEE_BREAKTHROUGH[key] = nil
    IEF_MELEE_BREAKTHROUGH_DONE[key] = turno
    IEF_UNIT_NO_MOVE_NEXT_TURN[key] = true

    if not targetKey then
        local pieno = main_unitFullMove(key)
        melee_btTranslate(basi, pieno)
        printToAll(string.format("[MISCHIA] Sfondamento della %s: avanza di %d\", nessun nemico raggiunto",
            main_decodeExtendedUnitLabel(key), pieno), {r=1,g=0.8,b=0.3})
        return
    end

    melee_btTranslate(basi, dist or 0)
    if charge_alignToEnemy then charge_alignToEnemy(key, targetKey) end

    if main_getCohesion(targetKey) == COHESION.ROT then
        printToAll(string.format("[MISCHIA] Sfondamento: la %s raggiunge la %s in rotta e la DISTRUGGE",
            main_decodeExtendedUnitLabel(key), main_decodeExtendedUnitLabel(targetKey)), {r=1,g=0.3,b=0.3})
        main_generalRoutCaught(targetKey)
        main_removeBases(targetKey, main_getUnitBases(targetKey))
        return
    end

    local k1 = (slot == 1) and key or targetKey
    local k2 = (slot == 1) and targetKey or key
    local e = melee_findOrCreateElement(k1, k2)
    e.turnStart = turno
    e.resolvedTurn = nil
    if slot == 1 then e.chargedArmy1 = true else e.chargedArmy2 = true end
    printToAll(string.format("[MISCHIA] Sfondamento: la %s carica la %s, mischia da risolvere subito (fattori di primo turno)",
        main_decodeExtendedUnitLabel(key), main_decodeExtendedUnitLabel(targetKey)), {r=1,g=0.8,b=0.3})
end

-- onClick del pannello SFONDAMENTO
function melee_btClick(ctx, slot, player, rec, value)
    ctx.player = player.color
    if value == "SX" then melee_btPivot(ctx, "left", player)
    elseif value == "DX" then melee_btPivot(ctx, "right", player)
    elseif value == "GO" then
        melee_btGo(ctx, player)
        engine_subClose("SFONDAMENTO", slot, { fatto = true })
    else
        melee_btClear(ctx)
        IEF_MELEE_BREAKTHROUGH[ctx.key] = nil
        IEF_MELEE_BREAKTHROUGH_DONE[ctx.key] = melee_currentTurn()
        printToAll(string.format("[MISCHIA] La %s rinuncia allo sfondamento", main_decodeExtendedUnitLabel(ctx.key)), {r=0.8,g=0.8,b=0.8})
        engine_subClose("SFONDAMENTO", slot, { fatto = false })
    end
end

function melee_btDone(ctx, result, slot)
    callHandler("buildUI")
    melee_hideChargeLists()
end
