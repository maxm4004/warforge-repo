-- ============================================================
-- RENDERER: 2BtnClickMeleeList
-- ============================================================
registerRenderer("2BtnClickMeleeList", function(phase)
    UI.setAttribute("panelBtnUp",   "active", "true")
    UI.setAttribute("panelBtnDown", "active", "false")
    UI.setAttribute("panelBtnUp",   "offsetXY", "0 -223")
    UI.setAttribute("panelDices",   "active", "false")
    local attivo = (#melee_getGroups() > 0) and "true" or "false"
    UI.setAttribute("melee_list_army1", "active", attivo)
    UI.setAttribute("melee_list_army2", "active", attivo)
    UI.setAttribute("charge_attack_list_army1",  "active", "false")
    UI.setAttribute("charge_attack_list_army2",  "active", "false")
    UI.setAttribute("charge_defense_list_army1", "active", "false")
    UI.setAttribute("charge_defense_list_army2", "active", "false")
end)

-- ============================================================
-- RENDERER: meleeResolve
-- ============================================================
registerRenderer("meleeResolve", function(phase)
    UI.setAttribute("panelBtnUp",   "active", "true")
    UI.setAttribute("panelBtnDown", "active", "false")
    UI.setAttribute("panelDices",   "active", "false")
    UI.setAttribute("panelBtnUp",   "offsetXY", "0 -223")
    UI.setAttribute("melee_list_army1", "active", "false")
    UI.setAttribute("melee_list_army2", "active", "false")
    UI.setAttribute("charge_attack_list_army1",  "active", "false")
    UI.setAttribute("charge_attack_list_army2",  "active", "false")
    UI.setAttribute("charge_defense_list_army1", "active", "false")
    UI.setAttribute("charge_defense_list_army2", "active", "false")
end)
