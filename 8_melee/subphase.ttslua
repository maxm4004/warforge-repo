-- ============================================================
-- FUNZIONE: melee_subphases()
-- ============================================================
function melee_subphases()
    return {
        MELEE_RESOLVE = {
            scope       = "shared",
            blocksPhase = false,
            title       = "",
            first       = "TIRO",
            onEnter     = "melee_resolveEnter",
            subphases   = { "MORALE_TEST" },
            steps = {
                TIRO   = { render = "meleeTiro",   actor = "both", icon = "mischia", label = "Combatti in Mischia", onClick = "melee_resolveFocus", onRoll = "melee_resolveRoll" },
                MORALE = { render = "meleeMorale", actor = "both", icon = "morale"},
                ESCI   = { render = "meleeEsci",   actor = "both", onEnter = "melee_resolveEsciEnter", onRestore = "melee_resolveEsciEnter" },
            },
        },
        SFONDAMENTO = {
            scope   = "player",
            title   = "SFONDAMENTO",
            first   = "SCEGLI",
            onEnter = "melee_btEnter",
            steps = {
                SCEGLI = { render = "meleeSfondamento", actor = "owner", onClick = "melee_btClick" },
            },
        },
    }
end

-- ============================================================
-- FUNZIONE: melee_resolveCtx(groupId)
-- ctx di MELEE_RESOLVE se è aperta su questo gruppo, altrimenti nil.
-- ============================================================
function melee_resolveCtx(groupId)
    local sh = engine_subShared()
    if sh and sh.name == "MELEE_RESOLVE" and sh.ctx and sh.ctx.groupId == groupId then
        return sh.ctx, sh
    end
    return nil
end
-- ============================================================
-- FUNZIONE: melee_diceScheda(slot, calc, tiro, i, n)
-- Scheda del pannello dadi per UN tiro (unità -> nemico): dadi
-- dell'unità (contatto, posteriori, overlap, mista, disordinata),
-- dadi verso quel nemico, soglia e modificatori della coppia.
-- tiro = nil: nessun dado per lo slot. Solo dati semplici.
-- ============================================================
function melee_diceScheda(slot, calc, tiro, i, n)
    local righe = { { "DADI", "", "sezione" } }
    local nomeEs = ARMY[slot] and ARMY[slot].name or ""
    if not tiro then
        table.insert(righe, { "Nessun dado in questa mischia", "", DICEPANEL.subColor })
        return { titolo = "MISCHIA", sottotitolo = nomeEs, righe = righe }
    end

    local info = calc and calc.unita and calc.unita[tiro.unita] or {}
    local d = info.dettaglio or {}
    local parti = string.format("contatto %d, posteriori %d", d.contatto or 0, d.posteriori or 0)
    if (d.overlap or 0) > 0 then parti = parti .. string.format(", overlap %d", d.overlap) end
    table.insert(righe, { "Basi: " .. parti, tostring(d.dadiGrezzi or 0) })
    if d.mista then table.insert(righe, { "Unita' mista: meta' dei dadi", "" }) end
    if d.dimezzati then table.insert(righe, { "Disordinata: meta' dei dadi", "" }) end
    if n and n > 1 then
        table.insert(righe, { "Dadi contro " .. main_decodeExtendedUnitLabel(tiro.nemico), tostring(tiro.dadi) })
    end
    table.insert(righe, { "Totale dadi", tiro.dadi .. "D6" })

    table.insert(righe, { "PER COLPIRE", "", "sezione" })
    table.insert(righe, { "Turno di mischia", d.primoTurno and "primo" or "successivo" })
    table.insert(righe, { "Mischia: serve", tiro.base .. "+" })
    if not tiro.voci or #tiro.voci == 0 then
        table.insert(righe, { "Nessun modificatore", "", DICEPANEL.subColor })
    end
    for _, v in ipairs(tiro.voci or {}) do table.insert(righe, { v[1], v[2] }) end

    return {
        titolo      = (n and n > 1) and string.format("MISCHIA - tiro %d/%d", i, n) or "MISCHIA",
        sottotitolo = string.format("%s: %s contro %s", nomeEs,
            main_decodeExtendedUnitLabel(tiro.unita), main_decodeExtendedUnitLabel(tiro.nemico)),
        righe       = righe,
        serve       = shoot_sogliaTesto(tiro.base, tiro.soglia),
        soglia      = tiro.soglia,
    }
end
-- ============================================================
-- FUNZIONE: melee_resolveEnter(ctx, slot, rec)
-- Apertura: calcola i dadi del gruppo, i tiri per bersaglio e
-- le schede del pannello dadi (prima scheda di ogni esercito).
-- ctx["tiri"..s] = { { unita, nemico, dadi, base, mod, soglia,
--                      scheda, colpi }, ... }, ctx["tiro"..s] = indice
-- ============================================================
function melee_resolveEnter(ctx, slot, rec)
    engine_diceClearLastRoll(1)
    engine_diceClearLastRoll(2)

    local gruppo = melee_getGroupById(ctx.groupId)
    local calc = gruppo and melee_computeGroup(gruppo)

    ctx.unita = {}
    for s = 1, 2 do
        local tiri = {}
        local lista = (calc and calc[s].tiri) or {}
        for i, t in ipairs(lista) do
            table.insert(tiri, {
                unita = t.unita, nemico = t.nemico, dadi = t.dadi,
                base = t.base, mod = t.mod, soglia = t.soglia,
                scheda = melee_diceScheda(s, calc, t, i, #lista),
                colpi = nil,
            })
        end
        ctx["tiri" .. s]     = tiri
        ctx["tiro" .. s]     = 1
        ctx["dadi" .. s]     = calc and calc[s].dadi or 0
        ctx["rolled" .. s]   = #tiri == 0
        ctx["successi" .. s] = 0
        ctx["scheda" .. s]   = tiri[1] and tiri[1].scheda or melee_diceScheda(s, calc, nil)
        -- Entrambe le colonne del pannello dadi visibili da subito
        -- (prima dei tiri), affiancate.
        engine_dicePanelOpen(s, ctx["scheda" .. s])
        for i, t in ipairs(tiri) do
            printToAll(string.format("[MISCHIA] %s tiro %d/%d: %s contro %s, %dD6, %s",
                ARMY[s].name, i, #tiri, main_decodeExtendedUnitLabel(t.unita),
                main_decodeExtendedUnitLabel(t.nemico), t.dadi, t.scheda.serve or ""), {r=1,g=0.8,b=0.3})
        end
    end
    if calc then
        for key, info in pairs(calc.unita) do
            ctx.unita[key] = { slot = info.slot, dadi = info.dadi, verso = info.verso }
        end
    end
    ctx.testInCorso = 0

    -- Nessuno ha dadi: esito subito (fuori da engine_subOpen)
    if ctx.rolled1 and ctx.rolled2 then
        local groupId = ctx.groupId
        Wait.frames(function()
            local c = melee_resolveCtx(groupId)
            if c then melee_resolveOutcome(c) end
        end, 1)
    end
end

-- ============================================================
-- FUNZIONE: melee_resolveFocus(ctx, slot, player, rec)
-- Bottone dello step TIRO: camera sui dadi e pannello dadi.
-- ============================================================
function melee_resolveFocus(ctx, slot, player, rec)
    ctx["aiDadi" .. slot] = true
    if player then
        engine_cameraByNamme(player, nil, CAMERA_ZONE.ARMY_ROLL_DICES)
    end
    if ctx["scheda" .. slot] and not ctx["rolled" .. slot] and not engine_dicePanelIsOpen(slot) then
        engine_dicePanelOpen(slot, ctx["scheda" .. slot])
    end
    engine_subRedraw()
end

-- ============================================================
-- FUNZIONE: melee_resolveRoll(ctx, slot, player, rec)
-- Roll fisico nello step TIRO: tira il tiro corrente dello slot
-- (un'unità contro un nemico). Con più bersagli, dopo l'esito si
-- passa al tiro successivo (nuovo Roll). Salva i colpi per
-- coppia, NON toglie basi: le perdite sono reciproche
-- (melee_resolveOutcome) e si calcolano a tiri finiti.
-- ============================================================
function melee_resolveRoll(ctx, slot, player, rec)
    if ctx["rolled" .. slot] or ctx["tirando" .. slot] then return end
    local tiri = ctx["tiri" .. slot] or {}
    local idx = ctx["tiro" .. slot] or 1
    local tiro = tiri[idx]
    if not tiro then return end

    local groupId = ctx.groupId
    IEF_DICE_ROLL_TRY[slot] = { dadi = tiro.dadi, soglia = tiro.soglia }
    ctx["tirando" .. slot] = true
    warningToColor(string.format("%s tira %d D6 contro %s: %s", ARMY[slot].name, tiro.dadi,
        main_decodeExtendedUnitLabel(tiro.nemico), tiro.scheda.serve or ""), player, "Yellow", 5, true)
    if not engine_dicePanelIsOpen(slot) then
        engine_dicePanelOpen(slot, tiro.scheda)
    end

    engine_diceThrowFromBag(slot, nil, function(risultati, successi)
        local c = melee_resolveCtx(groupId)
        if not c or c["rolled" .. slot] then return end
        c["tirando" .. slot] = nil

        local t = c["tiri" .. slot][idx]
        t.colpi = successi or 0
        c["successi" .. slot] = (c["successi" .. slot] or 0) + t.colpi
        printToAll(string.format("[MISCHIA] %s: %s contro %s, %d colpi a segno", ARMY[slot].name,
            main_decodeExtendedUnitLabel(t.unita), main_decodeExtendedUnitLabel(t.nemico), t.colpi), {r=1,g=0.8,b=0.3})
        engine_dicePanelOutcome(slot,
            (t.colpi == 1) and "1 colpo a segno" or string.format("%d colpi a segno", t.colpi),
            (t.colpi > 0) and DICEPANEL.okColor or DICEPANEL.koColor)

        local prossimo = c["tiri" .. slot][idx + 1]
        if prossimo then
            -- Tiro successivo dello stesso esercito: nuova scheda, nuovo Roll
            c["tiro" .. slot] = idx + 1
            c["scheda" .. slot] = prossimo.scheda
            Wait.time(function()
                local c2 = melee_resolveCtx(groupId)
                if not c2 or c2["tiro" .. slot] ~= idx + 1 then return end
                engine_diceClearLastRoll(slot)
                engine_dicePanelOpen(slot, prossimo.scheda)
                if player then engine_cameraByNamme(player, nil, CAMERA_ZONE.ARMY_ROLL_DICES) end
                warningToColor(string.format("Tiro %d/%d: %dD6 contro %s - premi Roll",
                    idx + 1, #c2["tiri" .. slot], prossimo.dadi, main_decodeExtendedUnitLabel(prossimo.nemico)),
                    player, "Yellow", 5, true)
            end, MORALE_ESITO_SECONDS)
            return
        end

        Wait.time(function()
            engine_cameraByNamme(player, nil, CAMERA_ZONE.ARMY_HOME)
        end, 2)
        c["rolled" .. slot] = true
        if c.rolled1 and c.rolled2 then
            melee_resolveOutcome(c)
        else
            engine_subRedraw()
        end
    end)
end
-- ============================================================
-- FUNZIONE: melee_moraleTestDone(dati, esito)
-- onDone dei test di morale IMMEDIATI nati dalla mischia.
-- dati = { groupId, key, slot }
-- ============================================================
function melee_moraleTestDone(dati, esito)
    local ctx, rec = melee_resolveCtx(dati.groupId)

    if esito == MORALE_RESULT.KO then
        melee_lowerAndCheckRout(ctx, dati.key, dati.slot)
    end

    if ctx then
        ctx.testInCorso = (ctx.testInCorso or 1) - 1
        if ctx.testInCorso <= 0 and rec.step == "MORALE" then
            engine_subStep("MELEE_RESOLVE", nil, "ESCI")
        end
    end
end

-- ============================================================
-- FUNZIONE: melee_resolveEsciEnter(ctx, slot, rec)
-- Step ESCI: esito per MORALE_ESITO_SECONDS, poi chiusura.
-- ============================================================
function melee_resolveEsciEnter(ctx, slot, rec)
    local groupId = ctx.groupId
    Wait.time(function()
        if melee_resolveCtx(groupId) then
            engine_subClose("MELEE_RESOLVE", nil, { groupId = groupId })
        end
    end, MORALE_ESITO_SECONDS)
end

-- ============================================================
-- FUNZIONE: melee_resolveDone(ctx, result, slot)
-- onDone di MELEE_RESOLVE: gruppo risolto in questo turno,
-- coppie con unità in ROTTA tolte, coppie non più a contatto
-- tolte (melee_pruneList, come al vecchio rientro in MELEE),
-- lista ridisegnata.
-- Si resta in MELEE.
-- ============================================================
function melee_resolveDone(ctx, result, slot)

    engine_dicePanelClose(1)
    engine_dicePanelClose(2)

    local gruppo = melee_getGroupById(ctx.groupId)
    if gruppo then
        local turno = melee_currentTurn()
        for _, e in ipairs(gruppo.elementi) do e.resolvedTurn = turno end
    end

    for i = #IEF_MELEE_LIST, 1, -1 do
        local e = IEF_MELEE_LIST[i]
        if main_getCohesion(e.unitArmy1Key) == COHESION.ROT or main_getCohesion(e.unitArmy2Key) == COHESION.ROT then
            table.remove(IEF_MELEE_LIST, i)
        end
    end

    melee_pruneList()

    callHandler("buildUI")
    melee_hideChargeLists()
end

-- ============================================================
-- Registrazione
-- ============================================================
registerSubphases(melee_subphases())
registerHandler("melee_resolveEnter",     function(c,s,r)     return melee_resolveEnter(c,s,r)     end)
registerHandler("melee_resolveFocus",     function(c,s,p,r)   return melee_resolveFocus(c,s,p,r)   end)
registerHandler("melee_resolveRoll",      function(c,s,p,r)   return melee_resolveRoll(c,s,p,r)    end)
registerHandler("melee_moraleTestDone",   function(d,esito)   return melee_moraleTestDone(d,esito) end)
registerHandler("melee_resolveEsciEnter", function(c,s,r)     return melee_resolveEsciEnter(c,s,r) end)
registerHandler("melee_resolveDone",      function(c,res,s)   return melee_resolveDone(c,res,s)    end)
registerHandler("melee_btEnter",          function(c,s,r)     return melee_btEnter(c,s,r)          end)
registerHandler("melee_btClick",          function(...)       return melee_btClick(...)            end)
registerHandler("melee_btDone",           function(c,res,s)   return melee_btDone(c,res,s)         end)
