IEF_MELEE_LIST = IEF_MELEE_LIST or {}

-- Contatore id univoci in IEF_MELEE_LIST
IEF_MELEE_NEXT_ID = IEF_MELEE_NEXT_ID or 0

-- Perdite di mischia MARCATE nella fase corrente, rimosse a
-- fine fase MELEE: [unitKey] = { guid, ... }
IEF_MELEE_MARKED = IEF_MELEE_MARKED or {}

-- Pannelli 3D INFO MISCHIA aperti: [unitKey] = base ospite
IEF_MELEE_INFO_HOST = IEF_MELEE_INFO_HOST or {}

-- Sfondamenti (IMPETO) disponibili: [unitKey] = { slot, nemico, turno }
IEF_MELEE_BREAKTHROUGH = IEF_MELEE_BREAKTHROUGH or {}
-- Sfondamento già fatto/rinunciato: [unitKey] = turno (uno per turno)
IEF_MELEE_BREAKTHROUGH_DONE = IEF_MELEE_BREAKTHROUGH_DONE or {}
