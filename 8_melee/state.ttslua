IEF_MELEE_LIST = IEF_MELEE_LIST or {}

-- Contatore id univoci in IEF_MELEE_LIST
IEF_MELEE_NEXT_ID = IEF_MELEE_NEXT_ID or 0

-- Gruppo scelto dalla lista in attesa di Attacca/Annulla nel
