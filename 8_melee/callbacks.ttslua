-- ============================================================
-- FUNZIONE: melee_btn_army1(player, value, id, buttonConfig)
-- "Mischie Completate": consentito solo a gruppi tutti risolti;
-- se ci sono test di morale di fine fase, li avvia prima.
-- ============================================================
function melee_btn_army1(player, value, id, buttonConfig)

    if main_moraleBlocksPhase(player, 1) then return false end

    if melee_listHasPending() then
        warningToColor("Ci sono ancora mischie da risolvere", player, "Yellow", 5)
        return false
    end
    if melee_startEndOfPhaseTests(player) then
        return false
    end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY1)
    return true
end

-- ============================================================
-- FUNZIONE: melee_btn_army2(player, value, id, buttonConfig)
-- ============================================================
function melee_btn_army2(player, value, id, buttonConfig)

    if main_moraleBlocksPhase(player, 2) then return false end

    if melee_listHasPending() then
        warningToColor("Ci sono ancora mischie da risolvere", player, "Yellow", 5)
        return false
    end
    if melee_startEndOfPhaseTests(player) then
        return false
    end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY2)
    return true
end