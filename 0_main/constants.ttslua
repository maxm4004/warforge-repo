-- ============================================================
-- APPOGGIO DELLE BASI SUL TERRENO (movimenti da script)
-- setPosition con la Y vecchia lascia la base dentro una collina.
-- Si misura il terreno su tutta l'impronta della base (griglia
-- 5x5 di raggi verso il basso, dimensioni dichiarate, assi nativi
-- TTS) nella posizione e rotazione di arrivo, si prende il punto
-- più alto e ci si appoggia il fondo della base.
-- ============================================================
IEF_GROUND_GRID    = { -1, -0.5, 0, 0.5, 1 }   -- campioni per lato (frazione della semidimensione)

IEF_GROUND_INSET   = 0.02                     -- unità TTS: campioni appena dentro il bordo

IEF_GROUND_EPSILON = 0.01                     -- unità TTS: margine sopra il terreno

-- F27: gioco fra le basi di un'unità (unità TTS), usato sia allo
-- spawn sia da RIORDINA. 0.10 = 1.3 mm: con le mesh alla misura
-- esatta, ranghi a contatto => la fisica solleva qualche base.
IEF_FILE_GAP = 0.03                           -- fra le colonne

IEF_RANK_GAP = 0.03                           -- fra i ranghi (F28: 0.10 lasciava spazio visibile)

-- ============================================================
-- F31: MODO DI APPOGGIO SUI PENDII (prova, scelta di Max)
--   "A" = la base si inclina e segue il pendio (calcolato dallo
--         script, niente fisica)
--   "B" = la base resta piana, poi la fisica la fa assestare
--   "C" = la base resta piana, appoggiata sul punto più alto
--         (come prima: a valle resta sospesa)
-- Si cambia al volo con  /execute debug_terreno("A")
-- ============================================================
IEF_GROUND_MODE  = IEF_GROUND_MODE or "A"

IEF_CHARGE_PIVOT_INCHES = 2

-- ------------------------------------------------------------
-- (da 0_main/morale.ttslua)
-- ------------------------------------------------------------
-- ============================================================
-- SITUAZIONI (regolamento "QUANDO È NECESSARIO EFFETTUARE UN
-- TEST DI MORALE?"). Filtri assenti = nessun filtro.
--   evento        : chi solleva la situazione (LOSS, CHARGED,
--                   CHARGE_DECLARE, FRIEND_ROUT, GENERAL_KILLED)
--   testa         : chi fa il test (VITTIMA, CARICATA, CARICANTE,
--                   AMICHE_IN_RAGGIO)
--   tipi / tipiAvversario / tipiAvversarioEsclusi : tipi unità
--   terreno       : categoria terreno dell'unità che testa
--   lato          : lato del contatto (FRONTE, FIANCO, RETRO)
--   soloArmiDaTiro: l'unità che testa ha SOLO armi da tiro
--                   (main_soloArmiDaTiro): almeno un'arma da tiro
--                   non in armiEscluse e nessuna arma da mischia
--                   elencata (le unità miste, es. Lancia+Arco, no)
--   raggio        : pollici per AMICHE_IN_RAGGIO
--   tipiOrigineEsclusi / escludiGiaInFuga : filtri sull'unità
--                   che ha generato l'evento
--   effetto       : colonna di morale.json (per_caricare,
--                   per_riordinare, altre_situazioni)
--   quando        : IMMEDIATO o FINE_FASE (dopo tutte le mischie
--                   o tutti i tiri)
-- ============================================================
IEF_MORALE_SITUATIONS = {
    BASE_PERSA = {
        evento = "LOSS",
        testa = "VITTIMA",
        effetto = "altre_situazioni",
        quando = "IMMEDIATO",
        label = "ha perso basi",
    },
    CARICA_IN_TERRENO_APERTO = {
        evento = "CHARGED",
        testa = "CARICATA",
        tipi = { "FM" },
        tipiAvversario = { "KN", "CP" },
        terreno = "APERTO",
        effetto = "altre_situazioni",
        quando = "IMMEDIATO",
        label = "caricata in terreno aperto",
    },
    CARICA_SUL_FRONTE = {
        evento = "CHARGE_DECLARE",
        testa = "CARICANTE",
        tipi = { "CL" },
        tipiAvversarioEsclusi = { "CL", "FL", "ART" },
        lato = "FRONTE",
        effetto = "per_caricare",
        quando = "IMMEDIATO",
        label = "vuole caricare sul fronte",   
    },
    CARICA_CON_ARMI_DA_TIRO = {
        evento = "CHARGE_DECLARE",
        testa = "CARICANTE",
        tipi = { "FP", "FM" },
        soloArmiDaTiro = true,
        armiEscluse = { "GIAVELLOTTO" },
        tipiAvversarioEsclusi = { "FL", "ART" },
        effetto = "per_caricare",
        quando = "IMMEDIATO",
        label = "con sole armi da tiro vuole caricare",
    },
    AMICA_IN_ROTTA = {
        evento = "FRIEND_ROUT",
        testa = "AMICHE_IN_RAGGIO",
        raggio = 6,
        tipiOrigineEsclusi = { "FL" },
        escludiGiaInFuga = true,
        effetto = "altre_situazioni",
        quando = "FINE_FASE",
        label = "un'unita' amica vicina e' in rotta",
    },
    GENERALE_UCCISO = {
        evento = "GENERAL_KILLED",
        testa = "AMICHE_IN_RAGGIO",
        raggio = 6,
        effetto = "altre_situazioni",
        quando = "FINE_FASE",
        label = "il Generale e' stato ucciso",

    },
}

