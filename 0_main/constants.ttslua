    RECUPERO = "tenta di riordinarsi",
}

-- ============================================================
-- MODIFICATORI del test di morale. chiave = morale_modifiers di
-- morale.json (valore unitario), condizione = funzione in
-- IEF_MORALE_CONDITIONS che ritorna quante volte si applica.
-- ============================================================
IEF_MORALE_MODIFIERS = {
    { chiave = "generale_con_unita",      condizione = "GENERALE_AGGREGATO",   label = "Generale aggregato" },
    { chiave = "ogni_base_persa",         condizione = "BASI_PERSE_DA_INIZIO", label = "Basi perse" },
    { chiave = "fianco_retro_caricabile", condizione = "NEMICO_FIANCO_RETRO",  label = "Nemico su fianco o retro" },
    { chiave = "unita_disordinata",       condizione = "COESIONE_DIS",         label = "Unita' disordinata" },
    { chiave = "unita_in_rotta",          condizione = "COESIONE_ROT",         label = "Unita' in rotta" },
}

-- Tolleranza di contatto per il Generale aggregato (pollici)
IEF_GENERAL_ATTACH_INCHES = 0.1

-- Gravità delle categorie di terreno (la peggiore vince)
IEF_TERRAIN_SEVERITY = { APERTO = 0, COVER = 0, ROTTO = 1, FIUME = 2, DIFFICILE = 3, INTRANSITABILE = 4 }

-- ============================================================
-- CONDIZIONI: function(unitKey, ctx) -> numero di applicazioni
-- ctx.basiInSospeso = basi perse non ancora rimosse (mischia)
-- ============================================================
IEF_MORALE_CONDITIONS = {
    GENERALE_AGGREGATO = function(unitKey, ctx)
        return main_getAttachedGeneral(unitKey) and 1 or 0
    end,
    BASI_PERSE_DA_INIZIO = function(unitKey, ctx)
        return (IEF_UNIT_BASES_LOST[unitKey] or 0) + ((ctx and ctx.basiInSospeso) or 0)
    end,
    NEMICO_FIANCO_RETRO = function(unitKey, ctx)
        return main_enemyOnFlankOrRear(unitKey) and 1 or 0
    end,
    COESIONE_DIS = function(unitKey, ctx)
        return main_getCohesion(unitKey) == COHESION.DIS and 1 or 0
    end,
    COESIONE_ROT = function(unitKey, ctx)
        return main_getCohesion(unitKey) == COHESION.ROT and 1 or 0
    end,
}

