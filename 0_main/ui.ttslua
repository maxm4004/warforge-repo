-- Bottoni dei pannelli di conferma (Tiro, Dichiara, Test Morale,
-- Annulla misura): testo normale (non grassetto), colori qui.
CONFIRMPANEL = {
    actionBg   = "#B8902E",                  -- bottone d'azione: oro
    closeBg    = "rgba(0.75,0.75,0.75,1)",   -- Chiudi / Annulla: grigio chiaro
    actionText = "Black",
    closeText  = "Black",
}
-- ============================================================
-- rulesets/imperifeudi/engine/ui.ttslua
-- UI specifica IEF: getRulesetUiXml() + updateCenterPanel()
-- buildUI() vive in engine/ui.ttslua (come in LH)
-- ============================================================

function getRulesetUiXml()

    -- Genera 2 copie del pannello di caricamento, una per slot
    local movePanels = ""
    for slot = 1, 2 do
        local s = tostring(slot)
        local col = ARMY[slot].color

        movePanels = movePanels .. string.format([[

    <Panel id="loadingPanel_%s" rectAlignment="MiddleCenter" width="320" height="40" color="rgba(0,0,0,0.35)" visibility="%s" active="false">
        <VerticalLayout spacing="2" padding="0" childAlignment="MiddleCenter">
            <Text id="loadingLabel_%s" text="" font="warforge_font" fontSize="10" color="White" alignment="MiddleCenter" width="290" height="24"/>
            <ProgressBar id="loadingBar_%s" width="350" height="30" percentage="0" color="#333333" fillImageColor="Orange" 
                showPercentageText="true" textColor="White"/>
        </VerticalLayout>
    </Panel>

        ]], s, col, s, s)
    end

    -- Liste Attacco/Difesa carica: righe generate dinamicamente
    -- da IEF_CHARGE_QUEUE (nessun limite fisso), stesso schema di
    -- popups/movePanels sopra.

    local chargeAttack1  = charge_getAttackListPanelXml(1)
    local chargeAttack2  = charge_getAttackListPanelXml(2)
    local chargeDefense1 = charge_getDefenseListPanelXml(1)
    local chargeDefense2 = charge_getDefenseListPanelXml(2)
    local meleeList1 = melee_getListPanelXml(1)
    local meleeList2 = melee_getListPanelXml(2)
    local moraleQueue1 = main_getMoraleQueuePanelXml(1)
    local moraleQueue2 = main_getMoraleQueuePanelXml(2)

    return 
    [[

    <Panel id="panelTop"
           rectAlignment="UpperCenter"
           width="450" height="150"
           color="rgba(0,0,0,0.25)"
           offsetXY="0 -70">
        <VerticalLayout spacing="6" padding="10 10 10 10">
            <HorizontalLayout spacing="6" childAlignment="MiddleCenter">
                <Text id="textTurno"
                      text=""
                      fontSize="22" fontStyle="Bold"
                      outline="#000000" outlineSize="2"
                      color="Orange"/>
            </HorizontalLayout>
            <HorizontalLayout spacing="6" childAlignment="MiddleCenter">         
                <Text id="textFase"
                      text=""
                      fontSize="18" fontStyle="Bold"
                      outline="#000000" outlineSize="2"
                      color="Yellow"/>
            </HorizontalLayout>
            <Text id="textDesc"
                  text=""
                  fontSize="12"
                  color="rgba(0.8,0.8,0.8,1)"
                  alignment="MiddleCenter"/>
            <HorizontalLayout spacing="6" childAlignment="MiddleCenter" color="rgba(0,0,0,0)">
                <Text id="army1" text="Army 1" fontSize="14" fontStyle="Bold" color="Grey" alignment="MiddleCenter"/>
                <Button id="iconWinnerArmy1" icon="left" iconColor="rgba(1,1,1,0)" color="rgba(0,0,0,0)"/>
                <Button icon="iniziativa" tooltip="Iniziativa" tooltipPosition="Below" iconAlignment="Left" color="rgba(0,0,0,0)"/>
                <Button id="iconWinnerArmy2" icon="right" iconColor="rgba(1,1,1,0)" color="rgba(0,0,0,0)"/>
                <Text id="army2" text="Army 2" fontSize="14" fontStyle="Bold" color="Grey" alignment="MiddleCenter"/>
            </HorizontalLayout>
        </VerticalLayout>
    </Panel>

    <Panel id="panelBtnUp"
           rectAlignment="UpperCenter"
           width="450" height="50"
           color="rgba(0,0,0,0.35)">
        <VerticalLayout spacing="6" padding="10 10 10 10">
            <HorizontalLayout spacing="30">
                    <Button id="BTN_ARMY1" text="" fontSize="14" fontStyle="Bold"
                            color="Red" textColor="White"
                            outline="#000000" outlineSize="1"
                            onClick="onBtnArmy1"/>
                    <Button id="BTN_ARMY2" text="" fontSize="14" fontStyle="Bold"
                            color="Green" textColor="White"
                            outline="#000000" outlineSize="1"
                            onClick="onBtnArmy2"/>
            </HorizontalLayout>
        </VerticalLayout>
    </Panel>

    <Panel id="panelBtnDown"
           rectAlignment="UpperCenter"
           width="450" height="50"
           color="rgba(0,0,0,0.37)"
           offsetXY="0 -244">
        <VerticalLayout spacing="6" padding="10 10 10 10">
            <HorizontalLayout childAlignment="MiddleCenter">
                    <Button id="BTN_SINGLE" text="BTN_SINGLE" width="380" fontSize="14" fontStyle="Bold"
                            color="Grey" textColor="White"
                            outline="#000000" outlineSize="1"
                            onClick="onBtnScelta"/>
            </HorizontalLayout>
        </VerticalLayout>
    </Panel>
    <!--
    <Panel id="iconWinnerArmy1" rectAlignment="UpperCenter" width="50" height="30" 
    offsetXY="-195 -180" color="rgba(0,0,0,0)" active="false">
        <Image outline="#000000" outlineSize="0.6" image="https://raw.githubusercontent.com/maxm4004/warforge-ief/refs/heads/main/images/crown.png" preserveAspect="1"/>
    </Panel>
    <Panel id="iconWinnerArmy2" rectAlignment="UpperCenter" width="50" height="30" 
    offsetXY="195 -180" color="rgba(0,0,0,0)" active="false">
        <Image outline="#000000" outlineSize="0.6" image="https://raw.githubusercontent.com/maxm4004/warforge-ief/refs/heads/main/images/crown.png" preserveAspect="1"/>
    </Panel>
    <Panel id="iconMoveArmy1" rectAlignment="UpperCenter" width="40" height="20" offsetXY="-35 -206" color="rgba(0,0,0,0)" active="false">
        <Image outline="#000000" outlineSize="0.6" image="https://raw.githubusercontent.com/maxm4004/warforge-ief/refs/heads/main/images/arr11.png" preserveAspect="1"/>
    </Panel>
    <Panel id="iconMoveArmy2" rectAlignment="UpperCenter" width="40" height="20" offsetXY="35 -206" color="rgba(0,0,0,0)" active="false">
        <Image outline="#000000" outlineSize="0.6" image="https://raw.githubusercontent.com/maxm4004/warforge-ief/refs/heads/main/images/arr22.png" preserveAspect="1"/>
    </Panel>
    -->
    <Panel id="panelFieldDice"
        rectAlignment="UpperCenter"
        width="450" height="100"
        color="rgba(0,0,0,0.35)"
        offsetXY="0 -244"
        active="false">
        <HorizontalLayout spacing="6" childAlignment="MiddleCenter" height="60">
            <Image id="diceField" image="https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-Lua/refs/heads/main/dice/1d6.png" preserveAspect="1"/>
        </HorizontalLayout>
    </Panel>
    ]] .. movePanels ..  [[
    
        <!-- CONFIRM SHOOT PANEL -->
        <Panel id="confirm_panel_shoot"
        rectAlignment="LowerCenter"
        width="300" height="50"
        color="rgba(0,0,0,0.00)"
        offsetXY="0 100"
        active="false">
        <HorizontalLayout spacing="8" padding="10 10 10 10" childAlignment="MiddleCenter" childForceExpandWidth="false" position="0 -100 0">
            <Button id="btnShoot" text="Tiro" font="warforge_font" fontSize="13" fontStyle="Normal" color="]] .. CONFIRMPANEL.actionBg .. [[" textColor="]] .. CONFIRMPANEL.actionText .. [[" preferredWidth="130" preferredHeight="34" onClick="shoot_Confirm"/>
            <Button id="btnShootCancel" text="Chiudi" font="warforge_font" fontSize="13" fontStyle="Normal" color="]] .. CONFIRMPANEL.closeBg .. [[" textColor="]] .. CONFIRMPANEL.closeText .. [[" preferredWidth="130" preferredHeight="34" onClick="shoot_ResetLines"/>
        </HorizontalLayout>
        </Panel>
    ]] .. shoot_infoPanelXml() .. [[

<Panel id="confirm_panel_charge"
        rectAlignment="LowerCenter"
        width="300" height="50"
        color="rgba(0,0,0,0.00)"
        offsetXY="0 100"
        active="false">
        <HorizontalLayout spacing="8" padding="10 10 10 10" childAlignment="MiddleCenter" childForceExpandWidth="false" position="0 -100 0">
            <Button id="btnActionCharge" text="Dichiara" font="warforge_font" fontSize="13" fontStyle="Normal" color="]] .. CONFIRMPANEL.actionBg .. [[" textColor="]] .. CONFIRMPANEL.actionText .. [[" preferredWidth="130" preferredHeight="34" onClick="charge_declareConfirm"/>
            <Button id="btnCancelCharge" text="Chiudi" font="warforge_font" fontSize="13" fontStyle="Normal" color="]] .. CONFIRMPANEL.closeBg .. [[" textColor="]] .. CONFIRMPANEL.closeText .. [[" preferredWidth="130" preferredHeight="34" onClick="charge_declareCancel"/>
        </HorizontalLayout>
        </Panel>

<Panel id="confirm_panel_morale"
        rectAlignment="LowerCenter"
        width="300" height="50"
        color="rgba(0,0,0,0.00)"
        offsetXY="0 100"
        active="false">
        <HorizontalLayout spacing="8" padding="10 10 10 10" childAlignment="MiddleCenter" childForceExpandWidth="false" position="0 -100 0">
            <Button id="btnActionMorale" text="Test Morale" font="warforge_font" fontSize="13" fontStyle="Normal" color="]] .. CONFIRMPANEL.actionBg .. [[" textColor="]] .. CONFIRMPANEL.actionText .. [[" preferredWidth="130" preferredHeight="34" onClick="charge_moraleConfirm"/>
            <Button id="btnCancelMorale" text="Chiudi" font="warforge_font" fontSize="13" fontStyle="Normal" color="]] .. CONFIRMPANEL.closeBg .. [[" textColor="]] .. CONFIRMPANEL.closeText .. [[" preferredWidth="130" preferredHeight="34" onClick="charge_moraleCancel"/>
        </HorizontalLayout>
        </Panel>
            ]] .. chargeAttack1 .. chargeAttack2 .. chargeDefense1 .. chargeDefense2 .. meleeList1 .. meleeList2 .. moraleQueue1 .. moraleQueue2 .. main_getRoutListPanelXml(1) .. main_getRoutListPanelXml(2) .. main_unitInfoPanelsXml()
end
