-- ============================================================
-- WARFORGE IEF — 0_main/general.ttslua
-- Generale aggregato: stato esplicito e riposizionamento da
-- script (il Fixed Joint di TTS non segue setPosition).
-- Il Generale si aggrega/disaggrega solo nel Movimento
-- (regolamento, Fase 3) e poi segue l'unità in ogni spostamento.
--
-- IEF_GENERAL_ATTACHED[genKey] = {
--     host    = unitKey dell'unità,
--     refGuid = GUID della base dell'unità di riferimento,
--     lx, lz  = posizione del Generale nel sistema locale della
--               base di riferimento (destra, fronte), unità TTS,
--     dyaw    = rotazione Y del Generale meno quella della base }
-- ============================================================
IEF_GENERAL_ATTACHED = IEF_GENERAL_ATTACHED or {}

-- ============================================================
-- FUNZIONE: main_generalOffsetFrom(gen, ref)
-- Offset del Generale nel sistema locale della base ref.
-- ============================================================
function main_generalOffsetFrom(gen, ref)
    local pg, pr = gen.getPosition(), ref.getPosition()
    local f, r = ref.getTransformForward(), ref.getTransformRight()
    local fXZ = Vector(f.x, 0, f.z):normalized()
    local rXZ = Vector(r.x, 0, r.z):normalized()
    local dx, dz = pg.x - pr.x, pg.z - pr.z
    return dx * rXZ.x + dz * rXZ.z,
           dx * fXZ.x + dz * fXZ.z,
           gen.getRotation().y - ref.getRotation().y
end

-- ============================================================
-- FUNZIONE: main_generalTouchedBase(genKey)
-- Base amica (non di un Generale) toccata dal Generale entro
-- IEF_GENERAL_ATTACH_INCHES; se più d'una, la più vicina.
-- Ritorna: base, unitKey (oppure nil).
-- ============================================================
function main_generalTouchedBase(genKey)
    local gen = main_getUnitBases(genKey)[1]
    local slot = main_unitSlot(genKey)
    if not gen or not slot then return nil end

    local migliore, chiave, dist = nil, nil, nil
    for key, basi in pairs(main_unitsOfSlot(slot)) do
        if key ~= genKey and not main_isGeneralKey(key) then
            for _, b in ipairs(basi) do
                local d = main_distanceInches(gen, b)
                if d and d <= IEF_GENERAL_ATTACH_INCHES and (not dist or d < dist) then
                    migliore, chiave, dist = b, key, d
                end
            end
        end
    end
    return migliore, chiave
end

-- ============================================================
-- FUNZIONE: main_generalInFrontOrBehindCaptain(gen, hostKey)
-- True se il Generale sta davanti o dietro la base capitana
-- (dove ci sono i pulsanti): proiezione dentro la larghezza
-- della capitana lungo il suo asse frontale.
-- ============================================================
function main_generalInFrontOrBehindCaptain(gen, hostKey)
    local guid = IEF_UNIT_BUTTON_BASE and IEF_UNIT_BUTTON_BASE[hostKey]
    local cap = guid and getObjectFromGUID(guid)
    if not cap then return false end
    local lx = main_generalOffsetFrom(gen, cap)
    local meta = main_getUnitMeta(cap)
    local ut = meta and meta.unitType and main_getUnitType(meta.unitType)
    local halfWidth = ((ut and ut.base_width_cm) or 4) * CM_TO_TTS / 2
    return math.abs(lx) < halfWidth
end

-- ============================================================
-- FUNZIONE: main_generalAttach(genKey)
-- Aggrega il Generale all'unità che tocca. Ritorna hostKey
-- oppure nil + motivo.
-- ============================================================
function main_generalAttach(genKey)
    local gen = main_getUnitBases(genKey)[1]
    if not gen then return nil, "Generale non trovato" end

    local ref, hostKey = main_generalTouchedBase(genKey)
    if not ref then return nil, "Il Generale deve toccare un'unita' amica" end
    if main_generalInFrontOrBehindCaptain(gen, hostKey) then
        return nil, "Non davanti o dietro la base capitana"
    end

    local lx, lz, dyaw = main_generalOffsetFrom(gen, ref)
    IEF_GENERAL_ATTACHED[genKey] = { host = hostKey, refGuid = ref.getGUID(), lx = lx, lz = lz, dyaw = dyaw }
    printToAll(string.format("[GENERALE] %s aggregato a %s",
        main_decodeExtendedUnitLabel(genKey), main_decodeExtendedUnitLabel(hostKey)), {r=0.6,g=0.8,b=1})
    return hostKey
end

-- ============================================================
-- FUNZIONE: main_generalDetach(genKey)
-- ============================================================
function main_generalDetach(genKey)
    local a = IEF_GENERAL_ATTACHED[genKey]
    if not a then return end
    IEF_GENERAL_ATTACHED[genKey] = nil
    printToAll(string.format("[GENERALE] %s disaggregato da %s",
        main_decodeExtendedUnitLabel(genKey), main_decodeExtendedUnitLabel(a.host)), {r=0.6,g=0.8,b=1})
end

-- ============================================================
-- FUNZIONE: main_syncAttachedGeneral(hostKey)
-- Riporta ogni Generale aggregato all'unità nella sua posizione
-- relativa alla base di riferimento. Se quella base non c'è
-- più, prende la base superstite più vicina al Generale e
-- ricalcola l'offset (il Generale resta dov'è). Unità senza
-- basi: il Generale si disaggrega.
-- Da chiamare a fine di ogni spostamento dell'unità.
-- ============================================================
function main_syncAttachedGeneral(hostKey)
    for genKey, a in pairs(IEF_GENERAL_ATTACHED) do
        if a.host == hostKey then
            local gen = main_getUnitBases(genKey)[1]
            local ref = getObjectFromGUID(a.refGuid)
            if ref and main_getUnitKey(ref) ~= hostKey then ref = nil end

            if gen and not ref then
                local dist = nil
                for _, b in ipairs(main_getUnitBases(hostKey)) do
                    local d = main_distanceInches(gen, b)
                    if d and (not dist or d < dist) then ref, dist = b, d end
                end
                if ref then
                    a.refGuid = ref.getGUID()
                    a.lx, a.lz, a.dyaw = main_generalOffsetFrom(gen, ref)
                end
            end

            if not gen or not ref then
                IEF_GENERAL_ATTACHED[genKey] = nil
            else
                local pr = ref.getPosition()
                local f, r = ref.getTransformForward(), ref.getTransformRight()
                local fXZ = Vector(f.x, 0, f.z):normalized()
                local rXZ = Vector(r.x, 0, r.z):normalized()
                local rg = gen.getRotation()
                local nuovaYaw = ref.getRotation().y + a.dyaw
                main_setPositionOnGround(gen,
                    pr.x + rXZ.x * a.lx + fXZ.x * a.lz,
                    pr.z + rXZ.z * a.lx + fXZ.z * a.lz,
                    math.rad(rg.y - nuovaYaw))
                gen.setRotation(Vector(rg.x, nuovaYaw, rg.z))
            end
        end
    end
end

-- ============================================================
-- FUNZIONE: main_generalAttachedHost(genKey)
-- Unità a cui il Generale è aggregato (stato), o nil.
-- ============================================================
function main_generalAttachedHost(genKey)
    local a = IEF_GENERAL_ATTACHED[genKey]
    return a and a.host or nil
end

-- ============================================================
-- FUNZIONE: main_generalReanchor(hostKey)
-- Ricalcola l'offset dei Generali aggregati dalle posizioni
-- attuali (il Generale resta dov'è).
-- ============================================================
function main_generalReanchor(hostKey)
    for genKey, a in pairs(IEF_GENERAL_ATTACHED) do
        if a.host == hostKey then
            local gen = main_getUnitBases(genKey)[1]
            local ref = getObjectFromGUID(a.refGuid)
            if gen and ref then
                a.lx, a.lz, a.dyaw = main_generalOffsetFrom(gen, ref)
            end
        end
    end
end

-- ============================================================
-- FUNZIONE: main_generalFlipAndMove(hostKey, dirX, dirZ, deltaTTS)
-- Movimenti in cui ogni base si gira di 180° sul posto e poi
-- trasla (rotta, evasione): il Generale fa lo stesso, come una
-- base dell'unità, poi si ricalcola l'offset. (Con
-- main_syncAttachedGeneral finirebbe sul lato opposto, dentro
-- l'unità.)
-- ============================================================
function main_generalFlipAndMove(hostKey, dirX, dirZ, deltaTTS)
    for genKey, a in pairs(IEF_GENERAL_ATTACHED) do
        if a.host == hostKey then
            local gen = main_getUnitBases(genKey)[1]
            if gen then
                local rg = gen.getRotation()
                gen.setRotation(Vector(rg.x, rg.y + 180, rg.z))
                local pg = gen.getPosition()
                main_setPositionOnGround(gen, pg.x + dirX * deltaTTS, pg.z + dirZ * deltaTTS)
            end
        end
    end
    main_generalReanchor(hostKey)
end

-- ============================================================
-- FUNZIONE: main_generalAttachedTo(unitKey)
-- Generale aggregato all'unità (stato), o nil.
-- ============================================================
function main_generalAttachedTo(unitKey)
    for genKey, a in pairs(IEF_GENERAL_ATTACHED) do
        if a.host == unitKey and #main_getUnitBases(genKey) > 0 then
            return genKey
        end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: main_syncGeneralsOfBases(basiObjs)
-- Come main_syncAttachedGeneral, partendo dalle basi mosse
-- (per le funzioni di movimento che ricevono solo le basi).
-- ============================================================
function main_syncGeneralsOfBases(basiObjs)
    local b = basiObjs and basiObjs[1]
    local key = b and main_getUnitKey(b)
    if key then main_syncAttachedGeneral(key) end
end

-- ============================================================
-- FUNZIONE: main_generalRefreshButtons(genKey)
-- Ricrea i pulsanti sulla base del Generale (AGGREGA /
-- DISAGGREGA cambiano con lo stato).
-- ============================================================
function main_generalRefreshButtons(genKey)
    local gen = main_getUnitBases(genKey)[1]
    if gen then main_createBaseButtons(gen, TURN.phase, genKey) end
end

-- ============================================================
-- FUNZIONE: main_generalAttachFromButton(obj, player_color, alt_click)
-- Pulsante AGGREGA sulla base del Generale (fase Movimento).
-- ============================================================
function main_generalAttachFromButton(obj, player_color, alt_click)
    local genKey = main_getUnitKey(obj)
    local slot = main_unitSlot(genKey)
    local player = Player[player_color]
    if not genKey or not slot or main_getArmyByColor(player) ~= slot then return end

    local host, motivo = main_generalAttach(genKey)
    if not host then
        warningToColor(motivo, player, "Yellow", 5, true)
        return
    end
    if IEF_MOVE_UNITS[genKey] then move_close(genKey) end
    main_generalRefreshButtons(genKey)
end

-- ============================================================
-- FUNZIONE: main_generalDetachFromButton(obj, player_color, alt_click)
-- Pulsante DISAGGREGA sulla base del Generale (fase Movimento).
-- ============================================================
function main_generalDetachFromButton(obj, player_color, alt_click)
    local genKey = main_getUnitKey(obj)
    local slot = main_unitSlot(genKey)
    if not genKey or not slot or main_getArmyByColor(Player[player_color]) ~= slot then return end

    main_generalDetach(genKey)
    main_generalRefreshButtons(genKey)
end

-- ============================================================
-- FUNZIONE: attachGeneral(obj, unit, pos, rot, w, h, color, textColor)
-- Pulsante AGGREGA (solo Generale non aggregato).
-- ============================================================
function attachGeneral(obj, unit, pos, rot, w, h, color, textColor)
    if main_generalAttachedHost(unit) then return end
    obj.createButton({
        click_function = "main_generalAttachFromButton",
        function_owner = Global,
        label = "AGGREGA",
        position = pos,
        rotation = rot,
        width = w + 50,
        height = h,
        font_size = 70,
        color = color,
        font_color = textColor,
        tooltip = "Aggrega il Generale all'unita' che tocca"
    })
end

-- ============================================================
-- MOVIMENTO DEL GENERALE (fase Movimento)
-- Regolamento: Generali e Comandanti 9", in qualsiasi direzione.
-- Si trascina a mano; i 9" si misurano in linea retta (centro
-- della base) dalla posizione di inizio fase. Durante il
-- trascinamento un "filo" dalla partenza: verde entro 9", rosso
-- oltre. Al rilascio oltre i 9" il Generale va a 9" esatti lungo
-- il filo. A fine fase controllo finale (main_generalMoveBlocksPhase).
--
-- IEF_GENERAL_MOVE_START[genKey] = { x, y, z } (salvato)
-- IEF_GENERAL_MOVE_CIRCLE[genKey] = true se il cerchio è acceso
-- IEF_GENERAL_DRAG[genKey] = { waitId, color } trascinamento in corso
-- ============================================================
IEF_GENERAL_MOVE_START  = IEF_GENERAL_MOVE_START  or {}
IEF_GENERAL_MOVE_CIRCLE = IEF_GENERAL_MOVE_CIRCLE or {}
IEF_GENERAL_DRAG        = IEF_GENERAL_DRAG        or {}


-- ============================================================
-- FUNZIONE: main_generalMoveInches()
-- Movimento dei Generali da unit_types (GEN), 9" di default.
-- ============================================================
function main_generalMoveInches()
    local ut = main_getUnitType(UNIT_TYPE_LABELS.GEN)
    return (ut and ut.move_inches) or 9
end

-- ============================================================
-- FUNZIONE: main_generalMoveStartAll()
-- Inizio fase Movimento: posizione di partenza di ogni Generale.
-- ============================================================
function main_generalMoveStartAll()
    IEF_GENERAL_MOVE_START = {}
    IEF_GENERAL_MOVE_CIRCLE = {}
    for slot = 1, 2 do
        for key, basi in pairs(main_unitsOfSlot(slot)) do
            if main_isGeneralKey(key) and basi[1] then
                local p = basi[1].getPosition()
                IEF_GENERAL_MOVE_START[key] = { x = p.x, y = p.y, z = p.z }
            end
        end
    end
    main_aggiornaLinee()
end

-- ============================================================
-- FUNZIONE: main_generalMoveDistance(genKey, pos)
-- Pollici in linea retta dalla partenza (centro della base).
-- ============================================================
function main_generalMoveDistance(genKey, pos)
    local s = IEF_GENERAL_MOVE_START[genKey]
    if not s or not pos then return 0 end
    local dx, dz = pos.x - s.x, pos.z - s.z
    return math.sqrt(dx * dx + dz * dz) / INCH_TO_TTS
end

-- ============================================================
-- FUNZIONE: main_generalMoveLines()
-- Linee globali del movimento dei Generali (cerchi accesi e filo
-- del trascinamento), raccolte da main_aggiornaLinee.
-- ============================================================
function main_generalMoveLines()
    local out = {}
    local y = IEF_GENERAL_LINE_Y
    local raggio = main_generalMoveInches() * INCH_TO_TTS

    for genKey, _ in pairs(IEF_GENERAL_MOVE_CIRCLE) do
        local s = IEF_GENERAL_MOVE_START[genKey]
        if s then
            local punti = {}
            for i = 0, 48 do
                local a = (i / 48) * 2 * math.pi
                table.insert(punti, { s.x + math.cos(a) * raggio, y, s.z + math.sin(a) * raggio })
            end
            table.insert(out, { points = punti, color = { 1, 0.6, 0 }, thickness = 0.05 })
        end
    end

    for genKey, _ in pairs(IEF_GENERAL_DRAG) do
        local s = IEF_GENERAL_MOVE_START[genKey]
        local gen = main_getUnitBases(genKey)[1]
        if s and gen then
            local p = gen.getPosition()
            local entro = main_generalMoveDistance(genKey, p) <= main_generalMoveInches()
            table.insert(out, {
                points = { { s.x, y, s.z }, { p.x, y, p.z } },
                color = entro and { 0.2, 0.9, 0.2 } or { 1, 0.1, 0.1 },
                thickness = 0.08,
            })
        end
    end
    return out
end

-- ============================================================
-- FUNZIONE: main_generalMoveButton(obj, player_color, alt_click)
-- Pulsante MOVIMENTO del Generale libero: accende/spegne il
-- cerchio dei 9" attorno alla partenza; alt-click riporta il
-- Generale alla partenza.
-- ============================================================
function main_generalMoveButton(obj, player_color, alt_click)
    local genKey = main_getUnitKey(obj)
    local slot = main_unitSlot(genKey)
    if not genKey or not slot or main_getArmyByColor(Player[player_color]) ~= slot then return end

    local s = IEF_GENERAL_MOVE_START[genKey]
    if not s then
        local p = obj.getPosition()
        s = { x = p.x, y = p.y, z = p.z }
        IEF_GENERAL_MOVE_START[genKey] = s
    end

    if alt_click then
        main_setPositionOnGround(obj, s.x, s.z)
    elseif IEF_GENERAL_MOVE_CIRCLE[genKey] then
        IEF_GENERAL_MOVE_CIRCLE[genKey] = nil
    else
        IEF_GENERAL_MOVE_CIRCLE[genKey] = true
    end
    main_aggiornaLinee()
end

-- ============================================================
-- FUNZIONE: main_generalDragStart(genKey, player_color)
-- ============================================================
function main_generalDragStart(genKey, player_color)
    main_generalDragStop(genKey)
    local id = Wait.time(function()
        local gen = main_getUnitBases(genKey)[1]
        if not gen or gen.isDestroyed() or not gen.held_by_color then
            main_generalDragStop(genKey)
            return
        end
        main_generalDistUpdate(genKey, gen)
        main_aggiornaLinee()
    end, IEF_GENERAL_DRAG_TICK, -1)
    IEF_GENERAL_DRAG[genKey] = { waitId = id, color = player_color }
    local gen = main_getUnitBases(genKey)[1]
    if gen then main_generalDistShow(gen, player_color) end
end

-- ============================================================
-- F37: pannellino della distanza sul Generale trascinato (come per
-- le unità: stessa grafica, stessa posizione relativa)
-- ============================================================
function main_generalDistShow(gen, colore)
    local P = MOVEPANEL
    local x, y, z = main_calcolaPosizionePannello(1, 1)
    gen.UI.setXml(string.format([[
        <Panel id="panelDistGen" active="true" color="%s" width="420" height="90" offsetXY="0 405" position="%f %f %f" rotation="-90 0 0" visibility="%s">
            <Text id="txtDistGen" text="0.00&quot;" font="%s" fontStyle="Bold" fontSize="44" color="#FFFFFF" alignment="MiddleCenter"/>
        </Panel>
        ]], P.bg, x, y, z, colore or "Black", P.font))
end

function main_generalDistUpdate(genKey, gen)
    local max = main_generalMoveInches()
    local d = main_generalMoveDistance(genKey, gen.getPosition())
    gen.UI.setAttribute("txtDistGen", "text", string.format('%.2f" / %d"', d, max))
    gen.UI.setAttribute("txtDistGen", "color", d > max + IEF_GENERAL_MOVE_TOL and "#FF4040" or "#FFFFFF")
end

-- ============================================================
-- FUNZIONE: main_generalDragStop(genKey)
-- ============================================================
function main_generalDragStop(genKey)
    local d = IEF_GENERAL_DRAG[genKey]
    if not d then return end
    if d.waitId then Wait.stop(d.waitId) end
    IEF_GENERAL_DRAG[genKey] = nil
    local gen = main_getUnitBases(genKey)[1]
    if gen and not gen.isDestroyed() then gen.UI.setXml("") end
    main_aggiornaLinee()
end

-- ============================================================
-- FUNZIONE: main_generalOnPickUp(player_color, obj)
-- Da onObjectPickUp: filo solo nel Movimento e per Generali liberi.
-- ============================================================
function main_generalOnPickUp(player_color, obj)
    if ENGINE.phase ~= PHASE.MOVE then return end
    local genKey = main_getUnitKey(obj)
    if not main_isGeneralKey(genKey) or main_generalAttachedHost(genKey) then return end
    if not IEF_GENERAL_MOVE_START[genKey] then
        local p = obj.getPosition()
        IEF_GENERAL_MOVE_START[genKey] = { x = p.x, y = p.y, z = p.z }
    end
    main_generalDragStart(genKey, player_color)
end

-- ============================================================
-- FUNZIONE: main_generalOnDrop(player_color, obj)
-- Da onObjectDrop: Generale aggregato -> torna attaccato
-- all'unità; libero oltre i 9" -> a 9" esatti lungo il filo.
-- ============================================================
function main_generalOnDrop(player_color, obj)
    local genKey = main_getUnitKey(obj)
    if not main_isGeneralKey(genKey) then return end
    main_generalDragStop(genKey)

    local host = main_generalAttachedHost(genKey)
    if host then
        main_syncAttachedGeneral(host)
        return
    end
    if ENGINE.phase ~= PHASE.MOVE then return end

    local s = IEF_GENERAL_MOVE_START[genKey]
    if not s then return end
    local p = obj.getPosition()
    local max = main_generalMoveInches()
    local d = main_generalMoveDistance(genKey, p)
    if d > max then
        local f = (max * INCH_TO_TTS) / (d * INCH_TO_TTS)
        main_setPositionOnGround(obj, s.x + (p.x - s.x) * f, s.z + (p.z - s.z) * f)
        warningToColor(string.format("Il Generale muove al massimo %d\": riportato a %d\"", max, max),
            Player[player_color], "Yellow", 4, false)
    end
    main_aggiornaLinee()
end

-- ============================================================
-- FUNZIONE: main_generalMoveBlocksPhase(player, slot)
-- Fine Movimento: true (e avviso) se un Generale dell'esercito è
-- oltre i 9" dalla partenza.
-- ============================================================
function main_generalMoveBlocksPhase(player, slot)
    local max = main_generalMoveInches() + IEF_GENERAL_MOVE_TOL
    for key, basi in pairs(main_unitsOfSlot(slot)) do
        if main_isGeneralKey(key) and basi[1] and not main_generalAttachedHost(key) then
            local d = main_generalMoveDistance(key, basi[1].getPosition())
            if d > max then
                warningToColor(string.format("%s ha mosso %.1f\": massimo %d\"",
                    main_decodeExtendedUnitLabel(key), d, main_generalMoveInches()), player, "Yellow", 5, true)
                return true
            end
        end
    end
    return false
end

-- ============================================================
-- FUNZIONE: main_generalMoveEnd()
-- Fine Movimento: spegne cerchi e fili.
-- ============================================================
function main_generalMoveEnd()
    for key, _ in pairs(IEF_GENERAL_DRAG) do main_generalDragStop(key) end
    IEF_GENERAL_MOVE_CIRCLE = {}
    main_aggiornaLinee()
end

-- ============================================================
-- Eventi TTS (non definiti altrove)
-- ============================================================
function onObjectPickUp(player_color, obj)
    main_generalOnPickUp(player_color, obj)
    if move_manualOnPickUp then move_manualOnPickUp(player_color, obj) end
    if shoot_mirinoOnPickUp then shoot_mirinoOnPickUp(player_color, obj) end
    if charge_mirinoOnPickUp then charge_mirinoOnPickUp(player_color, obj) end
end

function onObjectDrop(player_color, obj)
    main_generalOnDrop(player_color, obj)
    if move_manualOnDrop then move_manualOnDrop(player_color, obj) end
    if shoot_mirinoOnDrop then shoot_mirinoOnDrop(player_color, obj) end
    if charge_mirinoOnDrop then charge_mirinoOnDrop(player_color, obj) end
end

-- ============================================================
-- FUNZIONE: debug_generalAttach(genKey) / debug_generalDetach(genKey)
-- Solo test: /execute debug_generalAttach("ANG_GEN_FP_1")
-- ============================================================
function debug_generalAttach(genKey)
    local host, motivo = main_generalAttach(genKey)
    if not host then print("[GENERALE] " .. tostring(motivo)) end
end

function debug_generalDetach(genKey)
    main_generalDetach(genKey)
end

-- ============================================================
-- MORTE DEI GENERALI (regolamento, p. 25-26)
-- 1) unità con il Generale perde una base (tiro o mischia):
--    2D6, con 12 il Generale muore;
-- 2) unità con il Generale sfondata e mandata in rotta da
--    IMPETO: 2D6, muore con 11 o 12;
-- 3) unità in ROTTA con il Generale raggiunta da nemici: 2D6,
--    muore con 10, 11 o 12; se sopravvive si sgancia e scappa
--    verso le unità amiche più vicine.
-- Il proprietario tira 2D6 dal suo sacchetto (automatico, uno
-- alla volta). Generale morto: tolto dal tavolo (BP: 2 punti) e
-- test di morale per le unità amiche entro 6" (tabella
-- GENERALE_UCCISO).
-- ============================================================
IEF_GENERAL_RISK_QUEUE = IEF_GENERAL_RISK_QUEUE or {}

function main_unitSlot(unitKey)
    local b = main_getUnitBases(unitKey)[1]
    if not b then return nil end
    return b.hasTag("Army1") and 1 or (b.hasTag("Army2") and 2 or nil)
end

-- soglia: risultato minimo che uccide; fuga: caso 3 (se sopravvive scappa)
function main_generalRisk(unitKey, soglia, motivo, fuga)
    local genKey = main_generalAttachedTo(unitKey)
    if not genKey then return end
    table.insert(IEF_GENERAL_RISK_QUEUE, { genKey = genKey, unitKey = unitKey, slot = main_unitSlot(genKey),
        soglia = soglia, motivo = motivo, fuga = fuga })
    printToAll(string.format("[GENERALE] %s rischia la vita (%s): 2D6, muore con %d+",
        main_decodeExtendedUnitLabel(genKey), motivo, soglia), {r=1,g=0.7,b=0.3})
    if not IEF_GENERAL_RISK_BUSY then
        IEF_GENERAL_RISK_BUSY = true
        Wait.time(main_generalRiskNext, 2)
    end
end

function main_generalRiskNext()
    local r = table.remove(IEF_GENERAL_RISK_QUEUE, 1)
    if not r then IEF_GENERAL_RISK_BUSY = false; return end
    IEF_GENERAL_RISK_BUSY = true
    if #main_getUnitBases(r.genKey) == 0 or not r.slot then
        main_generalRiskNext(); return
    end
    engine_diceClearLastRoll(r.slot)
    IEF_DICE_ROLL_TRY[r.slot] = { dadi = 2, soglia = nil }
    engine_diceThrowFromBag(r.slot, nil, function(risultati)
        local a, b = risultati and risultati[1], risultati and risultati[2]
        if not a or not b then
            printToAll("[GENERALE] Tiro non leggibile, si ritira", {r=1,g=0.6,b=0.3})
            table.insert(IEF_GENERAL_RISK_QUEUE, 1, r)
            Wait.time(main_generalRiskNext, 1)
            return
        end
        local somma = a + b
        if somma >= r.soglia then
            printToAll(string.format("[GENERALE] %d+%d = %d: %s e' UCCISO", a, b, somma,
                main_decodeExtendedUnitLabel(r.genKey)), {r=1,g=0.3,b=0.3})
            main_generalKilled(r.genKey, r.slot)
        else
            printToAll(string.format("[GENERALE] %d+%d = %d: %s sopravvive", a, b, somma,
                main_decodeExtendedUnitLabel(r.genKey)), {r=0.6,g=0.9,b=0.6})
            if r.fuga then main_generalFlee(r.genKey, r.slot) end
        end
        Wait.time(main_generalRiskNext, 2)
    end)
end

function main_generalKilled(genKey, slot)
    local gen = main_getUnitBases(genKey)[1]
    if not gen then return end
    local pos = gen.getPosition()
    main_generalDetach(genKey)
    IEF_GENERAL_KILLED = IEF_GENERAL_KILLED or {}
    IEF_GENERAL_KILLED[genKey] = true

    -- Test delle unità amiche entro il raggio (tabella GENERALE_UCCISO)
    for _, s in ipairs(main_moraleSituationsFor("GENERAL_KILLED", {})) do
        if s.def.testa == "AMICHE_IN_RAGGIO" then
            for key, basi in pairs(main_unitsOfSlot(slot)) do
                if key ~= genKey and not main_isGeneralKey(key) and main_getCohesion(key) ~= COHESION.ROT then
                    local vicino = false
                    for _, b in ipairs(basi) do
                        local d = main_distanceInchesToPoint(b, pos)
                        if d and d <= (s.def.raggio or 6) then vicino = true; break end
                    end
                    if vicino then
                        local item = { key = key, slot = slot, motivo = s.nome, effetto = s.def.effetto }
                        if s.def.quando == "FINE_FASE" then
                            table.insert(IEF_MORALE_END_QUEUE, item)
                        else
                            main_runMoraleQueue({ item })
                        end
                    end
                end
            end
        end
    end

    main_removeBases(genKey, { gen })
end

-- Caso 3 sopravvissuto: si sgancia e va dietro l'unità amica più vicina
function main_generalFlee(genKey, slot)
    local gen = main_getUnitBases(genKey)[1]
    if not gen then return end
    main_generalDetach(genKey)
    local gp = gen.getPosition()
    local meglio, dMin = nil, nil
    for key, basi in pairs(main_unitsOfSlot(slot)) do
        if not main_isGeneralKey(key) and main_getCohesion(key) ~= COHESION.ROT and #basi > 0 then
            for _, b in ipairs(basi) do
                local d = main_distanceInchesToPoint(b, gp)
                if d and (not dMin or d < dMin) then meglio, dMin = key, d end
            end
        end
    end
    if not meglio then
        printToAll(string.format("[GENERALE] %s si sgancia: nessuna unita' amica a cui riparare",
            main_decodeExtendedUnitLabel(genKey)), {r=1,g=0.7,b=0.3})
        return
    end
    local basi = main_getUnitBases(meglio)
    local cx, cz = 0, 0
    for _, b in ipairs(basi) do local p = b.getPosition(); cx = cx + p.x; cz = cz + p.z end
    cx, cz = cx / #basi, cz / #basi
    local fwd = charge_getFrontLine(basi)
    local dietro = -math.huge
    for _, b in ipairs(basi) do
        local p = b.getPosition()
        dietro = math.max(dietro, -((p.x - cx) * fwd.x + (p.z - cz) * fwd.z))
    end
    local off = dietro + 2 * INCH_TO_TTS
    main_setPositionOnGround(gen, cx - fwd.x * off, cz - fwd.z * off)
    printToAll(string.format("[GENERALE] %s si sgancia e ripara dietro la %s",
        main_decodeExtendedUnitLabel(genKey), main_decodeExtendedUnitLabel(meglio)), {r=0.6,g=0.8,b=1})
end

-- Caso 3: unità in rotta raggiunta da nemici
function main_generalRoutCaught(unitKey)
    if main_getCohesion(unitKey) ~= COHESION.ROT then return end
    main_generalRisk(unitKey, 10, "unita' in rotta raggiunta dal nemico", true)
end
