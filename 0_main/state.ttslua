-- ============================================================
-- rulesets/imperifeudi/engine/state.ttslua
-- Tabelle di stato globale IEF.
-- ============================================================
-- Colori esercito (alias leggibili)
colorArmy1 = colorArmy1 or COLOR.NOARMY
colorArmy2 = colorArmy2 or COLOR.NOARMY

-- Metadati eserciti in gioco
ARMY = ARMY or {
    [1] = { name = "Army1", color = COLOR.ARMY1, slot = 1 },
    [2] = { name = "Army2", color = COLOR.ARMY2, slot = 2 },
}

-- Stato mischie attive IEF
-- { [id] = { turno_inizio, unitaAtk, slotAtk, unitaDif, slotDif, ... } }
IEF_MELEE_STATE = IEF_MELEE_STATE or {
    mischie      = {},
    nextId       = 1,
}

-- Contatore GUID → soglia contatto
IEF_CONTACT_THRESHOLD = 0.1

-- Traccia turni di mischia per unità { [chiaveUnita] = turnoInizio }
IEF_MELEE_ENGAGED = IEF_MELEE_ENGAGED or {}

-- Stato tiro (resettato ogni fase SHOOT)
IEF_FIRED = IEF_FIRED or {}

-- Wounds per base { [nickname] = wounds }
wounds_data = wounds_data or {}

IEF_FRONT_WIDTH = IEF_FRONT_WIDTH or {}
IEF_REFORM_USED = IEF_REFORM_USED or {}

-- ============================================================
-- SISTEMA PANNELLI 3D — stato indicizzato per unitKey, NON più
-- per slot. Permette più unità (anche dello stesso giocatore)
-- con pannello aperto contemporaneamente, ognuna con stato
-- indipendente. Il vecchio pannello 2D (IEF_FORM[1]/[2]) è
-- stato rimosso: niente più overlay a schermo per Formazione.
-- ============================================================
IEF_FORM_UNITS = IEF_FORM_UNITS or {}
-- [unitKey] = { basiObjs = {...}, activePlayer = Player, panel3DObj = obj }

IEF_FORM_TEST_MODE = true

IEF_DICE_ZONE = IEF_DICE_ZONE or {
    [1] = { x = -53.67, y = 1.31, z = -58.89 },   -- provvisorio, da aggiustare
    [2] = { x = 80,  y = 3, z = 0 },   -- provvisorio, da aggiustare
}

IEF_UNIT_BUTTON_BASE = IEF_UNIT_BUTTON_BASE or {}   -- [unitKey] = GUID della base che ha il pulsante ora
