    print("[DEBUG] Turno corrente: " .. ENGINE.turn)
    callHandler("updateCenterPanel")

end
  -- ============================================================
  -- FUNZIONE DI TEST: debug_meleeAdd(unitArmy1Key, unitArmy2Key, chargedSlot)
  -- Crea una coppia in IEF_MELEE_LIST senza passare dalla carica.
  -- chargedSlot opzionale (1/2): quale esercito è "in carica".
  -- ============================================================
  function debug_meleeAdd(unitArmy1Key, unitArmy2Key, chargedSlot)
      local e, creato = melee_findOrCreateElement(unitArmy1Key, unitArmy2Key)
      if chargedSlot == 1 then e.chargedArmy1 = true end
      if chargedSlot == 2 then e.chargedArmy2 = true end
      print(string.format("[DEBUG] Mischia %d %s: %s vs %s", e.id, creato and "creata" or "esistente", unitArmy1Key, unitArmy2Key))
  end

