-- FUNZIONE DI TEST: debug_checkIefDataStructure()
-- /execute debug_checkIefDataStructure()
-- ============================================================
function debug_checkIefDataStructure()

    print("========== [DEBUG] IEF_DATA.weapons ==========")
    print("tipo:", type(IEF_DATA.weapons))
    for k, v in pairs(IEF_DATA.weapons or {}) do
        print("  chiave weapons:", k)
    end

    print("ARCO esiste?", IEF_DATA.weapons and IEF_DATA.weapons.ARCO ~= nil)
    if IEF_DATA.weapons and IEF_DATA.weapons.ARCO then
        print("  hit_threshold:", IEF_DATA.weapons.ARCO.hit_threshold)
        print("  min_to_hit:", IEF_DATA.weapons.ARCO.min_to_hit)
    end

    print("========== [DEBUG] IEF_DATA.melee ==========")
    print("tipo:", type(IEF_DATA.melee))
    for k, v in pairs(IEF_DATA.melee or {}) do
        print("  chiave melee:", k)
    end
    print("first_turn_modifiers esiste?", IEF_DATA.melee and IEF_DATA.melee.first_turn_modifiers ~= nil)

    print("========== [DEBUG] IEF_DATA.morale (controllo) ==========")
    print("morale_levels esiste?", IEF_DATA.morale and IEF_DATA.morale.morale_levels ~= nil)
    for k, v in pairs(IEF_DATA.morale and IEF_DATA.morale.morale_levels or {}) do
        print("  livello:", k, "soglia:", v.threshold)
    end

    print("========== [DEBUG] DUMP COMPLETO weapons ==========")
    print(JSON.encode_pretty(IEF_DATA.weapons))

    print("========== [DEBUG] DUMP COMPLETO melee ==========")
    print(JSON.encode_pretty(IEF_DATA.melee))

end
-- ============================================================
-- DEBUG: stampa in console il contenuto di IEF_CHARGE_QUEUE,
-- una riga per elemento, leggibile.
-- /execute debug_chargePrintQueue()
-- ============================================================
function debug_chargePrintQueue()
    if #IEF_CHARGE_QUEUE == 0 then
        print("[DEBUG CARICA] Coda vuota")
        return
    end

    print(#IEF_CHARGE_QUEUE)

    for i, e in ipairs(IEF_CHARGE_QUEUE) do
        print(string.format("[DEBUG CARICA] #%d  id=%s  step=%s  outcome=%s  reciproca=%s",
            i, tostring(e.id), tostring(e.step), tostring(e.outcome), tostring(charge_elementoIsReciprocal(e))))
        print(string.format("    Army1: %-20s  request=%-6s  response=%s",
            tostring(e.unitArmy1Key), tostring(e.requestArmy1), tostring(e.responseArmy1)))
        print(string.format("    Army2: %-20s  request=%-6s  response=%s",
            tostring(e.unitArmy2Key), tostring(e.requestArmy2), tostring(e.responseArmy2)))
        print("")
    end
end
-- ============================================================
-- FUNZIONE: charge_moveUnitInches(distanzaInch)
-- /execute debug_moveUnit(1.723)
-- ============================================================
function debug_moveUnit(distanzaInch)
    
    local selected = main_SelectedObjects()
    if not selected or #selected < 2 then
        print("[CARICA] charge_moveUnitInches: seleziona 2 basi (la tua unità e il bersaglio) prima di lanciare il comando")
        return false
    end

    local myObj = selected[1]
    local targetObj = selected[2]

    local unitKey = main_getUnitKey(myObj)
    if not unitKey then
        print("[CARICA] charge_moveUnitInches: impossibile identificare l'unità dalla prima base selezionata")
        return false
    end

    local basiObjs = charge_getUnitBases(unitKey)
    if #basiObjs == 0 then
        print("[CARICA] charge_moveUnitInches: nessuna base trovata per " .. unitKey)
        return false
    end

    local originBase = charge_closestBaseToPoint(basiObjs, targetObj.getPosition())
    if not originBase then
        print("[CARICA] charge_moveUnitInches: impossibile determinare la base d'origine")
        return false
    end

    charge_moveTowardPoint(basiObjs, originBase, targetObj.getPosition(), distanzaInch)
    print(string.format("[CARICA] %s mosso di %.2f\" verso %s", unitKey, distanzaInch, targetObj.getName()))
    return true
end

-- ============================================================
-- FUNZIONE DI TEST: debug_chargeQueue()
-- Stampa la coda cariche: una riga per elemento.
-- ============================================================
function debug_chargeQueue()
    if #IEF_CHARGE_QUEUE == 0 then
        print("[DEBUG] Coda cariche vuota")
        return
    end
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        print(string.format("#%s  %s [req=%s resp=%s mosso=%s]  vs  %s [req=%s resp=%s mosso=%s]  step=%s esito=%s",
            tostring(e.id),
            tostring(e.unitArmy1Key), tostring(e.requestArmy1), tostring(e.responseArmy1), tostring(e.movedArmy1),
            tostring(e.unitArmy2Key), tostring(e.requestArmy2), tostring(e.responseArmy2), tostring(e.movedArmy2),
            tostring(e.step), tostring(e.outcome)))
    end
end
-- ============================================================
-- FUNZIONE DI TEST: debug_chargeReactions()
-- Stampa le reazioni: per ogni lato caricato (non reciproco)
-- la risposta registrata o "DA SCEGLIERE".
-- ============================================================
function debug_chargeReactions()
    local n = 0
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoIsReciprocal(e) then
            print(string.format("#%s  %s <-> %s : carica reciproca, nessuna reazione",
                tostring(e.id), tostring(e.unitArmy1Key), tostring(e.unitArmy2Key)))
            n = n + 1
        else
            for slot = 1, 2 do
                local altro = charge_elementoOtherSlot(slot)
                if charge_elementoRequest(e, altro) and not charge_elementoRequest(e, slot) then
                    local risposta = charge_elementoResponse(e, slot)
                    print(string.format("#%s  %s caricata da %s : %s",
                        tostring(e.id),
                        tostring(charge_elementoUnitKey(e, slot)),
                        tostring(charge_elementoUnitKey(e, altro)),
                        risposta and tostring(risposta) or "DA SCEGLIERE"))
                    n = n + 1
                end
            end
        end
    end
    if n == 0 then print("[DEBUG] Nessuna reazione in coda") end
end