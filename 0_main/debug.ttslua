-- DEBUG: testa un gettone FISICO sopra una base
-- ============================================================
function debug_testGettoneFisico(guid)
    local base = getObjectFromGUID(guid)
    if not base then print("GUID non trovato") return end

    local pos = base.getPosition()
    spawnObject({
        type = "Checker_red",
        position = {pos.x, pos.y + 1, pos.z + 2},
        rotation = {0, 0, 0},
        scale = {0.5, 0.5, 0.5},
    })
end

