-- DEBUG: stampa in console il contenuto di IEF_CHARGE_QUEUE,
-- una riga per elemento, leggibile.
-- /execute debug_chargePrintQueue()
-- ============================================================
function debug_chargePrintQueue()
    if #IEF_CHARGE_QUEUE == 0 then
        print("[DEBUG CARICA] Coda vuota")
        return
    end

    print(#IEF_CHARGE_QUEUE)

    for i, e in ipairs(IEF_CHARGE_QUEUE) do
        print(string.format("[DEBUG CARICA] #%d  id=%s  step=%s  outcome=%s  reciproca=%s",
            i, tostring(e.id), tostring(e.step), tostring(e.outcome), tostring(charge_elementoIsReciprocal(e))))
        print(string.format("    Army1: %-20s  request=%-6s  response=%s",
            tostring(e.unitArmy1Key), tostring(e.requestArmy1), tostring(e.responseArmy1)))
        print(string.format("    Army2: %-20s  request=%-6s  response=%s",
            tostring(e.unitArmy2Key), tostring(e.requestArmy2), tostring(e.responseArmy2)))
        print("")
    end
end
-- ============================================================
-- FUNZIONE: charge_moveUnitInches(distanzaInch)
-- /execute debug_moveUnit(1.723)
-- ============================================================
function debug_moveUnit(distanzaInch)
    
    local selected = main_SelectedObjects()
    if not selected or #selected < 2 then
        print("[CARICA] charge_moveUnitInches: seleziona 2 basi (la tua unità e il bersaglio) prima di lanciare il comando")
        return false
    end

    local myObj = selected[1]
    local targetObj = selected[2]

    local unitKey = main_getUnitKey(myObj)
    if not unitKey then
        print("[CARICA] charge_moveUnitInches: impossibile identificare l'unità dalla prima base selezionata")
        return false
    end

    local basiObjs = charge_getUnitBases(unitKey)
    if #basiObjs == 0 then
        print("[CARICA] charge_moveUnitInches: nessuna base trovata per " .. unitKey)
        return false
    end

    local originBase = charge_closestBaseToPoint(basiObjs, targetObj.getPosition())
    if not originBase then
        print("[CARICA] charge_moveUnitInches: impossibile determinare la base d'origine")
        return false
    end

    charge_moveTowardPoint(basiObjs, originBase, targetObj.getPosition(), distanzaInch)
    print(string.format("[CARICA] %s mosso di %.2f\" verso %s", unitKey, distanzaInch, targetObj.getName()))
    return true
end

-- ============================================================
-- FUNZIONE DI TEST: debug_chargeQueue()
-- Stampa la coda cariche: una riga per elemento.
-- ============================================================
function debug_chargeQueue()
    if #IEF_CHARGE_QUEUE == 0 then
        print("[DEBUG] Coda cariche vuota")
        return
    end
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        print(string.format("#%s  %s [req=%s resp=%s mosso=%s]  vs  %s [req=%s resp=%s mosso=%s]  step=%s esito=%s",
            tostring(e.id),
            tostring(e.unitArmy1Key), tostring(e.requestArmy1), tostring(e.responseArmy1), tostring(e.movedArmy1),
            tostring(e.unitArmy2Key), tostring(e.requestArmy2), tostring(e.responseArmy2), tostring(e.movedArmy2),
            tostring(e.step), tostring(e.outcome)))
    end
end
-- ============================================================
-- FUNZIONE DI TEST: debug_chargeReactions()
-- Stampa le reazioni: per ogni lato caricato (non reciproco)
-- la risposta registrata o "DA SCEGLIERE".
-- ============================================================
function debug_chargeReactions()
    local n = 0
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoIsReciprocal(e) then
            print(string.format("#%s  %s <-> %s : carica reciproca, nessuna reazione",
                tostring(e.id), tostring(e.unitArmy1Key), tostring(e.unitArmy2Key)))
            n = n + 1
        else
            for slot = 1, 2 do
                local altro = charge_elementoOtherSlot(slot)
                if charge_elementoRequest(e, altro) and not charge_elementoRequest(e, slot) then
                    local risposta = charge_elementoResponse(e, slot)
                    print(string.format("#%s  %s caricata da %s : %s",
                        tostring(e.id),
                        tostring(charge_elementoUnitKey(e, slot)),
                        tostring(charge_elementoUnitKey(e, altro)),
                        risposta and tostring(risposta) or "DA SCEGLIERE"))
                    n = n + 1
                end
            end
        end
    end
    if n == 0 then print("[DEBUG] Nessuna reazione in coda") end
end
-- ============================================================
-- FUNZIONE DI TEST: debug_reset()
-- /execute debug_reset(PHASE.CHARGE_DECLARE)
-- Resta nella fase corrente. Azzera:
--  - coesione: tutte le unità tornano SALDE (tinta bianca)
--  - coda cariche (e le reazioni in attesa di scelta)
-- ============================================================
function debug_reset(fase)

    if fase then debug_moveToPhase(fase) end

    local chiavi = {}
    for key, _ in pairs(IEF_UNIT_COHESION or {}) do table.insert(chiavi, key) end
    for _, key in ipairs(chiavi) do
        main_setCohesion(key, COHESION.SAL)
    end

    IEF_CHARGE_QUEUE = {}
    IEF_MORALE_ROLL_PENDING = { [1] = {}, [2] = {} }
    IEF_ROUT_PENDING = { [1] = {}, [2] = {} }
    
    engine_subInitState()

    engine_dicePanelClose(1)
    engine_dicePanelClose(2)

    main_unitInfoClose(1)
    main_unitInfoClose(2)
    
    IEF_MORALE_TEST_ROLLING = { [1] = false, [2] = false }

        -- Perdite marcate (tiro/carica e mischia): le basi tornano normali
    local marcate = {}
    for _, tabella in ipairs({ IEF_MARKED_LOSSES or {}, IEF_MELEE_MARKED or {} }) do
        for unitKey, guids in pairs(tabella) do
            marcate[unitKey] = true
            for _, guid in ipairs(guids) do
                local obj = getObjectFromGUID(guid)
                if obj then obj.highlightOff() end
            end
        end
    end
    IEF_MARKED_LOSSES = {}
    IEF_MELEE_MARKED = {}
    for unitKey, _ in pairs(marcate) do
        main_applyCohesionTint(unitKey)
    end

    print(string.format("[DEBUG] Reset: %d unita' tornate salde, coda cariche vuota (fase %s)", #chiavi, tostring(ENGINE.phase)))

    callHandler("buildUI")
    callHandler("updateCenterPanel")
end
-- ============================================================
-- FUNZIONE: debug_routCheck(unitKey, distInches)
-- Solo test: /execute debug_routCheck("CHIAVE_UNITA", 6)
-- Stampa il controllo del passo e della fine rotta senza muovere.
-- ============================================================
function debug_routCheck(unitKey, distInches)
    local s = main_routCheckStep(unitKey, distInches or 6)
    print(string.format("[ROTTA DEBUG] %s: avanza %.2f\" nemico=%s terreno=%s",
        unitKey, s.avanza, tostring(s.nemico), tostring(s.terreno)))
    for key, tipo in pairs(s.amiche) do
        local tipoMio = main_getUnitMeta(main_getUnitBases(unitKey)[1]).unitType
        print(string.format("  amica %s (%s) disordinata=%s", key, tostring(tipo),
            tostring(not main_canInterpenetrate(tipoMio, tipo))))
    end
    local st = main_routSettle(unitKey)
    print(string.format("  posizione attuale: arretra %.2f\"", st.arretra))
    for key in pairs(st.davanti) do print("  si ferma davanti a " .. key) end
    for key in pairs(st.generali) do print("  Generale da spostare " .. key) end
end
-- ============================================================
-- FUNZIONE: debug_allRects(attivo)
-- Solo test: /execute debug_allRects()       -> disegna
--            /execute debug_allRects(false)  -> cancella
-- Disegna in celeste il rettangolo usato dai calcoli
-- (main_baseRectOfType) per OGNI base di entrambi gli eserciti,
-- in coordinate del tavolo. Le linee sono una fotografia: se le
-- basi si muovono, rilanciare. Stampa quante basi non hanno le
-- misure reali salvate (deploy precedente alla fix).
-- ============================================================
function debug_allRects(attivo)
    IEF_DEBUG_RECT_LINES = {}
    if attivo == false then
        callHandler("aggiornaLinee")
        print("[RECT] rettangoli cancellati")
        return
    end
    local y = 1.32
    local basi, senzaMisure = 0, 0
    for _, o in ipairs(getAllObjects()) do
        if o.hasTag("Army1") or o.hasTag("Army2") then
            local info = main_parseNickname(o.getName())
            if info then
                local meta = main_getUnitMeta(o)
                local r = main_baseRectOfType(o, meta and meta.unitType)
                local c = r.corners   -- (-w,-d) (-w,+d) (+w,-d) (+w,+d)
                table.insert(IEF_DEBUG_RECT_LINES, { points = {
                    { c[1].x, y, c[1].z }, { c[2].x, y, c[2].z }, { c[4].x, y, c[4].z },
                    { c[3].x, y, c[3].z }, { c[1].x, y, c[1].z } },
                    color = { 0.2, 0.9, 1 }, thickness = 0.03 })
                basi = basi + 1
                if not main_baseCentro(o).w then senzaMisure = senzaMisure + 1 end
            end
        end
    end
    callHandler("aggiornaLinee")
    print(string.format("[RECT] %d basi disegnate, %d senza misure reali salvate", basi, senzaMisure))
end

-- ============================================================
-- FUNZIONE DI TEST: debug_flank(color)
-- Il giocatore color seleziona almeno una base della SUA unità
-- (chi carica) e una base dell'unità nemica (bersaglio), poi:
--   /execute debug_flank("Red")      -> calcolo e disegno
--   /execute debug_flank("Red", false) -> cancella il disegno
-- Disegna: in giallo il prolungamento del fronte del bersaglio
-- (con freccia verso il suo davanti), in ciano le basi del
-- bersaglio, in verde le basi del caricante tutte dietro la
-- linea, in rosso quelle che la superano anche di poco.
-- Fianco = almeno 2 basi verdi.
-- ============================================================
function debug_flank(color, attivo)
    IEF_DEBUG_RECT_LINES = {}
    if attivo == false then
        callHandler("aggiornaLinee")
        print("[FIANCO] disegno cancellato")
        return
    end

    local player = Player[color]
    local mySlot = player and main_getArmyByColor(player)
    if not mySlot then print("[FIANCO] colore non associato a un esercito: " .. tostring(color)); return end

    local chargerKey, targetKey
    for _, o in ipairs(player.getSelectedObjects() or {}) do
        local key = main_getUnitKey(o)
        if key and main_parseNickname(o.getName()) then
            if o.hasTag("Army" .. mySlot) then chargerKey = chargerKey or key
            elseif o.hasTag("Army1") or o.hasTag("Army2") then targetKey = targetKey or key end
        end
    end
    if not chargerKey or not targetKey then
        print("[FIANCO] Seleziona una base della tua unità (chi carica) e una base dell'unità nemica")
        return
    end

    local d = charge_flankDetails(chargerKey, targetKey)
    if not d then print("[FIANCO] basi non trovate"); return end

    local y = 1.32
    local function rett(r, col)
        local c = r.corners
        table.insert(IEF_DEBUG_RECT_LINES, { points = {
            { c[1].x, y, c[1].z }, { c[2].x, y, c[2].z }, { c[4].x, y, c[4].z },
            { c[3].x, y, c[3].z }, { c[1].x, y, c[1].z } }, color = col, thickness = 0.04 })
    end

    -- linea del fronte prolungata + freccia verso il davanti
    local p, rgt, fwd, L = d.puntoFronte, d.right, d.fwd, 40
    table.insert(IEF_DEBUG_RECT_LINES, { points = {
        { p.x - rgt.x * L, y, p.z - rgt.z * L }, { p.x + rgt.x * L, y, p.z + rgt.z * L } },
        color = { 1, 0.9, 0.1 }, thickness = 0.05 })
    table.insert(IEF_DEBUG_RECT_LINES, { points = {
        { p.x, y, p.z }, { p.x + fwd.x * 2, y, p.z + fwd.z * 2 } },
        color = { 1, 0.9, 0.1 }, thickness = 0.05 })

    for _, r in ipairs(d.basiT) do rett(r, { 0.2, 0.9, 1 }) end
    for _, bc in ipairs(d.basiC) do
        rett(bc.rect, bc.dietro and { 0.2, 1, 0.2 } or { 1, 0.2, 0.2 })
    end
    callHandler("aggiornaLinee")

    print(string.format("[FIANCO] %s -> %s: %d basi su %d dietro il fronte => %s",
        main_decodeExtendedUnitLabel(chargerKey), main_decodeExtendedUnitLabel(targetKey),
        d.dietro, #d.basiC, d.dietro >= 2 and "CARICA SUL FIANCO" or "carica frontale"))
end

-- ============================================================
-- FUNZIONE DI TEST: debug_metti(color, pollici)
-- Avvicina (o allontana) un'unità nemica a una distanza esatta da
-- una tua unità muovendola IN LINEA RETTA lungo il suo fronte:
-- niente rotazioni né spostamenti laterali (come una carica).
-- Il giocatore color seleziona una base della SUA unità
-- (riferimento, non si muove) e una base dell'unità NEMICA (quella
-- che viene spostata), poi:
--   /execute debug_metti("Red", 5)
-- Distanza bordo-bordo minima fra le basi (rettangoli reali), la
-- stessa del gioco. Variante con le chiavi:
--   /execute debug_mettiKeys("ANG_HUSCARL_FP_1", "VIK_HUSCARL_FP_2", 5)
-- ============================================================
function debug_metti(color, pollici)
    local player = Player[color]
    local mySlot = player and main_getArmyByColor(player)
    if not mySlot then print("[METTI] colore non associato a un esercito: " .. tostring(color)); return end
    local fermaKey, muoviKey
    for _, o in ipairs(player.getSelectedObjects() or {}) do
        local key = main_parseNickname(o.getName()) and main_getUnitKey(o)
        if key then
            if o.hasTag("Army" .. mySlot) then fermaKey = fermaKey or key
            elseif o.hasTag("Army1") or o.hasTag("Army2") then muoviKey = muoviKey or key end
        end
    end
    if not fermaKey or not muoviKey then
        print("[METTI] Seleziona una base della tua unita' (riferimento) e una base dell'unita' nemica (da spostare)")
        return
    end
    debug_mettiKeys(fermaKey, muoviKey, pollici)
end

function debug_mettiKeys(fermaKey, muoviKey, pollici)
    pollici = tonumber(pollici) or 0
    local ferme, mobili = main_getUnitBases(fermaKey), main_getUnitBases(muoviKey)
    if #ferme == 0 or #mobili == 0 then print("[METTI] basi non trovate"); return end
    local tipoF = (main_getUnitMeta(ferme[1]) or {}).unitType
    local tipoM = (main_getUnitMeta(mobili[1]) or {}).unitType

    local rF, rM = {}, {}
    for _, b in ipairs(ferme) do table.insert(rF, main_baseRectOfType(b, tipoF)) end
    for _, b in ipairs(mobili) do table.insert(rM, main_baseRectOfType(b, tipoM)) end

    -- Direzione: il fronte dell'unità che si sposta
    local f = mobili[1].getTransformForward()
    local dir = Vector(f.x, 0, f.z):normalized()

    -- Distanza (pollici) se l'unità mobile fosse traslata di t pollici
    local function distanza(t)
        local dx, dz = dir.x * t * INCH_TO_TTS, dir.z * t * INCH_TO_TTS
        local m = math.huge
        for _, a in ipairs(rM) do
            local sp = { x = a.x + dx, z = a.z + dz, fx = a.fx, fz = a.fz, rx = a.rx, rz = a.rz, hw = a.hw, hd = a.hd, corners = {} }
            for _, c in ipairs(a.corners) do table.insert(sp.corners, { x = c.x + dx, z = c.z + dz }) end
            for _, b in ipairs(rF) do
                local d = main_rectsDistance(sp, b)
                if d < m then m = d end
            end
        end
        return m / INCH_TO_TTS
    end

    local d0 = distanza(0)
    local verso = (d0 > pollici) and 1 or -1      -- avanti se troppo lontana, indietro se troppo vicina
    local passo, limite = 0.25, 72
    local prima, dopo = 0, nil
    local t = 0
    while math.abs(t) < limite do
        t = t + verso * passo
        local d = distanza(t)
        if (verso == 1 and d <= pollici) or (verso == -1 and d >= pollici) then dopo = t; break end
        prima = t
    end
    if not dopo then
        print(string.format("[METTI] Muovendosi dritta la %s non arriva a %.2f\" dalla %s (non e' rivolta verso di lei?). Distanza attuale %.2f\"",
            main_decodeExtendedUnitLabel(muoviKey), pollici, main_decodeExtendedUnitLabel(fermaKey), d0))
        return
    end
    -- bisezione fra prima e dopo
    for _ = 1, 30 do
        local mezzo = (prima + dopo) / 2
        local d = distanza(mezzo)
        if (verso == 1 and d <= pollici) or (verso == -1 and d >= pollici) then dopo = mezzo else prima = mezzo end
    end
    local sposta = dopo * INCH_TO_TTS
    for _, b in ipairs(mobili) do
        local p = b.getPosition()
        main_setPositionOnGround(b, p.x + dir.x * sposta, p.z + dir.z * sposta)
    end
    main_syncGeneralsOfBases(mobili)
    main_riposizionaPulsanteFormazione(muoviKey, mobili)

    Wait.frames(function()
        print(string.format("[METTI] %s %s di %.2f\" in linea retta: distanza dalla %s %.2f\" (richiesta %.2f\")",
            main_decodeExtendedUnitLabel(muoviKey), (dopo >= 0) and "avanza" or "arretra", math.abs(dopo),
            main_decodeExtendedUnitLabel(fermaKey), main_unitsDistanceInches(ferme, mobili) or -1, pollici))
    end, 5)
end

-- ============================================================
-- FUNZIONE DI TEST: debug_shootBasi(color)
-- Perché una base tira o non tira. Il giocatore color seleziona
-- una base della SUA unità che tira e una base dell'unità nemica
-- bersaglio, poi: /execute debug_shootBasi("Red")
-- Evidenzia le basi del tiratore:
--   verde  = pronta al tiro
--   giallo = 1°/2° rango ma bersaglio fuori gittata
--   rosso  = 1°/2° rango in gittata ma senza linea di vista
--   viola  = 1°/2° rango, nessuna base nemica nel cono
--   bianco = 3° rango o oltre (non tira, regolamento)
-- /execute debug_shootBasi("Red", false) toglie le evidenziazioni.
-- ============================================================
function debug_shootBasi(color, attivo)
    local player = Player[color]
    local mySlot = player and main_getArmyByColor(player)
    if not mySlot then print("[TIRO-DBG] colore non associato a un esercito"); return end
    local mioKey, suoKey
    for _, o in ipairs(player.getSelectedObjects() or {}) do
        local key = main_parseNickname(o.getName()) and main_getUnitKey(o)
        if key then
            if o.hasTag("Army" .. mySlot) then mioKey = mioKey or key
            elseif o.hasTag("Army1") or o.hasTag("Army2") then suoKey = suoKey or key end
        end
    end
    if not mioKey or not suoKey then
        print("[TIRO-DBG] Seleziona una base dell'unita' che tira e una base del bersaglio nemico"); return
    end
    local mie, sue = main_getUnitBases(mioKey), main_getUnitBases(suoKey)
    for _, b in ipairs(mie) do b.highlightOff() end
    if attivo == false then
        IEF_DEBUG_RECT_LINES = {}
        callHandler("aggiornaLinee")
        print("[TIRO-DBG] evidenziazioni tolte"); return
    end

    local weapon = shoot_getWeapon(mioKey)
    if not weapon then print("[TIRO-DBG] l'unita' non ha armi da tiro"); return end
    local rangeUnits = weapon.range_inches * INCH_TO_TTS
    local tipo = (main_getUnitMeta(mie[1]) or {}).unitType
    local angolo = (tipo == "CL" and weapon._arma_key == "ARCO") and 360 or (IEF_SHOOTING.angle or 45)

    local tiratrici = shoot_basiTiratrici(mie, tipo)
    local inRango = {}
    for _, b in ipairs(tiratrici) do inRango[b] = true end

    local mieRect = {}
    for i, b in ipairs(tiratrici) do mieRect[i] = main_baseRectOfType(b, tipo) end
    local cono = shoot_coneOf(mieRect, angolo)
    local nemRect = {}
    for _, n in ipairs(sue) do
        local r = main_baseRectOfType(n, (main_getUnitMeta(n) or {}).unitType)
        local poly = shoot_clipRectToCone(cono, r)
        if #poly > 0 then r.poly = poly; table.insert(nemRect, r) end
    end
    local ostacoli = shoot_ostacoli()
    local escludi = { [mioKey] = true, [suoKey] = true }

    local conta = { pronta = 0, gittata = 0, vista = 0, cono = 0, rango = 0 }
    IEF_DEBUG_RECT_LINES = {}
    for _, b in ipairs(mie) do
        if not inRango[b] then
            b.highlightOn({ 1, 1, 1 }); conta.rango = conta.rango + 1
        end
    end
    for _, nr in ipairs(nemRect) do
        local m = math.huge
        for i = 1, #tiratrici do m = math.min(m, shoot_distRectToPoly(mieRect[i], nr.poly)) end
        nr.distUnita = m
    end
    for i, b in ipairs(tiratrici) do
        local stato = "cono"
        local minD = nil
        local perBase, totPerBase, primo = {}, {}, {}
        local bloccanti = {}
        for _, nr in ipairs(nemRect) do
            local d = shoot_distRectToPoly(mieRect[i], nr.poly)
            if not minD or d < minD then minD = d end
            if nr.distUnita <= rangeUnits then
                if stato ~= "pronta" then stato = "vista" end
                local nome = nr.obj and nr.obj.getName() or "?"
                for _, c in ipairs(shoot_corridoi(mieRect[i], nr.poly, ostacoli, escludi)) do
                    totPerBase[nome] = (totPerBase[nome] or 0) + 1
                    if c.libero then
                        stato = "pronta"
                        perBase[nome] = (perBase[nome] or 0) + 1
                        -- disegna il primo corridoio libero verso ogni base nemica
                        if not primo[nome] then
                            primo[nome] = true
                            local pts = {}
                            for _, v in ipairs(c.poligono) do table.insert(pts, { v.x, 1.4, v.z }) end
                            table.insert(pts, { c.poligono[1].x, 1.4, c.poligono[1].z })
                            table.insert(IEF_DEBUG_RECT_LINES, { points = pts, color = { 0.2, 1, 0.2 }, thickness = 0.015 })
                        end
                    elseif c.blocca and c.blocca.obj then
                        bloccanti[c.blocca.obj.getName()] = true
                    end
                end
            elseif stato == "cono" then
                stato = "gittata"
            end
        end
        conta[stato] = conta[stato] + 1
        local col = ({ pronta = { 0.2, 1, 0.2 }, gittata = { 1, 0.9, 0.1 }, vista = { 1, 0.2, 0.2 }, cono = { 0.7, 0.3, 1 } })[stato]
        b.highlightOn(col)
        print(string.format("[TIRO-DBG] %s: %s%s", b.getName(),
            ({ pronta = "PRONTA", gittata = "fuori gittata", vista = "nessun corridoio libero di 4 cm", cono = "nessun nemico nel cono" })[stato],
            minD and string.format(" (bersaglio a %.2f\")", minD / INCH_TO_TTS) or ""))
        if stato == "pronta" then
            local nomi = {}
            for nome in pairs(perBase) do table.insert(nomi, nome) end
            table.sort(nomi, function(x, y) return perBase[x] > perBase[y] end)
            for _, nome in ipairs(nomi) do
                print(string.format("[TIRO-DBG]     -> %s: %d corridoi liberi su %d", nome, perBase[nome], totPerBase[nome]))
            end
        else
            local nomi = {}
            for n in pairs(bloccanti) do table.insert(nomi, n) end
            if #nomi > 0 then print("[TIRO-DBG]   corridoi bloccati da: " .. table.concat(nomi, ", ")) end
        end
    end
    callHandler("aggiornaLinee")
    -- Confronto con la funzione VERA del gioco (7_shoot/lib.ttslua)
    IEF_SHOOT_DEBUG = true
    local nGioco, _, _, motivi = shoot_basiPronte(mie, sue, rangeUnits, angolo)
    IEF_SHOOT_DEBUG = nil
    motivi = motivi or {}
    print(string.format("[TIRO-DBG] Funzione del gioco shoot_basiPronte: %d pronte (fuori gittata %d, senza vista %d) - versione %s",
        nGioco, motivi.fuoriGittata or 0, motivi.senzaVista or 0,
        IEF_SHOOT_GITTATA_UNITA and "NUOVA (gittata dell'unita')" or "VECCHIA (gittata per base)"))
    print(string.format("[TIRO-DBG] %s (%d basi) -> %s: pronte %d, fuori gittata %d, senza vista %d, fuori cono %d, 3° rango e oltre %d. Gittata %d\"",
        main_decodeExtendedUnitLabel(mioKey), #mie, main_decodeExtendedUnitLabel(suoKey),
        conta.pronta, conta.gittata, conta.vista, conta.cono, conta.rango, weapon.range_inches))
end
