function debug_fillProgress(slot)

    slot = slot or 1
    local s = tostring(slot)

    UI.setAttribute("loadingPanel_" .. s, "active", "true")
    local pct = 0
    local function step()
        pct = pct + 5
        UI.setAttribute("loadingBar_" .. s, "percentage", pct)
        UI.setAttribute("loadingLabel_" .. s, "text", "Test caricamento... " .. pct .. "%")
        if pct < 100 then
            Wait.time(step, 0.1)
        else
            Wait.time(function()
                UI.setAttribute("loadingPanel_" .. s, "active", "false")
            end, 0.5)
        end
    end
    step()
end

