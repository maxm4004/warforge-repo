-- ============================================================
-- WARFORGE IEF — 0_main/subphase.ttslua
-- Sottofasi trasversali (usabili da qualsiasi fase).
--
-- MORALE_TEST (scope player): il test di morale attivo di un
-- giocatore. Si apre SOLO dal pannello morale (main_moraleRowClick)
-- su una richiesta della coda IEF_MORALE_ROLL_PENDING[slot].
--   ROLL  : info del test nel pannello sottofase, camera sui
--           dadi, si tira col Roll fisico.
--   ESITO : risultato per 1,5 s, poi chiusura.
-- Alla chiusura main_moraleTestDone toglie la richiesta dalla
-- coda e chiama il suo onDone.
-- ============================================================

-- Tiro in corso per slot (non salvato: un tiro non sopravvive
-- a un ricaricamento, si ritira)
IEF_MORALE_TEST_ROLLING = { [1] = false, [2] = false }

-- Secondi in cui l'esito del test resta visibile prima della chiusura
MORALE_ESITO_SECONDS = 6

-- ============================================================
-- FUNZIONE: main_subphases()
-- ============================================================
function main_subphases()
    return {
        MORALE_TEST = {
            scope    = "player",
            anywhere = true,
            title    = "TEST DI MORALE",
            first    = "ROLL",
            onEnter  = "main_moraleTestEnter",
            steps = {
                ROLL  = { render = "moraleRoll",  actor = "owner", icon = "morale", label = "Controlla il Morale", onClick = "main_moraleTestFocus", onRoll = "main_moraleTestRoll" },
                ESITO = { render = "moraleEsito", actor = "owner", onRestore = "main_moraleTestEsitoRestore" },
            },
        },
    }
end

-- ============================================================
-- FUNZIONE: main_moraleCamera(player)
-- Unica funzione camera dei test di morale.
-- ============================================================
function main_moraleCamera(player)
    if player then
        engine_cameraByNamme(player, nil, CAMERA_ZONE.ARMY_ROLL_DICES)
    end
end

-- ============================================================
-- FUNZIONE: main_moraleTestEnter(ctx, slot, rec)
-- ============================================================
function main_moraleTestEnter(ctx, slot, rec)

    IEF_MORALE_TEST_ROLLING[slot] = false
    main_clearWarning()
    engine_diceClearLastRoll(slot)
    engine_dicePanelClose(slot)

    local req, idx = main_moraleFindRequest(slot, ctx.reqId)
    if req then
        local id = string.format("morale_queue_row_%d_%d", slot, idx)
        UI.setAttribute(id, "text", main_moraleRowText(req, true))
        Wait.frames(function()
            UI.setAttribute(id, "textColor", "White")
        end, 1)
    end
end
-- ============================================================
-- FUNZIONE: main_moraleDiceScheda(req, modCalc, dettCalc)
-- Scheda del pannello dadi per un test di morale: classe e
-- soglia, ogni modificatore con il suo valore, totale e
-- risultato da ottenere sui 2D6. modCalc/dettCalc: modificatore
-- già calcolato (main_moraleTestMod), per non ricalcolarlo.
-- ============================================================
function main_moraleDiceScheda(req, modCalc, dettCalc)
    local bases = main_getUnitBases(req.key)
    local meta = bases[1] and main_getUnitMeta(bases[1])
    local classe = meta and meta.morale
    local moraleData = classe and main_getMorale(classe)
    local soglia = moraleData and moraleData.threshold

    local mod, dettaglio = req.mod, nil
    if modCalc ~= nil then
        mod, dettaglio = modCalc, dettCalc
    elseif mod == nil then
        mod, dettaglio = main_moraleCurrentModifier(req.key)
    end
    mod = mod or 0

    local righe = {}
    table.insert(righe, { "Motivo: " .. main_moraleMotivoText(req.motivo or req.situazione), "" })
    if soglia then
        table.insert(righe, { string.format("Morale %s: serve %d+ con 2D6", tostring(classe), soglia), "" })
    end
    if dettaglio then
        for _, d in ipairs(dettaglio) do
            local voce = main_moraleModifierLabel(d.chiave)
            if d.volte > 1 then voce = string.format("%s (x%d)", voce, d.volte) end
            table.insert(righe, { voce, string.format("%+d", d.valore) })
        end
        if #dettaglio == 0 then table.insert(righe, { "Nessun modificatore", "" }) end
    else
        table.insert(righe, { "Modificatori fissi", string.format("%+d", mod) })
    end
    table.insert(righe, { "Totale modificatori", string.format("%+d", mod) })

    local serve = nil
    if soglia then
        local minimo = soglia - mod
        if minimo <= 2 then
            serve = "Superato con qualsiasi risultato"
        elseif minimo > 12 then
            serve = "Non superabile con 2D6"
        else
            serve = string.format("Serve almeno %d sui dadi", minimo)
        end
    end

    return {
        titolo      = "TEST DI MORALE",
        sottotitolo = string.format("%s - %s", main_decodeExtendedUnitLabel(req.key), main_getCohesion(req.key)),
        righe       = righe,
        serve       = serve,
    }
end
-- ============================================================
-- FUNZIONE: main_moraleTestMod(ctx, req)
-- Modificatore del test calcolato UNA volta per test e tenuto in
-- ctx (mod, dettaglio): il calcolo (nemico su fianco/retro in
-- particolare) è pesante e prima si ripeteva al Roll.
-- ============================================================
function main_moraleTestMod(ctx, req)
    if ctx.mod == nil then
        if req.mod ~= nil then
            ctx.mod = req.mod
        else
            ctx.mod, ctx.dettaglio = main_moraleCurrentModifier(req.key)
        end
    end
    return ctx.mod, ctx.dettaglio
end
-- ============================================================
-- FUNZIONE: main_moraleTestFocus(ctx, slot, player, rec)
-- Bottone del pannello sottofase: camera sui dadi e pannello dadi.
-- ============================================================
function main_moraleTestFocus(ctx, slot, player, rec)
    ctx.aiDadi = true
    main_moraleCamera(player)
    local req = main_moraleFindRequest(slot, ctx.reqId)
    if req then
        local mod, dettaglio = main_moraleTestMod(ctx, req)
        engine_dicePanelOpen(slot, main_moraleDiceScheda(req, mod, dettaglio))
    end
    engine_subRedraw()
end
-- ============================================================
-- FUNZIONE: main_moraleTestRoll(ctx, slot, player, rec)
-- Roll fisico durante lo step ROLL.
-- ============================================================
function main_moraleTestRoll(ctx, slot, player, rec)
    if IEF_MORALE_TEST_ROLLING[slot] then return end

    local req = main_moraleFindRequest(slot, ctx.reqId)
    if not req then
        engine_subClose("MORALE_TEST", slot, nil)
        return
    end

    local mod, dettaglio = main_moraleTestMod(ctx, req)

    if not engine_dicePanelIsOpen(slot) then
        engine_dicePanelOpen(slot, main_moraleDiceScheda(req, mod, dettaglio))
    end

    IEF_MORALE_TEST_ROLLING[slot] = true

    main_testMorale(req.key, player, req.situazione, mod, function(esito, somma, soglia, effetto)
        IEF_MORALE_TEST_ROLLING[slot] = false
        if esito == nil then                    -- lettura dadi fallita: si ritira
            engine_dicePanelOutcome(slot, "Lettura dei dadi non riuscita: ritira", DICEPANEL.koColor)
            return
        end

        local superato = esito == MORALE_RESULT.OK
        engine_dicePanelOutcome(slot,
            string.format("%s: %d %+d = %d contro %d", esito, somma - (mod or 0), mod or 0, somma, soglia),
            superato and DICEPANEL.okColor or DICEPANEL.koColor,
            effetto)

        ctx.esito, ctx.somma, ctx.soglia, ctx.effetto = esito, somma, soglia, effetto
        engine_subStep("MORALE_TEST", slot, "ESITO")

        Wait.time(function()
            engine_subClose("MORALE_TEST", slot, { esito = esito, somma = somma, soglia = soglia, effetto = effetto })
        end, MORALE_ESITO_SECONDS)
    end)
end
-- ============================================================
-- FUNZIONE: main_moraleTestEsitoRestore(ctx, slot, rec)
-- onRestore dello step ESITO: dopo un caricamento riavvia il
-- timer di chiusura (l'esito è già in ctx).
-- ============================================================
function main_moraleTestEsitoRestore(ctx, slot, rec)
    Wait.time(function()
        local top = engine_subPrivate(slot)
        if top ~= rec or rec.step ~= "ESITO" then return end
        engine_subClose("MORALE_TEST", slot, { esito = ctx.esito, somma = ctx.somma, soglia = ctx.soglia, effetto = ctx.effetto })
    end, MORALE_ESITO_SECONDS)
end

-- ============================================================
-- FUNZIONE: main_moraleTestDone(ctx, result, slot)
-- onDone di MORALE_TEST: toglie la richiesta dalla coda e
-- chiama il suo onDone (nome handler oppure funzione).
-- ============================================================
function main_moraleTestDone(ctx, result, slot)

    engine_dicePanelClose(slot)
    local req, idx = main_moraleFindRequest(slot, ctx.reqId)
    if req then
        table.remove(IEF_MORALE_ROLL_PENDING[slot], idx)
    end

    if req and result and result.esito then
        if type(req.onDone) == "function" then
            req.onDone(result.esito, result.somma, result.soglia, result.effetto)
        elseif type(req.onDone) == "string" then
            callHandler(req.onDone, req.ctx or {}, result.esito, result.somma, result.soglia, result.effetto)
        end
    end

    main_moraleRefreshUI()

    if main_moraleQueueCount(slot) == 0 then
        local player = Player[ARMY[slot].color]
        if player then engine_cameraByNamme(player, nil, CAMERA_ZONE.ARMY_HOME) end
    end
end
