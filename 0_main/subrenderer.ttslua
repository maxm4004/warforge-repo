-- ============================================================
-- WARFORGE IEF — 0_main/subrenderer.ttslua
-- Renderer delle sottofasi trasversali (pannello sottofase).
-- Solo caratteri ASCII.
-- ============================================================

registerSubRenderer("moraleRoll", function(rec, def, step, slot, isActor)
    return {
        title  = def.title,
        button = isActor and step.label or nil,
        wait   = (not isActor) and "In attesa" or nil,
    }
end)

registerSubRenderer("moraleEsito", function(rec, def, step, slot, isActor)
    local c = rec.ctx or {}
    return {
        title = def.title,
        info  = string.format("Risultato %s contro %s", tostring(c.somma or "?"), tostring(c.soglia or "?")),
        wait  = (c.esito == MORALE_RESULT.OK) and "SUPERATO" or "FALLITO",
    }
end)