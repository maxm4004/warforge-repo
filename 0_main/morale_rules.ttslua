-- ============================================================
-- WARFORGE IEF — 0_main/morale_rules.ttslua
-- Regole del morale a TABELLE: situazioni che richiedono un test
-- e modificatori. Le regole sono dati: per cambiare chi è
-- coinvolto si modificano i campi, non il codice.
-- Caricato dopo lib (usa main_*).
-- ============================================================

-- ============================================================
-- SITUAZIONI (regolamento "QUANDO È NECESSARIO EFFETTUARE UN
-- TEST DI MORALE?"). Filtri assenti = nessun filtro.
--   evento        : chi solleva la situazione (LOSS, CHARGED,
--                   CHARGE_DECLARE, FRIEND_ROUT, GENERAL_KILLED)
--   testa         : chi fa il test (VITTIMA, CARICATA, CARICANTE,
--                   AMICHE_IN_RAGGIO)
--   tipi / tipiAvversario / tipiAvversarioEsclusi : tipi unità
--   terreno       : categoria terreno dell'unità che testa
--   lato          : lato del contatto (FRONTE, FIANCO, RETRO)
--   soloArmiDaTiro: l'unità che testa ha solo armi da tiro
--                   (escluse le armiEscluse)
--   raggio        : pollici per AMICHE_IN_RAGGIO
--   tipiOrigineEsclusi / escludiGiaInFuga : filtri sull'unità
--                   che ha generato l'evento
--   effetto       : colonna di morale.json (per_caricare,
--                   per_riordinare, altre_situazioni)
--   quando        : IMMEDIATO o FINE_FASE (dopo tutte le mischie
--                   o tutti i tiri)
-- ============================================================
IEF_MORALE_SITUATIONS = {
    BASE_PERSA = {
        evento = "LOSS",
        testa = "VITTIMA",
        effetto = "altre_situazioni",
        quando = "IMMEDIATO",
    },
    CARICA_IN_TERRENO_APERTO = {
        evento = "CHARGED",
        testa = "CARICATA",
        tipi = { "FM" },
        tipiAvversario = { "KN", "CP" },
        terreno = "APERTO",
        effetto = "altre_situazioni",
        quando = "IMMEDIATO",
    },
    CARICA_SUL_FRONTE = {
        evento = "CHARGE_DECLARE",
        testa = "CARICANTE",
        tipi = { "CL" },
        tipiAvversarioEsclusi = { "CL", "FL", "ART" },
        lato = "FRONTE",
        effetto = "per_caricare",
        quando = "IMMEDIATO",
    },
    CARICA_CON_ARMI_DA_TIRO = {
        evento = "CHARGE_DECLARE",
        testa = "CARICANTE",
        tipi = { "FP", "FM" },
        conArmiDaTiro  = true,
        armiEscluse = { "GIAVELLOTTI" },
        tipiAvversarioEsclusi = { "FL", "ART" },
        effetto = "per_caricare",
        quando = "IMMEDIATO",
    },
    AMICA_IN_ROTTA = {
        evento = "FRIEND_ROUT",
        testa = "AMICHE_IN_RAGGIO",
        raggio = 6,
        tipiOrigineEsclusi = { "FL" },
        escludiGiaInFuga = true,
        effetto = "altre_situazioni",
        quando = "FINE_FASE",
    },
    GENERALE_UCCISO = {
        evento = "GENERAL_KILLED",
        testa = "AMICHE_IN_RAGGIO",
        raggio = 6,
        effetto = "altre_situazioni",
        quando = "FINE_FASE",
    },
}

-- ============================================================
-- MODIFICATORI del test di morale. chiave = morale_modifiers di
-- morale.json (valore unitario), condizione = funzione in
-- IEF_MORALE_CONDITIONS che ritorna quante volte si applica.
-- ============================================================
IEF_MORALE_MODIFIERS = {
    { chiave = "generale_con_unita",      condizione = "GENERALE_AGGREGATO" },
    { chiave = "ogni_base_persa",         condizione = "BASI_PERSE_DA_INIZIO" },
    { chiave = "fianco_retro_caricabile", condizione = "NEMICO_FIANCO_RETRO" },
    { chiave = "unita_disordinata",       condizione = "COESIONE_DIS" },
    { chiave = "unita_in_rotta",          condizione = "COESIONE_ROT" },
}

-- Tolleranza di contatto per il Generale aggregato (pollici)
IEF_GENERAL_ATTACH_INCHES = 0.1

-- Gravità delle categorie di terreno (la peggiore vince)
IEF_TERRAIN_SEVERITY = { APERTO = 0, COVER = 0, ROTTO = 1, FIUME = 2, DIFFICILE = 3, INTRANSITABILE = 4 }

-- ============================================================
-- CONDIZIONI: function(unitKey, ctx) -> numero di applicazioni
-- ctx.basiInSospeso = basi perse non ancora rimosse (mischia)
-- ============================================================
IEF_MORALE_CONDITIONS = {
    GENERALE_AGGREGATO = function(unitKey, ctx)
        return main_getAttachedGeneral(unitKey) and 1 or 0
    end,
    BASI_PERSE_DA_INIZIO = function(unitKey, ctx)
        return (IEF_UNIT_BASES_LOST[unitKey] or 0) + ((ctx and ctx.basiInSospeso) or 0)
    end,
    NEMICO_FIANCO_RETRO = function(unitKey, ctx)
        return main_enemyOnFlankOrRear(unitKey) and 1 or 0
    end,
    COESIONE_DIS = function(unitKey, ctx)
        return main_getCohesion(unitKey) == COHESION.DIS and 1 or 0
    end,
    COESIONE_ROT = function(unitKey, ctx)
        return main_getCohesion(unitKey) == COHESION.ROT and 1 or 0
    end,
}

-- ============================================================
-- FUNZIONE: main_listHas(lista, valore)
-- ============================================================
function main_listHas(lista, valore)
    for _, v in ipairs(lista or {}) do
        if v == valore then return true end
    end
    return false
end

-- ============================================================
-- FUNZIONE: main_moraleSituationsFor(evento, ctx)
-- Situazioni della tabella che si applicano. ctx:
-- conArmiDaTiro : l'unità che testa ha armi da tiro
-- tipoOrigine, origineGiaInFuga
-- Ritorna lista { nome, def } ordinata per nome.
-- ============================================================
function main_moraleSituationsFor(evento, ctx)
    ctx = ctx or {}
    local out = {}
    for nome, def in pairs(IEF_MORALE_SITUATIONS) do
        local ok = def.evento == evento
        if ok and def.tipi and not main_listHas(def.tipi, ctx.tipo) then ok = false end
        if ok and def.tipiAvversario and not main_listHas(def.tipiAvversario, ctx.tipoAvversario) then ok = false end
        if ok and def.tipiAvversarioEsclusi and main_listHas(def.tipiAvversarioEsclusi, ctx.tipoAvversario) then ok = false end
        if ok and def.terreno and def.terreno ~= ctx.terreno then ok = false end
        if ok and def.lato and def.lato ~= ctx.lato then ok = false end
        if ok and def.conArmiDaTiro and not ctx.conArmiDaTiro then ok = false end
        if ok and def.tipiOrigineEsclusi and main_listHas(def.tipiOrigineEsclusi, ctx.tipoOrigine) then ok = false end
        if ok and def.escludiGiaInFuga and ctx.origineGiaInFuga then ok = false end
        if ok then table.insert(out, { nome = nome, def = def }) end
    end
    table.sort(out, function(a, b) return a.nome < b.nome end)
    return out
end

-- ============================================================
-- FUNZIONE: main_moraleModifier(unitKey, ctx)
-- Somma dei modificatori di IEF_MORALE_MODIFIERS.
-- Ritorna: totale, dettaglio { {chiave, volte, valore}, ... }
-- ============================================================
function main_moraleModifier(unitKey, ctx)
    local totale, dettaglio = 0, {}
    for _, m in ipairs(IEF_MORALE_MODIFIERS) do
        local cond = IEF_MORALE_CONDITIONS[m.condizione]
        local volte = cond and cond(unitKey, ctx) or 0
        if volte > 0 then
            local unitario = main_getMoraleModifier(m.chiave) or 0
            totale = totale + unitario * volte
            table.insert(dettaglio, { chiave = m.chiave, volte = volte, valore = unitario * volte })
        end
    end
    return totale, dettaglio
end

-- ============================================================
-- FUNZIONE: main_moraleModifierText(dettaglio)
-- ============================================================
function main_moraleModifierText(dettaglio)
    local parti = {}
    for _, d in ipairs(dettaglio or {}) do
        table.insert(parti, string.format("%s %+d", d.chiave, d.valore))
    end
    return (#parti > 0) and table.concat(parti, ", ") or "nessuno"
end

-- ============================================================
-- FUNZIONE: main_unitSlot(unitKey)
-- ============================================================
function main_unitSlot(unitKey)
    local b = main_getUnitBases(unitKey)[1]
    if not b then return nil end
    if b.hasTag("Army1") then return 1 end
    if b.hasTag("Army2") then return 2 end
    return nil
end

-- ============================================================
-- FUNZIONE: main_unitsOfSlot(slot)
-- Tutte le unità di un esercito sul tavolo: { [unitKey] = { basi } }
-- ============================================================
function main_unitsOfSlot(slot)
    local out = {}
    local tag = "Army" .. slot
    for _, o in ipairs(getAllObjects()) do
        if o.hasTag(tag) and main_getUnitMeta(o) then
            local key = main_getUnitKey(o)
            out[key] = out[key] or {}
            table.insert(out[key], o)
        end
    end
    return out
end

-- ============================================================
-- FUNZIONE: main_isGeneralKey(unitKey)
-- ============================================================
function main_isGeneralKey(unitKey)
    return unitKey ~= nil and string.find(unitKey, "_GEN_", 1, true) ~= nil
end

-- ============================================================
-- FUNZIONE: main_unitsDistanceInches(basiA, basiB)
-- Distanza minima bordo-bordo fra due insiemi di basi.
-- ============================================================
function main_unitsDistanceInches(basiA, basiB)
    local minimo = nil
    for _, a in ipairs(basiA) do
        for _, b in ipairs(basiB) do
            local d = main_distanceInches(a, b)
            if d and (not minimo or d < minimo) then minimo = d end
        end
    end
    return minimo
end

-- ============================================================
-- FUNZIONE: main_getGeneralHost(genKey)
-- Unità amica a cui il Generale è aggregato: la sua base tocca
-- (entro IEF_GENERAL_ATTACH_INCHES) una base dell'unità; se ne
-- tocca più d'una, la più vicina. Calcolato al volo.
-- ============================================================
function main_getGeneralHost(genKey)
    local slot = main_unitSlot(genKey)
    if not slot then return nil end
    local genBasi = main_getUnitBases(genKey)

    local migliore, distMigliore = nil, nil
    for key, basi in pairs(main_unitsOfSlot(slot)) do
        if key ~= genKey and not main_isGeneralKey(key) then
            local d = main_unitsDistanceInches(genBasi, basi)
            if d and d <= IEF_GENERAL_ATTACH_INCHES and (not distMigliore or d < distMigliore) then
                migliore, distMigliore = key, d
            end
        end
    end
    return migliore
end

-- ============================================================
-- FUNZIONE: main_getAttachedGeneral(unitKey)
-- Generale aggregato all'unità (chiave) o nil.
-- ============================================================
function main_getAttachedGeneral(unitKey)
    local slot = main_unitSlot(unitKey)
    if not slot then return nil end
    for key, _ in pairs(main_unitsOfSlot(slot)) do
        if main_isGeneralKey(key) and main_getGeneralHost(key) == unitKey then
            return key
        end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: main_enemyOnFlankOrRear(unitKey)
-- True se un'unità nemica (non in ROTTA) è a contatto sul
-- fianco/retro oppure è sul fianco/retro entro la propria mossa
-- (= in grado di caricarlo nel turno successivo).
-- Fianco/retro = fuori dal settore frontale di 90° dell'unità.
-- ============================================================
function main_enemyOnFlankOrRear(unitKey)
    local slot = main_unitSlot(unitKey)
    if not slot then return false end
    local mieBasi = main_getUnitBases(unitKey)

    local fwd = mieBasi[1].getTransformForward()
    local fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()
    local cx, cz = 0, 0
    for _, b in ipairs(mieBasi) do
        local p = b.getPosition()
        cx, cz = cx + p.x, cz + p.z
    end
    cx, cz = cx / #mieBasi, cz / #mieBasi

    local altro = (slot == 1) and 2 or 1
    for key, basi in pairs(main_unitsOfSlot(altro)) do
        if main_getCohesion(key) ~= COHESION.ROT then
            local meta = main_getUnitMeta(basi[1])
            local ut = meta and meta.unitType and main_getUnitType(meta.unitType)
            local mossa = (ut and ut.move_inches) or 0

            local d = main_unitsDistanceInches(mieBasi, basi)
            if d and d <= math.max(mossa, IEF_GENERAL_ATTACH_INCHES) then
                local ex, ez = 0, 0
                for _, b in ipairs(basi) do
                    local p = b.getPosition()
                    ex, ez = ex + p.x, ez + p.z
                end
                local dir = Vector(ex / #basi - cx, 0, ez / #basi - cz)
                if dir:magnitude() > 0 then
                    dir = dir:normalized()
                    local cosAng = dir.x * fwdXZ.x + dir.z * fwdXZ.z
                    if cosAng < math.cos(math.rad(45)) then
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- ============================================================
-- FUNZIONE: main_getUnitTerrain(unitKey)
-- Categoria di terreno (APERTO, ROTTO, DIFFICILE, ...) su cui si
-- trova l'unità: raggio verso il basso da ogni base, si leggono
-- i tag degli oggetti colpiti (tipo carta -> categoria con
-- IEF_FIELD_TIPO_TO_CATEGORIA, o categoria diretta). Vince la
-- più grave; nessun pezzo di terreno = APERTO.
-- ============================================================
function main_getUnitTerrain(unitKey)
    local peggiore, gravita = "APERTO", 0
    local mappa = IEF_FIELD_TIPO_TO_CATEGORIA or {}

    for _, base in ipairs(main_getUnitBases(unitKey)) do
        local p = base.getPosition()
        local hits = Physics.cast({
            origin       = Vector(p.x, p.y + 5, p.z),
            direction    = Vector(0, -1, 0),
            type         = 1,
            max_distance = 15,
        })
        for _, hit in ipairs(hits) do
            local o = hit.hit_object
            if o and o ~= base then
                for _, tag in ipairs(o.getTags()) do
                    local cat = mappa[tag] or (IEF_TERRAIN_SEVERITY[tag] and tag)
                    if cat and (IEF_TERRAIN_SEVERITY[cat] or 0) > gravita then
                        peggiore, gravita = cat, IEF_TERRAIN_SEVERITY[cat]
                    end
                end
            end
        end
    end
    return peggiore
end

-- ============================================================
-- PERDITE MARCATE (tiro, e in futuro Tiro d'Arresto): le basi
-- perse si evidenziano e si rimuovono solo a fine fase.
-- [unitKey] = { guid, ... }
-- ============================================================
IEF_MARKED_LOSSES = IEF_MARKED_LOSSES or {}

-- ============================================================
-- FUNZIONE: main_markedCount(unitKey)
-- ============================================================
function main_markedCount(unitKey)
    return #(IEF_MARKED_LOSSES[unitKey] or {})
end

-- ============================================================
-- FUNZIONE: main_markLosses(unitKey, hits)
-- Marca floor(hits / figures_per_base) basi nell'ordine di
-- main_lossOrder (rango posteriore, da destra), saltando quelle
-- già marcate. Colpi in eccesso persi. Ritorna: basi marcate ora
-- ============================================================
function main_markLosses(unitKey, hits)
    if not hits or hits <= 0 then return 0 end

    local ordinate, fpb = main_lossOrder(unitKey)
    if not fpb or fpb <= 0 then return 0 end

    IEF_MARKED_LOSSES[unitKey] = IEF_MARKED_LOSSES[unitKey] or {}
    local gia = {}
    for _, guid in ipairs(IEF_MARKED_LOSSES[unitKey]) do gia[guid] = true end

    local n, marcate = math.floor(hits / fpb), 0
    for _, obj in ipairs(ordinate) do
        if marcate >= n then break end
        local guid = obj.getGUID()
        if not gia[guid] then
            table.insert(IEF_MARKED_LOSSES[unitKey], guid)
            obj.setColorTint(LOSS_HIGHLIGHT_COLOR)
            marcate = marcate + 1
        end
    end

    printToAll(string.format("[PERDITE] %s: %d colpi -> %d basi perse (rimosse a fine fase)",
        main_decodeExtendedUnitLabel(unitKey), hits, marcate), {r=1,g=0.4,b=0.4})
    return marcate
end

-- ============================================================
-- FUNZIONE: main_removeMarkedLosses()
-- Fine fase: rimuove tutte le basi marcate (main_removeBases).
-- ============================================================
function main_removeMarkedLosses()
    for unitKey, guids in pairs(IEF_MARKED_LOSSES) do
        local objs = {}
        for _, guid in ipairs(guids) do
            local obj = getObjectFromGUID(guid)
            if obj then
                obj.setColorTint({0, 0, 0})
                table.insert(objs, obj)
            end
        end
        main_removeBases(unitKey, objs)
    end
    IEF_MARKED_LOSSES = {}
end

-- ============================================================
-- FUNZIONE: main_isAliveAfterMarks(unitKey)
-- L'unità ha ancora basi non marcate.
-- ============================================================
function main_isAliveAfterMarks(unitKey)
    return #main_getUnitBases(unitKey) > main_markedCount(unitKey)
end

-- ============================================================
-- FUNZIONE: main_routMove(unitKey)
-- Movimento di rotta immediato, come l'evasione: cambio fronte
-- di 180° e mossa piena in linea retta.
-- NON ancora: blocco (distruzione) e disordine delle amiche
-- attraversate.
-- ============================================================
function main_routMove(unitKey)
    local bases = main_getUnitBases(unitKey)
    if #bases == 0 then return end

    local meta = main_getUnitMeta(bases[1])
    local ut = meta and meta.unitType and main_getUnitType(meta.unitType)
    local moveInches = (ut and ut.move_inches) or 0

    local oldFwd = bases[1].getTransformForward()
    local fleeXZ = Vector(-oldFwd.x, 0, -oldFwd.z):normalized()
    local delta = moveInches * INCH_TO_TTS

    for _, obj in ipairs(bases) do
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y + 180, rot.z))
        local p = obj.getPosition()
        obj.setPosition(Vector(p.x + fleeXZ.x * delta, p.y, p.z + fleeXZ.z * delta))
    end

    printToAll(string.format("[ROTTA] %s fugge di %s\"", main_decodeExtendedUnitLabel(unitKey), tostring(moveInches)), {r=1,g=0.3,b=0.3})
end

-- ============================================================
-- FUNZIONE: main_onRout(unitKey, slot, pushItem)
-- Unità appena andata in ROTTA: test delle amiche secondo le
-- situazioni FRIEND_ROUT (valutate prima della fuga), passati a
-- pushItem(item, quando); poi movimento di rotta.
-- ============================================================
function main_onRout(unitKey, slot, pushItem)
    local bases = main_getUnitBases(unitKey)
    local meta = bases[1] and main_getUnitMeta(bases[1])

    for _, s in ipairs(main_moraleSituationsFor("FRIEND_ROUT", { tipoOrigine = meta and meta.unitType, origineGiaInFuga = false })) do
        if s.def.testa == "AMICHE_IN_RAGGIO" then
            for altraKey, altreBasi in pairs(main_unitsOfSlot(slot)) do
                if altraKey ~= unitKey and not main_isGeneralKey(altraKey)
                   and main_getCohesion(altraKey) ~= COHESION.ROT then
                    local d = main_unitsDistanceInches(bases, altreBasi)
                    if d and d <= (s.def.raggio or 0) then
                        pushItem({ key = altraKey, slot = slot, motivo = s.nome, effetto = s.def.effetto }, s.def.quando)
                    end
                end
            end
        end
    end

    main_routMove(unitKey)
end

-- ============================================================
-- FUNZIONE: main_lowerAndCheckRout(unitKey, slot, pushItem)
-- ============================================================
function main_lowerAndCheckRout(unitKey, slot, pushItem)
    local prima = main_getCohesion(unitKey)
    local dopo = main_lowerCohesion(unitKey)
    if prima ~= COHESION.ROT and dopo == COHESION.ROT then
        main_onRout(unitKey, slot, pushItem)
    end
end

-- ============================================================
-- FUNZIONE: main_runMoraleQueue(coda, onDone)
-- Esegue in sequenza (tiro automatico dal sacchetto del
-- giocatore proprietario) i test di una coda { {key, slot,
-- motivo, effetto}, ... }. Fallito -> -1 coesione; se va in
-- ROTTA, i nuovi test IMMEDIATO si accodano qui, quelli FINE_FASE
-- in IEF_MORALE_END_QUEUE (o qui se finePhase = true).
-- ============================================================
function main_runMoraleQueue(coda, onDone, finePhase)
    local function push(item, quando)
        if quando == "FINE_FASE" and not finePhase then
            table.insert(IEF_MORALE_END_QUEUE, item)
        else
            table.insert(coda, item)
        end
    end

    local function prossimo()
        local item = (#coda > 0) and table.remove(coda, 1) or nil
        if not item then
            if onDone then onDone() end
            return
        end
        if main_getCohesion(item.key) == COHESION.ROT or not main_isAliveAfterMarks(item.key) then
            prossimo()
            return
        end

        local mod, dettaglio = main_moraleModifier(item.key, { basiInSospeso = main_markedCount(item.key) })
        printToAll(string.format("[MORALE] %s testa (%s), modificatori: %s",
            main_decodeExtendedUnitLabel(item.key), item.motivo or "", main_moraleModifierText(dettaglio)), {r=1,g=0.8,b=0.3})

        main_requestMoraleRoll(item.key, item.slot, item.effetto or "altre_situazioni", mod, item.motivo, function(esito)
        if esito == MORALE_RESULT.KO then
                main_lowerAndCheckRout(item.key, item.slot, push)
        end
        Wait.time(prossimo, 1)
        end)
    end
    prossimo()
end

-- ============================================================
-- FUNZIONE: main_lossTests(unitKey, slot)
-- Test previsti dalla tabella per l'evento LOSS (basi perse).
-- ============================================================
function main_lossTests(unitKey, slot)
    local out = {}
    local meta = main_getUnitMeta(main_getUnitBases(unitKey)[1])
    for _, s in ipairs(main_moraleSituationsFor("LOSS", { tipo = meta and meta.unitType })) do
        if s.def.testa == "VITTIMA" then
            table.insert(out, { key = unitKey, slot = slot, motivo = s.nome, effetto = s.def.effetto, quando = s.def.quando })
        end
    end
    return out
end
-- ============================================================
-- FUNZIONE: main_requestMoraleRoll(unitKey, slot, situazione, mod, motivo, callback)
-- Accoda il test ed aggiorna il pannello (solo UI.setAttribute,
-- mai buildUI/UI.setXml — causa un freeze se chiamato da dentro
-- la catena dei dadi).
-- ============================================================
function main_requestMoraleRoll(unitKey, slot, situazione, mod, motivo, callback)
    IEF_MORALE_ROLL_PENDING[slot] = IEF_MORALE_ROLL_PENDING[slot] or {}
    table.insert(IEF_MORALE_ROLL_PENDING[slot], {
        key = unitKey, situazione = situazione, mod = mod or 0,
        motivo = motivo, callback = callback,
    })
    main_refreshMoraleQueuePanel(slot)
end

-- ============================================================
-- FUNZIONE: main_doPendingMoraleRoll(player, slot)
-- Dispatch da engine_diceRoll_start. Risolve la riga attivata
-- dal click (IEF_MORALE_ACTIVE_ROW[slot]) o, in assenza, la
-- prima in coda.
-- ============================================================
function main_doPendingMoraleRoll(player, slot)
    local coda = IEF_MORALE_ROLL_PENDING[slot]
    if not coda or #coda == 0 then return false end
    if coda.inCorso then return true end

    local idx = IEF_MORALE_ACTIVE_ROW[slot]
    if not idx or not coda[idx] then idx = 1 end
    local p = coda[idx]

    coda.inCorso = true

    main_testMorale(p.key, player, p.situazione, p.mod, function(esito, somma, soglia, effetto)
        coda.inCorso = false
        if esito == nil then return end

        table.remove(coda, idx)
        IEF_MORALE_ACTIVE_ROW[slot] = nil
        main_refreshMoraleQueuePanel(slot)

        if p.callback then p.callback(esito, somma, soglia, effetto) end

        if #coda > 0 then
            engine_cameraByNamme(player, nil, CAMERA_ZONE.ARMY_ROLL_DICES)
        else
            engine_cameraByNamme(player, nil, CAMERA_ZONE.ARMY_HOME)
        end
    end)
    return true
end

-- ============================================================
-- FUNZIONE: main_moraleRowClick(player, value, id)
-- Click su una riga del pannello morale: attiva quella riga
-- come prossima da risolvere col Roll fisico, zooma sui dadi.
-- ============================================================
function main_moraleRowClick(player, value, id)
    local slotStr, idxStr = id:match("^morale_queue_row_btn_(%d)_(%d)$")
    if not slotStr then return end
    local slot = tonumber(slotStr)
    local idx  = tonumber(idxStr)

    local coda = IEF_MORALE_ROLL_PENDING[slot]
    if not coda or not coda[idx] then return end

    IEF_MORALE_ACTIVE_ROW[slot] = idx
    engine_diceCameraZoom(player, slot)
end

-- ============================================================
-- Pannello morale: righe fisse pre-costruite nell'XML base
-- (main_getMoraleQueuePanelXml, generato una volta sola a
-- buildUI/game start). Aggiungere o togliere un test aggiorna
-- SOLO testo e visibilità via UI.setAttribute
-- (main_refreshMoraleQueuePanel) — mai UI.setXml/buildUI.
-- ============================================================
MORALE_QUEUE_MAX_ROWS = 6

-- ============================================================
-- FUNZIONE: main_getMoraleQueuePanelXml(slot)
-- ============================================================
function main_getMoraleQueuePanelXml(slot)

    local colore = ARMY[slot] and ARMY[slot].color or "White"

    local rows = ""
    for i = 1, MORALE_QUEUE_MAX_ROWS do
        rows = rows .. string.format(
            '<Row preferredHeight="25" active="false" id="morale_queue_row_container_%d_%d">' ..
                '<Cell>' ..
                    '<Button id="morale_queue_row_%d_%d" text="" font="warforge_font" fontSize="11" color="rgba(0,0,0,0.30)" textColor="White" alignment="MiddleLeft" width="475" />' ..
                '</Cell>' ..
                '<Cell>' ..
                    '<Button id="morale_queue_row_btn_%d_%d" text="" fontSize="14" fontStyle="Bold" color="rgba(0.7,0.15,0.15,1)" textColor="White" onClick="main_moraleRowClick"/>' ..
                '</Cell>' ..
            '</Row>',
            slot, i, slot, i, slot, i
        )
    end

    return string.format(
        '<Panel id="morale_queue_list_army%d" rectAlignment="MiddleRight" color="rgba(0,0,0,0.35)" width="500" height="160" offsetXY="-20 0" visibility="%s" active="false">' ..
        '<Text id="morale_queue_list_title_army%d" text="TEST DI MORALE %s" font="warforge_font" fontSize="14" fontStyle="Bold" outlineColor="Black" outlineSize="1" color="White" position="0 65 0" alignment="MiddleCenter" width="300" height="22"/>' ..
        '<TableLayout width="500" height="120" cellBackgroundColor="rgba(0,0,0,0.00)" columnWidths="460 40" position="0 -5 0">' ..
        '%s' ..
        '</TableLayout>' ..
        '</Panel>',
        slot, colore, slot, ARMY[slot].name, rows
    )
end

-- ============================================================
-- FUNZIONE: main_refreshMoraleQueuePanel(slot)
-- Aggiorna SOLO via UI.setAttribute le righe del pannello (già
-- esistenti nell'XML base) in base a IEF_MORALE_ROLL_PENDING[slot].
-- Mai UI.setXml/buildUI.
-- ============================================================
function main_refreshMoraleQueuePanel(slot)
    local coda = IEF_MORALE_ROLL_PENDING[slot] or {}

    UI.setAttribute("morale_queue_list_army" .. slot, "active", (#coda > 0) and "true" or "false")

    for i = 1, MORALE_QUEUE_MAX_ROWS do
        local item = coda[i]
        local containerId = "morale_queue_row_container_" .. slot .. "_" .. i
        local textId = "morale_queue_row_" .. slot .. "_" .. i

        if item then
            UI.setAttribute(containerId, "active", "true")
            UI.setAttribute(textId, "text", main_decodeExtendedUnitLabel(item.key) .. ": test di morale (" .. (item.motivo or item.situazione or "") .. ")")
        else
            UI.setAttribute(containerId, "active", "false")
        end
    end
end