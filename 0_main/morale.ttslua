-- ============================================================
-- WARFORGE IEF — 0_main/morale.ttslua
-- Regole del morale a TABELLE: situazioni che richiedono un test
-- e modificatori. Le regole sono dati: per cambiare chi è
-- coinvolto si modificano i campi, non il codice.
-- Caricato dopo lib (usa main_*).
-- ============================================================



-- ============================================================
-- FUNZIONE: main_moraleMotivoText(motivo)
-- Testo leggibile del motivo di un test; se manca l'etichetta
-- ritorna il nome tecnico.
-- ============================================================
function main_moraleMotivoText(motivo)
    if not motivo then return "" end
    local s = IEF_MORALE_SITUATIONS[motivo]
    return (s and s.label) or IEF_MORALE_MOTIVO_LABEL[motivo] or motivo
end

-- ============================================================
-- FUNZIONE: main_moraleRowText(req, inCorso)
-- Testo della riga del pannello morale.
-- ============================================================
function main_moraleRowText(req, inCorso)
    return string.format("La %s: %s%s",
        main_decodeExtendedUnitLabel(req.key),
        main_moraleMotivoText(req.motivo or req.situazione),
        inCorso and " [in corso]" or "")
end

-- ============================================================
-- FUNZIONE: main_moraleModifierLabel(chiave)
-- Etichetta leggibile di un modificatore (IEF_MORALE_MODIFIERS).
-- ============================================================
function main_moraleModifierLabel(chiave)
    for _, m in ipairs(IEF_MORALE_MODIFIERS) do
        if m.chiave == chiave then return m.label or chiave end
    end
    return chiave
end




-- ============================================================
-- FUNZIONE: main_listHas(lista, valore)
-- ============================================================
function main_listHas(lista, valore)
    for _, v in ipairs(lista or {}) do
        if v == valore then return true end
    end
    return false
end

-- ============================================================
-- FUNZIONE: main_soloArmiDaTiro(armi, escluse)
-- Regolamento: "FP - FM dotati solo di armi da tiro (escluso i
-- GIAVELLOTTI)". Vero se c'è almeno un'arma da tiro non esclusa
-- e nessuna arma da mischia elencata (range 0, SCUDO escluso).
-- ============================================================
function main_soloArmiDaTiro(armi, escluse)
    local dict = IEF_DATA.weapons and (IEF_DATA.weapons.weapons or IEF_DATA.weapons)
    if not dict or not armi then return false end
    local tiro, mischia = false, false
    for _, nome in ipairs(armi) do
        local w = dict[nome]
        if w and nome ~= "SCUDO" then
            if (w.range_inches or 0) > 0 then
                if not main_listHas(escluse, nome) then tiro = true end
            else
                mischia = true
            end
        end
    end
    return tiro and not mischia
end
-- ============================================================
-- FUNZIONE: main_moraleSituationsFor(evento, ctx)
-- Situazioni della tabella che si applicano. ctx:
-- armi         : armi dell'unità che testa (per soloArmiDaTiro)
-- tipoOrigine, origineGiaInFuga
-- Ritorna lista { nome, def } ordinata per nome.
-- ============================================================
function main_moraleSituationsFor(evento, ctx)
    ctx = ctx or {}
    local out = {}
    for nome, def in pairs(IEF_MORALE_SITUATIONS) do
        local ok = def.evento == evento
        if ok and def.tipi and not main_listHas(def.tipi, ctx.tipo) then ok = false end
        if ok and def.tipiAvversario and not main_listHas(def.tipiAvversario, ctx.tipoAvversario) then ok = false end
        if ok and def.tipiAvversarioEsclusi and main_listHas(def.tipiAvversarioEsclusi, ctx.tipoAvversario) then ok = false end
        if ok and def.terreno and def.terreno ~= ctx.terreno then ok = false end
        if ok and def.lato and def.lato ~= ctx.lato then ok = false end
        if ok and def.soloArmiDaTiro and not main_soloArmiDaTiro(ctx.armi, def.armiEscluse) then ok = false end
        if ok and def.tipiOrigineEsclusi and main_listHas(def.tipiOrigineEsclusi, ctx.tipoOrigine) then ok = false end
        if ok and def.escludiGiaInFuga and ctx.origineGiaInFuga then ok = false end
        if ok then table.insert(out, { nome = nome, def = def }) end
    end
    table.sort(out, function(a, b) return a.nome < b.nome end)
    return out
end

-- ============================================================
-- FUNZIONE: main_moraleModifier(unitKey, ctx)
-- Somma dei modificatori di IEF_MORALE_MODIFIERS.
-- Ritorna: totale, dettaglio { {chiave, volte, valore}, ... }
-- ============================================================
function main_moraleModifier(unitKey, ctx)
    local totale, dettaglio = 0, {}
    for _, m in ipairs(IEF_MORALE_MODIFIERS) do
        local cond = IEF_MORALE_CONDITIONS[m.condizione]
        local volte = cond and cond(unitKey, ctx) or 0
        if volte > 0 then
            local unitario = main_getMoraleModifier(m.chiave) or 0
            totale = totale + unitario * volte
            table.insert(dettaglio, { chiave = m.chiave, volte = volte, valore = unitario * volte })
        end
    end
    return totale, dettaglio
end

-- ============================================================
-- FUNZIONE: main_moraleModifierText(dettaglio)
-- ============================================================
function main_moraleModifierText(dettaglio)
    local parti = {}
    for _, d in ipairs(dettaglio or {}) do
        table.insert(parti, string.format("%s %+d", d.chiave, d.valore))
    end
    return (#parti > 0) and table.concat(parti, ", ") or "nessuno"
end

-- ============================================================
-- FUNZIONE: main_unitSlot(unitKey)
-- ============================================================
function main_unitSlot(unitKey)
    local b = main_getUnitBases(unitKey)[1]
    if not b then return nil end
    if b.hasTag("Army1") then return 1 end
    if b.hasTag("Army2") then return 2 end
    return nil
end

-- ============================================================
-- FUNZIONE: main_unitsOfSlot(slot)
-- Tutte le unità di un esercito sul tavolo: { [unitKey] = { basi } }
-- ============================================================
function main_unitsOfSlot(slot)
    local out = {}
    local tag = "Army" .. slot
    for _, o in ipairs(getAllObjects()) do
        if o.hasTag(tag) and main_getUnitMeta(o) then
            local key = main_getUnitKey(o)
            out[key] = out[key] or {}
            table.insert(out[key], o)
        end
    end
    return out
end

-- ============================================================
-- FUNZIONE: main_isGeneralKey(unitKey)
-- ============================================================
function main_isGeneralKey(unitKey)
    return unitKey ~= nil and string.find(unitKey, "_GEN_", 1, true) ~= nil
end

-- ============================================================
-- FUNZIONE: main_unitsDistanceInches(basiA, basiB)
-- Distanza minima bordo-bordo fra due insiemi di basi.
-- ============================================================
function main_unitsDistanceInches(basiA, basiB)
    local minimo = nil
    for _, a in ipairs(basiA) do
        for _, b in ipairs(basiB) do
            local d = main_distanceInches(a, b)
            if d and (not minimo or d < minimo) then minimo = d end
        end
    end
    return minimo
end
-- ============================================================
-- FUNZIONE: main_getGeneralHost(genKey)
-- Unità a cui il Generale è aggregato (stato salvato, si
-- cambia solo nel Movimento: 0_main/general.ttslua).
-- ============================================================
function main_getGeneralHost(genKey)
    return main_generalAttachedHost(genKey)
end
-- ============================================================
-- FUNZIONE: main_getAttachedGeneral(unitKey)
-- Generale aggregato all'unità (chiave) o nil.
-- ============================================================
function main_getAttachedGeneral(unitKey)
    return main_generalAttachedTo(unitKey)
end
-- ============================================================
-- FUNZIONE: main_getUnitTerrain(unitKey)
-- Categoria di terreno (APERTO, ROTTO, DIFFICILE, ...) su cui si
-- trova l'unità: raggio verso il basso da ogni base, si leggono
-- i tag degli oggetti colpiti (tipo carta -> categoria con
-- IEF_FIELD_TIPO_TO_CATEGORIA, o categoria diretta). Vince la
-- più grave; nessun pezzo di terreno = APERTO.
-- ============================================================
function main_getUnitTerrain(unitKey)
    local peggiore, gravita = "APERTO", 0
    local mappa = IEF_FIELD_TIPO_TO_CATEGORIA or {}

    for _, base in ipairs(main_getUnitBases(unitKey)) do
        local p = base.getPosition()
        local hits = Physics.cast({
            origin       = Vector(p.x, p.y + 5, p.z),
            direction    = Vector(0, -1, 0),
            type         = 1,
            max_distance = 15,
        })
        for _, hit in ipairs(hits) do
            local o = hit.hit_object
            if o and o ~= base then
                for _, tag in ipairs(o.getTags()) do
                    local cat = mappa[tag] or (IEF_TERRAIN_SEVERITY[tag] and tag)
                    if cat and (IEF_TERRAIN_SEVERITY[cat] or 0) > gravita then
                        peggiore, gravita = cat, IEF_TERRAIN_SEVERITY[cat]
                    end
                end
            end
        end
    end
    return peggiore
end

-- ============================================================
-- PERDITE MARCATE (tiro, e in futuro Tiro d'Arresto): le basi
-- perse si evidenziano e si rimuovono solo a fine fase.
-- [unitKey] = { guid, ... }
-- ============================================================
IEF_MARKED_LOSSES = IEF_MARKED_LOSSES or {}

-- ============================================================
-- FUNZIONE: main_markedCount(unitKey)
-- ============================================================
function main_markedCount(unitKey)
    return #(IEF_MARKED_LOSSES[unitKey] or {})
end

-- ============================================================
-- FUNZIONE: main_markLosses(unitKey, hits)
-- Marca floor(hits / figures_per_base) basi nell'ordine di
-- main_lossOrder (rango posteriore, da destra), saltando quelle
-- già marcate. Colpi in eccesso persi. Ritorna: basi marcate ora
-- ============================================================
function main_markLosses(unitKey, hits)
    if not hits or hits <= 0 then return 0 end

    local ordinate, fpb = main_lossOrder(unitKey)
    if not fpb or fpb <= 0 then return 0 end

    IEF_MARKED_LOSSES[unitKey] = IEF_MARKED_LOSSES[unitKey] or {}
    local gia = {}
    for _, guid in ipairs(IEF_MARKED_LOSSES[unitKey]) do gia[guid] = true end

    local n, marcate = math.floor(hits / fpb), 0
    for _, obj in ipairs(ordinate) do
        if marcate >= n then break end
        local guid = obj.getGUID()
        if not gia[guid] then
            table.insert(IEF_MARKED_LOSSES[unitKey], guid)
            obj.setColorTint(LOSS_HIGHLIGHT_COLOR)
            marcate = marcate + 1
        end
    end

    printToAll(string.format("[PERDITE] %s: %d colpi -> %d basi perse (rimosse a fine fase)",
        main_decodeExtendedUnitLabel(unitKey), hits, marcate), {r=1,g=0.4,b=0.4})
    if marcate > 0 then main_generalRisk(unitKey, 12, "l'unita' ha perso una base") end
    return marcate
end

-- ============================================================
-- FUNZIONE: main_removeMarkedLosses()
-- Fine fase: rimuove tutte le basi marcate (main_removeBases).
-- ============================================================
function main_removeMarkedLosses()
    for unitKey, guids in pairs(IEF_MARKED_LOSSES) do
        local objs = {}
        for _, guid in ipairs(guids) do
            local obj = getObjectFromGUID(guid)
            if obj then
                obj.setColorTint({0, 0, 0})
                table.insert(objs, obj)
            end
        end
        main_removeBases(unitKey, objs)
    end
    IEF_MARKED_LOSSES = {}
end

-- ============================================================
-- FUNZIONE: main_isAliveAfterMarks(unitKey)
-- L'unità ha ancora basi non marcate.
-- ============================================================
function main_isAliveAfterMarks(unitKey)
    return #main_getUnitBases(unitKey) > main_markedCount(unitKey)
end

-- ============================================================
-- FUNZIONE: main_routMove(unitKey, onDone)
-- Movimento di rotta (regolamento, "Effetti della rotta" e fase
-- di mischia): l'unità si volta e fugge dritta per tutta la
-- mossa, ignorando le penalità di terreno.
-- - Nemico sul percorso -> unità distrutta.
-- - Amiche superate del tutto -> disordinate (-1 coesione, che
--   per le già disordinate è la rotta), tranne le eccezioni di
--   interpenetrazione (main_canInterpenetrate: FL, CL).
-- - Se finirebbe sopra un'amica -> si ferma prima, a contatto, e
--   quell'amica non viene disordinata.
-- - Terreno intransitabile -> si ferma al bordo (perno/distruzione
--   non ancora gestiti: avviso).
-- Geometria: main_routCheckStep / main_routSettle (break.ttslua).
-- onDone(esito) facoltativa: "MOSSA" o "DISTRUTTA".
-- ============================================================
function main_routMove(unitKey, onDone)
    local bases = main_getUnitBases(unitKey)
    if #bases == 0 then
        if onDone then onDone(nil) end
        return
    end

    local slot = main_unitSlot(unitKey)
    local info = main_parseNickname(bases[1].getName())
    local tipo = info and info.unitType
    local ut = tipo and main_getUnitType(tipo)
    local moveInches = (ut and ut.move_inches) or 0
    local label = main_decodeExtendedUnitLabel(unitKey)

    local oldFwd = bases[1].getTransformForward()
    local fleeXZ = Vector(-oldFwd.x, 0, -oldFwd.z):normalized()

    -- 1. dietrofront sul posto (il controllo usa il nuovo fronte)
    for _, obj in ipairs(bases) do
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y + 180, rot.z))
    end

    Wait.frames(function()
        -- 2. controllo del percorso
        local passo = main_routCheckStep(unitKey, moveInches)

        if passo.nemico then
            printToAll(string.format("[ROTTA] %s: nemico sul percorso (%s), unità distrutta",
                label, main_decodeExtendedUnitLabel(passo.nemico)), {r=1,g=0.3,b=0.3})
            main_removeBases(unitKey, main_getUnitBases(unitKey))
            if onDone then onDone("DISTRUTTA") end
            return
        end

        -- 3. avanti fino a dove si può
        local delta = passo.avanza * INCH_TO_TTS
        for _, obj in ipairs(main_getUnitBases(unitKey)) do
            local p = obj.getPosition()
            main_setPositionOnGround(obj, p.x + fleeXZ.x * delta, p.z + fleeXZ.z * delta)
        end

        Wait.frames(function()
            -- 4. sopra un'amica: arretra fino al contatto
            local fine = main_routSettle(unitKey)
            local arretra = fine.arretra * INCH_TO_TTS
            if arretra > 0 then
                for _, obj in ipairs(main_getUnitBases(unitKey)) do
                    local p = obj.getPosition()
                    main_setPositionOnGround(obj, p.x - fleeXZ.x * arretra, p.z - fleeXZ.z * arretra)
                end
            end

            local netto = math.max(0, delta - arretra)
            main_generalFlipAndMove(unitKey, fleeXZ.x, fleeXZ.z, netto)

            printToAll(string.format("[ROTTA] %s fugge di %.1f\"", label, netto / INCH_TO_TTS), {r=1,g=0.3,b=0.3})
            if passo.terreno then
                printToAll(string.format("[ROTTA] %s: fermata da terreno intransitabile", label), {r=1,g=0.6,b=0})
            end

            -- 5. amiche superate: disordinate (tranne eccezioni)
            local function push(item, quando)
                if quando == "FINE_FASE" then
                    table.insert(IEF_MORALE_END_QUEUE, item)
                else
                    main_runMoraleQueue({ item })
                end
            end
            for key, tipoAmica in pairs(passo.amiche) do
                if not fine.davanti[key] and not main_canInterpenetrate(tipo, tipoAmica)
                   and main_getCohesion(key) ~= COHESION.ROT then
                    printToAll(string.format("[ROTTA] %s attraversa la %s e la disordina",
                        label, main_decodeExtendedUnitLabel(key)), {r=1,g=0.6,b=0})
                    main_lowerAndCheckRout(key, slot, push)
                end
            end

            if onDone then onDone("MOSSA") end
        end, 2)
    end, 2)
end

-- ============================================================
-- FUNZIONE: main_onRout(unitKey, slot, pushItem)
-- Unità appena andata in ROTTA: test delle amiche secondo le
-- situazioni FRIEND_ROUT (valutate prima della fuga), passati a
-- pushItem(item, quando); poi movimento di rotta.
-- ============================================================
function main_onRout(unitKey, slot, pushItem)
    local bases = main_getUnitBases(unitKey)
    local meta = bases[1] and main_getUnitMeta(bases[1])

    for _, s in ipairs(main_moraleSituationsFor("FRIEND_ROUT", { tipoOrigine = meta and meta.unitType, origineGiaInFuga = false })) do
        if s.def.testa == "AMICHE_IN_RAGGIO" then
            for altraKey, altreBasi in pairs(main_unitsOfSlot(slot)) do
                if altraKey ~= unitKey and not main_isGeneralKey(altraKey)
                   and main_getCohesion(altraKey) ~= COHESION.ROT then
                    local d = main_unitsDistanceInches(bases, altreBasi)
                    if d and d <= (s.def.raggio or 0) then
                        pushItem({ key = altraKey, slot = slot, motivo = s.nome, effetto = s.def.effetto }, s.def.quando)
                    end
                end
            end
        end
    end

    main_routEnqueue(unitKey, slot)

end

-- ============================================================
-- FUNZIONE: main_lowerAndCheckRout(unitKey, slot, pushItem)
-- ============================================================
function main_lowerAndCheckRout(unitKey, slot, pushItem)
    local prima = main_getCohesion(unitKey)
    local dopo = main_lowerCohesion(unitKey)
    if prima ~= COHESION.ROT and dopo == COHESION.ROT then
        main_onRout(unitKey, slot, pushItem)
    end
end

-- ============================================================
-- FUNZIONE: main_runMoraleQueue(coda, onDone)
-- Esegue in sequenza (tiro automatico dal sacchetto del
-- giocatore proprietario) i test di una coda { {key, slot,
-- motivo, effetto}, ... }. Fallito -> -1 coesione; se va in
-- ROTTA, i nuovi test IMMEDIATO si accodano qui, quelli FINE_FASE
-- in IEF_MORALE_END_QUEUE (o qui se finePhase = true).
-- ============================================================
function main_runMoraleQueue(coda, onDone, finePhase)
    local function push(item, quando)
        if quando == "FINE_FASE" and not finePhase then
            table.insert(IEF_MORALE_END_QUEUE, item)
        else
            table.insert(coda, item)
        end
    end

    local function prossimo()
        local item = (#coda > 0) and table.remove(coda, 1) or nil
        if not item then
            if onDone then onDone() end
            return
        end
        if main_getCohesion(item.key) == COHESION.ROT or not main_isAliveAfterMarks(item.key) then
            prossimo()
            return
        end

        main_requestMoraleRoll(item.key, item.slot, item.effetto or "altre_situazioni", nil, item.motivo, function(esito)

        if esito == MORALE_RESULT.KO then
                main_lowerAndCheckRout(item.key, item.slot, push)
        end
        Wait.time(prossimo, 1)
        end)
    end
    prossimo()
end

-- ============================================================
-- FUNZIONE: main_lossTests(unitKey, slot)
-- Test previsti dalla tabella per l'evento LOSS (basi perse).
-- ============================================================
function main_lossTests(unitKey, slot)
    local out = {}
    local meta = main_getUnitMeta(main_getUnitBases(unitKey)[1])
    for _, s in ipairs(main_moraleSituationsFor("LOSS", { tipo = meta and meta.unitType })) do
        if s.def.testa == "VITTIMA" then
            table.insert(out, { key = unitKey, slot = slot, motivo = s.nome, effetto = s.def.effetto, quando = s.def.quando })
        end
    end
    return out
end

-- ============================================================
-- FUNZIONE: main_moraleQueueCount(slot)
-- Numero di test di morale in attesa per l'esercito slot.
-- ============================================================
function main_moraleQueueCount(slot)
    local coda = IEF_MORALE_ROLL_PENDING[slot]
    return coda and #coda or 0
end

-- ============================================================
-- FUNZIONE: main_moraleBlocksPhase(player, slot)
-- Da chiamare in testa ai bottoni di fine fase: true (e avviso)
-- se l'esercito ha ancora test di morale da tirare.
-- ============================================================
function main_moraleBlocksPhase(player, slot)
    if main_routBlocksPhase(player, slot) then return true end
    local n = main_moraleQueueCount(slot)
    if n == 0 then return false end
    warningToColor(string.format("%d test di morale da tirare: usa il pannello morale", n), player, "Yellow", 5, true)
    return true
end
-- ============================================================
-- FUNZIONE: main_moraleCurrentModifier(unitKey)
-- Modificatore del test calcolato ADESSO: basi perse marcate e
-- non ancora rimosse (tiro e mischia) contano come perse.
-- Ritorna: totale, dettaglio
-- ============================================================
function main_moraleCurrentModifier(unitKey)
    local inSospeso = main_markedCount(unitKey) + #((IEF_MELEE_MARKED or {})[unitKey] or {})
    return main_moraleModifier(unitKey, { basiInSospeso = inSospeso })
end
-- ============================================================
-- FUNZIONE: main_moraleRefreshUI()
-- Rigenera il pannello morale (buildUI + updateCenterPanel),
-- rimandato fuori dalla catena dei dadi. updateCenterPanel
-- rimette le etichette di default dei bottoni di fase: nelle
-- fasi con bottoni dinamici (Tiro d'Arresto, risoluzione
-- mischia) si riapplica il loro redraw subito dopo.
-- ============================================================
function main_moraleRefreshUI()
    Wait.time(function()
        callHandler("buildUI")
        callHandler("updateCenterPanel")
    end, 0.5)
end
-- ============================================================
-- FUNZIONE: main_requestMoraleRoll(unitKey, slot, situazione, mod, motivo, onDone, ctx)
-- Accoda il test (riga nel pannello morale); si tira aprendo la
-- sottofase MORALE_TEST dal pannello. mod = nil -> calcolato al Roll.
-- onDone: NOME di un handler, chiamato con (ctx, esito, somma,
-- soglia, effetto) — salvabile; oppure una funzione (esito, somma,
-- soglia, effetto) — formato vecchio, NON salvato (da eliminare
-- con la migrazione di Tiro d'Arresto e mischia).
-- ============================================================
function main_requestMoraleRoll(unitKey, slot, situazione, mod, motivo, onDone, ctx)
    IEF_MORALE_NEXT_ID = (IEF_MORALE_NEXT_ID or 0) + 1
    IEF_MORALE_ROLL_PENDING[slot] = IEF_MORALE_ROLL_PENDING[slot] or {}
    table.insert(IEF_MORALE_ROLL_PENDING[slot], {
        id = IEF_MORALE_NEXT_ID,
        key = unitKey, situazione = situazione, mod = mod,
        motivo = motivo, onDone = onDone, ctx = ctx,
    })
    main_moraleRefreshUI()
    return IEF_MORALE_NEXT_ID
end

-- ============================================================
-- FUNZIONE: main_moraleFindRequest(slot, id)
-- ============================================================
function main_moraleFindRequest(slot, id)
    for i, req in ipairs(IEF_MORALE_ROLL_PENDING[slot] or {}) do
        if req.id == id then return req, i end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: main_moraleSerializableQueue()
-- Copia della coda per il salvataggio: solo onDone per nome.
-- ============================================================
function main_moraleSerializableQueue()
    local out = { [1] = {}, [2] = {} }
    for slot = 1, 2 do
        for _, req in ipairs(IEF_MORALE_ROLL_PENDING[slot] or {}) do
            if type(req.onDone) ~= "function" then
                table.insert(out[slot], req)
            end
        end
    end
    return out
end
-- ============================================================
-- FUNZIONE: main_moraleTestInfo(p)
-- Righe informative di un test in coda: unità e coesione, motivo,
-- modificatori (calcolati ora se il test non li ha fissi) e
-- risultato da ottenere sui 2D6.
-- ============================================================
function main_moraleTestInfo(p)
    local bases = main_getUnitBases(p.key)
    local meta = bases[1] and main_getUnitMeta(bases[1])
    local classe = meta and meta.morale
    local moraleData = classe and main_getMorale(classe)
    local soglia = moraleData and moraleData.threshold

    local mod, dettaglio = p.mod, nil
    if mod == nil then
        mod, dettaglio = main_moraleCurrentModifier(p.key)
    end
    mod = mod or 0

    local righe = {
        string.format("%s - %s", main_decodeExtendedUnitLabel(p.key), main_getCohesion(p.key)),
        string.format("Test: %s", p.motivo or p.situazione or ""),
        string.format("Modificatori: %s (totale %+d)",
            dettaglio and main_moraleModifierText(dettaglio) or "fissi", mod),
    }
    if soglia then
        table.insert(righe, string.format("Morale %s: serve %d+ (2D6 %+d), cioè almeno %d sui dadi",
            tostring(classe), soglia, mod, soglia - mod))
    end
    return righe
end
-- ============================================================
-- FUNZIONE: main_clearWarning()
-- Ferma un warningListToColor in corso e nasconde il messaggio.
-- ============================================================
function main_clearWarning()
    IEF_WARNING_ACTIVE = false
    UI.setAttribute("playerGameMessage", "active", "false")
end

-- ============================================================
-- FUNZIONE: main_moraleRowClick(player, value, id)
-- Ferma un warningListToColor in corso e nasconde il messaggio.
-- ============================================================
function main_moraleRowClick(player, value, id)
    local slotStr, idxStr = id:match("^morale_queue_row_(%d)_(%d+)$")
    if not slotStr then return end
    local slot = tonumber(slotStr)
    if main_getArmyByColor(player) ~= slot then return end

    local req = (IEF_MORALE_ROLL_PENDING[slot] or {})[tonumber(idxStr)]
    if not req then return end

    local aperta = engine_subPrivate(slot)
    if aperta then
        if aperta.name == "MORALE_TEST" and aperta.ctx.reqId == req.id then
            return
        else
            warningToColor("Completa prima il test in corso", player, "Yellow", 5, true)
        end
        return
    end

    engine_subOpen("MORALE_TEST", slot, { reqId = req.id }, "main_moraleTestDone")
end

-- ============================================================
-- FUNZIONE: main_moraleIsActive(slot, id)
-- ============================================================
function main_moraleIsActive(slot, id)
    local rec = engine_subPrivate(slot)
    return rec ~= nil and rec.name == "MORALE_TEST" and rec.ctx.reqId == id
end
-- ============================================================
-- FUNZIONE: main_getMoraleQueuePanelXml(slot)
-- Pannello dei test di morale in attesa: una riga per ogni test
-- di IEF_MORALE_ROLL_PENDING[slot], active calcolato dalla coda
-- (stesso schema di charge_getAttackListPanelXml). Si aggiorna
-- con buildUI quando la coda cambia.
-- ============================================================
function main_getMoraleQueuePanelXml(slot)
    local coda = IEF_MORALE_ROLL_PENDING[slot] or {}
    local attivo = (#coda > 0) and "true" or "false"
    local recupero = ENGINE.phase == PHASE.RECOVERY

    local righe = {}
    for i, item in ipairs(coda) do
        local attiva = main_moraleIsActive(slot, item.id)
        table.insert(righe, {
            id      = string.format("morale_queue_row_%d_%d", slot, i),
            testo   = main_moraleRowText(item, attiva),
            colore  = attiva and LISTPANEL.gold or LISTPANEL.todo,
            onClick = "main_moraleRowClick",
        })
    end

    return ui_listPanelXml({
        id         = "morale_queue_list_army" .. slot,
        titleId    = "morale_queue_list_title_army" .. slot,
        titolo     = (recupero and "RECUPERO - " or "TEST DI MORALE - ") .. ARMY[slot].name,
        nota       = recupero and "Clicca una riga per tentare il recupero (tutte prima di chiudere)"
                              or "Clicca una riga per tirare il test",
        visibility = ARMY[slot] and ARMY[slot].color or "",
        attivo     = attivo,
        righe      = righe,
        offsetXY   = "-10 -100",
    })
end