-- ============================================================
-- rulesets/imperifeudi/engine/persistence.ttslua
-- Save/restore stato IEF.
-- Portato da LH rulesets/lionheart/engine/persistence.ttslua
-- Modifiche: LIONHEART_DATA → IEF_DATA, nomi funzioni
-- ============================================================

-- ============================================================
-- FUNZIONE: ief_onSave()
-- ============================================================
function main_onSave()
    local players_saved = {}

    local p1 = Player[COLOR.ARMY1]
    if p1 and p1.seated then
        players_saved[1] = {
            steam_id   = p1.steam_id,
            steam_name = p1.steam_name,
            color      = COLOR.ARMY1,
            slot       = 1,
            seated     = p1.seated
        }
    end

    local p2 = Player[COLOR.ARMY2]
    if p2 and p2.seated then
        players_saved[2] = {
            steam_id   = p2.steam_id,
            steam_name = p2.steam_name,
            color      = COLOR.ARMY2,
            slot       = 2,
            seated     = p2.seated
        }
    end

  local saveData = {
    engine = {
        phase = ENGINE and ENGINE.phase or nil,
        turn  = ENGINE and ENGINE.turn  or nil,
    },
    players_saved     = players_saved,
    dice_contest      = DICE_CONTEST,
    turn              = TURN,
    colorArmy1        = colorArmy1,
    colorArmy2        = colorArmy2,
    wounds_data       = wounds_data,
    deployment_armies = DEPLOYMENT and DEPLOYMENT.armies or nil,
    ief_front_width   = IEF_FRONT_WIDTH,
    ief_reform_used   = IEF_REFORM_USED,
    ief_move_budget   = IEF_MOVE_BUDGET,
    ief_pivot_budget  = IEF_PIVOT_BUDGET,
    ief_unit_button_base = IEF_UNIT_BUTTON_BASE,
    field_state = callHandler("field_serializeState"),
    ief_charge_queue = IEF_CHARGE_QUEUE,
    ief_charge_index = IEF_CHARGE_INDEX,
}

    return JSON.encode(saveData)
end

-- ============================================================
-- FUNZIONE: restoreState(save_state)
-- ============================================================
function main_restoreState(save_state)

    if not save_state or save_state == "" then return false end

    local ok, data = pcall(JSON.decode, save_state)
    if not ok or not data then
        print("restoreState: JSON decode fallito")
        return false
    end

    ENGINE = ENGINE or {}

    if data.engine then
        ENGINE.phase = data.engine.phase or ENGINE.phase
        ENGINE.turn  = data.engine.turn  or ENGINE.turn
    end

    players_saved = data.players_saved or {}

    if data.turn then
        TURN = data.turn
    end

    if data.dice_contest then
        DICE_CONTEST = data.dice_contest
    end

    if data.engine and data.engine.phase ~= "SITTING" then
        colorArmy1 = data.colorArmy1 or COLOR.NOARMY
        colorArmy2 = data.colorArmy2 or COLOR.NOARMY
    end
    
    if data.wounds_data then
        wounds_data = data.wounds_data
    end

    if data.deployment_armies then
        DEPLOYMENT = DEPLOYMENT or {}
        DEPLOYMENT.armies = data.deployment_armies
    end

    if data.ief_front_width then
        IEF_FRONT_WIDTH = data.ief_front_width
    end
    if data.ief_reform_used then
        IEF_REFORM_USED = data.ief_reform_used
    end
    if data.ief_move_budget then
        IEF_MOVE_BUDGET = data.ief_move_budget
    end
    if data.ief_pivot_budget then
        IEF_PIVOT_BUDGET = data.ief_pivot_budget
    end
    
    if data.ief_charge_queue then
        IEF_CHARGE_QUEUE = data.ief_charge_queue
    end

    if data.ief_charge_index then
        IEF_CHARGE_INDEX = data.ief_charge_index
    end
    if data.ief_unit_button_base then
        IEF_UNIT_BUTTON_BASE = data.ief_unit_button_base
    end

    if data.field_state then
        callHandler("field_restoreState", data.field_state)
    end

    Wait.time(function()
        callHandler("deployment_scanTable")
        callHandler("aggiornaSchedeUnita")
    end, 2)

    Wait.time(function()
        main_refreshAllBaseButtons()
    end, 2)

    return true
end

-- ============================================================
-- FUNZIONE: restorePlayersColors()
-- ============================================================
function main_restorePlayersColors()
    if not players_saved then return end

    local currentPlayers = Player.getPlayers()
    for _, saved in pairs(players_saved) do
        for _, p in ipairs(currentPlayers) do
            if tostring(p.steam_id) == tostring(saved.steam_id) then
                p.changeColor(saved.color)
            end
        end
    end
end
