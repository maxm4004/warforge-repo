    if not r then
        print("[IEF_DATA] Scenario non in cache: " .. tostring(nome) .. " — usare ief_loadScenario()")
    end
    return r
end
-- ============================================================
-- ============================================================
-- FUNZIONE: deployment_parseNickname()
-- Parser: "FP_1.3_ARCL" → {unitType="FP", unitNumber=1, baseSeq=3, weapon="ARCL"}
-- ============================================================
function main_parseNickname(nickname)

    if not nickname or nickname == "" then return nil end
    local unitType, unitNumber, baseSeq = string.match(nickname, "_([A-Z]+)_(%d+)%.(%d+)$")

    if not unitType then return nil end

    return {
        unitType   = unitType,
        unitNumber = tonumber(unitNumber),
        baseSeq    = tonumber(baseSeq)
    }
end
-- ============================================================
-- FUNZIONE: move_listUnits()
-- ============================================================
function main_listUnits()
    local unita = {}
    for _, obj in ipairs(getAllObjects()) do
        local info = main_parseNickname(obj.getName())
        if info then
            local objSlot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
            if objSlot then
                local unitKey = main_getUnitKey(obj)
                if not unita[unitKey] then
                    unita[unitKey] = {
                        count       = 0,
                        tipo        = info.unitType,
                        numero      = info.unitNumber,
                        slot        = objSlot,
                        nomeDisplay = obj.getDescription(),
                        nickname    = obj.getName(),
                    }
                end
                unita[unitKey].count = unita[unitKey].count + 1
            end
        end
    end

    -- print("[MOVIMENTO] Unità presenti sul tavolo:")
    -- for unitKey, dati in pairs(unita) do
    --     print(string.format("  %s  |  %s  |  \"%s\"  (basi=%d)",
    --         unitKey, dati.nickname, dati.nomeDisplay ~= "" and dati.nomeDisplay or "?", dati.count))
    -- end

    return unita
end
-- ============================================================
-- FUNZIONE: main_detectFormationSelected(player)
-- Wrapper da console: prende la selezione mouse corrente,
-- filtra per unitKey, rileva il fronte reale con
-- main_detectFormation() e lo stampa in console.
-- ============================================================
function main_detectFormationSelected(player)

    local selected = main_getSelectedObjects(player)
    if not selected or #selected < 1 then
        print("[DETECT] Nessuna base selezionata")
        return nil
    end

    local mover = selected[1]
    local moverSlot = mover.hasTag("Army1") and 1 or (mover.hasTag("Army2") and 2 or nil)
    if moverSlot == nil then
        print("[DETECT] La base selezionata non appartiene a nessun esercito")
        return nil
    end

    local baseInfo = main_parseNickname(mover.getName())
    if not baseInfo then
        print("[DETECT] Impossibile leggere il nickname della base")
        return nil
    end

    local unitKey = main_getUnitKey(mover)

    local basiObjs = {}
    for _, obj in ipairs(selected) do
        local info = main_parseNickname(obj.getName())
        if info then
            if main_getUnitKey(obj) == unitKey then
                table.insert(basiObjs, obj)
            end
        end
    end

    local fronte = main_detectFormation(basiObjs)
    local profondita = math.ceil(#basiObjs / fronte)

    print(string.format("[DETECT] Unità %s: %d basi totali, fronte rilevato = %d, profondità ≈ %d",
        unitKey, #basiObjs, fronte, profondita))

    return fronte
end
-- ============================================================
-- FUNZIONE: main_detectFormation(basiObjs)
-- Rileva il fronte ATTUALE dell'unità leggendo le posizioni
-- fisiche reali sul tavolo, invece di fidarsi di uno stato
-- memorizzato che può disallinearsi. Ritorna il numero di basi
-- nel rango più avanzato (il fronte).
-- ============================================================
function main_detectFormation(basiObjs)
    if not basiObjs or #basiObjs < 1 then return 1 end
    if #basiObjs == 1 then return 1 end

    local ref   = basiObjs[1]
    local fwd   = ref.getTransformForward()
    local fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()

    -- Proiezione di ogni base lungo il fronte
    local maxProj = -math.huge
    local projections = {}
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        table.insert(projections, proj)
        if proj > maxProj then maxProj = proj end
    end

    -- Conta quante basi condividono la proiezione massima (stesso rango frontale)
    local EPS = 0.5
    local count = 0
    for _, proj in ipairs(projections) do
        if math.abs(proj - maxProj) < EPS then
            count = count + 1
        end
    end

    return count
end
-- ============================================================
-- FUNZIONE: main_formationOpenFromButton(obj, player_color, alt_click)
-- Click sul pulsante 3D "Formazione" attaccato alla base
-- capitana. Popola IEF_FORM_UNITS[unitKey] e apre il pannello.
-- ============================================================
function main_formationOpenFromButton(obj, player_color, alt_click)
    local slot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
    if not slot then return end

    local unitKey = main_getUnitKey(obj)
    if not unitKey then return end

    local basiObjs = {}
    for _, o in ipairs(getAllObjects()) do
        if main_getUnitKey(o) == unitKey then
            table.insert(basiObjs, o)
        end
    end

    if #basiObjs == 0 then return end
    
    local vietato = main_moveForbiddenReason(unitKey)
    if vietato then
        warningToColor(vietato, Player[player_color], "Yellow", 5, true)
        return
    end
    main_cameraToUnitPanel(Player[player_color], basiObjs, 30, main_unitYaw(basiObjs), 15)

    IEF_FORM_UNITS[unitKey] = {
        basiObjs     = basiObjs,
        activePlayer = Player[player_color],
        panel3DObj   = obj,
    }

    -- Schieramento: stesso pannello unico Movimento + Formazione,
    -- con i bottoni di movimento spenti (Annulla vale anche qui).
    local startPos, startRot = {}, {}
    for _, b in ipairs(basiObjs) do
        startPos[b.getGUID()] = b.getPosition()
        startRot[b.getGUID()] = b.getRotation()
    end
    IEF_MOVE_UNITS[unitKey] = {
        basiObjs        = basiObjs,
        activePlayer    = Player[player_color],
        panel3DObj      = obj,
        startPos        = startPos,
        startRot        = startRot,
        startReformUsed = IEF_REFORM_USED[unitKey] or false,
        startFrontWidth = IEF_FRONT_WIDTH and IEF_FRONT_WIDTH[unitKey],
        history         = {},
        schieramento    = true,
        startYaw        = basiObjs[1].getRotation().y,
    }
    IEF_FORM_UNITS[unitKey].basiObjs = IEF_MOVE_UNITS[unitKey].basiObjs

    main_formationRedraw(unitKey)
end

-- ============================================================
-- FUNZIONE: main_formationRedraw(unitKey, sign)
-- Ricostruisce il pannello 3D dell'unità con label/pulsanti
-- aggiornati (abilitati/disabilitati secondo fase e tipo).
-- ============================================================
function main_formationRedraw(unitKey)
    main_syncAttachedGeneral(unitKey)
    -- Pannello unico Movimento + Formazione (fase MOVE)
    if IEF_MOVE_UNITS and IEF_MOVE_UNITS[unitKey] then
        move_redraw(unitKey)
        return
    end
    local state = IEF_FORM_UNITS[unitKey]
    if not state or not state.panel3DObj or not state.basiObjs then return end
    if state.panel3DObj.isDestroyed() then
        IEF_FORM_UNITS[unitKey] = nil
        return
    end

    local basiObjs = state.basiObjs
    local baseInfo = main_parseNickname(basiObjs[1].getName())
    local tipo = baseInfo and baseInfo.unitType
    local inMovePhase = (TURN.phase == "MOVE")
    local reformUsed  = IEF_REFORM_USED[unitKey] or false

    local fronteAttuale = main_detectFormation(basiObjs)
    local x, y, z = main_calcolaPosizionePannello(fronteAttuale, #basiObjs)

    local panel3D = state.panel3DObj
    local labelText = string.format("%s — Fronte: %d", unitKey, fronteAttuale)
    panel3D.UI.setXml(main_buildFormationPanel3DXml(unitKey, x, y, z, state.activePlayer.color, labelText))

    Wait.frames(function()
    if not panel3D.isDestroyed() then
        --panel3D.UI.setAttribute("panelForm_" .. unitKey, "position", string.format("%f 0 %f", x, z))
    end
    end, 3)

    local function canDo(manovra)
        if not inMovePhase then return true end
        return tipo and main_canManeuver(manovra, tipo)
    end
    local function turnOk()
        if not inMovePhase then return true end
        return IEF_FORM_TEST_MODE or (not reformUsed and not main_unitHasMoved(unitKey))
    end

    local inRotta = inMovePhase and main_getCohesion(unitKey) == COHESION.ROT
    local reformOk = (canDo("espandi_contrai_1_2_basi_fermi") and turnOk()) or inRotta
    local espandiOk = reformOk and not inRotta
    local fronte180Ok = canDo("cambio_fronte_180_fermi") and turnOk() and not inRotta
    local isRettangolare = (#basiObjs % fronteAttuale == 0)
    local fronte90Ok = canDo("cambio_fronte_90_fermi") and isRettangolare and turnOk() and not inRotta
    local sistemaOk = turnOk()

    local COLOR_ON  = "rgba(0.45,0.45,0.45,1)"
    local COLOR_OFF = "rgba(0.2,0.2,0.2,0.5)"

    Wait.frames(function()
        if panel3D.isDestroyed() then return end
        local function setBtn(id, ok)
            panel3D.UI.setAttribute(id, "interactable", ok and "true" or "false")
            panel3D.UI.setAttribute(id, "color", ok and COLOR_ON or COLOR_OFF)
            Wait.frames(function()
                if not panel3D.isDestroyed() then
                    panel3D.UI.setAttribute(id, "textColor", "White")
                end
            end, 1)
        end
        setBtn("btn_" .. unitKey .. "_FrontMinus2", reformOk)
        setBtn("btn_" .. unitKey .. "_FrontMinus1", reformOk)
        setBtn("btn_" .. unitKey .. "_FrontPlus1",  espandiOk)
        setBtn("btn_" .. unitKey .. "_FrontPlus2",  espandiOk)
        setBtn("btn_" .. unitKey .. "_Cambio90Sx",  fronte90Ok)
        setBtn("btn_" .. unitKey .. "_Cambio90Dx",  fronte90Ok)
        setBtn("btn_" .. unitKey .. "_Cambio180",   fronte180Ok)
        setBtn("btn_" .. unitKey .. "_Sistema",     sistemaOk)
    end, 5)
end
-- ============================================================
-- FUNZIONE: main_formationCloseUnit(unitKey)
-- Chiude il pannello 3D dell'unità e pulisce lo stato.
-- ============================================================
function main_formationCloseUnit(unitKey)
    local state = IEF_FORM_UNITS[unitKey]
    if not state then return end

    if state.basiObjs then
        for _, obj in ipairs(state.basiObjs) do
            obj.highlightOff()
        end
    end
    if state.panel3DObj and not state.panel3DObj.isDestroyed() then
        state.panel3DObj.UI.setXml("")
    end

    IEF_FORM_UNITS[unitKey] = nil
end

-- ============================================================
-- FUNZIONE: main_ricostruisciFormazione(basiObjs, fronte)
-- ============================================================
function main_ricostruisciFormazione(basiObjs, fronte)

    if not basiObjs or #basiObjs < 1 then return false end
    if not fronte or fronte < 1 then fronte = #basiObjs end
    if fronte > #basiObjs then fronte = #basiObjs end

    local refObj = basiObjs[1]
    local refSeq = nil
    for _, obj in ipairs(basiObjs) do
        local info = main_parseNickname(obj.getName())
        local seq  = info and info.baseSeq
        if seq and (refSeq == nil or seq < refSeq) then
            refSeq = seq
            refObj = obj
        end
    end

    local fwd    = refObj.getTransformForward()
    local fwdXZ  = Vector(fwd.x, 0, fwd.z):normalized()
    local right  = Vector(fwdXZ.z, 0, -fwdXZ.x)

    local maxProj = -math.huge
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        if proj > maxProj then maxProj = proj end
    end
    local EPS = 0.5
    local frontRank = {}
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        if math.abs(proj - maxProj) < EPS then
            table.insert(frontRank, obj)
        end
    end
    table.sort(frontRank, function(a, b)
        local pa, pb = a.getPosition(), b.getPosition()
        return (pa.x*right.x + pa.z*right.z) < (pb.x*right.x + pb.z*right.z)
    end)
    local leftPos   = frontRank[1].getPosition()
    local rightPos  = frontRank[#frontRank].getPosition()
    local centerPos = Vector((leftPos.x+rightPos.x)/2, leftPos.y, (leftPos.z+rightPos.z)/2)

    table.sort(basiObjs, function(a, b)
        local ia = main_parseNickname(a.getName())
        local ib = main_parseNickname(b.getName())
        return (ia and ia.baseSeq or 0) < (ib and ib.baseSeq or 0)
    end)

    local baseInfoAnchor = main_parseNickname(refObj.getName())
    local unitTypeDataAnchor = baseInfoAnchor and main_getUnitType(baseInfoAnchor.unitType)
    -- F27: stessi giochi dello spawn (prima RIORDINA, chiamato
    -- anche a fine spawn, rimetteva i ranghi a 0.03 e annullava il
    -- gioco dello schieramento).
    local HGAP = IEF_FILE_GAP
    local VGAP = IEF_RANK_GAP
    local width = (unitTypeDataAnchor and unitTypeDataAnchor.base_width_cm or 4) * CM_TO_TTS + HGAP
    local depth = (unitTypeDataAnchor and unitTypeDataAnchor.base_depth_cm or 3) * CM_TO_TTS + VGAP

    local totalBasi   = #basiObjs
    local ranghiPieni = math.floor(totalBasi / fronte)
    local resto       = totalBasi % fronte

    local halfSpan = (fronte - 1) * width / 2
    local startPos = Vector(
        centerPos.x - right.x*halfSpan,
        leftPos.y,
        centerPos.z - right.z*halfSpan
    )

    for i, obj in ipairs(basiObjs) do
        local idx  = i - 1
        local rank = math.floor(idx / fronte)
        local col  = idx % fronte

        if resto == 2 and rank == ranghiPieni then
            local posizioneNelResto = idx - (ranghiPieni * fronte)
            col = (posizioneNelResto == 0) and 0 or (fronte - 1)
        end

        -- Rotazione finale PIANA: solo l'orientamento Y della base di
        -- riferimento (prima si copiava anche l'inclinazione presa
        -- sulla collina, e le basi si alzavano).
        local refRot = refObj.getRotation()
        main_setPositionOnGround(obj,
            startPos.x + right.x*(col*width) - fwdXZ.x*(rank*depth),
            startPos.z + right.z*(col*width) - fwdXZ.z*(rank*depth),
            math.rad(obj.getRotation().y - refRot.y))
        obj.setRotation(Vector(0, refRot.y, 0))
    end

    return true
end

-- ============================================================
-- FUNZIONE: main_espandiContraiCore(unitKey, deltaFronte)
-- ============================================================
function main_espandiContraiCore(unitKey, deltaFronte)
    local state = IEF_FORM_UNITS[unitKey]
    if not state or not state.basiObjs or #state.basiObjs < 2 then return false end
    local basiObjs = state.basiObjs
    local player = state.activePlayer

    local baseInfo = main_parseNickname(basiObjs[1].getName())
    if not baseInfo then return false end

    if not main_formationCanStart(unitKey, "espandi_contrai_1_2_basi_fermi", baseInfo.unitType, player) then
        return false
    end
    if deltaFronte > 0 and TURN.phase == "MOVE" and main_getCohesion(unitKey) == COHESION.ROT then
        if player then printToColor("[FORMAZIONE] Unità in rotta: può solo contrarre il fronte", player.color, {r=1,g=0.6,b=0}) end
        return false
    end

    local fronteAttuale = main_detectFormation(basiObjs)
    local newFront = fronteAttuale + deltaFronte
    if newFront < 1 then newFront = 1 end
    if newFront > #basiObjs then newFront = #basiObjs end

    main_ricostruisciFormazione(basiObjs, newFront)

    IEF_FRONT_WIDTH[unitKey] = newFront
    main_formationAfter(unitKey, "espandi_contrai_1_2_basi_e_muovi", baseInfo.unitType)

    main_riposizionaPulsanteFormazione(unitKey, basiObjs)
    main_formationRedraw(unitKey)
    return true
end

-- ============================================================
-- FUNZIONE: main_cambioFronte180Core(unitKey)
-- ============================================================
function main_cambioFronte180Core(unitKey)
    local state = IEF_FORM_UNITS[unitKey]
    if not state or not state.basiObjs then return false end
    local basiObjs = state.basiObjs
    local player = state.activePlayer

    local baseInfo = main_parseNickname(basiObjs[1].getName())
    if not baseInfo then return false end
    if not main_formationCanStart(unitKey, "cambio_fronte_180_fermi", baseInfo.unitType, player) then
        return false
    end

    local sumX, sumY, sumZ = 0, 0, 0
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        sumX, sumY, sumZ = sumX+p.x, sumY+p.y, sumZ+p.z
    end
    local n = #basiObjs
    local center = Vector(sumX/n, sumY/n, sumZ/n)

    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        main_setPositionOnGround(obj, 2*center.x - p.x, 2*center.z - p.z)
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y + 180, rot.z))
    end

    main_formationAfter(unitKey, "cambio_fronte_180_e_muovi", baseInfo.unitType)
    main_riposizionaPulsanteFormazione(unitKey, basiObjs)
    main_formationRedraw(unitKey)
    return true
end
-- ============================================================
-- FUNZIONE: main_sistemaFormazioneCore(unitKey)
-- "Ripara" la formazione al fronte attualmente rilevato.
-- ============================================================
function main_sistemaFormazioneCore(unitKey, basiObjs)
    IEF_FORM_UNITS[unitKey] = basiObjs
    local fronte = main_detectFormation(basiObjs)
    main_ricostruisciFormazione(basiObjs, fronte)
    main_riposizionaPulsanteFormazione(unitKey, basiObjs)
    main_formationRedraw(unitKey)
    return true
end
-- ============================================================
-- Wrapper pulsanti UI 3D — TTS passa (player, value, id);
-- l'unitKey si estrae dall'id del pulsante (unico per unità).
-- ============================================================
-- Nel pannello unico ogni manovra riuscita entra nella cronologia
-- di Annulla (fotografia presa PRIMA della manovra).
local function formOp(unitKey, fn)
    local state = IEF_MOVE_UNITS and IEF_MOVE_UNITS[unitKey]
    if state and move_manualOff then move_manualOff(unitKey) end
    local snap = state and move_snapshot(unitKey)
    if fn() and snap then
        -- F32: la manovra non può far finire l'unità in terreno
        -- vietato (non in schieramento né in rotta)
        if not state.schieramento and not state.rotta and not IEF_MOVE_TEST_MODE then
            local f, cat = main_unitTerrainFactorNow(unitKey)
            if f >= IEF_TERRAIN_BLOCK then
                move_restoreSnapshot(unitKey, snap)
                if state.activePlayer then
                    warningToColor(string.format("Manovra impossibile: l'unita' finirebbe nel terreno %s", tostring(cat)),
                        state.activePlayer, "Yellow", 5, true)
                end
                move_redraw(unitKey)
                main_formationCamera(unitKey)
                return
            end
        end
        state.history = state.history or {}
        table.insert(state.history, snap)
        move_redraw(unitKey)
        main_formationCamera(unitKey)
    end
end

-- Telecamera dopo un cambio di fronte: ruota insieme all'unità
-- (yaw di partenza dell'esercito + rotazione fatta dall'apertura
-- del pannello), così il pannello resta davanti al giocatore.
function main_formationCamera(unitKey)
    local state = IEF_MOVE_UNITS and IEF_MOVE_UNITS[unitKey]
    if not state or not state.activePlayer or not state.basiObjs or not state.basiObjs[1] then return end
    local b = state.basiObjs[1]
    local slot = b.hasTag("Army1") and 1 or (b.hasTag("Army2") and 2 or nil)
    if not slot then return end
    Wait.frames(function()
        main_cameraToUnitPanel(state.activePlayer, state.basiObjs, 30, main_unitYaw(state.basiObjs), 15)
    end, 5)
end
function main_frontMinus2(player, value, id)
    local unitKey = id:match("^btn_(.+)_FrontMinus2$")
    if unitKey then formOp(unitKey, function() return main_espandiContraiCore(unitKey, -2) end) end
end
function main_frontMinus1(player, value, id)
    local unitKey = id:match("^btn_(.+)_FrontMinus1$")
    if unitKey then formOp(unitKey, function() return main_espandiContraiCore(unitKey, -1) end) end
end
function main_frontPlus1(player, value, id)
    local unitKey = id:match("^btn_(.+)_FrontPlus1$")
    if unitKey then formOp(unitKey, function() return main_espandiContraiCore(unitKey, 1) end) end
end
function main_frontPlus2(player, value, id)
    local unitKey = id:match("^btn_(.+)_FrontPlus2$")
    if unitKey then formOp(unitKey, function() return main_espandiContraiCore(unitKey, 2) end) end
end
function main_cambioFronte90Sx(player, value, id)
    local unitKey = id:match("^btn_(.+)_Cambio90Sx$")
    if unitKey then formOp(unitKey, function() return main_cambioFronte90Core(unitKey, "left") end) end
end
function main_cambioFronte90Dx(player, value, id)
    local unitKey = id:match("^btn_(.+)_Cambio90Dx$")
    if unitKey then formOp(unitKey, function() return main_cambioFronte90Core(unitKey, "right") end) end
end
function main_cambioFronte180(player, value, id)
    local unitKey = id:match("^btn_(.+)_Cambio180$")
    if unitKey then formOp(unitKey, function() return main_cambioFronte180Core(unitKey) end) end
end

-- ============================================================
-- FUNZIONE: main_formationButtonStates(unitKey, basiObjs)
-- Quali manovre di formazione sono consentite ora (stesse regole
-- di main_formationRedraw / main_formationCanStart).
-- ============================================================
function main_formationButtonStates(unitKey, basiObjs)
    local baseInfo = main_parseNickname(basiObjs[1].getName())
    local tipo = baseInfo and baseInfo.unitType
    local inMovePhase = (TURN.phase == "MOVE")
    local function canDo(manovra)
        if not inMovePhase then return true end
        return tipo and main_canManeuver(manovra, tipo)
    end
    local turnOk = (not inMovePhase) or IEF_FORM_TEST_MODE
        or (not IEF_REFORM_USED[unitKey] and not main_unitHasMoved(unitKey))
    local fronte = main_detectFormation(basiObjs)
    local inRotta = inMovePhase and main_getCohesion(unitKey) == COHESION.ROT
    local multi = #basiObjs >= 2
    local contraiOk = multi and ((canDo("espandi_contrai_1_2_basi_fermi") and turnOk) or inRotta)
    return {
        contrai   = contraiOk,
        espandi   = contraiOk and not inRotta,
        fronte90  = multi and canDo("cambio_fronte_90_fermi") and (#basiObjs % fronte == 0) and turnOk and not inRotta,
        fronte180 = canDo("cambio_fronte_180_fermi") and turnOk and not inRotta,
        usata     = IEF_REFORM_USED[unitKey] == true,
        fronte    = fronte,
    }
end
function main_formationClose(player, value, id)
    local unitKey = id:match("^btn_(.+)_Close$")
    if unitKey then main_formationCloseUnit(unitKey) end
end

-- ============================================================
-- FUNZIONE: main_updateLoadingBar(slot, pct, label)
-- ============================================================
function main_updateLoadingBar(slot, pct, label)
    local s = tostring(slot)
    UI.setAttribute("loadingPanel_" .. s, "active", pct < 100 and "true" or "false")
    UI.setAttribute("loadingBar_" .. s, "percentage", pct)
    UI.setAttribute("loadingLabel_" .. s, "text", label)
end

-- ============================================================
-- FUNZIONE: main_movementOpenFromButton(obj, player_color, alt_click)
-- Click sul pulsante 3D "Muovi" attaccato alla base capitana.
-- ============================================================
function main_movementOpenFromButton(obj, player_color, alt_click)

    local slot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
    if not slot then return end

    local unitKey = main_getUnitKey(obj)
    if not unitKey then return end

    local basiObjs = {}
    for _, o in ipairs(getAllObjects()) do
        if main_getUnitKey(o) == unitKey then
            table.insert(basiObjs, o)
        end
    end

    if #basiObjs == 0 then return end

    -- Unità in ROTTA: solo la prosecuzione della rotta (obbligatoria,
    -- senza raggio di comando), una volta, se non è andata in rotta
    -- in questo turno.
    local inRotta = ENGINE.phase == PHASE.MOVE and not main_isGeneralKey(unitKey)
                    and main_getCohesion(unitKey) == COHESION.ROT
    if inRotta and not main_routContinueItem(unitKey) then
        local msg = main_isRoutedThisTurn(unitKey)
            and "Unita' andata in rotta in questo turno: ha gia' fatto la fuga"
            or  "Prosecuzione della rotta gia' eseguita"
        warningToColor(msg, Player[player_color], "Yellow", 5, true)
        return
    end

    local vietato = (not inRotta) and main_moveForbiddenReason(unitKey)
    if vietato then
        warningToColor(vietato, Player[player_color], "Yellow", 5, true)
        return
    end

    -- Regolamento: per muovere l'unità deve essere nel raggio di
    -- comando di un Generale (Generali esclusi)
    if ENGINE.phase == PHASE.MOVE and not main_isGeneralKey(unitKey) and not inRotta then
        local inRaggio = false
        for _, b in ipairs(basiObjs) do
            if main_isInCommandRange(b, slot) then inRaggio = true break end
        end
        if not inRaggio then
            warningToColor("Unita' fuori dal raggio di comando: non puo' muovere", Player[player_color], "Yellow", 5, true)
            return
        end
    end

    if IEF_MOVE_BUDGET[unitKey] == nil or IEF_MOVE_TEST_MODE then
        local unitTypesDict = IEF_DATA.unitTypes and (IEF_DATA.unitTypes.unit_types or IEF_DATA.unitTypes)
        local baseInfo = main_parseNickname(obj.getName())
        local tipoMovimento = main_isGeneralKey(unitKey) and "GEN" or (baseInfo and baseInfo.unitType)
        local typeData = unitTypesDict and tipoMovimento and unitTypesDict[tipoMovimento]
        IEF_MOVE_BUDGET[unitKey] = typeData and typeData.move_inches or 0
    end
    if IEF_PIVOT_BUDGET[unitKey] == nil or IEF_MOVE_TEST_MODE then
        IEF_PIVOT_BUDGET[unitKey] = 3
    end

    -- Mossa già completata in questo turno (budget esaurito, anche da
    -- un cambio di formazione che consuma la mossa): avviso e stop.
    if not inRotta and not IEF_MOVE_TEST_MODE and (IEF_MOVE_BUDGET[unitKey] or 0) <= 0.001 then
        warningToColor("Movimento gia' eseguito in questo turno", Player[player_color], "Yellow", 5, true)
        return
    end

    main_cameraToUnitPanel(Player[player_color], basiObjs, 30, main_unitYaw(basiObjs), 15)

    local startPos, startRot = {}, {}
    for _, b in ipairs(basiObjs) do
        startPos[b.getGUID()] = b.getPosition()
        startRot[b.getGUID()] = b.getRotation()
    end

    IEF_MOVE_UNITS[unitKey] = {
        basiObjs     = basiObjs,
        activePlayer = Player[player_color],
        panel3DObj   = obj,
        lineHost     = nil,
        startPos     = startPos,
        startRot     = startRot,
        startBudget      = IEF_MOVE_BUDGET[unitKey],
        startPivotBudget = IEF_PIVOT_BUDGET[unitKey],
        startReformUsed  = IEF_REFORM_USED[unitKey] or false,
        startFrontWidth  = IEF_FRONT_WIDTH and IEF_FRONT_WIDTH[unitKey],
        startYaw         = basiObjs[1].getRotation().y,
        history      = {},
        rotta        = inRotta or nil,
        amicheRotta  = inRotta and {} or nil,
    }
    -- Pannello unico: le manovre di formazione lavorano sulle
    -- stesse basi e sullo stesso pannello
    IEF_FORM_UNITS[unitKey] = {
        basiObjs     = basiObjs,
        activePlayer = Player[player_color],
        panel3DObj   = obj,
    }

    move_redraw(unitKey)
end
-- ============================================================
-- FUNZIONE: main_calcolaPosizionePannello(fronte, totalBasi, tipo, isMovimento)
-- ============================================================
function main_calcolaPosizionePannello(fronte, totalBasi)
    fronte = tonumber(fronte)
    totalBasi = tonumber(totalBasi)
    if not fronte or fronte < 1 then fronte = 1 end
    if not totalBasi or totalBasi < 1 then totalBasi = fronte end

    local x
    if fronte == 1 then x = 10
        elseif fronte == 2 then x = 150 
        elseif fronte == 3 then x = 310
        elseif fronte == 4 then x = 470
        elseif fronte == 5 then x = 630
        elseif fronte == 6 then x = 800
        elseif fronte == 7 then x = 960
        elseif fronte == 8 then x = 1120
        else x = 10 - 160 * (fronte - 1)   -- fallback per fronti oltre 8, mai misurati
    end

    --if sign then x = x * -1 end
    local y = 100
    local z = -500
    return x, y, z
end
-- ============================================================
-- FUNZIONE: main_trovaBaseAngoloLibero(basiObjs)
-- ============================================================
function main_trovaBaseAngoloLibero(basiObjs)
    local refObj = basiObjs[1]
    local refSeq = nil
    for _, obj in ipairs(basiObjs) do
        local info = main_parseNickname(obj.getName())
        local seq  = info and info.baseSeq
        if seq and (refSeq == nil or seq < refSeq) then
            refSeq = seq
            refObj = obj
        end
    end

    local fwd   = refObj.getTransformForward()
    local fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()
    local right = Vector(fwdXZ.z, 0, -fwdXZ.x)

    -- Rango posteriore: proiezione minima lungo fwdXZ (il più
    -- lontano dal nemico, quindi mai coperto da altri ranghi)
    local minProj = math.huge
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        if proj < minProj then minProj = proj end
    end

    local EPS = 0.5
    local rangoPosteriore = {}
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        if math.abs(proj - minProj) < EPS then
            table.insert(rangoPosteriore, obj)
        end
    end

    -- Dentro il rango posteriore, la base più a sinistra
    local baseScelta = rangoPosteriore[1]
    local minRight = math.huge
    for _, obj in ipairs(rangoPosteriore) do
        local p = obj.getPosition()
        local projRight = p.x*right.x + p.z*right.z
        if projRight < minRight then
            minRight = projRight
            baseScelta = obj
        end
    end

    return baseScelta
end
-- ============================================================
-- FUNZIONE: main_riposizionaPulsanteFormazione(unitKey, basiObjs)
-- Ricalcola la base "angolo libero" e sposta lì i pulsanti 3D,
-- se è cambiata rispetto a prima.
-- ============================================================
function main_riposizionaPulsanteFormazione(unitKey, basiObjs)
    local nuovaBase = main_trovaBaseAngoloLibero(basiObjs)
    local nuovoGuid = nuovaBase.getGUID()
    local vecchioGuid = IEF_UNIT_BUTTON_BASE[unitKey]

    if vecchioGuid == nuovoGuid then return end

    if vecchioGuid then
        local vecchiaBase = getObjectFromGUID(vecchioGuid)
        if vecchiaBase then
            vecchiaBase.clearButtons()
        end
    end
   
    main_createBaseButtons(nuovaBase, TURN.phase, unitKey)
    IEF_UNIT_BUTTON_BASE[unitKey] = nuovoGuid

    -- Se il pannello era aperto su una base diversa da quella nuova, chiudi il vecchio prima di spostare il riferimento
    local formState = IEF_FORM_UNITS[unitKey]
    if formState and formState.panel3DObj and formState.panel3DObj ~= nuovaBase then
        if not formState.panel3DObj.isDestroyed() then
            formState.panel3DObj.UI.setXml("")
        end
        formState.panel3DObj = nuovaBase
    end

    local moveState = IEF_MOVE_UNITS[unitKey]
    if moveState and moveState.panel3DObj and moveState.panel3DObj ~= nuovaBase then
        if not moveState.panel3DObj.isDestroyed() then
            moveState.panel3DObj.UI.setXml("")
        end
        moveState.panel3DObj = nuovaBase
    end
end

-- ============================================================
-- FUNZIONE: main_getUnitKey(obj)
-- Identificativo univoco di unità: il nickname della base SENZA
-- il numero di sequenza finale (.seq). Es. "ANG_HUSCARL_FP_1.3"
-- -> "ANG_HUSCARL_FP_1". Fonte di verità UNICA per unitKey in
-- tutto il progetto — non costruirlo mai a mano altrove.
-- ============================================================
function main_getUnitKey(obj)
    if not obj then return nil end
    -- Tra parentesi: gsub ritorna DUE valori (stringa, numero di
    -- sostituzioni). Senza parentesi, in TTS (MoonSharp) usata come
    -- chiave di tabella -- es. { [main_getUnitKey(b)] = true } --
    -- la chiave diventa una tupla e non vale più come la stringa:
    -- così la FL non veniva esclusa dagli ostacoli del suo stesso tiro.
    return (obj.getName():gsub("%.%d+$", ""))
end

-- ============================================================
-- FUNZIONE: main_buildFormationPanel3DXml(unitKey, x, z, colore, labelText)
-- Pannello 3D Formazione: 2 righe da 4 pulsanti + Chiudi a
-- piena larghezza. ID pulsanti unici per unitKey.
-- ============================================================
function main_buildFormationPanel3DXml(unitKey, x, y, z, colore, labelText)
    return string.format([[
        <Panel id="panelForm_%s" active="true" color="rgba(0,0,0,0.85)" width="600" height="400" offsetXY="0 300" position="%f %f %f" rotation="-90 0 0" visibility="%s">
            <VerticalLayout spacing="10" padding="20 20 20 20" childAlignment="MiddleCenter">
                <Text text="%s" fontStyle="Bold" font="warforge_font" fontSize="22" color="Orange" alignment="MiddleCenter" width="560" height="35"/>
                <HorizontalLayout spacing="10" childAlignment="MiddleCenter">
                    <Button id="btn_%s_FrontMinus2" text="Fronte -2" font="warforge_font" fontStyle="Bold" fontSize="16" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="130" height="30" onClick="Global/main_frontMinus2"/>
                    <Button id="btn_%s_FrontMinus1" text="Fronte -1" font="warforge_font" fontStyle="Bold" fontSize="16" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="130" height="30" onClick="Global/main_frontMinus1"/>
                    <Button id="btn_%s_FrontPlus1"  text="Fronte +1" font="warforge_font" fontStyle="Bold" fontSize="16" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="130" height="30" onClick="Global/main_frontPlus1"/>
                    <Button id="btn_%s_FrontPlus2"  text="Fronte +2" font="warforge_font" fontStyle="Bold" fontSize="16" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="130" height="30" onClick="Global/main_frontPlus2"/>
                </HorizontalLayout>
                <HorizontalLayout spacing="10" childAlignment="MiddleCenter">
                    <Button id="btn_%s_Cambio90Sx" text="90° Sn"   font="warforge_font" fontStyle="Bold" fontSize="16" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="130" height="30" onClick="Global/main_cambioFronte90Sx"/>
                    <Button id="btn_%s_Cambio90Dx" text="90° Dx"   font="warforge_font" fontStyle="Bold" fontSize="16" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="130" height="30" onClick="Global/main_cambioFronte90Dx"/>
                    <Button id="btn_%s_Cambio180"  text="180°"    font="warforge_font" fontStyle="Bold" fontSize="16" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="130" height="30" onClick="Global/main_cambioFronte180"/>
                </HorizontalLayout>
                <Button id="btn_%s_Close" text="Chiudi" font="warforge_font" fontStyle="Bold" fontSize="18" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="560" height="30" onClick="Global/main_formationClose"/>
            </VerticalLayout>
        </Panel>
    ]], unitKey, x, y, z, colore, labelText, unitKey, unitKey, unitKey, unitKey, unitKey, unitKey, unitKey, unitKey, unitKey)
end

-- ============================================================
-- FUNZIONE: main_buildMovementPanel3DXml(unitKey, x, y, z, colore, titolo, info)
-- Pannello 3D unico MOVIMENTO + FORMAZIONE (grafica nuova:
-- sfondo 70%, oro per titolo e sezioni). ID pulsanti unici per
-- unitKey; lo stato (attivo/spento) lo imposta move_redraw.
-- ============================================================
MOVEPANEL = {
    width   = 760,
    bg      = "rgba(0,0,0,0.70)",
    font    = "warforge_font",
    gold    = "#FFD833",
    grey    = "#BBBBBB",
    btnOn   = "#B8902E",
    btnOff  = "rgba(0.25,0.25,0.25,0.6)",
    undo1   = "#8A5A1E",
    undo2   = "#8A2E2E",
    close   = "rgba(0.35,0.35,0.35,1)",
}
function main_buildMovementPanel3DXml(unitKey, x, y, z, colore, titolo, info)
    local P = MOVEPANEL
    local function btn(suffisso, testo, onClick, larghezza, colore2)
        return string.format('<Button id="btn_%s_%s" text="%s" font="%s" fontStyle="Bold" fontSize="16" color="%s" textColor="White" preferredWidth="%d" preferredHeight="34" onClick="Global/%s"/>',
            unitKey, suffisso, testo, P.font, colore2 or P.btnOn, larghezza, onClick)
    end
    local function sezione(testo)
        return string.format('<Text text="%s" font="%s" fontStyle="Bold" fontSize="15" color="%s" alignment="MiddleLeft" preferredHeight="22"/>', testo, P.font, P.gold)
    end
    local function riga(contenuto)
        return '<HorizontalLayout spacing="8" childAlignment="MiddleCenter" childForceExpandWidth="false" preferredHeight="34">' .. contenuto .. '</HorizontalLayout>'
    end
    return string.format([[
        <Panel id="panelMove_%s" active="true" color="%s" width="%d" height="470" offsetXY="0 385" position="%f %f %f" rotation="-90 0 0" visibility="%s">
            <VerticalLayout spacing="6" padding="20 20 16 16" childAlignment="UpperCenter" childForceExpandHeight="false">
                <Text text="%s" font="%s" fontStyle="Bold" fontSize="22" color="%s" alignment="MiddleCenter" preferredHeight="30"/>
                <Text text="%s" font="%s" fontSize="15" color="%s" alignment="MiddleCenter" preferredHeight="22"/>
                %s %s %s %s %s %s
                <Button id="btn_%s_Close" text="Chiudi" font="%s" fontStyle="Bold" fontSize="18" color="%s" textColor="White" preferredHeight="34" onClick="Global/move_btnClose"/>
            </VerticalLayout>
        </Panel>
        ]], unitKey, P.bg, P.width, x, y, z, colore,
        titolo, P.font, P.gold,
        info, P.font, P.grey,
        sezione("MOVIMENTO"),
        riga(btn("MoveManual", "Avanti", "move_btnManual", 172) .. btn("MoveMax", "Avanti Max", "move_btnMoveMax", 172)
          .. btn("PivotSx", "Perno Sn", "move_btnPivotSx", 172) .. btn("PivotDx", "Perno Ds", "move_btnPivotDx", 172)),
        sezione("FORMAZIONE"),
        riga(btn("FrontMinus2", "Fronte -2", "main_frontMinus2", 120) .. btn("FrontMinus1", "Fronte -1", "main_frontMinus1", 120)
          .. btn("FrontPlus1", "Fronte +1", "main_frontPlus1", 120) .. btn("FrontPlus2", "Fronte +2", "main_frontPlus2", 120)),
        riga(btn("Cambio90Sx", "90° Sn", "main_cambioFronte90Sx", 160) .. btn("Cambio90Dx", "90° Ds", "main_cambioFronte90Dx", 160)
          .. btn("Cambio180", "180°", "main_cambioFronte180", 160)),
        riga(btn("UndoLast", "Annulla Ultimo", "move_btnUndoLast", 330, P.undo1) .. btn("UndoAll", "Annulla Tutto", "move_btnUndoAll", 330, P.undo2)),
        unitKey, P.font, P.close)
end
-- ============================================================
-- FUNZIONE: main_getChildOffsets()
-- ============================================================
function main_getChildOffsets(player)
    
    local sel = player.getSelectedObjects()
    if not sel or #sel < 1 then
        print("[OFFSET] Seleziona la base")
        return
    end

    local base = sel[1]
    local ok, jsonStr = pcall(function() return base.getJSON() end)
    if not ok or not jsonStr then
        print("[OFFSET] Errore getJSON")
        return
    end

    local data = JSON.decode(jsonStr)
    if not data then
        print("[OFFSET] Errore JSON.decode")
        return
    end

    print("[OFFSET] Base: " .. base.getName())

    local states = data.States or {}
    local attached = data.AttachedObjects or data.ContainedObjects or {}

    if #attached == 0 then
        -- prova ChildObjects
        attached = data.ChildObjects or {}
    end

    print("[OFFSET] Attachment trovati: " .. #attached)

    for i, child in ipairs(attached) do
        local t = child.Transform or {}
        local pos = t.posX and t or (child.Position or {})
        local x = pos.posX or pos.x or 0
        local y = pos.posY or pos.y or 0
        local z = pos.posZ or pos.z or 0

        print(string.format(
            "[%d] \'%.2f\' \'%.2f\' \'%.2f\'",
            i, x, y, z
        ))
    end
end
-- ============================================================
-- FUNZIONE: main_getUnitBases(unitKey)
-- Tutte le basi sul tavolo che condividono lo stesso unitKey.
-- Motore condiviso: usato da Carica, Tiro, Mischia, Recupero.
-- ============================================================
function main_getUnitBases(unitKey)
    local bases = {}
    for _, o in ipairs(getAllObjects()) do
        if main_getUnitKey(o) == unitKey then
            table.insert(bases, o)
        end
    end
    return bases
end

-- ============================================================
-- FUNZIONE: main_getUnitMeta(obj)
-- Legge i metadata scritti in GMNotes da deployment_applyBaseMetadata
-- (unitType, morale, armi, capabilities, ecc.). Ritorna nil se
-- la base non ha metadata IEF validi.
-- ============================================================
function main_getUnitMeta(obj)
    if not obj then return nil end
    local raw = obj.getGMNotes()
    if not raw or raw == "" then return nil end
    local ok, meta = pcall(JSON.decode, raw)
    if not ok or not meta then return nil end
    return meta
end

-- ============================================================
-- FUNZIONE: main_testMorale(unitKey, player, situazione, modificatori, callback)
-- Motore condiviso Test di Morale (2D6 + modificatori vs soglia
-- di morale_levels[livello].threshold). Riusa il motore dadi
-- fisico (engine_diceThrowFromBag), stesso schema di
-- field_doRollFieldElement in 2_field/lib.ttslua.
--
-- unitKey:       unità che effettua il test
-- player:        Player che tira (per camera e messaggi)
-- situazione:    "per_riordinare" | "per_caricare" | "altre_situazioni"
--                (solo per il testo effetto da morale_effects)
-- modificatori:  somma numerica già calcolata dal chiamante
--                (main_getMoraleModifier per le chiavi applicabili)
-- callback(esito, somma, soglia, effetto)
--   esito: "SUPERATO" | "FALLITO" | nil (in caso di errore)
-- ============================================================
function main_testMorale(unitKey, player, situazione, modificatori, callback)

    local slot = main_getArmyByColor(player)
    if not slot then
        print("[MORALE] Player non riconosciuto")
        if callback then callback(nil, nil, nil, nil) end
        return
    end

    local bases = main_getUnitBases(unitKey)
    if #bases == 0 then
        print("[MORALE] Nessuna base trovata per " .. tostring(unitKey))
        if callback then callback(nil, nil, nil, nil) end
        return
    end

    local meta = main_getUnitMeta(bases[1])
    local livello = meta and meta.morale
    local moraleData = livello and main_getMorale(livello)
    local soglia = moraleData and moraleData.threshold

    if not soglia then
        print("[MORALE] Livello morale non valido per " .. tostring(unitKey) .. ": " .. tostring(livello))
        if callback then callback(nil, nil, nil, nil) end
        return
    end

    engine_diceClearLastRoll(slot)
    IEF_DICE_ROLL_TRY[slot] = { dadi = 2, soglia = nil }

    engine_diceThrowFromBag(slot, nil, function(risultati, successi)

        if not risultati[1] or not risultati[2] then
            if callback then callback(nil, nil, nil, nil) end
            return
        end
        local somma = risultati[1] + risultati[2] + (modificatori or 0)
        local esito = (somma >= soglia) and MORALE_RESULT.OK or MORALE_RESULT.KO
        local effetto = main_getMoraleEffect(esito, situazione)

        printToColor(string.format("[MORALE] %s: %d+%d%s = %d vs soglia %d -> %s",
            unitKey, risultati[1], risultati[2],
            (modificatori and modificatori ~= 0) and string.format(" (%+d)", modificatori) or "",
            somma, soglia, esito), player.color, {r=0.9,g=0.9,b=0.3})

        if callback then callback(esito, somma, soglia, effetto) end
    end)
end
-- ============================================================
-- FUNZIONE: main_getCohesion(unitKey)
-- Livello di coesione attuale dell'unità (COHESION.*).
-- Unità assente da IEF_UNIT_COHESION = SALDA.
-- ============================================================
function main_getCohesion(unitKey)
    local c = unitKey and IEF_UNIT_COHESION[unitKey]
    return (c and c.level) or COHESION.SAL
end

-- ============================================================
-- FUNZIONE: main_setCohesion(unitKey, level)
-- Unico punto di scrittura della coesione. Se l'unità entra in
-- ROTTA registra il turno (routedTurn), altrimenti lo azzera.
-- ============================================================
function main_setCohesion(unitKey, level)
    if not unitKey or not level then return end

    local prima = main_getCohesion(unitKey)

    if level == COHESION.SAL then
        IEF_UNIT_COHESION[unitKey] = nil
    else
        local routedTurn = nil
        if level == COHESION.ROT then
            local c = IEF_UNIT_COHESION[unitKey]
            routedTurn = (prima == COHESION.ROT and c and c.routedTurn) or (ENGINE and ENGINE.turn) or 1
        end
        IEF_UNIT_COHESION[unitKey] = { level = level, routedTurn = routedTurn }
    end

    if prima ~= level then
        printToAll(string.format("[COESIONE] %s: %s -> %s",
            main_decodeExtendedUnitLabel(unitKey), prima, level), {r=1,g=0.8,b=0.3})
        if level == COHESION.ROT and main_checkVictory then
            Wait.frames(function() main_checkVictory() end, 1)
        end
    end

        main_applyCohesionTint(unitKey)
end
-- ============================================================
-- FUNZIONE: main_applyCohesionTint(unitKey)
-- Colora le basi dell'unità secondo la coesione (COHESION_TINT).
-- Le basi marcate come perse restano rosse.
-- ============================================================
function main_applyCohesionTint(unitKey)
    if not unitKey then return end
    local tinta = COHESION_TINT[main_getCohesion(unitKey)] or COHESION_TINT[COHESION.SAL]

    local marcate = {}
    for _, guid in ipairs((IEF_MARKED_LOSSES or {})[unitKey] or {}) do marcate[guid] = true end
    for _, guid in ipairs((IEF_MELEE_MARKED or {})[unitKey] or {}) do marcate[guid] = true end

    for _, obj in ipairs(main_getUnitBases(unitKey)) do
        if not marcate[obj.getGUID()] then
            obj.setColorTint(tinta)
        end
    end
end

-- ============================================================
-- FUNZIONE: main_lowerCohesion(unitKey)
-- Perde un livello: SALDA -> DISORDINATA -> ROTTA.
-- Già in ROTTA resta in ROTTA. Ritorna il nuovo livello.
-- ============================================================
function main_lowerCohesion(unitKey)
    local attuale = main_getCohesion(unitKey)
    local nuovo = attuale
    if attuale == COHESION.SAL then
        nuovo = COHESION.DIS
    elseif attuale == COHESION.DIS then
        nuovo = COHESION.ROT
    end
    main_setCohesion(unitKey, nuovo)
    return nuovo
end

-- ============================================================
-- FUNZIONE: main_raiseCohesion(unitKey)
-- Recupera un livello: ROTTA -> DISORDINATA -> SALDA.
-- Ritorna il nuovo livello.
-- ============================================================
function main_raiseCohesion(unitKey)
    local attuale = main_getCohesion(unitKey)
    local nuovo = attuale
    if attuale == COHESION.ROT then
        nuovo = COHESION.DIS
    elseif attuale == COHESION.DIS then
        nuovo = COHESION.SAL
    end
    main_setCohesion(unitKey, nuovo)
    return nuovo
end

-- ============================================================
-- FUNZIONE: main_isRoutedThisTurn(unitKey)
-- True se l'unità è in ROTTA ed è andata in rotta nel turno
-- corrente (Recupero: non può tentare il test; Morale: diversa
-- da "unità che stanno scappando dai turni precedenti").
-- ============================================================
function main_isRoutedThisTurn(unitKey)
    local c = unitKey and IEF_UNIT_COHESION[unitKey]
    if not c or c.level ~= COHESION.ROT then return false end
    return c.routedTurn == ((ENGINE and ENGINE.turn) or 1)
end

-- ============================================================
-- FUNZIONE: main_getCohesionMoraleModifier(unitKey)
-- Modificatore al test di morale dovuto alla coesione attuale
-- (morale.json: unita_disordinata / unita_in_rotta). 0 se SALDA.
-- ============================================================
function main_getCohesionMoraleModifier(unitKey)
    local livello = main_getCohesion(unitKey)
    if livello == COHESION.DIS then
        return main_getMoraleModifier("unita_disordinata") or 0
    elseif livello == COHESION.ROT then
        return main_getMoraleModifier("unita_in_rotta") or 0
    end
    return 0
end
-- ============================================================
-- FUNZIONE: main_refreshAllBaseButtons()
-- Richiamata ad ogni cambio fase: per ciascuna unità presente
-- sul tavolo (identificata da unitKey), ricrea i bottoni sulla
-- sua base "capitana" (quella salvata in IEF_UNIT_BUTTON_BASE,
-- o la prima base trovata se non ancora assegnata).
-- ============================================================
function main_refreshAllBaseButtons()
    for slot = 1, 2 do
        local capitaneViste = {}
        for _, obj in ipairs(getAllObjects()) do
            local objSlot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
            if objSlot == slot and main_parseNickname(obj.getName()) then
                local unitKey = main_getUnitKey(obj)
                if unitKey and not capitaneViste[unitKey] then
                    capitaneViste[unitKey] = true

                    local guidSalvato = IEF_UNIT_BUTTON_BASE[unitKey]
                    local baseDaUsare = guidSalvato and getObjectFromGUID(guidSalvato) or obj

                    if baseDaUsare then
                        main_createBaseButtons(baseDaUsare, TURN.phase, unitKey)
                        IEF_UNIT_BUTTON_BASE[unitKey] = baseDaUsare.getGUID()
                    end
                end
            end
        end
    end
end
-- ============================================================
-- FUNZIONE: main_createBaseButtons(obj)
-- Crea i pulsanti 3D (Formazione + Muovi) sulla base indicata.
-- ============================================================
function main_createBaseButtons(obj, phase, unit)

    obj.clearButtons()

    local azioniUnita = {
        [PHASE.DEPLOY_SPAWN]     = {tidy, info, form},
        [PHASE.DEPLOY_POSITION]  = {tidy, info, form},
        [PHASE.CHARGE_DECLARE]   = {tidy, info, charge},
        [PHASE.CHARGE_REACT]     = {tidy, info},
        [PHASE.CHARGE_AUTO]      = {tidy, info},
        [PHASE.MOVE]             = {tidy, info, move},   -- formazione nel pannello movimento
        [PHASE.SHOOT]            = {tidy, info, shoot},
        [PHASE.MELEE]            = {tidy, info},
        [PHASE.RECOVERY]         = {tidy, info, recovery}
    }

    local azioniGenerali = {
        [PHASE.DEPLOY_SPAWN]     = {range, info},
        [PHASE.CHARGE_DECLARE]   = {range, info},
        [PHASE.CHARGE_REACT]     = {range, info},
        [PHASE.CHARGE_AUTO]      = {range, info},
        [PHASE.MOVE]             = {moveGeneral, info, range, attachGeneral},
        [PHASE.SHOOT]            = {range, info},
        [PHASE.MELEE]            = {range, info},
        [PHASE.RECOVERY]         = {range, info}
    }

    local pos = {x = 1.3, y = 0.1, z = -1.2}
    local rot = {x = 0, y = 180, z = 0}
    local w  = 400
    local h = 250
   
    local slot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
    local color = slot == 1 and "Red" or "Green"
    local textColor = "White"
    
    local isGenerale = not unit or string.find(unit, "GEN") ~= nil
    local is4x15 = not unit or string.find(unit, "FP") ~= nil
    local is4x20 = not unit or string.find(unit, "FM") ~= nil or string.find(unit, "FL") ~= nil
    local is4x30 = not unit or string.find(unit, "CP") ~= nil
   
    if isGenerale then 
        if ENGINE.phase == PHASE.MOVE then
           pos.x = 1.3; pos.z = -1.1; pos.y = 0.1;
        else 
           pos.x = 0.4; pos.z = -1.1; pos.y = 0.1;
        end
    end    
        
    if is4x15 then pos.z = -1.1 end
    if is4x20 then pos.z = -1.1 end
    if is4x30 then pos.z = -1.6 end

    local funzioni
    if isGenerale then
        funzioni = azioniGenerali[phase]
    else
        funzioni = azioniUnita[phase]
    end
    if not funzioni then return end

    for _, f in ipairs(funzioni) do
        f(obj, unit, pos, rot, w, h, color, textColor)
        pos.x = pos.x - 0.8
    end
end
