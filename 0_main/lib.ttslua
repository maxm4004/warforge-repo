-- ============================================================
-- FUNZIONE:  main_decodeUnitTypeLabel(unitKey)
-- ============================================================
function main_decodeUnitTypeLabel(unitKey)

    if not unitKey then return "Sconosciuto" end
    for segmento in unitKey:gmatch("[^_]+") do
        if UNIT_TYPE_LABELS[segmento] then
            return UNIT_TYPE_LABELS[segmento]
        end
    end
    return "Sconosciuto"
end
-- ============================================================
-- FUNZIONE:  main_decodeUnitTypeLabel(unitKey)
-- ============================================================
function main_decodeUnitTypeExtendedLabel(unitKey)

    if not unitKey then return "Sconosciuto" end
    for segmento in unitKey:gmatch("[^_]+") do
        if UNIT_TYPE_LABELS_EXT[segmento] then
            return UNIT_TYPE_LABELS_EXT[segmento]
        end
    end
    return "Sconosciuto"
end
-- ============================================================
-- FUNZIONE: main_decodeArmyCodeLabel(unitKey)
-- ============================================================
function main_decodeArmyCodeLabel(unitKey)
    if not unitKey then return "Sconosciuto" end
    local codice = unitKey:match("^([^_]+)")
    if not codice then return "Sconosciuto" end
    return ARMIES_UNIT_LABELS[codice] or codice
end

-- ============================================================
-- FUNZIONE: main_decodeExtendedUnitLabel(unitKey)
-- ============================================================
function main_decodeExtendedUnitLabel(unitKey)
    return main_decodeUnitTypeLabel(unitKey).. " ".. main_decodeArmyCodeLabel(unitKey)
end
-- ============================================================
-- FUNZIONE: main_cameraToUnitPanel(player, basiObjs, pitch, yaw, distance)
-- ============================================================
-- ============================================================
-- FUNZIONE: main_unitYaw(basiObjs)
-- Orientamento dell'unità (rotazione Y della prima base). Allo
-- schieramento è 0 per Army1 e 180 per Army2, come ArmyYaw: la
-- telecamera con questo yaw vede il pannello della base dritto
-- anche se l'unità è ruotata (perni, cambi di fronte).
-- ============================================================
function main_unitYaw(basiObjs)
    local b = basiObjs and basiObjs[1]
    return b and b.getRotation().y or 0
end

function main_cameraToUnitPanel(player, basiObjs, pitch, yaw, distance)
    if #basiObjs == 0 then return end

    local sumX, sumY, sumZ = 0, 0, 0
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        sumX = sumX + p.x
        sumY = sumY + p.y
        sumZ = sumZ + p.z
    end
    local n = #basiObjs
    local center = Vector(sumX / n, (sumY / n) + 2, sumZ / n)

    engine_cameraByPosition(player, center, pitch, yaw, distance)
end
-- ============================================================
-- FUNZIONE: main_cameraToPoint(player, slot, position)
-- Sposta la telecamera del giocatore su un punto qualsiasi del
-- tavolo. Riusa engine_diceCamera (engine/lib.ttslua), che
-- accetta una posizione libera, non solo le zone camera fisse.
-- ============================================================
function main_cameraToPoint(player, slot, position)
    local yaw = (slot == 1) and 0 or 180
    engine_diceCamera(player, position, 40, yaw, 15)
end
-- ============================================================
-- FUNZIONE: main_findGenerals(slot)
-- Trova tutte le basi Generale dell'esercito ARMY{slot}. GEN non
-- è un valore di unitType nei metadata — compare solo come
-- segmento dentro l'unitKey (es. "VIK_XXX_GEN_1") — quindi il
-- riconoscimento passa da main_getUnitKey, non da meta.unitType.
-- ============================================================
function main_findGenerals(slot)
    local generali = {}
    for _, obj in ipairs(getAllObjects()) do
        local meta = main_getUnitMeta(obj)
        if meta and meta.armySlot == slot then
            local unitKey = main_getUnitKey(obj)
            if unitKey then
                for segmento in unitKey:gmatch("[^_]+") do
                    if segmento == "GEN" then
                        table.insert(generali, obj)
                        break
                    end
                end
            end
        end
    end
    return generali
end
-- ============================================================
-- FUNZIONE: main_isInCommandRange(baseObj, slot)
-- ============================================================
function main_isInCommandRange(baseObj, slot)
    if not baseObj then return false end
    local generali = main_findGenerals(slot)
    if #generali == 0 then return false end

    for _, gen in ipairs(generali) do
        local dist = main_distanceInches(baseObj, gen)
        if dist and dist <= COMMAND_RANGE_INCHES then return true end
    end
    return false
end
-- ============================================================
-- FUNZIONE: main_drawRangeCircle(obj, radiusInches, colorRGB, segments)
-- Disegna una circonferenza di raggio radiusInches centrata su
-- obj, self-hosted (stesso principio del corridoio di carica —
-- obj.setVectorLines su se stesso, coordinate locali). segments
-- = numero di lati del poligono che approssima il cerchio
-- (default 48, abbastanza per sembrare liscio).
-- ============================================================
function main_drawRangeCircle(obj, radiusInches, colorRGB, segments)
    if not obj then return end
    segments = segments or 48
    colorRGB = colorRGB or {0.2, 0.6, 1}

    local center = obj.getPosition()
    local radiusUnits = radiusInches * INCH_TO_TTS
    local y = 1.20

    local points = {}
    for i = 0, segments do
        local angle = (i / segments) * 2 * math.pi
        local px = center.x + math.cos(angle) * radiusUnits
        local pz = center.z + math.sin(angle) * radiusUnits
        table.insert(points, obj.positionToLocal(Vector(px, y, pz)))
    end

    local segments_data = {}
    for i = 1, #points - 1 do
        table.insert(segments_data, {
            points = {points[i], points[i+1]},
            color = "Yellow",
            thickness = 0.03,
        })
    end

    obj.setVectorLines(segments_data)
end

-- ============================================================
-- FUNZIONE: main_clearRangeCircle(obj)
-- ============================================================
function main_clearRangeCircle(obj)
    if not obj then return end
    obj.setVectorLines({})
end
-- ============================================================
-- FUNZIONE: main_btnShowRange(obj, player_color, alt_click)
-- Bottone 3D direttamente sulla base (createButton, stesso stile
-- di charge_declareOpenFromButton): mostra/nasconde (toggle) il
-- cerchio di 12" (raggio di comando) centrato su questa base.
-- ============================================================

function main_btnShowRange(obj, player_color, alt_click)

    local player = Player[player_color]
    if not player then return end

    local unitKey = main_getUnitKey(obj)
    if not unitKey then return end

    local slot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
    if not slot then return end

    if IEF_RANGE_CIRCLE_SHOWN[unitKey] then
        main_clearRangeCircle(obj)
        main_clearHighlightList(IEF_RANGE_HIGHLIGHTED[unitKey])
        IEF_RANGE_CIRCLE_SHOWN[unitKey] = nil
        IEF_RANGE_HIGHLIGHTED[unitKey] = nil
    else
        main_drawRangeCircle(obj, COMMAND_RANGE_INCHES, {0.2, 0.6, 1})
        IEF_RANGE_HIGHLIGHTED[unitKey] = main_highlightUnitsInRange(obj, slot, COMMAND_RANGE_INCHES, {0.2, 0.6, 1})
        IEF_RANGE_CIRCLE_SHOWN[unitKey] = true
    end
end
-- ============================================================
-- FUNZIONE: main_highlightUnitsInRange(obj, slot, radiusInches, highlightColor)
-- Evidenzia (highlightOn) tutte le basi di ARMY{slot} entro
-- radiusInches da obj (il Generale). Ritorna la lista delle basi
-- evidenziate, per poterle spegnere dopo col toggle.
-- ============================================================
function main_highlightUnitsInRange(obj, slot, radiusInches, highlightColor)
    local center = obj.getPosition()
    local rangeUnits = radiusInches * INCH_TO_TTS
    local evidenziate = {}

    for _, o in ipairs(getAllObjects()) do
        local meta = main_getUnitMeta(o)
        if meta and meta.armySlot == slot and o ~= obj then
            local p = o.getPosition()
            local dist = Vector(p.x - center.x, 0, p.z - center.z):magnitude()
            if dist <= rangeUnits then
                o.highlightOn(highlightColor, 999)
                table.insert(evidenziate, o)
            end
        end
    end

    return evidenziate
end

-- ============================================================
-- FUNZIONE: main_clearHighlightList(lista)
-- ============================================================
function main_clearHighlightList(lista)
    if not lista then return end
    for _, o in ipairs(lista) do
        if not o.isDestroyed() then
            o.highlightOff()
        end
    end
end

-- ============================================================
-- FUNZIONE: main_distanceInches(objA, objB)
-- Distanza regolamentare: minima bordo-bordo fra i rettangoli
-- dichiarati delle due basi (unit_types), in pollici. È la
-- stessa misura usata per gittata, bersaglio e raggio di comando.
-- ============================================================
function main_distanceInches(objA, objB)
    if not objA or not objB then return nil end
    local function rettangolo(o)
        local meta = main_getUnitMeta(o)
        return main_baseRectOfType(o, meta and meta.unitType)
    end
    return main_rectsDistance(rettangolo(objA), rettangolo(objB)) / INCH_TO_TTS
end

-- ============================================================
-- FUNZIONE: main_distanceInchesAlongCenters(objA, objB)
-- Distanza bordo-bordo LUNGO la linea fra i centri (raggio che
-- esce dai rettangoli dichiarati). Solo per i movimenti di carica
-- verso il centro della base nemica: percorrendo questa distanza
-- su quella linea le basi arrivano esattamente a contatto.
-- ============================================================
function main_distanceInchesAlongCenters(objA, objB)
    if not objA or not objB then return nil end

    local posA = objA.getPosition()
    local posB = objB.getPosition()
    if not posA or not posB then return nil end

    local dirAB = Vector(posB.x - posA.x, 0, posB.z - posA.z)
    local pianaLen = math.sqrt(dirAB.x*dirAB.x + dirAB.z*dirAB.z) 
    if pianaLen < 0.0001 then return 0 end

    local dirNorm = Vector(dirAB.x / pianaLen, 0, dirAB.z / pianaLen)

local function rayBoxExitDeclared(obj, dirWorldX, dirWorldZ)
    local meta = main_getUnitMeta(obj)
    local tipo = meta and meta.unitType
    local unitTypeData = tipo and main_getUnitType(tipo)
    local widthCm = (unitTypeData and unitTypeData.base_width_cm) or 4
    local depthCm = (unitTypeData and unitTypeData.base_depth_cm) or 3
    local halfWidth = (widthCm * CM_TO_TTS) / 2
    local halfDepth = (depthCm * CM_TO_TTS) / 2

    -- Nessuna matrice di rotazione costruita a mano: uso i veri
    -- assi locali dell'oggetto forniti da TTS stesso, eliminando
    -- ogni ambiguità sulla convenzione di rotazione (oraria/
    -- antioraria) che ha probabilmente causato il bug di oggi.
    local fwd = obj.getTransformForward()
    local right = obj.getTransformRight()

    local localZ = dirWorldX * fwd.x + dirWorldZ * fwd.z      -- componente lungo la profondità
    local localX = dirWorldX * right.x + dirWorldZ * right.z  -- componente lungo la larghezza

    local tx = (math.abs(localX) > 0.0001) and (halfWidth / math.abs(localX)) or math.huge
    local tz = (math.abs(localZ) > 0.0001) and (halfDepth / math.abs(localZ)) or math.huge
    return math.min(tx, tz)
end

    local offsetA = rayBoxExitDeclared(objA, dirNorm.x, dirNorm.z)
    local offsetB = rayBoxExitDeclared(objB, -dirNorm.x, -dirNorm.z)
        
    -- print(string.format("[DEBUG DIST] pianaLen=%.3f offsetA=%.3f offsetB=%.3f rotA=%.1f rotB=%.1f pianaLen_cm=%.2f offsetA_cm=%.2f offsetB_cm=%.2f",
    --     pianaLen, offsetA, offsetB, objA.getRotation().y, objB.getRotation().y,
    --     pianaLen/CM_TO_TTS, offsetA/CM_TO_TTS, offsetB/CM_TO_TTS))

    local distTTS = math.max(0, pianaLen - offsetA - offsetB)
    return distTTS / INCH_TO_TTS
end
-- ============================================================
-- FUNZIONE: main_distanceInchesToPoint(obj, point)
-- Distanza in pollici da un oggetto (bordo, bounds) a un punto
-- fisso (non un altro oggetto) — solo XZ. Stessa filosofia di
-- main_distanceInches, ma per un punto salvato/snapshot.
-- ============================================================
function main_distanceInchesToPoint(obj, point)
    if not obj or not point then return nil end
    local pos = obj.getPosition()
    local bounds = obj.getBounds()

    local dirAB = Vector(point.x - pos.x, 0, point.z - pos.z)
    local pianaLen = math.sqrt(dirAB.x*dirAB.x + dirAB.z*dirAB.z)
    if pianaLen < 0.0001 then return 0 end

    local distTTS = pianaLen
    if bounds then
        local dirNorm = Vector(dirAB.x / pianaLen, 0, dirAB.z / pianaLen)
        local offset = math.abs(bounds.size.x/2 * dirNorm.x) + math.abs(bounds.size.z/2 * dirNorm.z)
        distTTS = math.max(0, pianaLen - offset)
    end

    return distTTS / INCH_TO_TTS
end
-- ============================================================
-- FUNZIONE: main_manage_no_winner(player, phase)
-- ============================================================
function main_manage_no_winner_for_roll(player, phase)

      if phase == "INITIATIVE_ROLL" then
        Wait.time(function ()
            warning("Pareggio, il tiro per assegnare l'iniziativa deve essere ripetuto", "Yellow")
            DICE_CONTEST.rolledNumberArmy1 = nil
            DICE_CONTEST.rolledNumberArmy2 = nil
        end, 2)
        return
     end
end
-- ============================================================
-- FUNZIONE: main_lossOrder(unitKey)
-- Ordine di rimozione delle basi perse: RANGO POSTERIORE per
-- primo, all'interno del rango SEMPRE DA DESTRA verso sinistra
-- (la capitana, prima a sinistra del rango posteriore, esce per
-- ultima del suo rango). Destra = stessa convenzione di
-- main_trovaBaseAngoloLibero.
-- Ritorna: lista ordinata di oggetti base, figures_per_base
-- ============================================================
function main_lossOrder(unitKey)
    local bases = main_getUnitBases(unitKey)
    if #bases == 0 then return {}, nil end

    local meta = main_getUnitMeta(bases[1])
    local tipo = meta and meta.unitType
    local unitTypeData = tipo and main_getUnitType(tipo)
    local fpb = unitTypeData and unitTypeData.figures_per_base

    local fwd   = bases[1].getTransformForward()
    local fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()
    local right = Vector(fwdXZ.z, 0, -fwdXZ.x)

    local depthCm  = (unitTypeData and tonumber(unitTypeData.base_depth_cm)) or 3
    local rankStep = depthCm * CM_TO_TTS

    local minProj = math.huge
    local info = {}
    for _, obj in ipairs(bases) do
        local p = obj.getPosition()
        local proj = p.x * fwdXZ.x + p.z * fwdXZ.z
        if proj < minProj then minProj = proj end
        table.insert(info, { obj = obj, proj = proj, lat = p.x * right.x + p.z * right.z, guid = obj.getGUID() })
    end

    for _, b in ipairs(info) do
        b.rank = math.floor((b.proj - minProj) / rankStep + 0.5)
    end

    table.sort(info, function(a, b)
        if a.rank ~= b.rank then return a.rank < b.rank end
        if a.lat ~= b.lat then return a.lat > b.lat end
        return a.guid < b.guid
    end)

    local ordinate = {}
    for _, b in ipairs(info) do table.insert(ordinate, b.obj) end
    return ordinate, fpb
end

-- ============================================================
-- FUNZIONE: main_removeBases(unitKey, daRimuovere)
-- Rimuove le basi indicate: sposta prima il pulsante capitano
-- sulle superstiti (come il cambio formazione), poi distrugge.
-- Unico punto di rimozione: aggiorna IEF_UNIT_BASES_LOST.
-- ============================================================
function main_removeBases(unitKey, daRimuovere)
    if #daRimuovere == 0 then return end

    IEF_UNIT_BASES_LOST[unitKey] = (IEF_UNIT_BASES_LOST[unitKey] or 0) + #daRimuovere

    local via = {}
    for _, obj in ipairs(daRimuovere) do via[obj] = true end

    local superstiti = {}
    for _, obj in ipairs(main_getUnitBases(unitKey)) do
        if not via[obj] then table.insert(superstiti, obj) end
    end
    if #superstiti > 0 then
        main_riposizionaPulsanteFormazione(unitKey, superstiti)
    else
        IEF_UNIT_BUTTON_BASE[unitKey] = nil
    end

    for _, obj in ipairs(daRimuovere) do
        obj.highlightOn({1, 0, 0}, 2)
        Wait.time(function()
            if obj and not obj.isDestroyed() then obj.destruct() end
        end, 2)
    end
  
    -- Generale aggregato: nuova base di riferimento a basi tolte
    Wait.time(function()
        main_syncAttachedGeneral(unitKey)
        if main_checkVictory then main_checkVictory() end
    end, 2.5)
end

-- ============================================================
-- FUNZIONE: main_applyLosses(unitKey, hits)
-- Perdite IEF immediate (tiro, Tiro d'Arresto): ogni
-- figures_per_base colpi = 1 base, i colpi in eccesso si perdono.
-- Ordine di rimozione: main_lossOrder.
-- Ritorna: basiRimosse, colpiPersi
-- ============================================================
function main_applyLosses(unitKey, hits)
    if not hits or hits <= 0 then return 0, hits or 0 end

    local ordinate, fpb = main_lossOrder(unitKey)
    if #ordinate == 0 then return 0, hits end
    if not fpb or fpb <= 0 then
        print("[PERDITE] figures_per_base non valido per " .. tostring(unitKey))
        return 0, hits
    end

    local n = math.min(math.floor(hits / fpb), #ordinate)
    local colpiPersi = hits - n * fpb
    if n == 0 then
        printToAll(string.format("[PERDITE] %s: %d colpi, nessuna base rimossa",
            main_decodeExtendedUnitLabel(unitKey), hits), {r=1,g=0.6,b=0.4})
        return 0, colpiPersi
    end

    local daRimuovere = {}
    for i = 1, n do table.insert(daRimuovere, ordinate[i]) end
    main_removeBases(unitKey, daRimuovere)

    printToAll(string.format("[PERDITE] %s: %d colpi -> %d basi rimosse (%d colpi persi)",
        main_decodeExtendedUnitLabel(unitKey), hits, n, colpiPersi), {r=1,g=0.4,b=0.4})

    return n, colpiPersi
end
-- ============================================================
-- FUNZIONE: main_setWinnerIcon(slot, visibile)
-- Mostra/nasconde la freccia del vincitore dell'iniziativa senza
-- disattivarla (dentro un HorizontalLayout un elemento inattivo
-- sposta gli altri): rende trasparente solo l'icona.
-- ============================================================
function main_setWinnerIcon(slot, visibile)
    UI.setAttribute("iconWinnerArmy" .. slot, "iconColor", visibile and "White" or "rgba(1,1,1,0)")
end
-- ============================================================
-- APPOGGIO DELLE BASI SUL TERRENO (movimenti da script)
-- setPosition con la Y vecchia lascia la base dentro una collina.
-- Si misura il terreno su tutta l'impronta della base (griglia
-- 5x5 di raggi verso il basso, dimensioni dichiarate, assi nativi
-- TTS) nella posizione e rotazione di arrivo, si prende il punto
-- più alto e ci si appoggia il fondo della base.
-- ============================================================
IEF_GROUND_GRID    = { -1, -0.5, 0, 0.5, 1 }   -- campioni per lato (frazione della semidimensione)
IEF_GROUND_INSET   = 0.02                     -- unità TTS: campioni appena dentro il bordo
IEF_GROUND_EPSILON = 0.01                     -- unità TTS: margine sopra il terreno
-- F27: gioco fra le basi di un'unità (unità TTS), usato sia allo
-- spawn sia da RIORDINA. 0.10 = 1.3 mm: con le mesh alla misura
-- esatta, ranghi a contatto => la fisica solleva qualche base.
IEF_FILE_GAP = 0.03                           -- fra le colonne
IEF_RANK_GAP = 0.03                           -- fra i ranghi (F28: 0.10 lasciava spazio visibile)

-- ============================================================
-- FUNZIONE: main_groundY(x, z, refY)
-- Altezza della superficie (tavolo, collina, terreno) nel punto
-- XZ: raggio verso il basso, si ignorano le basi e le figure
-- degli eserciti (tag Army1/Army2). nil se non colpisce nulla.
-- ============================================================
function main_groundY(x, z, refY)
    local alto = (refY or 1) + 20
    local hits = Physics.cast({
        origin       = Vector(x, alto, z),
        direction    = Vector(0, -1, 0),
        type         = 1,
        max_distance = 40,
    })
    local migliore = nil
    for _, hit in ipairs(hits) do
        local o = hit.hit_object
        if o and not o.hasTag("Army1") and not o.hasTag("Army2") then
            if not migliore or hit.point.y > migliore then migliore = hit.point.y end
        end
    end
    return migliore
end

-- ============================================================
-- FUNZIONE: main_baseFootprintGroundY(obj, x, z, deltaRad)
-- Terreno più alto sotto l'impronta della base, con il centro
-- in (x, z) e ruotata di deltaRad rispetto a ora (stessa
-- convenzione di rotazione dei perni: x' = x cos - z sin,
-- z' = x sin + z cos). nil se nessun raggio colpisce.
-- ============================================================
function main_baseFootprintGroundY(obj, x, z, deltaRad)
    local meta = main_getUnitMeta(obj)
    local ut = meta and meta.unitType and main_getUnitType(meta.unitType)
    local widthCm = (ut and ut.base_width_cm) or 4
    local depthCm = (ut and ut.base_depth_cm) or widthCm
    local hw = math.max(0, widthCm * CM_TO_TTS / 2 - IEF_GROUND_INSET)
    local hd = math.max(0, depthCm * CM_TO_TTS / 2 - IEF_GROUND_INSET)

    local f, r = obj.getTransformForward(), obj.getTransformRight()
    local fXZ = Vector(f.x, 0, f.z):normalized()
    local rXZ = Vector(r.x, 0, r.z):normalized()
    local fx, fz, rx, rz = fXZ.x, fXZ.z, rXZ.x, rXZ.z
    if deltaRad and deltaRad ~= 0 then
        local c, s = math.cos(deltaRad), math.sin(deltaRad)
        fx, fz = fx * c - fz * s, fx * s + fz * c
        rx, rz = rx * c - rz * s, rx * s + rz * c
    end

    local refY = obj.getPosition().y
    local massimo = nil
    for _, a in ipairs(IEF_GROUND_GRID) do
        for _, b in ipairs(IEF_GROUND_GRID) do
            local px = x + rx * (a * hw) + fx * (b * hd)
            local pz = z + rz * (a * hw) + fz * (b * hd)
            local g = main_groundY(px, pz, refY)
            if g and (not massimo or g > massimo) then massimo = g end
        end
    end
    return massimo
end

-- ============================================================
-- FUNZIONE: main_baseBottomOffset(obj)
-- Distanza fra il centro (getPosition) e il fondo della base.
-- getBounds è allineato al mondo, ma sull'asse Y è esatto per
-- una base piatta (la rotazione è solo attorno a Y).
-- ============================================================
function main_baseBottomOffset(obj)
    -- F29: si torna a getBounds (allineato al mondo). Il debug ha
    -- mostrato che getBoundsNormalized dà un'altezza/offset sbagliati
    -- su molte basi (fondo stimato 0.108 sotto il centro invece di
    -- 0.025): RIORDINA le appoggiava 1 mm sopra il tavolo.
    -- Le basi sono sempre piane (main_setPositionOnGround le
    -- raddrizza prima di misurare), quindi sull'asse Y è esatto.
    local b = obj.getBounds()
    if not b or not b.size or not b.center then return nil end
    return obj.getPosition().y - (b.center.y - b.size.y / 2)
end

-- ============================================================
-- F31: MODO DI APPOGGIO SUI PENDII (prova, scelta di Max)
--   "A" = la base si inclina e segue il pendio (calcolato dallo
--         script, niente fisica)
--   "B" = la base resta piana, poi la fisica la fa assestare
--   "C" = la base resta piana, appoggiata sul punto più alto
--         (come prima: a valle resta sospesa)
-- Si cambia al volo con  /execute debug_terreno("A")
-- ============================================================
IEF_GROUND_MODE  = IEF_GROUND_MODE or "A"
IEF_BASE_FONDO   = IEF_BASE_FONDO or {}      -- guid -> fondo misurato a base piana
IEF_GROUND_TILT_PENDING = IEF_GROUND_TILT_PENDING or {}

local function groundStorto(a) a = ((a + 180) % 360) - 180; return math.abs(a) > 0.05 end

-- Distanza pivot -> fondo misurata con la base PIANA (con la base
-- inclinata getBounds darebbe il punto più basso, non il fondo).
-- Si salva nel GMNotes (fondoMesh) per sopravvivere al reload.
function main_baseFondoPiatto(obj, soloSalvato)
    local guid = obj.getGUID()
    if IEF_BASE_FONDO[guid] then return IEF_BASE_FONDO[guid] end
    local meta = main_getUnitMeta(obj)
    local f = meta and tonumber(meta.fondoMesh)
    if f then IEF_BASE_FONDO[guid] = f; return f end
    -- soloSalvato: la base è appena stata raddrizzata in questo
    -- frame, getBounds potrebbe essere ancora quello vecchio.
    if soloSalvato then return nil end
    local rot = obj.getRotation()
    if groundStorto(rot.x) or groundStorto(rot.z) then return nil end
    f = main_baseBottomOffset(obj)
    if f then
        IEF_BASE_FONDO[guid] = f
        if type(meta) == "table" then
            meta.fondoMesh = f
            obj.setGMNotes(JSON.encode(meta))
        end
    end
    return f
end

-- ============================================================
-- FUNZIONE: main_groundTilt(obj)   (modo A)
-- Inclina la base sul piano che approssima il terreno sotto la sua
-- impronta (minimi quadrati sui campioni della griglia), alzato
-- quanto basta perché nessun punto del terreno la buchi. Mantiene
-- la direzione del fronte (yaw) e il centro della base.
-- ============================================================
function main_groundTilt(obj)
    if not obj or obj.isDestroyed() then return end
    local rot = obj.getRotation()
    local yaw = rot.y
    local fondo = main_baseFondoPiatto(obj)

    -- assi orizzontali della base (rotazione piana)
    obj.setRotation(Vector(0, yaw, 0))
    if not fondo then fondo = main_baseBottomOffset(obj) end
    local f, r = obj.getTransformForward(), obj.getTransformRight()
    local F = Vector(f.x, 0, f.z):normalized()
    local R = Vector(r.x, 0, r.z):normalized()

    local c = main_baseCentro(obj)
    local meta = main_getUnitMeta(obj)
    local ut = meta and meta.unitType and main_getUnitType(meta.unitType)
    local hw = ((c.w and c.w > 0) and c.w / 2 or ((ut and ut.base_width_cm or 4) * CM_TO_TTS / 2)) - IEF_GROUND_INSET
    local hd = ((c.d and c.d > 0) and c.d / 2 or ((ut and ut.base_depth_cm or 3) * CM_TO_TTS / 2)) - IEF_GROUND_INSET

    local p = obj.getPosition()
    local Cx = p.x + R.x * c.x + F.x * c.z
    local Cz = p.z + R.z * c.x + F.z * c.z

    -- campioni (u = verso destra, v = verso il fronte)
    local campioni, sg, n = {}, 0, 0
    for _, a in ipairs(IEF_GROUND_GRID) do
        for _, b in ipairs(IEF_GROUND_GRID) do
            local u, v = a * hw, b * hd
            local g = main_groundY(Cx + R.x * u + F.x * v, Cz + R.z * u + F.z * v, p.y)
            if not g then
                -- un campione fuori dal tavolo: si resta piani
                main_setPositionOnGround(obj, p.x, p.z, nil, true)
                return
            end
            table.insert(campioni, { u = u, v = v, g = g })
            sg, n = sg + g, n + 1
        end
    end
    -- griglia simmetrica: i minimi quadrati si separano
    local h0 = sg / n
    local suu, svv, sug, svg = 0, 0, 0, 0
    for _, k in ipairs(campioni) do
        suu, svv = suu + k.u * k.u, svv + k.v * k.v
        sug, svg = sug + k.u * (k.g - h0), svg + k.v * (k.g - h0)
    end
    local su = suu > 0 and sug / suu or 0
    local sv = svv > 0 and svg / svv or 0
    local alza = 0
    for _, k in ipairs(campioni) do
        local d = k.g - (h0 + su * k.u + sv * k.v)
        if d > alza then alza = d end
    end
    h0 = h0 + alza

    -- normale del piano nel mondo
    local L = math.sqrt(su * su + sv * sv + 1)
    local nx = (-su * R.x - sv * F.x) / L
    local ny = 1 / L
    local nz = (-su * R.z - sv * F.z) / L

    -- angoli: pitch attorno alla destra, roll attorno al fronte.
    -- Il verso dei segni dipende dagli assi di TTS: si provano le 4
    -- combinazioni e si tiene quella con la normale giusta.
    local pitch = math.deg(math.atan(sv))
    local roll  = math.deg(math.asin(math.max(-1, math.min(1, su / L))))
    local migliore, best = nil, -2
    for _, sp in ipairs({ 1, -1 }) do
        for _, sr in ipairs({ 1, -1 }) do
            obj.setRotation(Vector(sp * pitch, yaw, sr * roll))
            local up = obj.getTransformUp()
            local d = up.x * nx + up.y * ny + up.z * nz
            if d > best then best, migliore = d, { sp * pitch, sr * roll } end
        end
    end
    obj.setRotation(Vector(migliore[1], yaw, migliore[2]))

    -- pivot = centro del fondo + up*fondo - (assi inclinati * centro mesh)
    local up = obj.getTransformUp()
    local f2, r2 = obj.getTransformForward(), obj.getTransformRight()
    local by = h0 + IEF_GROUND_EPSILON
    local fz = fondo or 0
    obj.setPosition(Vector(
        Cx + up.x * fz - r2.x * c.x - f2.x * c.z,
        by + up.y * fz - r2.y * c.x - f2.y * c.z,
        Cz + up.z * fz - r2.z * c.x - f2.z * c.z))
end

-- ============================================================
-- FUNZIONE: main_setPositionOnGround(obj, x, z, deltaRad, soloPiano)
-- Sposta la base in (x, z) con il fondo appoggiato sul punto più
-- alto del terreno sotto la sua impronta di arrivo. deltaRad:
-- rotazione che la base sta per ricevere (perni), facoltativa.
-- Se le misure non riescono, mantiene la Y attuale.
-- F31: poi, secondo IEF_GROUND_MODE, al frame dopo (quando il
-- chiamante ha già impostato la rotazione finale) la base si
-- inclina sul pendio (A) o la fisica la fa assestare (B).
-- ============================================================
function main_setPositionOnGround(obj, x, z, deltaRad, soloPiano)
    local rot = obj.getRotation()
    if groundStorto(rot.x) or groundStorto(rot.z) then
        obj.setRotation(Vector(0, rot.y, 0))
    else
        main_baseFondoPiatto(obj)      -- base piana: misura affidabile
    end
    local p = obj.getPosition()
    local terreno = main_baseFootprintGroundY(obj, x, z, deltaRad)
    local fondo = main_baseFondoPiatto(obj, true) or main_baseBottomOffset(obj)
    local y = p.y
    if terreno and fondo then
        y = terreno + fondo + IEF_GROUND_EPSILON
    end
    obj.setPosition(Vector(x, y, z))

    if soloPiano or IEF_GROUND_MODE == "C" then return end
    local guid = obj.getGUID()
    if IEF_GROUND_TILT_PENDING[guid] then return end
    IEF_GROUND_TILT_PENDING[guid] = true
    Wait.frames(function()
        IEF_GROUND_TILT_PENDING[guid] = nil
        if not obj or obj.isDestroyed() then return end
        if IEF_GROUND_MODE == "A" then
            main_groundTilt(obj)
        elseif IEF_GROUND_MODE == "B" and not obj.getLock() then
            -- sveglia la fisica: la base cade e si assesta da sola
            obj.setVelocity(Vector(0, -0.5, 0))
        end
    end, 1)
end
-- ============================================================
-- FUNZIONE: main_cambioFronte90Core(unitKey, direction)
-- Cambio di fronte di 90° a sinistra ("left") o a destra
-- ("right"). Solo formazioni rettangolari pure.
-- La griglia (rango/colonna) si ricava dalle POSIZIONI delle
-- basi. La colonna sul lato verso cui si gira diventa il nuovo
-- primo rango; perno sull'angolo anteriore di quel lato.
-- Ogni base ruota di 90°: fronte nuovo = vecchia profondità.
-- ============================================================
function main_cambioFronte90Core(unitKey, direction)
    local state = IEF_FORM_UNITS[unitKey]
    if not state or not state.basiObjs or #state.basiObjs < 2 then return false end
    local basiObjs = state.basiObjs
    local player = state.activePlayer

    local F = main_detectFormation(basiObjs)          -- basi di fronte
    local totalBasi = #basiObjs
    if totalBasi % F ~= 0 then
        if player then printToColor("[FORMAZIONE] Cambio fronte 90° solo su formazioni rettangolari", player.color, {r=1,g=0.6,b=0}) end
        return false
    end
    local R = totalBasi / F                            -- ranghi

    local baseInfo = main_parseNickname(basiObjs[1].getName())
    if not baseInfo then return false end

    if not main_formationCanStart(unitKey, "cambio_fronte_90_fermi", baseInfo.unitType, player) then
        return false
    end

    local ut = main_getUnitType(baseInfo.unitType)
    local GAP = 0.03
    local hw = (ut and ut.base_width_cm or 4) * CM_TO_TTS / 2
    local hd = (ut and ut.base_depth_cm or 3) * CM_TO_TTS / 2
    local pw, pd = 2 * hw + GAP, 2 * hd + GAP          -- passo colonne / ranghi

    -- Assi attuali (nativi TTS)
    local f0 = basiObjs[1].getTransformForward()
    local r0 = basiObjs[1].getTransformRight()
    local f = Vector(f0.x, 0, f0.z):normalized()
    local r = Vector(r0.x, 0, r0.z):normalized()

    -- Coordinate locali e bordi del blocco
    local sMax, tMin, tMax = -math.huge, math.huge, -math.huge
    local loc = {}
    for i, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local s = p.x * f.x + p.z * f.z
        local t = p.x * r.x + p.z * r.z
        loc[i] = { s = s, t = t }
        if s > sMax then sMax = s end
        if t < tMin then tMin = t end
        if t > tMax then tMax = t end
    end

    -- Nuovi assi e angolo di perno (angolo anteriore del lato)
    local nf, nr, cornerT
    if direction == "left" then
        nf, nr = Vector(-r.x, 0, -r.z), Vector(f.x, 0, f.z)
        cornerT = tMin - hw
    else
        nf, nr = Vector(r.x, 0, r.z), Vector(-f.x, 0, -f.z)
        cornerT = tMax + hw
    end
    local cornerS = sMax + hd
    local C = { x = f.x * cornerS + r.x * cornerT, z = f.z * cornerS + r.z * cornerT }

    -- Angolo anteriore-sinistro del nuovo blocco (fronte nuovo = R)
    local larghezza = (R - 1) * pw + 2 * hw
    local L = C
    if direction == "left" then
        L = { x = C.x - nr.x * larghezza, z = C.z - nr.z * larghezza }
    end

    local yaw = basiObjs[1].getRotation().y + (direction == "left" and -90 or 90)    
    local deltaRad = math.rad(direction == "left" and -90 or 90)

    for i, obj in ipairs(basiObjs) do
        local rank = math.floor((sMax - loc[i].s) / pd + 0.5)   -- 0 = primo rango
        local col  = math.floor((loc[i].t - tMin) / pw + 0.5)   -- 0 = sinistra
        local newRank, newCol
        if direction == "left" then
            newRank, newCol = col, (R - 1) - rank
        else
            newRank, newCol = (F - 1) - col, rank
        end
        local x = L.x + nr.x * (hw + newCol * pw) - nf.x * (hd + newRank * pd)
        local z = L.z + nr.z * (hw + newCol * pw) - nf.z * (hd + newRank * pd)
        main_setPositionOnGround(obj, x, z, deltaRad)
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, yaw, rot.z))
    end

    IEF_FRONT_WIDTH[unitKey] = R
    main_formationAfter(unitKey, "cambio_fronte_90_e_muovi", baseInfo.unitType)

    main_riposizionaPulsanteFormazione(unitKey, basiObjs)
    main_formationRedraw(unitKey)
    return true
end

-- ============================================================
-- FUNZIONE: main_baseRectOfType(obj, tipo)
-- Come main_baseRect, ma con il tipo già noto. Aggiunge i 4
-- vertici (corners) sul piano XZ.
-- ============================================================
function main_baseRectOfType(obj, tipo)
    local ut = main_getUnitType(tipo)
    local widthCm = (ut and ut.base_width_cm) or 4
    local depthCm = (ut and ut.base_depth_cm) or 3

    local p = obj.getPosition()
    local f = obj.getTransformForward()
    local r = obj.getTransformRight()
    local fXZ = Vector(f.x, 0, f.z):normalized()
    local rXZ = Vector(r.x, 0, r.z):normalized()

    -- Centro e misure della mesh reale (salvati al deploy): il
    -- rettangolo combacia con la base visibile. Senza dato: misure
    -- dichiarate in unit_types e nessuno scostamento.
    local c = main_baseCentro(obj)
    local cx = p.x + rXZ.x * c.x + fXZ.x * c.z
    local cz = p.z + rXZ.z * c.x + fXZ.z * c.z

    local rect = {
        x = cx, z = cz,
        fx = fXZ.x, fz = fXZ.z,
        rx = rXZ.x, rz = rXZ.z,
        hw = (c.w and c.w > 0) and (c.w / 2) or (widthCm * CM_TO_TTS / 2),
        hd = (c.d and c.d > 0) and (c.d / 2) or (depthCm * CM_TO_TTS / 2),
        obj = obj,
    }
    rect.corners = {}
    for _, sw in ipairs({ -1, 1 }) do
        for _, sd in ipairs({ -1, 1 }) do
            table.insert(rect.corners, {
                x = rect.x + rect.rx * rect.hw * sw + rect.fx * rect.hd * sd,
                z = rect.z + rect.rz * rect.hw * sw + rect.fz * rect.hd * sd,
            })
        end
    end
    return rect
end

-- ============================================================
-- FUNZIONE: main_baseCentro(obj) / main_saveBaseCentro(obj)
-- Scostamento (assi locali: x = destra, z = avanti) del centro
-- della mesh della base rispetto al suo punto di posizione.
-- Misurato al deploy prima di attaccare le figure (bounds della
-- sola base) e salvato nei GMNotes (campo centroMesh); cache per GUID.
-- Basi senza il dato (deploy precedente): nessuno scostamento.
-- ============================================================
IEF_BASE_CENTRO = IEF_BASE_CENTRO or {}

function main_saveBaseCentro(obj)
    if not obj then return end
    -- getBoundsNormalized().offset = posizione - centro (assi
    -- locali): lo scostamento del centro è il suo opposto.
    -- Verificato: FP rotY 0 centro (-0.14, -0.30) => offset (0.14, 0.30).
    -- size = ingombro della sola base (figure non ancora attaccate),
    -- senza rotazione: x = larghezza (destra), z = profondità (avanti).
    local bn = obj.getBoundsNormalized()
    local off = bn and bn.offset
    if not off then return end
    local centro = { x = -off.x, z = -off.z,
                     w = bn.size and bn.size.x or nil, d = bn.size and bn.size.z or nil }
    local ok, meta = pcall(function() return JSON.decode(obj.getGMNotes()) end)
    if ok and type(meta) == "table" then
        meta.centro = nil            -- vecchio dato col segno sbagliato
        meta.centroMesh = centro
        obj.setGMNotes(JSON.encode(meta))
    end
    IEF_BASE_CENTRO[obj.getGUID()] = centro
end

function main_baseCentro(obj)
    local guid = obj.getGUID()
    local c = IEF_BASE_CENTRO[guid]
    if c then return c end
    local meta = main_getUnitMeta(obj)
    c = (meta and type(meta.centroMesh) == "table" and meta.centroMesh) or { x = 0, z = 0 }
    c = { x = tonumber(c.x) or 0, z = tonumber(c.z) or 0, w = tonumber(c.w), d = tonumber(c.d) }
    IEF_BASE_CENTRO[guid] = c
    return c
end

-- ============================================================
-- FUNZIONE: main_pointRectDistance(px, pz, r)
-- Distanza (unità TTS) da un punto al rettangolo r; 0 se dentro.
-- ============================================================
function main_pointRectDistance(px, pz, r)
    local dx, dz = px - r.x, pz - r.z
    local ex = math.max(math.abs(dx * r.rx + dz * r.rz) - r.hw, 0)
    local ef = math.max(math.abs(dx * r.fx + dz * r.fz) - r.hd, 0)
    return math.sqrt(ex * ex + ef * ef)
end

-- ============================================================
-- FUNZIONE: main_rectsDistance(a, b)
-- Distanza minima bordo-bordo (unità TTS) fra due rettangoli:
-- il minimo è sempre su un vertice di uno dei due.
-- ============================================================
function main_rectsDistance(a, b)
    local m = math.huge
    for _, c in ipairs(a.corners) do
        local d = main_pointRectDistance(c.x, c.z, b)
        if d < m then m = d end
    end
    for _, c in ipairs(b.corners) do
        local d = main_pointRectDistance(c.x, c.z, a)
        if d < m then m = d end
    end
    return m
end

-- ============================================================
-- FUNZIONE: main_canChargeType(tipoCheCarica, tipoBersaglio)
-- Limitazioni di carica: ART mai; FL solo FL, ART, EL.
-- ============================================================
function main_canChargeType(tipoCheCarica, tipoBersaglio)
    if tipoCheCarica == "ART" or tipoCheCarica == "GEN" then return false end
    if tipoCheCarica == "FL" and tipoBersaglio ~= "FL"
       and tipoBersaglio ~= "ART" and tipoBersaglio ~= "EL" then
        return false
    end
    return true
end

-- ============================================================
-- FUNZIONE: main_unitsInMelee()
-- Insieme delle unità presenti in IEF_MELEE_LIST.
-- ============================================================
function main_unitsInMelee()
    local out = {}
    for _, e in ipairs(IEF_MELEE_LIST or {}) do
        out[e.unitArmy1Key] = true
        out[e.unitArmy2Key] = true
    end
    return out
end

-- ============================================================
-- FUNZIONE: main_isMistaMeta(meta)
-- Unità mista (ranghi con armi diverse, es. Bondi o Leidang:
-- lancieri + arcieri): attributo armamento = "MISTO" in GMNotes,
-- dall'Army Builder (3_deploy). Assente = "NORMALE".
-- ============================================================
function main_isMistaMeta(meta)
    return meta ~= nil and string.upper(meta.armamento or "") == "MISTO"
end

-- ============================================================
-- FUNZIONE: main_isMista(unitKey)
-- ============================================================
function main_isMista(unitKey)
    local b = main_getUnitBases(unitKey)[1]
    return main_isMistaMeta(b and main_getUnitMeta(b))
end

-- ============================================================
-- FUNZIONE: main_chargeCorridorHits(rects, tipo, bersaglioRects, tol)
-- Vero se l'unità (rects, tipo) può raggiungere una delle basi
-- bersaglio con una carica: in linea retta lungo il proprio fronte
-- per la sua mossa, dopo un perno di massimo 2" a inizio mossa
-- (regolamento, "Movimento di carica"). Il corridoio è largo
-- quanto il fronte; il perno si campiona fra -2" e +2" d'arco.
-- ============================================================
IEF_CHARGE_PIVOT_INCHES = 2

function main_chargeCorridorHits(rects, tipo, bersaglioRects, tol)
    if #rects == 0 or #bersaglioRects == 0 then return false end
    local ut = main_getUnitType(tipo)
    local mossa = ((ut and ut.move_inches) or 0) * INCH_TO_TTS
    if mossa <= 0 then return false end

    local r0 = rects[1]
    local fx, fz, rx, rz = r0.fx, r0.fz, r0.rx, r0.rz

    -- linea del fronte: angoli più avanzati, estensione laterale
    local sMax, tMin, tMax = -math.huge, math.huge, -math.huge
    for _, r in ipairs(rects) do
        for _, c in ipairs(r.corners) do
            local s = c.x * fx + c.z * fz
            local t = c.x * rx + c.z * rz
            if s > sMax then sMax = s end
            if t < tMin then tMin = t end
            if t > tMax then tMax = t end
        end
    end
    local larghezza = math.max(tMax - tMin, 0.01)
    local tMid = (tMin + tMax) / 2
    local cx = fx * sMax + rx * tMid
    local cz = fz * sMax + rz * tMid

    local angMax = (IEF_CHARGE_PIVOT_INCHES * INCH_TO_TTS) / larghezza
    for i = -4, 4 do
        local a = angMax * i / 4
        local ca, sa = math.cos(a), math.sin(a)
        local nfx, nfz = fx * ca - fz * sa, fx * sa + fz * ca
        local nrx, nrz = rx * ca - rz * sa, rx * sa + rz * ca
        local corr = {
            x = cx + nfx * (mossa / 2), z = cz + nfz * (mossa / 2),
            fx = nfx, fz = nfz, rx = nrx, rz = nrz,
            hw = larghezza / 2, hd = mossa / 2,
        }
        corr.corners = {}
        for _, sw in ipairs({ -1, 1 }) do
            for _, sd in ipairs({ -1, 1 }) do
                table.insert(corr.corners, {
                    x = corr.x + corr.rx * corr.hw * sw + corr.fx * corr.hd * sd,
                    z = corr.z + corr.rz * corr.hw * sw + corr.fz * corr.hd * sd,
                })
            end
        end
        for _, br in ipairs(bersaglioRects) do
            if main_rectsDistance(corr, br) <= tol then return true end
        end
    end
    return false
end

-- ============================================================
-- FUNZIONE: main_enemyOnFlankOrRear(unitKey)
-- True se una unità nemica (non Generale, non in ROTTA):
-- a) è a contatto con una base dell'unità e il centro della sua
--    base sta dietro la linea del fronte (contatto sul fianco o
--    sul retro);
-- b) oppure non è in mischia, può caricare l'unità (ART mai, FL
--    solo FL/ART/EL), ha almeno 2 basi interamente dietro il
--    prolungamento della linea del fronte ed è entro la sua
--    mossa (in grado di caricare un fianco/retro). Nessun
--    controllo del raggio di comando.
-- Linea del fronte = proiezione massima dei vertici delle basi
-- lungo il fronte dell'unità.
-- ============================================================
function main_enemyOnFlankOrRear(unitKey)
    -- Una sola passata sugli oggetti: unità per chiave
    local unita = {}
    for _, o in ipairs(getAllObjects()) do
        local info = main_parseNickname(o.getName())
        if info then
            local s = (o.hasTag("Army1") and 1) or (o.hasTag("Army2") and 2) or nil
            if s then
                local key = main_getUnitKey(o)
                local u = unita[key]
                if not u then
                    u = { slot = s, tipo = info.unitType, basi = {} }
                    unita[key] = u
                end
                table.insert(u.basi, o)
            end
        end
    end

    local mia = unita[unitKey]
    if not mia or #mia.basi == 0 then return false end

    local mieRect = {}
    for _, b in ipairs(mia.basi) do
        table.insert(mieRect, main_baseRectOfType(b, mia.tipo))
    end
    local fx, fz = mieRect[1].fx, mieRect[1].fz

    local fronte = -math.huge
    for _, r in ipairs(mieRect) do
        for _, c in ipairs(r.corners) do
            local s = c.x * fx + c.z * fz
            if s > fronte then fronte = s end
        end
    end

    local tol = IEF_FLANK_CONTACT_INCHES * INCH_TO_TTS
    local inMischia = main_unitsInMelee()

    for key, u in pairs(unita) do
        if u.slot ~= mia.slot and u.tipo ~= "GEN" and not main_isGeneralKey(key)
           and main_getCohesion(key) ~= COHESION.ROT then

            local rects = {}
            for _, b in ipairs(u.basi) do
                table.insert(rects, main_baseRectOfType(b, u.tipo))
            end

            -- a) contatto sul fianco/retro
            for _, er in ipairs(rects) do
                if er.x * fx + er.z * fz < fronte then
                    for _, mr in ipairs(mieRect) do
                        if main_rectsDistance(mr, er) <= tol then return true end
                    end
                end
            end

            -- b) in grado di caricare un fianco/retro
            if not inMischia[key] and main_canChargeType(u.tipo, mia.tipo) then
                local dietro = 0
                for _, er in ipairs(rects) do
                    local tutta = true
                    for _, c in ipairs(er.corners) do
                        if c.x * fx + c.z * fz > fronte + tol then tutta = false; break end
                    end
                    if tutta then dietro = dietro + 1 end
                end

                if dietro >= 2 and main_chargeCorridorHits(rects, u.tipo, mieRect, tol) then
                    return true
                end
            end
        end
    end
    return false
end

-- ============================================================
-- FUNZIONE: main_moveForbiddenReason(unitKey)
-- Regolamento, fase di manovra: non muove chi ha evaso o
-- caricato in questo turno (IEF_UNIT_NO_MOVE_NEXT_TURN, scritto
-- da 4_charge) né chi è in mischia. Ritorna il messaggio o nil.
-- ============================================================
function main_moveForbiddenReason(unitKey)
    if ENGINE.phase ~= PHASE.MOVE or main_isGeneralKey(unitKey) then return nil end
    if IEF_UNIT_NO_MOVE_NEXT_TURN and IEF_UNIT_NO_MOVE_NEXT_TURN[unitKey] then
        return "Unita' che ha caricato o evaso in questo turno: non puo' muovere"
    end
    for _, e in ipairs(IEF_MELEE_LIST or {}) do
        if e.unitArmy1Key == unitKey or e.unitArmy2Key == unitKey then
            return "Unita' in mischia: non puo' muovere"
        end
    end
    return nil
end