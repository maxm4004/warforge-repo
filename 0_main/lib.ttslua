-- ============================================================
-- FUNZIONE: move_ricostruisciFormazione(basiObjs, fronte)
-- Ancora la nuova griglia al CENTRO del rango frontale attuale
-- (non più alla base seq=1), così il fronte resta centrato
-- quando il fronte cambia, invece di scivolare lateralmente.
-- ============================================================
function main_ricostruisciFormazione(basiObjs, fronte)

    if not basiObjs or #basiObjs < 1 then return false end
    if not fronte or fronte < 1 then fronte = #basiObjs end
    if fronte > #basiObjs then fronte = #basiObjs end

    -- 1) Orientamento reale (prima di riordinare per seq)
    local refObj = basiObjs[1]
    local fwd    = refObj.getTransformForward()
    local fwdXZ  = Vector(fwd.x, 0, fwd.z):normalized()
    local right  = Vector(-fwdXZ.z, 0, fwdXZ.x)

    -- 2) Trova il rango FRONTALE attuale (proiezione più alta) e il suo centro reale
    local maxProj = -math.huge
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        if proj > maxProj then maxProj = proj end
    end
    local EPS = 0.5
    local frontRank = {}
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        if math.abs(proj - maxProj) < EPS then
            table.insert(frontRank, obj)
        end
    end
    table.sort(frontRank, function(a, b)
        local pa, pb = a.getPosition(), b.getPosition()
        return (pa.x*right.x + pa.z*right.z) < (pb.x*right.x + pb.z*right.z)
    end)
    local leftPos   = frontRank[1].getPosition()
    local rightPos  = frontRank[#frontRank].getPosition()
    local centerPos = Vector((leftPos.x+rightPos.x)/2, leftPos.y, (leftPos.z+rightPos.z)/2)

    -- 3) Ordina TUTTE le basi per baseSeq (griglia stabile di schieramento)
    table.sort(basiObjs, function(a, b)
        local ia = main_parseNickname(a.getName())
        local ib = main_parseNickname(b.getName())
        return (ia and ia.baseSeq or 0) < (ib and ib.baseSeq or 0)
    end)

    local baseInfoAnchor = main_parseNickname(refObj.getName())
    local unitTypeDataAnchor = baseInfoAnchor and main_getUnitType(baseInfoAnchor.unitType)
    local CM_TO_TTS = 0.7423
    local HGAP = 0.25
    local VGAP = 0.1
    local width = (unitTypeDataAnchor and unitTypeDataAnchor.base_width_cm or 4) * CM_TO_TTS + HGAP
    local depth = (unitTypeDataAnchor and unitTypeDataAnchor.base_depth_cm or 3) * CM_TO_TTS + VGAP

    local totalBasi   = #basiObjs
    local ranghiPieni = math.floor(totalBasi / fronte)
    local resto       = totalBasi % fronte

    -- 4) Punto di partenza: colonna 0 del nuovo fronte, CENTRATA su centerPos
    local halfSpan = (fronte - 1) * width / 2
    local startPos = Vector(
        centerPos.x - right.x*halfSpan,
        leftPos.y,
        centerPos.z - right.z*halfSpan
    )

    for i, obj in ipairs(basiObjs) do
        local idx  = i - 1
        local rank = math.floor(idx / fronte)
        local col  = idx % fronte

        if resto == 2 and rank == ranghiPieni then
            local posizioneNelResto = idx - (ranghiPieni * fronte)
            col = (posizioneNelResto == 0) and 0 or (fronte - 1)
        end

        local newPos = Vector(
            startPos.x + right.x*(col*width) - fwdXZ.x*(rank*depth),
            obj.getPosition().y,
            startPos.z + right.z*(col*width) - fwdXZ.z*(rank*depth)
        )
        obj.setPosition(newPos)
        obj.setRotation(refObj.getRotation())
    end

    return true
end
-- ============================================================
-- FUNZIONE: main_espandiContrai(deltaFronte)
-- ============================================================
function main_espandiContrai(deltaFronte)

    local basiObjs = IEF_FORM.basiObjs
    local unitKey  = IEF_FORM.unitKey
    local player   = IEF_FORM.activePlayer
    if not basiObjs or not unitKey or #basiObjs < 2 then return false end

    local baseInfo = main_parseNickname(basiObjs[1].getName())
    if not baseInfo then return false end

    if not main_CheckMatch() then return false end

    if not IEF_FORM_TEST_MODE then
        if IEF_REFORM_USED[unitKey] then
            printToColor("[MOVIMENTO] Manovra di riorganizzazione già usata questo turno", player.color, {r=1,g=0.6,b=0})
            return false
        end
        if not main_canManeuver("espandi_contrai_1_2_basi_fermi", baseInfo.unitType) then
            printToColor("[MOVIMENTO] Questa unità non può espandere/contrarre il fronte", player.color, {r=1,g=0.6,b=0})
            return false
        end
    end

    if IEF_FRONT_WIDTH[unitKey] == nil then
        IEF_FRONT_WIDTH[unitKey] = #basiObjs
    end
    local newFront = IEF_FRONT_WIDTH[unitKey] + deltaFronte

    local fronteAttuale = main_detectFormation(basiObjs)
    local newFront = fronteAttuale + deltaFronte

    if newFront < 1 then newFront = 1 end
    if newFront > #basiObjs then newFront = #basiObjs end

    main_ricostruisciFormazione(basiObjs, newFront)

    IEF_FRONT_WIDTH[unitKey] = newFront
    IEF_REFORM_USED[unitKey] = true

    main_formationRedraw(player)
    return true
end

-- ============================================================
-- FUNZIONE: move_cambioFronte180()
-- ============================================================
function main_cambioFronte180(player, value, id, buttonConfig)
    local basiObjs = IEF_FORM.basiObjs
    local unitKey  = IEF_FORM.unitKey
    if not basiObjs or not unitKey then return false end
    local player = IEF_FORM.activePlayer

    if not main_CheckMatch() then return false end

    if TURN.phase == "MOVE" and not IEF_FORM_TEST_MODE then
        if IEF_REFORM_USED[unitKey] then
            printToColor("[FORMAZIONE] Manovra di riorganizzazione già usata questo turno", player.color, {r=1,g=0.6,b=0})
            return false
        end
        local baseInfo = main_parseNickname(basiObjs[1].getName())
        if not baseInfo or not main_canManeuver("cambio_fronte_180_fermi", baseInfo.unitType) then
            printToColor("[FORMAZIONE] Questa unità non può fare dietrofront", player.color, {r=1,g=0.6,b=0})
            return false
        end
    end

    local sumX, sumZ, sumY = 0, 0, 0
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        sumX, sumZ, sumY = sumX + p.x, sumZ + p.z, sumY + p.y
    end
    local n = #basiObjs
    local center = Vector(sumX/n, sumY/n, sumZ/n)

    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        obj.setPosition(Vector(2*center.x - p.x, p.y, 2*center.z - p.z))
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y + 180, rot.z))
    end

    IEF_REFORM_USED[unitKey] = true
    main_formationRedraw(player)
    return true
end

-- ============================================================
-- FUNZIONE: move_cambioFronte90(direction)
-- ============================================================
function main_cambioFronte90(direction)
    local basiObjs = IEF_FORM.basiObjs
    local unitKey  = IEF_FORM.unitKey
    local player   = IEF_FORM.activePlayer
    if not basiObjs or not unitKey or #basiObjs < 2 then return false end

    local fronteAttuale = main_detectFormation(basiObjs)
    local totalBasi = #basiObjs

    if not main_CheckMatch() then return false end

    if totalBasi % fronteAttuale ~= 0 then
        printToColor("[FORMAZIONE] Cambio fronte 90° disponibile solo su formazioni rettangolari", player.color, {r=1,g=0.6,b=0})
        return false
    end

    local baseInfo = main_parseNickname(basiObjs[1].getName())
    if not baseInfo then return false end

    if TURN.phase == "MOVE" and not IEF_FORM_TEST_MODE then
        if IEF_REFORM_USED[unitKey] then
            printToColor("[FORMAZIONE] Manovra di riorganizzazione già usata questo turno", player.color, {r=1,g=0.6,b=0})
            return false
        end
        if not main_canManeuver("cambio_fronte_90_fermi", baseInfo.unitType) then
            printToColor("[FORMAZIONE] Questa unità non può cambiare fronte di 90°", player.color, {r=1,g=0.6,b=0})
            return false
        end
    end

    table.sort(basiObjs, function(a, b)
        local ia = main_parseNickname(a.getName())
        local ib = main_parseNickname(b.getName())
        return (ia and ia.baseSeq or 0) < (ib and ib.baseSeq or 0)
    end)

    local anchor    = basiObjs[1]
    local fwd       = anchor.getTransformForward()
    local fwdXZ     = Vector(fwd.x, 0, fwd.z):normalized()
    local right     = Vector(-fwdXZ.z, 0, fwdXZ.x)

    local unitTypeDataAnchor = main_getUnitType(baseInfo.unitType)
    local CM_TO_TTS = 0.7423
    local GAP = 0.05
    local width = (unitTypeDataAnchor and unitTypeDataAnchor.base_width_cm or 4) * CM_TO_TTS + GAP
    local depth = (unitTypeDataAnchor and unitTypeDataAnchor.base_depth_cm or 3) * CM_TO_TTS + GAP

    local anchorPos = anchor.getPosition()
    local anchorRot = anchor.getRotation()

    local vecchiaProfondita = totalBasi / fronteAttuale
    local nuovoFronte = vecchiaProfondita

    local griglia = {}
    for i, obj in ipairs(basiObjs) do
        local idx  = i - 1
        local rank = math.floor(idx / fronteAttuale)
        local col  = idx % fronteAttuale
        griglia[rank] = griglia[rank] or {}
        griglia[rank][col] = obj
    end

    for rank = 0, vecchiaProfondita - 1 do
        for col = 0, fronteAttuale - 1 do
            local obj = griglia[rank][col]
            if obj then
                local newRank, newCol
                if direction == "left" then
                    newRank = col
                    newCol  = rank
                else
                    newRank = (fronteAttuale - 1) - col
                    newCol  = rank
                end

                local newPos = Vector(
                    anchorPos.x + right.x*(newCol*width) - fwdXZ.x*(newRank*depth),
                    obj.getPosition().y,
                    anchorPos.z + right.z*(newCol*width) - fwdXZ.z*(newRank*depth)
                )
                obj.setPosition(newPos)
                obj.setRotation(anchorRot)
            end
        end
    end

    IEF_FRONT_WIDTH[unitKey] = nuovoFronte
    IEF_REFORM_USED[unitKey] = true

    main_formationRedraw(player)
    return true
end
-- ============================================================
-- FUNZIONE: deployment_parseNickname()
-- Parser: "FP_1.3_ARCL" → {unitType="FP", unitNumber=1, baseSeq=3, weapon="ARCL"}
-- ============================================================
function main_parseNickname(nickname)

    if not nickname or nickname == "" then return nil end
    local unitType, unitNumber, baseSeq = string.match(nickname, "_([A-Z]+)_(%d+)%.(%d+)$")

    if not unitType then return nil end

    return {
        unitType   = unitType,
        unitNumber = tonumber(unitNumber),
        baseSeq    = tonumber(baseSeq)
    }
end
-- ============================================================
-- Wrapper pulsanti formazione
-- ============================================================
function main_frontMinus2()      return main_espandiContrai(-2) end
function main_frontMinus1()      return main_espandiContrai(-1) end
function main_frontPlus1()       return main_espandiContrai(1) end
function main_frontPlus2()       return main_espandiContrai(2) end
function main_cambioFronte90Sx() return main_cambioFronte90("left") end
function main_cambioFronte90Dx() return main_cambioFronte90("right") end
-- ============================================================
-- FUNZIONE: move_sistemaFormazione(player)
-- ============================================================
function main_sistemaFormazione(player, value, id, buttonConfig)

    local selected = main_getSelectedObjects(player)
    if not selected or #selected < 1 then
        warningToColor("Seleziona almeno una base", player, "Yellow")
        return false
    end

    if not main_CheckMatch() then return false end

    local mover = selected[1]
    local moverSlot = mover.hasTag("Army1") and 1 or (mover.hasTag("Army2") and 2 or nil)
    if moverSlot == nil then return false end

    local baseInfo  = main_parseNickname(mover.getName())
    local moverUnit = baseInfo and main_findUnit(moverSlot, baseInfo.unitType, baseInfo.unitNumber)
    if not baseInfo then return false end

    local unitKey = moverSlot .. "_" .. baseInfo.unitType .. "_" .. baseInfo.unitNumber

    local basiObjs = {}
    for _, obj in ipairs(selected) do
        local info = main_parseNickname(obj.getName())
        if info then
            local objSlot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
            local objKey  = objSlot and (objSlot .. "_" .. info.unitType .. "_" .. info.unitNumber)
            if objKey == unitKey then
                table.insert(basiObjs, obj)
            end
        end
    end
    if #basiObjs == 0 then return false end

    local fronte = main_detectFormation(basiObjs)
    main_ricostruisciFormazione(basiObjs, fronte)

    IEF_FORM.basiObjs     = basiObjs
    IEF_FORM.unitKey      = unitKey
    IEF_FORM.activePlayer = player
    main_formationRedraw(player)

    return true
end

-- ============================================================
-- FUNZIONE: move_listUnits()
-- ============================================================
function main_listUnits()
    local unita = {}
    for _, obj in ipairs(getAllObjects()) do
        local info = main_parseNickname(obj.getName())
        if info then
            local objSlot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
            if objSlot then
                local unitKey = objSlot .. "_" .. info.unitType .. "_" .. info.unitNumber
                if not unita[unitKey] then
                    unita[unitKey] = {
                        count       = 0,
                        tipo        = info.unitType,
                        numero      = info.unitNumber,
                        slot        = objSlot,
                        nomeDisplay = obj.getDescription(),
                        nickname    = obj.getName(),
                    }
                end
                unita[unitKey].count = unita[unitKey].count + 1
            end
        end
    end

    print("[MOVIMENTO] Unità presenti sul tavolo:")
    for unitKey, dati in pairs(unita) do
        print(string.format("  %s  |  %s  |  \"%s\"  (basi=%d)",
            unitKey, dati.nickname, dati.nomeDisplay ~= "" and dati.nomeDisplay or "?", dati.count))
    end

    return unita
end
-- ============================================================
-- FUNZIONE: main_formationOpen(player)
-- ============================================================
function main_formationOpen(player, value, id, buttonConfig)

    --Chiudo il Move Panel se aperto
    if IEF_MOVE.lineHost then
        IEF_MOVE.lineHost.setVectorLines({})
    end
    
    IEF_MOVE.lineHost     = nil
    IEF_MOVE.basiObjs     = nil
    IEF_MOVE.unitKey      = nil
    IEF_MOVE.activePlayer = nil
    IEF_MOVE.nomeUnita    = nil
    UI.setAttribute("confirm_panel_move", "active", "false")

    local selected = main_getSelectedObjects(player)
    if not selected or #selected < 1 then
        warningToColor("Seleziona almeno una base", player, "Yellow")
        return false
    end

    local mover = selected[1]
    local moverSlot = mover.hasTag("Army1") and 1 or (mover.hasTag("Army2") and 2 or nil)
    if moverSlot == nil then return false end

    local baseInfo = main_parseNickname(mover.getName())
    if not baseInfo then
        warningToColor("Impossibile leggere le informazioni dell'unità", player, "Yellow")
        return false
    end

    local unitKey = moverSlot .. "_" .. baseInfo.unitType .. "_" .. baseInfo.unitNumber

    local basiObjs = {}
    for _, obj in ipairs(selected) do
        local info = main_parseNickname(obj.getName())
        if info then
            local objSlot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
            local objKey  = objSlot and (objSlot .. "_" .. info.unitType .. "_" .. info.unitNumber)
            if objKey == unitKey then
                table.insert(basiObjs, obj)
            end
        end
    end
    if #basiObjs == 0 then return false end

    local nomeUnita = mover.getName():gsub("%.%d+$", "")
    if not nomeUnita or nomeUnita == "" then nomeUnita = unitKey end

    IEF_FORM.basiObjs     = basiObjs
    IEF_FORM.unitKey      = unitKey
    IEF_FORM.activePlayer = player
    IEF_FORM.nomeUnita    = nomeUnita

    main_formationRedraw(player)
    return true
end
-- ============================================================
-- FUNZIONE: main_formationRedraw(player)
-- ============================================================
function main_formationRedraw(player)

    local basiObjs = IEF_FORM.basiObjs
    local unitKey  = IEF_FORM.unitKey
    if not basiObjs or not unitKey then return end

    local baseInfo = main_parseNickname(basiObjs[1].getName())
    local tipo = baseInfo and baseInfo.unitType
    local inMovePhase = (TURN.phase == "MOVE")
    local reformUsed  = IEF_REFORM_USED[unitKey] or false

    UI.setAttribute("confirm_panel_formation", "active", "true")
    UI.setAttribute("confirm_panel_formation", "visibility", player.color)

    local fronteAttuale = main_detectFormation(basiObjs)
    UI.setAttribute("unitInfoFormation", "text", IEF_FORM.nomeUnita)
    UI.setAttribute("formation_label", "text", string.format("Fronte: %d", fronteAttuale))
    
    local function canDo(manovra)
        if not inMovePhase then return true end
        return tipo and main_canManeuver(manovra, tipo)
    end
    local function turnOk()
        if not inMovePhase then return true end
        return IEF_FORM_TEST_MODE or not reformUsed
    end

    local COLOR_ON  = "rgba(0.45,0.45,0.45,1)"
    local COLOR_OFF = "rgba(0.2,0.2,0.2,0.5)"

    local function setBtn(id, ok)
        UI.setAttribute(id, "interactable", ok and "true" or "false")
        UI.setAttribute(id, "color", ok and COLOR_ON or COLOR_OFF)
        Wait.frames(function()
            UI.setAttribute(id, "textColor", "White")
        end, 1)
    end
    
    local reformOk = canDo("espandi_contrai_1_2_basi_fermi") and turnOk()
    setBtn("btnFrontMinus2", reformOk)
    setBtn("btnFrontMinus1", reformOk)
    setBtn("btnFrontPlus1",  reformOk)
    setBtn("btnFrontPlus2",  reformOk)

    local fronte180Ok = canDo("cambio_fronte_180_fermi") and turnOk()
    setBtn("btnCambio180", fronte180Ok)

    local isRettangolare = (#basiObjs % fronteAttuale == 0)
    local fronte90Ok = canDo("cambio_fronte_90_fermi") and isRettangolare and turnOk()
    setBtn("btnCambio90Sx", fronte90Ok)
    setBtn("btnCambio90Dx", fronte90Ok)
end
-- ============================================================
-- FUNZIONE: main_formationClose()
-- ============================================================
function main_formationClose(player, value, id)

    IEF_FORM.basiObjs     = nil
    IEF_FORM.unitKey      = nil
    IEF_FORM.activePlayer = nil
    IEF_FORM.nomeUnita    = nil

    UI.setAttribute("confirm_panel_formation", "active", "false")
    player.clearSelectedObjects()
end
-- ============================================================
-- FUNZIONE: main_formationCheckMatch()
-- Verifica che la selezione mouse attuale corrisponda ancora
-- al gruppo (unitKey) memorizzato in IEF_FORM. Se non combacia,
-- avvisa e blocca l'azione senza toccare nulla.
-- ============================================================
function main_CheckMatch()
    local player = IEF_FORM.activePlayer
    local unitKey = IEF_FORM.unitKey
    if not player or not unitKey then return false end

    local selected = main_getSelectedObjects(player)
    if not selected or #selected < 1 then
        warningToColor("Seleziona di nuovo l'unità: nessuna base selezionata", player, player)
        return false
    end

    local mover = selected[1]
    local moverSlot = mover.hasTag("Army1") and 1 or (mover.hasTag("Army2") and 2 or nil)
    local baseInfo = main_parseNickname(mover.getName())
    if not moverSlot or not baseInfo then return false end

    local currentKey = moverSlot .. "_" .. baseInfo.unitType .. "_" .. baseInfo.unitNumber
    if currentKey ~= unitKey then
        warningToColor(("La selezione dell'unità è cambiata riapri l'unità corretta"), player, "Yellow")
        return false
    end

    return true
end
-- ============================================================
-- FUNZIONE: main_detectFormationSelected(player)
-- Wrapper da console: prende la selezione mouse corrente,
-- filtra per unitKey, rileva il fronte reale con
-- main_detectFormation() e lo stampa in console.
-- ============================================================
function main_detectFormationSelected(player)

    local selected = main_getSelectedObjects(player)
    if not selected or #selected < 1 then
        print("[DETECT] Nessuna base selezionata")
        return nil
    end

    local mover = selected[1]
    local moverSlot = mover.hasTag("Army1") and 1 or (mover.hasTag("Army2") and 2 or nil)
    if moverSlot == nil then
        print("[DETECT] La base selezionata non appartiene a nessun esercito")
        return nil
    end

    local baseInfo = main_parseNickname(mover.getName())
    if not baseInfo then
        print("[DETECT] Impossibile leggere il nickname della base")
        return nil
    end

    local unitKey = moverSlot .. "_" .. baseInfo.unitType .. "_" .. baseInfo.unitNumber

    local basiObjs = {}
    for _, obj in ipairs(selected) do
        local info = main_parseNickname(obj.getName())
        if info then
            local objSlot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
            local objKey  = objSlot and (objSlot .. "_" .. info.unitType .. "_" .. info.unitNumber)
            if objKey == unitKey then
                table.insert(basiObjs, obj)
            end
        end
    end

    local fronte = main_detectFormation(basiObjs)
    local profondita = math.ceil(#basiObjs / fronte)

    print(string.format("[DETECT] Unità %s: %d basi totali, fronte rilevato = %d, profondità ≈ %d",
        unitKey, #basiObjs, fronte, profondita))

    return fronte
end
-- ============================================================
-- FUNZIONE: main_detectFormation(basiObjs)
-- Rileva il fronte ATTUALE dell'unità leggendo le posizioni
-- fisiche reali sul tavolo, invece di fidarsi di uno stato
-- memorizzato che può disallinearsi. Ritorna il numero di basi
-- nel rango più avanzato (il fronte).
-- ============================================================
function main_detectFormation(basiObjs)
    if not basiObjs or #basiObjs < 1 then return 1 end
    if #basiObjs == 1 then return 1 end

    local ref   = basiObjs[1]
    local fwd   = ref.getTransformForward()
    local fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()

    -- Proiezione di ogni base lungo il fronte
    local maxProj = -math.huge
    local projections = {}
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        table.insert(projections, proj)
        if proj > maxProj then maxProj = proj end
    end

    -- Conta quante basi condividono la proiezione massima (stesso rango frontale)
    local EPS = 0.5
    local count = 0
    for _, proj in ipairs(projections) do
        if math.abs(proj - maxProj) < EPS then
            count = count + 1
        end
    end

    return count
end