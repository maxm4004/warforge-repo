-- ============================================================
-- FUNZIONE: main_sistemaFormazione(obj, player_color, alt_click)
-- ============================================================
function main_sistemaFormazione(obj, player_color, alt_click)
    local unitKey = main_getUnitKey(obj)
    if not unitKey then return end
   
    local basiObjs = {}
    for _, o in ipairs(getAllObjects()) do
        if main_getUnitKey(o) == unitKey then
            table.insert(basiObjs, o)
        end
    end

    if unitKey then main_sistemaFormazioneCore(unitKey, basiObjs) end
end 
-- ============================================================
-- FUNZIONE: main_setCenterTextColors(t1, t2)
-- textColor dei bottoni centrali un frame dopo (il cambio di
-- text lo resetta); se la UI sta caricando (buildUI/setXml)
-- aspetta la fine del caricamento.
-- ============================================================
function main_setCenterTextColors(t1, t2)
    local function apply()
        UI.setAttribute(BUTTONS.BTN_ARMY1, "textColor", t1)
        UI.setAttribute(BUTTONS.BTN_ARMY2, "textColor", t2)
    end
    Wait.frames(function()
        if UI.loading then
            Wait.condition(function() Wait.frames(apply, 1) end, function() return not UI.loading end, 10)
        else
            apply()
        end
    end, 1)
end
-- ============================================================
-- FUNZIONE: updateCenterPanel()
-- ============================================================
function main_updateCenterPanel()
    
    if not ENGINE or not ENGINE.phases then return end
    local phase = ENGINE.phases[ENGINE.phase]
    if not phase then return end

    -- Renderer PRIMA — attiva i panel corretti
    local renderer = RENDERERS and RENDERERS[phase.render]
    if renderer then
        renderer(phase)
    else
        printToAll("[IEF] Renderer non trovato: " .. tostring(phase.render), "Red")
    end

    -- Fase e descrizione
    pcall(function()
        UI.setAttribute("versione", "text", VERSION)
        UI.setAttribute("textTurno", "text", "Turno: " .. tostring(ENGINE.turn or 1))
        UI.setAttribute("textFase", "text", (phase.title or ENGINE.phase))
        UI.setAttribute("textDesc", "text", phase.desc or "")
    end)

    -- Nomi e colori eserciti 
    pcall(function() 
        local n1 = (DEPLOYMENT and DEPLOYMENT.urls and DEPLOYMENT.urls.army1 and DEPLOYMENT.urls.army1.nome or "Army 1")
        local n2 = (DEPLOYMENT and DEPLOYMENT.urls and DEPLOYMENT.urls.army1 and DEPLOYMENT.urls.army2.nome or "Army 2")

        UI.setAttribute("army1", "text",  ARMY[1].name)
        UI.setAttribute("army2", "text",  ARMY[2].name)
        UI.setAttribute("army1", "color", colorArmy1 or COLOR.NOARMY)
        UI.setAttribute("army2", "color", colorArmy2 or COLOR.NOARMY)
    end)

    -- Label e colore bottoni DOPO panel già attivo
    pcall(function()
        for slot, button in pairs(phase.buttons or {}) do
            UI.setAttribute(slot, "color",     button.color     or "Grey")
            UI.setAttribute(slot, "text",      button.label     or slot)
            UI.setAttribute(slot, "textColor", button.textColor or "White")
        end
    end)

    -- Stato bottoni
    pcall(function()
        if ENGINE.phase == PHASE.SITTING then
            if colorArmy1 ~= COLOR.NOARMY then
                UI.setAttribute(BUTTONS.BTN_ARMY1, "color", COLOR.NOARMY)
            end
            if colorArmy2 ~= COLOR.NOARMY then
                UI.setAttribute(BUTTONS.BTN_ARMY2, "color", COLOR.NOARMY)
            end
        elseif phase.inputMode == "INITIATIVE" then

            -- Attivo solo chi ha l'iniziativa e non ha completato:
            -- 1) red/grey  2) grey/green  3) grey/grey (transizione)
            local completed = (TURN and TURN.completed) or {}
            local attivo1 = TURN and TURN.activeArmy == "Army1" and not completed.Army1
            local attivo2 = TURN and TURN.activeArmy == "Army2" and not completed.Army2

            UI.setAttribute(BUTTONS.BTN_ARMY1, "interactable", "true")
            UI.setAttribute(BUTTONS.BTN_ARMY2, "interactable", "true")
            UI.setAttribute(BUTTONS.BTN_ARMY1, "color", attivo1 and (colorArmy1 or COLOR.NOARMY) or COLOR.NOARMY)
            UI.setAttribute(BUTTONS.BTN_ARMY2, "color", attivo2 and (colorArmy2 or COLOR.NOARMY) or COLOR.NOARMY)

            main_setCenterTextColors(attivo1 and "White" or "Black", attivo2 and "White" or "Black")

        else
            -- OWNER: grigio chiaro = completato; bianco solo su quello cliccabile
            local completed = (TURN and TURN.completed) or {}
            local fatto1 = completed.Army1 == true
            local fatto2 = completed.Army2 == true

            UI.setAttribute(BUTTONS.BTN_ARMY1, "interactable", "true")
            UI.setAttribute(BUTTONS.BTN_ARMY2, "interactable", "true")
            if fatto1 then UI.setAttribute(BUTTONS.BTN_ARMY1, "color", COLOR.NOARMY) end
            if fatto2 then UI.setAttribute(BUTTONS.BTN_ARMY2, "color", COLOR.NOARMY) end

            main_setCenterTextColors(fatto1 and "Black" or "White", fatto2 and "Black" or "White")
        end
    end)

    -- Livello sottofasi: pannelli e blocco dei bottoni di fase
    engine_subRedraw()
        -- Schede unità aperte: si ricalcolano (cambio fase compreso)
    main_unitInfoRefresh()
end
-- ============================================================
-- FUNZIONE: aggiornaLinee()
-- ============================================================
function main_aggiornaLinee()

      
    local linee = {}

    local Y_LINEE    = 1.22
    local LX = 66.806
    local LZ = 44.536
    local DEPLOY_TTS = 30.48 * CM_TO_TTS   -- 12 pollici in TTS = 22.59
    local LAT_TTS = 6 * INCH_TO_TTS  -- 6 pollici in TTS = 11.31
    local LX_SPAWN   = 84.00


    if linea_field then
        table.insert(linee, { 
            points={{x=-LX,y=Y_LINEE,z=0},{x=LX,y=Y_LINEE,z=0}}, color={r=0.8,g=0.8,b=0.8}, thickness=0.3})
    end

    if linee_deploy then
        local y = Y_LINEE
                
        table.insert(linee, { points={{x=-(LX-LAT_TTS),y=y,z=-(LZ-DEPLOY_TTS)},{x=(LX-LAT_TTS),y=y,z=-(LZ-DEPLOY_TTS)}}, color={r=0.9,g=0.2,b=0.2}, thickness=0.3 })
        table.insert(linee, { points={{x=-(LX-LAT_TTS),y=y,z= (LZ-DEPLOY_TTS)},{x=(LX-LAT_TTS),y=y,z= (LZ-DEPLOY_TTS)}}, color={r=0.2,g=0.8,b=0.2}, thickness=0.3 })

         -- Lato sinistro zona deploy Army1 (rosso)
        table.insert(linee, { points={{x=-(LX-LAT_TTS),y=Y_LINEE,z=-LZ},{x=-(LX-LAT_TTS),y=Y_LINEE,z=-(LZ-DEPLOY_TTS)}}, color={r=0.9,g=0.2,b=0.2}, thickness=0.2 })
        table.insert(linee, { points={{x= (LX-LAT_TTS),y=Y_LINEE,z=-LZ},{x= (LX-LAT_TTS),y=Y_LINEE,z=-(LZ-DEPLOY_TTS)}}, color={r=0.9,g=0.2,b=0.2}, thickness=0.2 })

        -- Lato sinistro zona deploy Army2 (verde)
        table.insert(linee, { points={{x=-(LX-LAT_TTS),y=Y_LINEE,z=LZ},{x=-(LX-LAT_TTS),y=Y_LINEE,z=(LZ-DEPLOY_TTS)}}, color={r=0.2,g=0.8,b=0.2}, thickness=0.2 })
        table.insert(linee, { points={{x= (LX-LAT_TTS),y=Y_LINEE,z=LZ},{x= (LX-LAT_TTS),y=Y_LINEE,z=(LZ-DEPLOY_TTS)}}, color={r=0.2,g=0.8,b=0.2}, thickness=0.2 })

    end

    if linee_spawn then

        local y   = Y_LINEE
        local profondita = 22
        local gap = 4  -- unità TTS di distanza dal bordo tavolo

            -- Rettangolo Army1 (rosso)
            table.insert(linee, { points={
                {x=-LX_SPAWN, y=y, z=-(LZ+gap)},
                {x= LX_SPAWN, y=y, z=-(LZ+gap)},
                {x= LX_SPAWN, y=y, z=-(LZ+gap+profondita)},
                {x=-LX_SPAWN, y=y, z=-(LZ+gap+profondita)},
                {x=-LX_SPAWN, y=y, z=-(LZ+gap)}
            }, color={r=1,g=0,b=0}, thickness=0.3 })

            -- Rettangolo Army2 (verde)
            table.insert(linee, { points={
                {x=-LX_SPAWN, y=y, z= LZ+gap},
                {x= LX_SPAWN, y=y, z= LZ+gap},
                {x= LX_SPAWN, y=y, z= LZ+gap+profondita},
                {x=-LX_SPAWN, y=y, z= LZ+gap+profondita},
                {x=-LX_SPAWN, y=y, z= LZ+gap}
            }, color={r=0,g=1,b=0}, thickness=0.3 })

            if linee_settori then
                local cols=3; local rows=2
                local sx=(LX*2)/cols;
                local sz=(LZ*2)/rows;
                local y = 1.25
                for c=0,cols do local x=-LX+c*sx; table.insert(linee,{points={{x,y,-LZ},{x,y,LZ}},color={r=0.2,g=0.8,b=0.8},thickness=0.1}) end
                for r=0,rows do local z=-LZ+r*sz; table.insert(linee,{points={{-LX,y,z},{LX,y,z}},color={r=0.2,g=0.8,b=0.8},thickness=0.1}) end
            end
    end

    if ENGINE_MEASURE and ENGINE_MEASURE.activeLine then
        table.insert(linee, ENGINE_MEASURE.activeLine)
    end

    if IEF_SHOOTING and IEF_SHOOTING.activeLines then
        for _, l in ipairs(IEF_SHOOTING.activeLines) do
            table.insert(linee, l)
        end
    end

    if main_generalMoveLines then
        for _, l in ipairs(main_generalMoveLines()) do
            table.insert(linee, l)
        end
    end

    -- F32: corridoio e filo del movimento manuale
    if move_manualLines then
        for _, l in ipairs(move_manualLines()) do
            table.insert(linee, l)
        end
    end

    -- Debug: rettangoli di tutte le basi (debug_allRects)
    for _, l in ipairs(IEF_DEBUG_RECT_LINES or {}) do
        table.insert(linee, l)
    end

    Global.setVectorLines(linee)
end
-- ============================================================
-- FUNZIONE: restart()
-- ============================================================
function main_restart()

    initPhases()

    ENGINE = ENGINE or {}
    ENGINE.handlers = ENGINE.handlers or {}
    ENGINE.conditions = ENGINE.conditions or {}

    ENGINE.phase = "SITTING"
    ENGINE.turn = 1
 
    colorArmy1 = COLOR.NOARMY
    colorArmy2 = COLOR.NOARMY
     
    DICE_CONTEST = {
        rolledNumberArmy1 = nil,
        rolledNumberArmy2 = nil,
        winner = nil,
        initiative = nil
    }
    
    TURN = {
        phase = "SITTING",
        activeArmy = nil,
        firstArmy = nil,
        completed = {
            Army1 = false,
            Army2 = false
        }
    }
 
    IEF_CHARGE_QUEUE = {}
    IEF_CHARGE_DECLARE_SESSION = {}
    IEF_MELEE_LIST = {}
    IEF_MELEE_NEXT_ID = 0
    IEF_MELEE_INFO_HOST = {}
    IEF_MELEE_MARKED = {}
    IEF_UNIT_BASES_LOST = {}
    IEF_MORALE_END_QUEUE = {}
    IEF_MELEE_MARKED = {}
    IEF_MARKED_LOSSES = {}
    IEF_MORALE_ROLL_PENDING = { [1] = {}, [2] = {} }
    IEF_MORALE_NEXT_ID = 0
    IEF_GENERAL_ATTACHED = {}
    IEF_ROUT_PENDING = { [1] = {}, [2] = {} }
    IEF_ROUT_NEXT_ID = 0
    IEF_MORALE_TEST_ROLLING = { [1] = false, [2] = false }
    IEF_GENERAL_MOVE_START = {}
    IEF_GENERAL_MOVE_CIRCLE = {}

    engine_subInitState()
    engine_dicePanelClose(1)
    engine_dicePanelClose(2)
    main_unitInfoClose(1)
    main_unitInfoClose(2)
    main_setWinnerIcon(1, false)
    main_setWinnerIcon(2, false)

    UI.setAttribute("iconMoveArmy1", "active", "false")
    UI.setAttribute("iconMoveArmy2", "active", "false")

    UI.setAttribute("charge_attack_list_title_army1",  "active", "false")
    UI.setAttribute("charge_attack_list_title_army2",  "active", "false")
    UI.setAttribute("charge_defense_list_title_army1", "active", "false")
    UI.setAttribute("charge_defense_list_title_army2", "active", "false")

    -- Rimuovi elementi terreno spawnati
    for _, obj in ipairs(getAllObjects()) do
        if obj.hasTag and (obj.hasTag("Hill") or obj.hasTag("Field") or obj.hasTag("Wood")) then
            obj.destruct()
        end
    end
       
    for key, _ in pairs(IEF_UNIT_COHESION or {}) do
        for _, obj in ipairs(main_getUnitBases(key)) do
            obj.setColorTint(COHESION_TINT[COHESION.SAL])
        end
    end
    IEF_UNIT_COHESION = {}

    main_initUI()
    main_resetPlayers()
    restoreDiceUiState()
    main_updateCenterPanel()
    FIELD_STATE = field_defaultState()
    field_handPreviewReset(1)
    field_handPreviewReset(2)
    field_clearTerrainCards()
    callHandler("deployment_resetRuntimeOnly")
    callHandler("deployment_clearSpawnedModels") 

    FIELD_STATE.orientamento1 = orientamentoArmy1
    FIELD_STATE.orientamento2 = orientamentoArmy2

    FIELD_STATE.army1Elements = FIELD_ELEMENTS_BY_ORIENTAMENTO[orientamentoArmy1]
    FIELD_STATE.army2Elements = FIELD_ELEMENTS_BY_ORIENTAMENTO[orientamentoArmy2]

    linee_spawn = true
    linea_field   = false
    linee_deploy  = false
    linee_settori = false
    callHandler("engine_diceClearLastRoll", 1)
    callHandler("engine_diceClearLastRoll", 2)
    callHandler("engine_cameraResetAll")
    callHandler("aggiornaLinee")
    warning("RESTART...", "Yellow")

end
-- ============================================================
-- FUNZIONE: main_SlotByColor(color)
-- ============================================================
function main_SlotByColor(color)
    if color == COLOR.ARMY1 then return 1 end
    if color == COLOR.ARMY2 then return 2 end
    return nil
end
-- ============================================================
-- FUNZIONE: getArmyByColor()
-- ============================================================
function main_ArmyByColor(color)
    if color == COLOR.ARMY1 then return "Army1" end
    if color == COLOR.ARMY2 then return "Army2" end
    return nil
end
-- ============================================================
-- FUNZIONE: getColorByArmySlot()
-- ============================================================
function main_ColorByArmySlot(armySlot)
    if armySlot == "Army1" then return COLOR.ARMY1 end
    if armySlot == "Army2" then return COLOR.ARMY2 end
    return nil
end
-- ============================================================
-- FUNZIONE: ief_getSelectedObjects(player)
-- ============================================================
function main_SelectedObjects(player)
    if player then
        local selected = Player[player.color].getSelectedObjects()
        if selected and #selected > 0 then return selected end
        return {}
    end

    for _, p in ipairs(main_SeatedPlayers()) do
        local selected = Player[p.color].getSelectedObjects()
        if selected and #selected > 0 then return selected end
    end
    return {}
end
-- ============================================================
-- FUNZIONE: getSeatedPlayers()
-- ============================================================
function main_SeatedPlayers()
    local result = {}
    for _, p in ipairs(Player.getPlayers()) do
        if p and p.seated and (p.color == COLOR.ARMY1 or p.color == COLOR.ARMY2) then
            table.insert(result, p)
        end
    end
    return result
end
-- ============================================================
-- FUNZIONE: resetPlayers()
-- ============================================================
function main_resetPlayers()
    for _, p in ipairs(Player.getPlayers()) do
        if p then p.changeColor(COLOR.NOARMY) end
    end
end
-- ============================================================
-- FUNZIONE: goToPhase(phaseName)
-- Transizione manuale a una fase (bypass condizioni)
-- ============================================================
function main_goToPhase(phaseName)
    if not ENGINE or not ENGINE.phases then return end
    if not ENGINE.phases[phaseName] then
        print("[GOTO] Phase not found: " .. phaseName)
        return
    end
    local oldPhase = ENGINE.phase
    engine_exitPhase(oldPhase)
    ENGINE.phase = phaseName
    engine_resetState()
    engine_enterPhase(phaseName, oldPhase)
    main_updateCenterPanel()
end
-- ============================================================
-- FUNZIONE: resetTurnForPhase()
-- ============================================================
function main_resetTurnForPhase()
    if DEBUG then print("resetTurnForPhase") end
    if not DICE_CONTEST or not DICE_CONTEST.initiative then return end

    local army = main_ArmyByColor(DICE_CONTEST.initiative.color)
    TURN.phase          = ENGINE.phase
    TURN.firstArmy      = army
    TURN.activeArmy     = army
    TURN.completed.Army1 = false
    TURN.completed.Army2 = false
end
--=============================================================
--FUNZIONE: getArmyByButton()
--=============================================================
function main_getArmyByButton(id)
    for k,v in pairs(ARMY) do
        if v.button == id then
            return k
        end
    end
    return nil
end
--=============================================================
--FUNZIONE: getArmyByColor()
--=============================================================
function main_getArmyByColor(player)

    for k,v in pairs(ARMY) do
        if v.color == player.color then
            return k
        end
    end
    return nil
end
-- ============================================================
-- FUNZIONE: dice_check()
-- ============================================================
function main_dice_check()

   if not DICE_CONTEST.rolledNumberArmy1 or not DICE_CONTEST.rolledNumberArmy2 then return end

    if DICE_CONTEST.rolledNumberArmy1 == DICE_CONTEST.rolledNumberArmy2 then
        DICE_CONTEST.rolledNumberArmy1 = nil
        DICE_CONTEST.rolledNumberArmy2 = nil
        DICE_CONTEST.winner = nil
        return
    end

    if DICE_CONTEST.rolledNumberArmy1 > DICE_CONTEST.rolledNumberArmy2 then
        DICE_CONTEST.winner = 1
    else
        DICE_CONTEST.winner = 2
    end   
end
-- ============================================================
-- FUNZIONE: advanceTurnAfterClick()
-- ============================================================
function main_advanceTurnAfterClick(slot)
   
    if slot == BUTTONS.BTN_ARMY1 then
        TURN.completed.Army1 = true
    end

    if slot == BUTTONS.BTN_ARMY2 then
        TURN.completed.Army2 = true
    end

    if TURN.activeArmy == "Army1" then
        if TURN.completed.Army2 then
            TURN.activeArmy = nil
        else
            TURN.activeArmy = "Army2"
        end
        return
    end

    if TURN.activeArmy == "Army2" then
        if TURN.completed.Army1 then
            TURN.activeArmy = nil
        else
            TURN.activeArmy = "Army1"
        end
        return
    end
end
-- ============================================================
-- FUNZIONE: canUseButton()
-- ============================================================
function main_canUseButton(slot, player, value, id, button, phase)

    local mode = phase and phase.inputMode or "FREE"

    -- ========================================================
    -- FREE: tutti possono cliccare
    -- ========================================================
    if mode == "FREE" then
        return true
    end

    -- ========================================================
    -- OWNER: solo il player del bottone
    -- ========================================================
    if mode == "OWNER" then

        if slot == BUTTONS.BTN_ARMY1 then
            if not player or player.color ~= COLOR.ARMY1 then
                warningToColor("Non è possibile usare questo pulsante", player, "Yellow", 5, false)
                return false
            end
        end

        if slot == BUTTONS.BTN_ARMY2 then
            if not player or player.color ~= COLOR.ARMY2 then
                warningToColor("Non è possibile usare questo pulsante", player, "Yellow", 5, false)
                return false
            end
        end

        return true
    end

    -- ========================================================
    -- INITIATIVE: gestione turno con TURN
    -- ========================================================
    if mode == "INITIATIVE" then

        local activeColor = main_ColorByArmySlot(TURN.activeArmy)

        -- se esiste un turno attivo, solo lui può cliccare
        if activeColor then
            -- bottone di chi non ha l'iniziativa: nessun effetto
            local activeBtn = (TURN.activeArmy == "Army1") and BUTTONS.BTN_ARMY1 or BUTTONS.BTN_ARMY2
            if slot ~= activeBtn then
                return false
            end
            if not player or player.color ~= activeColor then
                warningToColor("Non è possibile usare questo pulsante", player, "Yellow", 5, false)
                return false
            end
        end
        return true
    end

    return true
end
-- ============================================================
-- FUNZIONE: prettyPrintTable()
-- ============================================================
function printTable(t, indent)
    indent = indent or 0
    if type(t) ~= "table" then
        print(tostring(t))
        return
    end
    for k, v in pairs(t) do
        local prefix = string.rep("  ", indent) .. tostring(k) .. ": "
        if type(v) == "table" then
            print(prefix)
            printTable(v, indent + 1)
        else
            print(prefix .. tostring(v))
        end
    end
end
-- ============================================================
-- FUNZIONE: initUI()
-- ============================================================
function main_initUI()
    callHandler("buildUI")
end
-- ============================================================
-- FUNZIONE: main_findUnit(slot, tipo, unita_num)
-- Trova un'unità in DEPLOYMENT.scanned
-- ============================================================
function main_findUnit(slot, tipo, unita_num)
    local esercito = DEPLOYMENT.scanned and DEPLOYMENT.scanned[slot]
    if not esercito then return nil end

    for _, u in ipairs(esercito) do
        if u.tipo == tipo and u.unita_num == unita_num then
            return u
        end
    end
    return nil
end
-- ============================================================
-- FUNZIONE: getSelectedObjects()
-- ============================================================
function main_getSelectedObjects(player)

    if player then
        local selected = player.getSelectedObjects()
        if selected and #selected > 0 then return selected end
        return {}
    end

    -- fallback senza player (comportamento precedente)
    for _, p in ipairs(main_SeatedPlayers()) do
        local selected = player.getSelectedObjects()
        if selected and #selected > 0 then return selected end
    end
    return {}
end

-- ============================================================
-- FUNZIONE: basiPresentiUnita(unita)
-- ============================================================
function main_basiPresentiUnita(unita)
    local count = 0
    for _, base in ipairs(unita.basi) do
        local obj = getObjectFromGUID(base.guid)
        if obj then count = count + 1 end
    end
    return count
end
-- ============================================================
-- FUNZIONE: main_figureTotaliUnita(unita)
-- IEF: nessuna perdita parziale per base — figure = basi
-- presenti x figures_per_base.
-- ============================================================
function main_figureTotaliUnita(unita)
    local fpb = (IEF_DATA.unitTypes and IEF_DATA.unitTypes[unita.tipo] or {}).figures_per_base or 0
    return main_basiPresentiUnita(unita) * fpb
end
-- ============================================================
-- FUNZIONE: aggiornaSchedeUnita() — compatibilità
-- ============================================================
function main_aggiornaSchedeUnita()
end
-- ============================================================
-- FUNZIONE: ief_data_onLoaded(errors)
-- Chiamata quando tutti i JSON base sono stati processati.
-- ============================================================
function main_data_onLoaded(errors)
    if errors and errors > 0 then
        printToAll("[IEF_DATA] Caricamento completato con " .. errors .. " errori.", {r=1,g=0.6,b=0})
    else
        local nUnit = 0
        for _ in pairs(IEF_DATA.unitTypes or {}) do nUnit = nUnit + 1 end
        printToAll("[IEF_DATA] Dati Json caricati - " .. nUnit .. " file", {r=0.4,g=0.9,b=0.4})
    end


    callHandler("ief_data_ready")
end
-- ============================================================
-- FUNZIONE: ief_loadArmy(nome, callback)
-- Carica on-demand l'esercito richiesto (cache in IEF_DATA.armies).
-- ============================================================
function main_loadArmy(nome, callback)
    if IEF_DATA.armies[nome] then
        if callback then callback(IEF_DATA.armies[nome]) end
        return
    end

    WebRequest.get(IEF_JSON_ARMIES_URL .. nome .. ".json", function(request)
        if request.is_error then
            printToAll("[IEF_DATA] Errore caricamento esercito: " .. nome, {r=1,g=0.3,b=0.3})
            if callback then callback(nil) end
            return
        end
        local ok, decoded = pcall(JSON.decode, request.text)
        if not ok or not decoded then
            printToAll("[IEF_DATA] JSON decode fallito: armies/" .. nome, {r=1,g=0.3,b=0.3})
            if callback then callback(nil) end
            return
        end
        IEF_DATA.armies[nome] = decoded
        if callback then callback(decoded) end
    end)
end
-- ============================================================
-- FUNZIONE: ief_loadScenario(nome, callback)
-- Carica on-demand lo scenario richiesto (cache in IEF_DATA.scenari).
-- ============================================================
function main_loadScenario(nome, callback)
    if IEF_DATA.scenari[nome] then
        if callback then callback(IEF_DATA.scenari[nome]) end
        return
    end

    WebRequest.get(IEF_JSON_SCENARI_URL .. nome .. ".json", function(request)
        if request.is_error then
            printToAll("[IEF_DATA] Errore caricamento scenario: " .. nome, {r=1,g=0.3,b=0.3})
            if callback then callback(nil) end
            return
        end
        local ok, decoded = pcall(JSON.decode, request.text)
        if not ok or not decoded then
            printToAll("[IEF_DATA] JSON decode fallito: scenari/" .. nome, {r=1,g=0.3,b=0.3})
            if callback then callback(nil) end
            return
        end
        IEF_DATA.scenari[nome] = decoded
        if callback then callback(decoded) end
    end)
end
-- ============================================================
-- FUNZIONE: ief_data_reset()
-- ============================================================
function main_data_reset()
    IEF_DATA.unitTypes    = {}
    IEF_DATA.morale       = {}
    IEF_DATA.weapons      = {}
    IEF_DATA.capabilities = {}
    IEF_DATA.terrain      = {}
    IEF_DATA.movement     = {}
    IEF_DATA.melee        = {}
    IEF_DATA.armies       = {}
    IEF_DATA.scenari      = {}
end
-- ============================================================
-- FUNZIONE: main_count()
-- ============================================================
function main_count(t)
    if type(t) ~= "table" then return 0 end
    local n = 0
    for _ in pairs(t) do n = n + 1 end
    return n
end
-- ============================================================
-- API PUBBLICA — funzioni di accesso read-only
-- Tutte fanno guard su nil e stampano un errore chiaro.
-- ex:ief_getUnitType("KN") → { base_width_cm=4, base_depth_cm=3, ... }
-- ============================================================
function main_getUnitType(tipo)
    if not IEF_DATA.unitTypes then
        print("[IEF_DATA] unitTypes non caricato"); return nil
    end
    local r = IEF_DATA.unitTypes[tipo]
    if not r then print("[IEF_DATA] Tipo unità non trovato: " .. tostring(tipo)) end
    return r
end

