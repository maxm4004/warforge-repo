-- ============================================================
-- FUNZIONE: main_pivotFrontCorner(basiObjs, direzione, pollici)
-- Perno secondo il regolamento: l'unità ruota rigidamente attorno
-- all'ANGOLO ANTERIORE esterno del lato del perno ("left" =
-- angolo sinistro) e l'angolo anteriore opposto percorre
-- esattamente "pollici" (arco). Angolo = pollici / larghezza del
-- fronte, quindi il costo è esatto per qualsiasi fronte.
-- Stessa convenzione di segno dei perni precedenti (left < 0).
-- Ritorna l'angolo applicato (radianti) o nil.
-- ============================================================
-- ============================================================
-- F34: DESTRA E SINISTRA DELL'UNITÀ (unica convenzione)
-- Destra = quella di TTS (getTransformRight): con il fronte
-- (fx, 0, fz) la destra è (fz, 0, -fx). Prima i perni usavano il
-- vettore opposto: "Perno Sx" teneva fermo l'angolo destro.
-- Etichette: Sn = sinistra, Ds = destra.
-- ============================================================
function main_rightOf(fwd)
    return Vector(fwd.z, 0, -fwd.x)
end

-- Angoli anteriori estremi dell'unità (sx = sinistro, dx = destro)
-- e versori fronte/destra. F33: riusata dal perno manuale.
function main_pivotCorners(basiObjs)
    if not basiObjs or #basiObjs < 1 then return nil end
    local meta = main_getUnitMeta(basiObjs[1])
    local tipo = meta and meta.unitType
    local f0 = basiObjs[1].getTransformForward()
    local fwd = Vector(f0.x, 0, f0.z):normalized()
    local right = main_rightOf(fwd)
    local fronte = -math.huge
    local angoli = {}
    for _, b in ipairs(basiObjs) do
        for _, c in ipairs(main_baseRectOfType(b, tipo).corners) do
            local v = c.x * fwd.x + c.z * fwd.z
            table.insert(angoli, { x = c.x, z = c.z, v = v, u = c.x * right.x + c.z * right.z })
            if v > fronte then fronte = v end
        end
    end
    local sx, dx = nil, nil
    for _, c in ipairs(angoli) do
        if c.v >= fronte - 0.05 then
            if not sx or c.u < sx.u then sx = c end
            if not dx or c.u > dx.u then dx = c end
        end
    end
    if not sx or not dx then return nil end
    return sx, dx, fwd, right
end

function main_pivotFrontCorner(basiObjs, direzione, pollici)
    if not basiObjs or #basiObjs < 2 or not pollici or pollici <= 0 then return nil end
    local meta = main_getUnitMeta(basiObjs[1])
    local tipo = meta and meta.unitType
    local f0 = basiObjs[1].getTransformForward()
    local fwd = Vector(f0.x, 0, f0.z):normalized()
    local right = main_rightOf(fwd)

    -- angoli anteriori (rettangoli reali) di tutte le basi
    local fronte = -math.huge
    local angoli = {}
    for _, b in ipairs(basiObjs) do
        for _, c in ipairs(main_baseRectOfType(b, tipo).corners) do
            local v = c.x * fwd.x + c.z * fwd.z
            table.insert(angoli, { x = c.x, z = c.z, v = v, u = c.x * right.x + c.z * right.z })
            if v > fronte then fronte = v end
        end
    end
    local sx, dx = nil, nil
    for _, c in ipairs(angoli) do
        if c.v >= fronte - 0.05 then
            if not sx or c.u < sx.u then sx = c end
            if not dx or c.u > dx.u then dx = c end
        end
    end
    if not sx or not dx then return nil end
    local perno, lontano = sx, dx
    if direzione ~= "left" then perno, lontano = dx, sx end
    local larghezza = math.sqrt((lontano.x - perno.x) ^ 2 + (lontano.z - perno.z) ^ 2)
    if larghezza < 0.01 then return nil end

    local ang = (pollici * INCH_TO_TTS) / larghezza
    -- F34: perno a sinistra = angolo sinistro fermo, la destra
    -- avanza: con la destra vera (main_rightOf) l'angolo è positivo
    if direzione ~= "left" then ang = -ang end
    local gradi = math.deg(ang)
    local cs, sn = math.cos(ang), math.sin(ang)
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local rx, rz = p.x - perno.x, p.z - perno.z
        main_setPositionOnGround(obj, perno.x + rx * cs - rz * sn, perno.z + rx * sn + rz * cs, ang)
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y - gradi, rot.z))
    end
    main_syncGeneralsOfBases(basiObjs)
    return ang
end

-- ============================================================
-- FUNZIONE: main_baseDims(obj, tipo)
-- Larghezza e profondità della base in unità TTS: misure reali
-- della mesh (centroMesh w/d, salvate al deploy) se ci sono,
-- altrimenti quelle dichiarate in unit_types.
-- ============================================================
function main_baseDims(obj, tipo)
    local c = obj and main_baseCentro(obj) or {}
    local ut = tipo and main_getUnitType(tipo)
    local w = (c.w and c.w > 0) and c.w or ((ut and ut.base_width_cm or 4) * CM_TO_TTS)
    local d = (c.d and c.d > 0) and c.d or ((ut and tonumber(ut.base_depth_cm) or 3) * CM_TO_TTS)
    return w, d
end

-- ============================================================
-- FUNZIONE: main_capabilitiesOf(unitKey, meta)
-- Capacità EFFETTIVE dell'unità: regolamento, EFFETTI DEL
-- DISORDINE: "Perderanno tutti gli effetti delle loro CAPACITA',
-- tranne per la capacità SPADA". meta opzionale (GMNotes).
-- ============================================================
function main_capabilitiesOf(unitKey, meta)
    if not meta then
        local b = unitKey and main_getUnitBases(unitKey)[1]
        meta = b and main_getUnitMeta(b)
    end
    local tutte = (meta and meta.capabilities) or {}
    if not unitKey or main_getCohesion(unitKey) ~= COHESION.DIS then return tutte end
    local out = {}
    for _, c in ipairs(tutte) do
        if c == "SPADA" then table.insert(out, c) end
    end
    return out
end

-- ============================================================
-- FUNZIONE: main_canManeuver(manovra, tipoUnita)
-- ============================================================   
function main_canManeuver(manovra, tipoUnita)
    local maneuvers = IEF_DATA.movement and IEF_DATA.movement.maneuvers
    if not maneuvers then
        print("[IEF_DATA] movement non caricato"); return nil
    end
    local m = maneuvers[manovra]
    if not m then
        print("[IEF_DATA] Manovra non trovata: " .. tostring(manovra)); return nil
    end
    return m[tipoUnita] == true
end

-- ============================================================
-- FUNZIONE: main_unitFullMove(unitKey)
-- Mossa piena dell'unità in pollici (unit_types.move_inches).
-- ============================================================
function main_unitFullMove(unitKey)
    local info = nil
    for _, o in ipairs(getAllObjects()) do
        if main_getUnitKey(o) == unitKey then
            info = main_parseNickname(o.getName())
            if info then break end
        end
    end
    local tipo = main_isGeneralKey(unitKey) and "GEN" or (info and info.unitType)
    local ut = tipo and main_getUnitType(tipo)
    return (ut and ut.move_inches) or 0
end

-- ============================================================
-- FUNZIONE: main_unitHasMoved(unitKey)
-- True se nella fase MOVE l'unità ha già speso movimento o
-- perni (budget sotto il valore pieno).
-- ============================================================
function main_unitHasMoved(unitKey)
    local mossa = IEF_MOVE_BUDGET[unitKey]
    local perni = IEF_PIVOT_BUDGET[unitKey]
    if perni ~= nil and perni < 3 then return true end
    if mossa ~= nil and mossa < main_unitFullMove(unitKey) - 0.001 then return true end
    return false
end

-- ============================================================
-- FUNZIONE: main_formationCanStart(unitKey, manovraFermi, tipo, player)
-- Regolamento (tabella movimenti): cambio di formazione/fronte
-- una sola volta, solo prima di muovere e solo se il tipo può.
-- ============================================================
function main_formationCanStart(unitKey, manovraFermi, tipo, player)
    if TURN.phase ~= "MOVE" or IEF_FORM_TEST_MODE then return true end
    local function no(msg)
        if player then printToColor("[FORMAZIONE] " .. msg, player.color, {r=1,g=0.6,b=0}) end
        return false
    end
    -- In rotta: "potrà contrarre il fronte" (anche durante la mossa,
    -- senza costo); nessun'altra manovra di formazione.
    if main_getCohesion(unitKey) == COHESION.ROT then
        if manovraFermi ~= "espandi_contrai_1_2_basi_fermi" then
            return no("Unità in rotta: può solo contrarre il fronte")
        end
        return true
    end
    if IEF_REFORM_USED[unitKey] then return no("Manovra già usata questo turno") end
    if main_unitHasMoved(unitKey) then return no("L'unità ha già mosso: niente cambi di formazione") end
    if not main_canManeuver(manovraFermi, tipo) then return no("Questa unità non può fare questa manovra") end
    return true
end

-- ============================================================
-- FUNZIONE: main_formationAfter(unitKey, manovraMuovi, tipo)
-- Dopo il cambio: se il tipo NON può "e poi muovere" la
-- manovra consuma tutta la mossa (budget a 0); altrimenti la
-- mossa resta intera (il cambio non costa pollici).
-- ============================================================
function main_formationAfter(unitKey, manovraMuovi, tipo)
    if main_getCohesion(unitKey) == COHESION.ROT then return end   -- contrazione in rotta: gratuita
    IEF_REFORM_USED[unitKey] = true
    if TURN.phase ~= "MOVE" or IEF_FORM_TEST_MODE then return end
    if not main_canManeuver(manovraMuovi, tipo) then
        IEF_MOVE_BUDGET[unitKey]  = 0
        IEF_PIVOT_BUDGET[unitKey] = 0
        -- Pannello unico: resta aperto (si può annullare); i
        -- bottoni di movimento si spengono (mossa consumata).
        if IEF_MOVE_UNITS and IEF_MOVE_UNITS[unitKey] then IEF_MOVE_UNITS[unitKey].consumata = true end
    end
end
