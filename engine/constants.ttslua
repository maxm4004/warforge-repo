-- ============================================================
-- WARFORGE IEF — engine/constants.ttslua
-- Costanti di configurazione della cartella (valori fissi:
-- misure, tolleranze, colori, interruttori, GUID, tabelle di
-- regole). Lo stato della partita resta in state.ttslua.
-- ============================================================

-- ------------------------------------------------------------
-- (da engine/dice.ttslua)
-- ------------------------------------------------------------
IEF_DICE_TRAY_GUID = IEF_DICE_TRAY_GUID or {
    [1] = "5418fe",
    [2] = "efb29f",
}

IEF_DICE_BAG_GUID = IEF_DICE_BAG_GUID or {
    [1] = "eb4ed3",
    [2] = "1338a3",
}

IEF_DICE_ZONE = IEF_DICE_ZONE or {
    [1] = { x = -77.72, y = 1.44, z = -35.97 },
    [2] = { x = 77.72, y = 1.44, z = 35.97 },    
}

IEF_DICE_SPAWN_POS = IEF_DICE_SPAWN_POS or {
    [1] = { x = 75.70, y = 1.44, z = -67.99 },
    [2] = { x = -75.70, y = 1.44, z = 67.99 },
}

IEF_DICE_CAMERA_HOME = {
    [1] = { x = 0, y = 40, z = 0 },   -- vista overview default per slot 1, aggiusta ai tuoi valori
    [2] = { x = 0, y = 40, z = 0 },   -- vista overview default per slot 2, aggiusta ai tuoi valori
}

IEF_DICE_CAMERA_YAW = {
    [1] = 0,
    [2] = 180,
}

-- ------------------------------------------------------------
-- (da engine/dicepanel.ttslua)
-- ------------------------------------------------------------
DICEPANEL = DICEPANEL or {
    rectAlignment = "MiddleCenter",
    offsetXY      = "0 -345",
    colWidth      = 330,      -- larghezza di una colonna
    colGap        = 16,       -- spazio fra le due colonne
    bg            = "rgba(0,0,0,0.70)",
    padding       = 12,
    spacing       = 2,
    font          = "warforge_font",
    titleColor    = "#FFD833",   -- titolo, intestazioni di sezione, "serve"
    textColor     = "White",
    subColor      = "#BBBBBB",   -- sottotitolo (nota sotto il titolo)
    titleHeight   = 24,
    subHeight     = 16,
    rowHeight     = 17,
    needHeight    = 22,
    outcomeHeight = 26,
    noteHeight    = 30,       -- nota sotto l'esito (2 righe)
    valueWidth    = 90,       -- colonna dei valori delle righe
    maxRows       = 14,
    maxFaces      = 24,
    faceSize      = 28,
    faceSpacing   = 4,
    faceKoColor   = "rgba(1,1,1,0.3)",   -- dado non riuscito (con soglia)
    okColor       = "#5BD35B",            -- esito positivo, dado a segno, bonus
    koColor       = "#FF6B6B",            -- esito negativo, malus
}

-- ------------------------------------------------------------
-- (da engine/subphase.ttslua)
-- ------------------------------------------------------------
-- Grafica dei pannelli sottofase (sotto il pannello centrale)
SUBPANEL = {
    offsetXY  = "0 -280",
    width     = 450,
    height    = 55,
    bg        = "rgba(0,0,0,0.70)",
    btnColor  = "#B8902E",
    btnWidth  = 200,
    btnHeight = 40,
    btnMax     = 4,      -- bottoni disponibili per pannello
    btnSpacing = 8,      -- spazio fra i bottoni    
}
