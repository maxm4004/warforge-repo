
diceUrls = {
    [1] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-Lua/refs/heads/main/dice/1d6.png",
    [2] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-L/uarefs/heads/main/dice/2d6.png",
    [3] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-Lua/refs/heads/main/dice/3d6.png",
    [4] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-Lua/refs/heads/main/dice/4d6.png",
    [5] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-Lua/refs/heads/main/dice/5d6.png",
    [6] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-Lua/refs/heads/main/dice/6d6.png"
}

rolling1 = nil
rolling2 = nil

-- ==========================================================

IEF_DICE_TEMPLATE = nil


IEF_DICE_ROLL_TRY = IEF_DICE_ROLL_TRY or {
    [1] = { dadi = 1, soglia = 0},
    [2] = { dadi = 1, soglia = 0},
}

IEF_DICE_LAST_ROLL = IEF_DICE_LAST_ROLL or {
    [1] = {},
    [2] = {},
}

IEF_DICE_TRAY_GUID = IEF_DICE_TRAY_GUID or {
    [1] = "5418fe",
    [2] = "efb29f",
}

IEF_DICE_BAG_GUID = IEF_DICE_BAG_GUID or {
    [1] = "eb4ed3",
    [2] = "1338a3",
}

IEF_DICE_ZONE = IEF_DICE_ZONE or {
    [1] = { x = -77.72, y = 1.44, z = -35.97 },
    [2] = { x = 77.72, y = 1.44, z = 35.97 },    
}

IEF_DICE_SPAWN_POS = IEF_DICE_SPAWN_POS or {
    [1] = { x = 75.70, y = 1.44, z = -67.99 },
    [2] = { x = -75.70, y = 1.44, z = 67.99 },
}

IEF_DICE_CAMERA_HOME = {
    [1] = { x = 0, y = 40, z = 0 },   -- vista overview default per slot 1, aggiusta ai tuoi valori
    [2] = { x = 0, y = 40, z = 0 },   -- vista overview default per slot 2, aggiusta ai tuoi valori
}

IEF_DICE_CAMERA_YAW = {
    [1] = 0,
    [2] = 180,
}

-- ============================================================
-- FUNZIONE: spinDie()
-- ============================================================
function spinDie(imageId, diceNumber, onEnd)

    local delays = {0.05, 0.05, 0.06, 0.06, 0.08, 0.10, 0.12, 0.15, 0.18, 0.22, 0.28}
    local index = 1

    local function step()

        local url = diceUrls[dice_roll()]
        if diceNumber == 1 then
            rolling1 = url
        else
            rolling2 = url
        end

        UI.setAttribute(imageId, "image", url)

        if index >= #delays then
            local finalValue = dice_roll()
            local finalUrl = diceUrls[finalValue]

            if diceNumber == 1 then
                rolling1 = finalUrl
            else
                rolling2 = finalUrl
            end

            UI.setAttribute(imageId, "image", finalUrl)
            

            if onEnd then               
                onEnd(finalValue)
            end
            return
        end

        local delay = delays[index]
        index = index + 1
        Wait.time(step, delay)
    end

    step()
end
-- ============================================================
-- FUNZIONE: dice_roll()
-- ============================================================
function dice_roll()
    return math.random(1, 6)
end
-- ============================================================
-- FUNZIONE: engine_rollDice(numDadi, soglia, callback)
-- Tira N dadi D6 e restituisce quanti >= soglia
-- callback(hits, results) dove results è la lista dei valori
-- ============================================================
function engine_rollDice(numDadi, soglia, callback)

    if numDadi <= 0 then
        if callback then callback(0, {}) end
        return
    end

    local results = {}
    local hits    = 0

    for i = 1, numDadi do
        local val = math.random(1, 6)
        table.insert(results, val)
        if val >= soglia then
            hits = hits + 1
        end
    end

    -- Simula animazione con spinDie
    local resultStr = table.concat(results, " | ")
    printToAll("[DICE] " .. numDadi .. "D6 (soglia " .. soglia .. "+): " .. resultStr .. " → HIT: " .. hits, {r=1,g=0.85,b=0.2})

    if callback then callback(hits, results) end
end
-- ============================================================
-- FUNZIONE: engine_rollDiceAnimated(numDadi, soglia, imageId, callback)
-- Come engine_rollDice ma con animazione spinDie su elemento UI
-- ============================================================
function engine_rollDiceAnimated(numDadi, soglia, imageId, callback)

    if numDadi <= 0 then
        if callback then callback(0, {}) end
        return
    end

    local results  = {}
    local hits     = 0
    local pending  = numDadi
    local complete = false

    local function checkDone()
        if complete then return end
        pending = pending - 1
        if pending <= 0 then
            complete = true
            local resultStr = table.concat(results, " | ")
            printToAll("[DICE] " .. numDadi .. "D6 (soglia " .. soglia .. "+): " .. resultStr .. " → HIT: " .. hits, {r=1,g=0.85,b=0.2})
            if callback then callback(hits, results) end
        end
    end

    for i = 1, numDadi do
        local idx = i
        spinDie(imageId or "diceArmy1", i, function(val)
            results[idx] = val
            if val >= soglia then hits = hits + 1 end
            checkDone()
        end)
        Wait.time(function() end, i * 0.1)
    end
end
-- ============================================================
-- FUNZIONE: restoreDiceUiState()
-- ============================================================
function restoreDiceUiState()

    if not DICE_CONTEST or not diceUrls then return end

    local resetUrl = diceUrls[1]

    if DICE_CONTEST.rolledNumberArmy1 then
        UI.setAttribute("diceArmy1", "image", diceUrls[DICE_CONTEST.rolledNumberArmy1])
    else
        UI.setAttribute("diceArmy1", "image", resetUrl)
    end

    if DICE_CONTEST.rolledNumberArmy2 then
        UI.setAttribute("diceArmy2", "image", diceUrls[DICE_CONTEST.rolledNumberArmy2])
    else
        UI.setAttribute("diceArmy2", "image", resetUrl)
    end
end

-- ============================================================
-- FUNZIONE: engine_diceSpawn(zonaXYZ, totalDice)
-- ============================================================
function engine_diceSpawn(zonaXYZ, totalDice)
    local GAP_Z = 2.2
    local dadi = {}

    for i = 1, totalDice do
        local pos = Vector(zonaXYZ.x, zonaXYZ.y, zonaXYZ.z - (i-1)*GAP_Z)
        local die = spawnObject({ type = "Die_6", position = pos, rotation = Vector(0,0,0) })
        table.insert(dadi, die)
    end

    return dadi
end

-- ============================================================
-- FUNZIONE: engine_diceRoll(dadi)
-- ============================================================
function engine_diceRoll(dadi)
    Wait.frames(function()
        for _, d in ipairs(dadi) do
            d.setVelocity({
                x = (math.random() - 0.5) * 6,
                y = 0.5,
                z = 6 + math.random() * 4
            })
            d.setAngularVelocity({
                x = math.random(8, 16),
                y = math.random(8, 16),
                z = math.random(8, 16)
            })
        end
    end, 5)   -- 5 frame di ritardo prima di applicare le velocità
end
-- ============================================================
--                     GESTIONE MANUALE
-- ============================================================

-- ============================================================
-- FUNZIONE: engine_diceReadResults(dadi, sogliaSuccesso, onComplete)
-- ============================================================
function engine_diceReadResults(dadi, sogliaSuccesso, onComplete)
    Wait.frames(function()
        Wait.condition(
            function()
                local risultati = {}
                for _, d in ipairs(dadi) do
                    if not d.isDestroyed() then
                        table.insert(risultati, d.getValue())
                    end
                end

                local testo = {}
                for _, v in ipairs(risultati) do
                    table.insert(testo, tostring(v))
                end
                warning("Dadi: " .. table.concat(testo, ", "), "Yellow")

                local successi = nil
                if sogliaSuccesso then
                    successi = 0
                    for _, v in ipairs(risultati) do
                        if v >= sogliaSuccesso then successi = successi + 1 end
                    end
                end
                onComplete(risultati, successi)
            end,
            function()
                for _, d in ipairs(dadi) do
                    if not d.isDestroyed() and not d.resting then return false end
                end
                return true
            end
        )
    end, 10)
end
-- ============================================================
-- FUNZIONE: engine_diceClearValid(validDadi)
-- ============================================================
function engine_diceClearValid(validDadi)
    if not validDadi then return end
    for _, d in ipairs(validDadi) do
        if not d.isDestroyed() then d.destruct() end
    end
end
-- ============================================================
-- FUNZIONE: engine_diceButtons3DShow()
-- ============================================================
function engine_diceButtons3DShow()

    Wait.condition(function()
        local army1 = getObjectFromGUID(IEF_DICE_TRAY_GUID[1])
        local army2 = getObjectFromGUID(IEF_DICE_TRAY_GUID[2])

        if not army1 then print("[DICE] GUID army1 non trovata") return end
        if not army2 then print("[DICE] GUID army2 non trovata") return end

        local pos1 = army1.getPosition()
        local pos2 = army2.getPosition()

        callHandler("engine_diceClearLastRoll", 1)
        callHandler("engine_diceClearLastRoll", 2)

        Wait.time(function()
            army1.UI.setXml(main_buildDiceRollPanelArmy1(pos1.x, pos1.y, pos1.z))
            army2.UI.setXml(main_buildDiceRollPanelArmy2(pos2.x, pos2.y, pos2.z))
        end, 1)

    end, function()
        return getObjectFromGUID(IEF_DICE_TRAY_GUID[1]) ~= nil
           and getObjectFromGUID(IEF_DICE_TRAY_GUID[2]) ~= nil
    end, 10)

end
