    return string.format([[
            <Panel id="panelDiceRoll3D" active="true" position="0 2 0" rotation="0 0 180">
                    <Button
                    offsetXY="210 270"
                    height="200"
                    width="200"
                    icon="Dice_Roll"
                    tooltip="◀ Roll"
                    textColor="#ffffff"
                    alignment="MiddleCenter"
                    padding="12 12 12 12"
                    colors="#1f4f9f|#1f5fcf|#3f3f3f|#1f1f1f"
                    tooltipPosition="Left"
                    showAnimation="Grow"
                    hideAnimation="Shrink"
                    animationDuration="0.1"
                    tooltipOffset="-40"
                    id="btn_diceRoll_start"
                    onClick="Global/engine_diceRoll_start"
                    />
                    <Button
                    offsetXY="-210 270"
                    height="200"
                    width="200"
                    icon="Icon_Trashcan"
                    tooltip="◀ Roll"
                    textColor="#ffffff"
                    alignment="MiddleCenter"
                    padding="12 12 12 12"
                    colors="#1f4f9f|#1f5fcf|#3f3f3f|#1f1f1f"
                    tooltipPosition="Left"
                    showAnimation="Grow"
                    hideAnimation="Shrink"
                    animationDuration="0.1"
                    tooltipOffset="-40"
                    id="btn_diceRoll_clear"
                    onClick="Global/engine_diceRoll_clear"
                    />
            </Panel>
    ]], 76.57, 1.44, -66.50)
end
