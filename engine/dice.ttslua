-- ============================================================
-- FUNZIONE: engine_diceGetTemplate(bagGuid)
-- ============================================================
function engine_diceGetTemplate(bagGuid)
    
    if IEF_DICE_TEMPLATE then return IEF_DICE_TEMPLATE end

    local bag = getObjectFromGUID(bagGuid)
    if not bag then print("[DICE] Bag non trovato: " .. tostring(bagGuid)) return nil end

    local data = bag.getData()
    if not data.ContainedObjects or #data.ContainedObjects == 0 then
        print("[DICE] Bag vuoto, impossibile creare il template")
        return nil
    end

    IEF_DICE_TEMPLATE = data.ContainedObjects[1]
    return IEF_DICE_TEMPLATE
end
-- ============================================================
-- FUNZIONE: engine_diceThrowFromBag(bagGuid, zonaTarget, numDadi, opts)
-- ============================================================
function engine_diceThrowFromBag(slot, opts, callback)

   local bagGuid = IEF_DICE_BAG_GUID[slot]
   local zonaTarget = IEF_DICE_ZONE[slot]
   local numDadi = IEF_DICE_ROLL_TRY[slot].dadi
   local sogliaSuccesso = IEF_DICE_ROLL_TRY[slot].soglia

    if not bagGuid then print("[DICE] bagGuid è nil") return end
    if not zonaTarget then print("[DICE] zonaTarget è nil") return end

    local template = engine_diceGetTemplate(bagGuid)
    if not template then return end

    opts = opts or {}
    local rollHeight = opts.rollHeight or 4
    local spread     = opts.spread or 3
    local stagger    = opts.stagger or 0.15   -- ritardo tra un dado e il successivo

    local bag = getObjectFromGUID(bagGuid)
    local originPos = bag.getPosition()
    local g = Physics.getGravity()
    local h = 0.25 + rollHeight / 4

    local offsetX = zonaTarget.x - originPos.x
    local offsetY = zonaTarget.y - originPos.y
    local offsetZ = zonaTarget.z - originPos.z

    local velX = (offsetX / h - g.x * h) * 0.68
    local velY = (offsetY / h - g.y * h) * 0.68
    local velZ = (offsetZ / h - g.z * h) * 0.68

    local rolledDice = {}

    for i = 1, numDadi do
        Wait.time(function()
            local rx = (math.random() - 0.5) * spread
            local ry = (math.random() - 0.5) * spread
            local rz = (math.random() - 0.5) * spread

            local finalVel = { x = velX + rx, y = velY + ry, z = velZ + rz }

            local obj = spawnObjectData({
                data     = template,
                position = { x = originPos.x, y = originPos.y + 4, z = originPos.z },   -- prima era +1.5
                rotation = { x = 0, y = 180, z = 0 }
            })

            table.insert(IEF_DICE_LAST_ROLL[slot], obj)
            table.insert(rolledDice, obj)

            Wait.frames(function()
                if not obj.isDestroyed() then
                    obj.randomize()
                    obj.setVelocity(finalVel)
                    obj.setAngularVelocity({
                        x = math.random(8, 16),
                        y = math.random(8, 16),
                        z = math.random(8, 16)
                    })
                end
            end, 3)
        end, (i - 1) * stagger)
    end

    -- Aspetta che tutti i dadi siano stati lanciati (ultimo a (numDadi-1)*stagger)
    -- prima di leggere i risultati, altrimenti rolledDice arriverebbe vuota/incompleta
    Wait.time(function()
        engine_diceReadResults(rolledDice, sogliaSuccesso, callback)
    end, numDadi * stagger + 0.5)
end
-- ============================================================
-- FUNZIONE: engine_diceClearLastRoll()
-- ============================================================
function engine_diceClearLastRoll(slot)

    if  not IEF_DICE_LAST_ROLL[slot] then return end

    for _, d in ipairs(IEF_DICE_LAST_ROLL[slot]) do
        if not d.isDestroyed() then d.destruct() end
    end
    IEF_DICE_LAST_ROLL[slot] = {}
end
-- ============================================================
-- FUNZIONE: engine_diceRoll_start(player, value, id)
-- ============================================================
function engine_diceRoll_start(player)
    local slot = main_SlotByColor(player.color)

    if not slot then warning("Impossibile usare questo button, scegliere prima un colore", "Yellow") return end
  
    if ENGINE.phase == "INITIATIVE_ROLL" then
        local key = slot == 1 and "rolledNumberArmy1" or "rolledNumberArmy2"
        if DICE_CONTEST[key] ~= nil then return end

        engine_diceThrowFromBag(slot, nil, function(risultati, successi)
            DICE_CONTEST[key] = risultati[1]
            engine_diceCameraReturn(player, slot)
    

            local bothRolled = DICE_CONTEST.rolledNumberArmy1 ~= nil and DICE_CONTEST.rolledNumberArmy2 ~= nil

            callHandler("dice_check")

            if bothRolled and DICE_CONTEST.winner == nil then
                engine_diceClearLastRoll(1)
                engine_diceClearLastRoll(2)
                return
            end

            local action = slot == 1 and ACTION.ARMY1_CLICK or ACTION.ARMY2_CLICK
            engine_handleAction({ type = action })
        end)
        return
    end

    if ENGINE.phase == "FIELD_ROLL" then
        engine_diceClearLastRoll(slot)
        field_doRollFieldElement(player, slot)
        Wait.time(function() 
                 local rolls = slot == 1 and #FIELD_STATE.rolls1 or #FIELD_STATE.rolls2
                 local totale = slot == 1 and FIELD_STATE.army1Elements or FIELD_STATE.army2Elements
                if rolls == totale then
                    engine_diceRoll_clear(player)
                    Wait.time(function() 
                        engine_cameraByNamme(player, nil, CAMERA_ZONE.ARMY_HOME)
                    end, 5) 
                    return
                end 
        end, 5) 
        return
    end

    if ENGINE.phase == "FIELD_BLOCK" then
        local slot = main_SlotByColor(player.color)
         engine_diceClearLastRoll(slot)
        field_doRollBlock(player, slot)
        return
    end

        engine_diceClearLastRoll(slot)
        engine_diceThrowFromBag(slot, nil, function(risultati, successi)
        engine_diceCameraReturn(player, slot)
    end)
end
-- ============================================================
-- FUNZIONE: engine_diceRoll_clear(player, value, id)
-- ============================================================
function engine_diceRoll_clear(player)
    local slot = main_SlotByColor(player.color)
    if not slot then warning("Impossibile usare questo button, scegliere prima un colore", "Yellow") return end
    engine_diceClearLastRoll(slot)
end
-- ============================================================
-- FUNZIONE: engine_diceCameraZoom(player, slot, duration)
-- ============================================================
function engine_diceCameraZoom(player, slot)
   if ENGINE.phase == "FIELD_ROLL" or ENGINE.phase == "FIELD_BLOCK" then
            engine_cameraByNamme(player, nil, CAMERA_ZONE.ARMY_ROLL_DICES)              
    end
end
-- ============================================================
-- FUNZIONE: engine_diceCameraReturn(player, slot)
-- ============================================================
function engine_diceCameraReturn(player, slot)

    local curremtElement =  slot == 1 and #FIELD_STATE.rolls1 or #FIELD_STATE.rolls2

    if ENGINE.phase == "FIELD_ROLL" or ENGINE.phase == "FIELD_BLOCK" then
        engine_cameraByNamme(player, curremtElement, CAMERA_ZONE.ARMY_CARDS)
        Wait.time(function ()
                engine_diceCameraZoom(player, slot)
        end, 2)
    end

    if  ENGINE.phase == "FIELD_BLOCK" then
        engine_cameraByNamme(player, nil, CAMERA_ZONE.ARMY_BLOCK)
        Wait.time(function ()
                engine_diceCameraZoom(player, slot)
        end, 2)
    end
end