-- ============================================================
-- METODO: engine_diceCheck(tipo, numDadi, soglia_calcolata, zonaTarget, callback)
-- ============================================================
IEF_DICE_THROW_DISTANCE = 10   -- quanto indietro rispetto alla zona parte il lancio
IEF_DICE_THROW_HEIGHT   = 5    -- quanto sopra il piano tavolo parte il lancio

function engine_diceCheck(tipo, numDadi, soglia_calcolata, zonaSpawn, zonaTarget, callback)

    if numDadi <= 0 then
        if callback then callback(0, {}) end
        return
    end

    local spawnPoint = Vector(
        zonaTarget.x,
        zonaTarget.y + IEF_DICE_THROW_HEIGHT,
        zonaTarget.z - IEF_DICE_THROW_DISTANCE
    )

    local dadi = engine_diceThrow(zonaSpawn, zonaTarget, numDadi)

    Wait.time(function()
        engine_diceRollToZone(dadi, zonaTarget)
    end, 0.3)   -- piccola attesa per essere certi che lo spawn sia completo

    engine_diceReadResults(dadi, nil, function(risultati)

        if tipo == "recovery" or tipo == "generali" then
            local somma = 0
            for _, v in ipairs(risultati) do somma = somma + v end
            local superato = somma >= soglia_calcolata

            printToAll("[DICE:" .. tipo .. "] " .. table.concat(risultati, "+") ..
                " = " .. somma .. " vs soglia " .. soglia_calcolata ..
                " → " .. (superato and "SUPERATO" or "FALLITO"), {r=1,g=0.85,b=0.2})

            if callback then callback(superato, risultati, somma) end

        else
            local successi = 0
            for _, v in ipairs(risultati) do
                if v >= soglia_calcolata then successi = successi + 1 end
            end

            printToAll("[DICE:" .. tipo .. "] " .. table.concat(risultati, " | ") ..
                " (soglia " .. soglia_calcolata .. "+) → successi: " .. successi, {r=1,g=0.85,b=0.2})

            if callback then callback(successi, risultati) end
        end
    end)
end
-- ============================================================
-- FUNZIONE: engine_diceClearValid(validDadi)
-- ============================================================
function engine_diceClearValid(validDadi)
    if not validDadi then return end
    for _, d in ipairs(validDadi) do
        if not d.isDestroyed() then d.destruct() end
    end
end

function engine_diceThrow(originPos, zonaTarget, numDadi, opts)
    opts = opts or {}
    local rollHeight = opts.rollHeight or 4
    local spread     = (opts.spread or 3) / 2

    local g = Physics.getGravity()
    local h = 0.25 + rollHeight / 4
    local offset = Vector(zonaTarget.x - originPos.x, zonaTarget.y - originPos.y, zonaTarget.z - originPos.z)
    local velocity = Vector(offset.x/h - g.x*h, offset.y/h - g.y*h, offset.z/h - g.z*h) * 0.68

    local dadi = {}

    for i = 1, numDadi do
        local randomVelocity = Vector(
            velocity.x + math.random(-spread, spread),
            velocity.y + math.random(-spread, spread),
            velocity.z + math.random(-spread, spread)
        )

        local d = spawnObject({
            type     = "Die_6",
            position = Vector(originPos.x, originPos.y + 1.5, originPos.z),
            rotation = Vector(0, 180, 0)
        })
        table.insert(dadi, d)

        Wait.condition(function()
            d.randomize()
            d.setVelocity(randomVelocity)
        end, function() return not d.spawning end, 3)
    end

    return dadi
end

function engine_diceRoll_start(player, value, id)
    print("engine_diceRoll_start")
    engine_diceCheck("shoot", 6, 4, IEF_DICE_SPAWN_POS[1], IEF_DICE_ZONE[1], function(esito, risultati, validDadi, extra)
    IEF_DEBUG_DADI_VALID = validDadi
    print("[DICEROLL] Successi: " .. esito .. " / 6")
    end)

end

function engine_diceRoll_clear(player, value, id)
    engine_diceClearValid(IEF_DEBUG_DADI_VALID)
end

function engine_diceButtons3DSetupOn()
    
    local anchor = getObjectFromGUID("1338a3")

    if not anchor then print("[DICE] GUID non trovata") return end

    local pos = IEF_DICE_SPAWN_POS[1]
    
    IEF_DICE_PANEL_ANCHOR = anchor

    anchor.UI.setXml(main_buildDiceRollPanel3DXml(pos.x, pos.y, pos.z))
   
    return anchor

end

