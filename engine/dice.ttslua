
diceUrls = {
    [1] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-Lua/refs/heads/main/dice/1d6.png",
    [2] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-L/uarefs/heads/main/dice/2d6.png",
    [3] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-Lua/refs/heads/main/dice/3d6.png",
    [4] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-Lua/refs/heads/main/dice/4d6.png",
    [5] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-Lua/refs/heads/main/dice/5d6.png",
    [6] = "https://raw.githubusercontent.com/maxm4004/Tabletop-Simulator-Lua/refs/heads/main/dice/6d6.png"
}

rolling1 = nil
rolling2 = nil
-- ============================================================
-- FUNZIONE: spinDie()
-- ============================================================
function spinDie(imageId, diceNumber, onEnd)

    local delays = {0.05, 0.05, 0.06, 0.06, 0.08, 0.10, 0.12, 0.15, 0.18, 0.22, 0.28}
    local index = 1

    local function step()

        local url = diceUrls[dice_roll()]
        if diceNumber == 1 then
            rolling1 = url
        else
            rolling2 = url
        end

        UI.setAttribute(imageId, "image", url)

        if index >= #delays then
            local finalValue = dice_roll()
            local finalUrl = diceUrls[finalValue]

            if diceNumber == 1 then
                rolling1 = finalUrl
            else
                rolling2 = finalUrl
            end

            UI.setAttribute(imageId, "image", finalUrl)
            

            if onEnd then               
                onEnd(finalValue)
            end
            return
        end

        local delay = delays[index]
        index = index + 1
        Wait.time(step, delay)
    end

    step()
end
-- ============================================================
-- FUNZIONE: dice_roll()
-- ============================================================
function dice_roll()
    return math.random(1, 6)
end
-- ============================================================
-- FUNZIONE: engine_rollDice(numDadi, soglia, callback)
-- Tira N dadi D6 e restituisce quanti >= soglia
-- callback(hits, results) dove results è la lista dei valori
-- ============================================================
function engine_rollDice(numDadi, soglia, callback)

    if numDadi <= 0 then
        if callback then callback(0, {}) end
        return
    end

    local results = {}
    local hits    = 0

    for i = 1, numDadi do
        local val = math.random(1, 6)
        table.insert(results, val)
        if val >= soglia then
            hits = hits + 1
        end
    end

    -- Simula animazione con spinDie
    local resultStr = table.concat(results, " | ")
    printToAll("[DICE] " .. numDadi .. "D6 (soglia " .. soglia .. "+): " .. resultStr .. " → HIT: " .. hits, {r=1,g=0.85,b=0.2})

    if callback then callback(hits, results) end
end
-- ============================================================
-- FUNZIONE: engine_rollDiceAnimated(numDadi, soglia, imageId, callback)
-- Come engine_rollDice ma con animazione spinDie su elemento UI
-- ============================================================
function engine_rollDiceAnimated(numDadi, soglia, imageId, callback)

    if numDadi <= 0 then
        if callback then callback(0, {}) end
        return
    end

    local results  = {}
    local hits     = 0
    local pending  = numDadi
    local complete = false

    local function checkDone()
        if complete then return end
        pending = pending - 1
        if pending <= 0 then
            complete = true
            local resultStr = table.concat(results, " | ")
            printToAll("[DICE] " .. numDadi .. "D6 (soglia " .. soglia .. "+): " .. resultStr .. " → HIT: " .. hits, {r=1,g=0.85,b=0.2})
            if callback then callback(hits, results) end
        end
    end

    for i = 1, numDadi do
        local idx = i
        spinDie(imageId or "diceArmy1", i, function(val)
            results[idx] = val
            if val >= soglia then hits = hits + 1 end
            checkDone()
        end)
        Wait.time(function() end, i * 0.1)
    end
end
-- ============================================================
-- FUNZIONE: restoreDiceUiState()
-- ============================================================
function restoreDiceUiState()

    if not DICE_CONTEST or not diceUrls then return end

    local resetUrl = diceUrls[1]

    if DICE_CONTEST.rolledNumberArmy1 then
        UI.setAttribute("diceArmy1", "image", diceUrls[DICE_CONTEST.rolledNumberArmy1])
    else
        UI.setAttribute("diceArmy1", "image", resetUrl)
    end

    if DICE_CONTEST.rolledNumberArmy2 then
        UI.setAttribute("diceArmy2", "image", diceUrls[DICE_CONTEST.rolledNumberArmy2])
    else
        UI.setAttribute("diceArmy2", "image", resetUrl)
    end
end
-- ============================================================
-- engine/dice.ttslua
-- ============================================================

-- ============================================================
-- engine/dice.ttslua
-- ============================================================

-- ============================================================
-- METODO 1: engine_diceSpawn(zonaXYZ, totalDice)
-- Spawna totalDice dadi sul piano del tavolo, allineati sulla
-- stessa x/y, z che scende progressivamente. Restano fermi.
-- Ritorna la tabella dei dadi spawnati.
-- ============================================================
function engine_diceSpawn(zonaXYZ, totalDice)
    local GAP_Z = 2.2
    local dadi = {}

    for i = 1, totalDice do
        local pos = Vector(zonaXYZ.x, zonaXYZ.y, zonaXYZ.z - (i-1)*GAP_Z)
        local die = spawnObject({ type = "Die_6", position = pos, rotation = Vector(0,0,0) })
        table.insert(dadi, die)
    end

    return dadi
end

-- ============================================================
-- METODO 2: engine_diceRoll(dadi)
-- Lancia orizzontalmente i dadi passati (già spawnati e fermi).
-- ============================================================
function engine_diceRoll(dadi)
    Wait.frames(function()
        for _, d in ipairs(dadi) do
            d.setVelocity({
                x = (math.random() - 0.5) * 6,
                y = 0.5,
                z = 6 + math.random() * 4
            })
            d.setAngularVelocity({
                x = math.random(8, 16),
                y = math.random(8, 16),
                z = math.random(8, 16)
            })
        end
    end, 5)   -- 5 frame di ritardo prima di applicare le velocità
end
-- ============================================================
-- METODO: engine_diceRollToZone(dadi, zonaTarget, opts)
-- Lancia i dadi (già spawnati, fermi) verso un punto preciso,
-- usando la fisica del proiettile (stesso principio del vecchio
-- mod diceRoller.ttslua, riscritto pulito e senza dipendenze
-- esterne). Ogni dado riceve uno spread casuale per non
-- sovrapporsi esattamente nello stesso punto di atterraggio.
-- opts = { rollHeight = 1, spread = 3 } (entrambi opzionali)
-- ============================================================
function engine_diceRollToZone(dadi, zonaTarget, opts)
    opts = opts or {}
    local rollHeight = opts.rollHeight or 1
    local spread     = (opts.spread or 3) / 2

    local g = Physics.getGravity()
    local h = 0.25 + rollHeight / 4

    Wait.frames(function()
        for _, d in ipairs(dadi) do
            local pos    = d.getPosition()
            local offset = Vector(zonaTarget.x - pos.x, zonaTarget.y - pos.y, zonaTarget.z - pos.z)

            local vx = offset.x / h - g.x * h
            local vy = offset.y / h - g.y * h
            local vz = offset.z / h - g.z * h

            local randomVelocity = Vector(
                (vx + math.random(-spread, spread)) * 0.68,
                (vy) * 0.68,
                (vz + math.random(-spread, spread)) * 0.68
            )

            d.setVelocity(randomVelocity)
            d.setAngularVelocity({
                x = math.random(8, 16),
                y = math.random(8, 16),
                z = math.random(8, 16)
            })
        end
    end, 5)
end
-- ============================================================
-- Punti di spawn dei dadi, uno per player/slot (partenza del
-- lancio). L'atterraggio resta IEF_DICE_ZONE[slot] (già esistente).
-- Default: centro tavolo per entrambi, sollevati di 5 sopra il
-- piano — da aggiustare quando vedi il test dal vivo.
-- ============================================================
IEF_DICE_FIXED_COUNT = {
    recovery = 2,   -- Test di Morale: sempre 2D6
    generali = 2,   -- Morte dei Generali: sempre 2D6
}
-- ============================================================
-- Punti di spawn/atterraggio dei dadi, uno per player/slot.
-- Default: centro tavolo per entrambi — da aggiustare al test.
-- ============================================================
IEF_DICE_SPAWN_POS = IEF_DICE_SPAWN_POS or {
    -- [1] = { x = 75.95, y = 1.44, z = -53.24 },
    -- [2] = { x = -75.95, y = 1.44, z = 53.24 },    
    [1] = { x = 0, y = 1.44, z = 0 },
    [2] = { x = 0, y = 1.44, z = 0 },
}

IEF_DICE_ZONE = IEF_DICE_ZONE or {
    [1] = { x = 75.70, y = 1.44, z = -67.99 },
    [2] = { x = -75.70, y = 1.44, z = 67.99 },
}
-- ============================================================
-- METODO: engine_diceCheck(tipo, numDadi, soglia_calcolata, zonaSpawn, zonaTarget, callback)
-- zonaSpawn:  punto di partenza del lancio (es. IEF_DICE_SPAWN_POS[slot])
-- zonaTarget: punto di atterraggio        (es. IEF_DICE_ZONE[slot])
-- ============================================================
function engine_diceCheck(tipo, numDadi, soglia_calcolata, zonaSpawn, zonaTarget, callback)

    if IEF_DICE_FIXED_COUNT[tipo] then
        numDadi = IEF_DICE_FIXED_COUNT[tipo]
    end

    if numDadi <= 0 then
        if callback then callback(0, {}, {}) end
        return
    end

    local dadi = engine_diceSpawn(zonaSpawn, numDadi)

    Wait.time(function()
        engine_diceRollToZone(dadi, zonaTarget)

        Wait.frames(function()
            Wait.condition(
                function()
                    local risultati   = {}
                    local validDadi   = {}
                    local invalidDadi = {}

                    for _, d in ipairs(dadi) do
                        if not d.isDestroyed() then
                            table.insert(risultati, d.getValue())
                        end
                    end

                    if tipo == "recovery" or tipo == "generali" then
                        local somma = 0
                        for _, v in ipairs(risultati) do somma = somma + v end
                        local superato = somma >= soglia_calcolata

                        for _, d in ipairs(dadi) do
                            if not d.isDestroyed() then
                                if superato then table.insert(validDadi, d)
                                else table.insert(invalidDadi, d) end
                            end
                        end
                        for _, d in ipairs(invalidDadi) do d.destruct() end

                        printToAll("[DICE:" .. tipo .. "] " .. table.concat(risultati, "+") ..
                            " = " .. somma .. " vs soglia " .. soglia_calcolata ..
                            " → " .. (superato and "SUPERATO" or "FALLITO"), {r=1,g=0.85,b=0.2})

                        if callback then callback(superato, risultati, validDadi, somma) end

                    else
                        local successi = 0
                        for _, d in ipairs(dadi) do
                            if not d.isDestroyed() then
                                if d.getValue() >= soglia_calcolata then
                                    successi = successi + 1
                                    table.insert(validDadi, d)
                                else
                                    table.insert(invalidDadi, d)
                                end
                            end
                        end
                        for _, d in ipairs(invalidDadi) do d.destruct() end

                        printToAll("[DICE:" .. tipo .. "] " .. table.concat(risultati, " | ") ..
                            " (soglia " .. soglia_calcolata .. "+) → successi: " .. successi, {r=1,g=0.85,b=0.2})

                        if callback then callback(successi, risultati, validDadi) end
                    end
                end,
                function()
                    for _, d in ipairs(dadi) do
                        if not d.isDestroyed() and not d.resting then return false end
                    end
                    return true
                end
            )
        end, 10)

    end, 0.3)
end
-- ============================================================
-- METODO: engine_diceClearValid(validDadi)
-- Rimuove dal tavolo i dadi validi lasciati da engine_diceCheck,
-- da chiamare quando il chiamante ha finito di mostrarli
-- (es. dopo che il giocatore ha confermato di aver visto l'esito).
-- ============================================================
function engine_diceClearValid(validDadi)
    if not validDadi then return end
    for _, d in ipairs(validDadi) do
        if not d.isDestroyed() then d.destruct() end
    end
end