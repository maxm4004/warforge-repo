-- ============================================================
-- engine/ui.ttslua
-- ============================================================

function getEngineUiXml()

    local panels = [[
        <Panel id="logo_panel" rectAlignment="UpperCenter" width="650" height="500" offsetXY="-700 80" active="true">
            <Image image="https://raw.githubusercontent.com/maxm4004/warforge-ief/refs/heads/main/images/warforge.png" preserveAspect="1"/>
        </Panel>
        <Panel rectAlignment="LowerCenter" width="1100" height="60" color="rgba(0,0,0,0)" offsetXY="0 300">
            <Text id="playerGameMessage" text="" fontStyle="Bold" font="warforge_font" fontSize="18" color="rgba(212,175,55,0.9)" outline="#000000" 
            outlineSize="1" alignment="LeftCenter"/>
        </Panel>
        <Panel id="panelVersion" active="true">
            rectAlignment="UpperCenter"
            width="420"
            height="30"
            color="rgba(0,0,0,0.35)"
            offsetXY="-700 -320">
            <Text id="versione" text="" font="warforge_font" fontSize="13" color="Yellow" alignment="MiddleCenter" outline="#000000" outlineSize="1"/>
        </Panel> 
        
        <Panel id="measure_cancel_panel"
        rectAlignment="LowerCenter"
        width="190" height="50"
        color="rgba(0,0,0,0.00)"
        offsetXY="0 0"
        active="false">
            <HorizontalLayout spacing="6" padding="10 10 10 10" childAlignment="MiddleCenter">
                <Button id="btn_measure_cancel_panel" text="Annulla misura" font="warforge_font" fontSize="13" fontStyle="Normal" color="rgba(0.75,0.75,0.75,1)" textColor="Black" preferredHeight="34" onClick="engine_measure_cancel"/>
            </HorizontalLayout>
     </Panel>
    ]]
    return panels
end
-- ============================================================
-- FUNZIONE: getHandPreviewXml(slot)
-- Costruisce l'XML del pannello mano per lo slot dato, con
-- tante Image quante sono gli elementi assegnati a quel player
-- (max 4). La larghezza iniziale riflette il numero di carte
-- già visibili in quel momento (handVisibleCount), poi viene
-- aggiornata dinamicamente da field_handPreviewUpdateWidth ad
-- ogni show/hide successivo.
-- ============================================================
function getHandPreviewXml(slot)

    local totale = slot == 1 and FIELD_STATE.army1Elements or FIELD_STATE.army2Elements
    local colore = slot == 1 and "Red" or "Green"

    local images = ""
    for i = 1, totale do
        images = images .. string.format(
            '<Image id="hand_slot_%d_%d" image="" width="200" height="300" active="false" preserveAspect="true" />',
            slot, i
        )
    end

    return string.format(
        '<Panel id="handPreview%d" rectAlignment="LowerCenter" width="%d" height="300" offsetXY="0 0" color="rgba(0,0,0,0)" visibility="%s" active="false">' ..
        '<HorizontalLayout spacing="10" childAlignment="MiddleCenter">%s</HorizontalLayout>' ..
        '</Panel>',
        slot, 0, colore, images
    )
end
-- ============================================================
-- FUNZIONE: buildUI()
-- ============================================================
function buildUI()
    local enginePanels = getEngineUiXml()
    local rulesetXml   = callHandler("getRulesetUiXml") or ""
    local handPreview  = getHandPreviewXml(1) .. getHandPreviewXml(2)
    local header = [[<XmlLayout xmlns="XmlLayout"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="XmlLayout ../../../Configuration/XmlLayout.xsd">]]
    local bottom = "</XmlLayout>"
        UI.setXml(header .. rulesetXml .. enginePanels .. handPreview .. engine_subPanelsXml() .. engine_dicePanelsXml() .. bottom)
end