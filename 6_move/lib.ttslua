-- ============================================================
-- FUNZIONE: move_getGroupAxis(basiObjs)
-- Ricalcola fwdXZ/right dalle posizioni/rotazioni attuali,
-- riordina basiObjs lungo l'asse "right". Usata da move_perno_apply
-- (ha bisogno degli estremi spaziali reali del gruppo).
-- ============================================================
function move_getGroupAxis(basiObjs)
    local fwdRef0 = basiObjs[1].getTransformForward()
    local fwdXZ0  = Vector(fwdRef0.x, 0, fwdRef0.z):normalized()
    local right0  = Vector(-fwdXZ0.z, 0, fwdXZ0.x)

    table.sort(basiObjs, function(a, b)
        local pa, pb = a.getPosition(), b.getPosition()
        return (pa.x*right0.x + pa.z*right0.z) < (pb.x*right0.x + pb.z*right0.z)
    end)

    local pos1, pos2 = basiObjs[1].getPosition(), basiObjs[#basiObjs].getPosition()
    local right, fwdXZ

    if #basiObjs == 1 then
        local fwd = basiObjs[1].getTransformForward()
        fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()
        right = Vector(-fwdXZ.z, 0, fwdXZ.x)
    else
        local dirUnita = Vector(pos2.x - pos1.x, 0, pos2.z - pos1.z):normalized()
        right = dirUnita
        fwdXZ = Vector(dirUnita.z, 0, -dirUnita.x)
    end

    return fwdXZ, right, pos1, pos2
end

-- ============================================================
-- FUNZIONE: move_getFrontLine(basiObjs, unitKey)
-- Individua il rango più avanzato per proiezione fisica reale
-- (non per baseSeq). Usata per disegnare il rettangolo "avanti".
-- ============================================================
function move_getFrontLine(basiObjs, unitKey)
    local anchorRef = basiObjs[1]
    local fwd    = anchorRef.getTransformForward()
    local fwdXZ  = Vector(fwd.x, 0, fwd.z):normalized()
    local right  = Vector(-fwdXZ.z, 0, fwdXZ.x)

    local maxProj = -math.huge
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        if proj > maxProj then maxProj = proj end
    end

    local EPS = 0.5
    local frontRank = {}
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        if math.abs(proj - maxProj) < EPS then
            table.insert(frontRank, obj)
        end
    end

    table.sort(frontRank, function(a, b)
        local pa, pb = a.getPosition(), b.getPosition()
        return (pa.x*right.x + pa.z*right.z) < (pb.x*right.x + pb.z*right.z)
    end)

    local pos1  = frontRank[1].getPosition()
    local pos2  = frontRank[#frontRank].getPosition()
    local mover = frontRank[1]

    return fwdXZ, right, pos1, pos2, mover
end

-- ============================================================
-- FUNZIONE: move_redraw(unitKey)
-- Ridisegna il rettangolo "avanti" e il pannello 3D Movimento
-- agganciato all'unità. Se il budget è esaurito, chiude.
-- ============================================================
function move_redraw(unitKey)
    local state = IEF_MOVE_UNITS[unitKey]
    if not state or not state.panel3DObj or not state.basiObjs then return end

    main_syncAttachedGeneral(unitKey)

    local basiObjs = state.basiObjs

    local moveResiduo  = IEF_MOVE_BUDGET[unitKey]  or 0
    local pivotResiduo = IEF_PIVOT_BUDGET[unitKey] or 0

    if moveResiduo <= 0.001 and not IEF_MOVE_TEST_MODE then
        if state.rotta then main_routContinueDone(unitKey, state) end
        if state.activePlayer then
            warningToColor("Movimento esaurito: l'unita' ha completato la mossa", state.activePlayer, "Yellow", 5, true)
        end
        move_close(unitKey)
        return
    end

    local baseInfo = main_parseNickname(basiObjs[1].getName())
    local tipo = baseInfo and baseInfo.unitType

    local fwdXZ, right, pos1, pos2, mover = move_getFrontLine(basiObjs, unitKey)

    if state.lineHost and state.lineHost ~= mover then
        state.lineHost.setVectorLines({})
    end

    local rangeUnits  = math.max(moveResiduo, 0) * INCH_TO_TTS
    local unitTypeData = main_getUnitType(tipo)
    local halfWidth = (unitTypeData and unitTypeData.base_width_cm or 4) * CM_TO_TTS / 2 - 0.06
    local halfDepth = (unitTypeData and unitTypeData.base_depth_cm or 3) * CM_TO_TTS / 2 - 0.06

    local SIDE_TOLERANCE = 0.05 * INCH_TO_TTS
    halfWidth = halfWidth + SIDE_TOLERANCE

    local y1 = 1.20

    local startLeft  = Vector(pos1.x - right.x*halfWidth + fwdXZ.x*halfDepth, y1, pos1.z - right.z*halfWidth + fwdXZ.z*halfDepth)
    local startRight = Vector(pos2.x + right.x*halfWidth + fwdXZ.x*halfDepth, y1, pos2.z + right.z*halfWidth + fwdXZ.z*halfDepth)
    local endLeft    = Vector(startLeft.x  + fwdXZ.x*rangeUnits, y1, startLeft.z  + fwdXZ.z*rangeUnits)
    local endRight   = Vector(startRight.x + fwdXZ.x*rangeUnits, y1, startRight.z + fwdXZ.z*rangeUnits)

    mover.setVectorLines({
        {points = {mover.positionToLocal(startLeft),  mover.positionToLocal(endLeft)},  color={0.2,0.6,1}, thickness=0.03},
        {points = {mover.positionToLocal(startRight), mover.positionToLocal(endRight)}, color={0.2,0.6,1}, thickness=0.03},
        {points = {mover.positionToLocal(endLeft),    mover.positionToLocal(endRight)}, color={0.2,0.6,1}, thickness=0.03},
    })
    state.lineHost = mover

    local fronte = main_detectFormation(basiObjs)
    local x, y, z = main_calcolaPosizionePannello(fronte, #basiObjs)
    local panel3D = state.panel3DObj
    local labelText = string.format("%s - Movimento: %.0f&quot;   Perno: %.0f&quot;", unitKey, moveResiduo, pivotResiduo)
    panel3D.UI.setXml(main_buildMovementPanel3DXml(unitKey, x, y, z, state.activePlayer.color, labelText))

    local function canDo(manovra)
        return tipo and main_canManeuver(manovra, tipo)
    end

    local COLOR_ON  = "rgba(0.45,0.45,0.45,1)"
    local COLOR_OFF = "rgba(0.2,0.2,0.2,0.5)"

    Wait.frames(function()
        if panel3D.isDestroyed() then return end
        local function setBtn(id, ok)
            panel3D.UI.setAttribute(id, "interactable", ok and "true" or "false")
            panel3D.UI.setAttribute(id, "color", ok and COLOR_ON or COLOR_OFF)
        end

        -- "Perno e restare fermi" (senza "perno e movimento
        -- restante"): o perni o avanti, non entrambi.
        local perniUsati = 3 - pivotResiduo
        local avanzato = (main_unitFullMove(unitKey) - moveResiduo) > perniUsati + 0.001
        local soloPerno = not canDo("perno_max3_e_muovi") and not IEF_MOVE_TEST_MODE and not state.rotta

        local avantiOk = canDo("avanti") and not (soloPerno and perniUsati > 0)
        -- Avanti 1": attivo con qualsiasi residuo (se < 1" muove il
        -- residuo, move_avanti_apply limita al budget). Tolleranza
        -- sui decimali dei budget (rotta, carica).
        setBtn("btn_" .. unitKey .. "_Move1",   avantiOk and moveResiduo > 0.001)
        setBtn("btn_" .. unitKey .. "_Move2",   avantiOk and moveResiduo >= 2 - 0.001)
        setBtn("btn_" .. unitKey .. "_MoveMax", avantiOk)

        local pivotOk = canDo("perno_max3_fermi") and pivotResiduo >= 1 - 0.001 and moveResiduo >= 1 - 0.001
                        and #basiObjs >= 2
                        and not (soloPerno and avanzato)
        setBtn("btn_" .. unitKey .. "_PivotSx", pivotOk)
        setBtn("btn_" .. unitKey .. "_PivotDx", pivotOk)

        -- Rotta: mossa obbligatoria, si chiude solo se bloccata
        if state.rotta then
            setBtn("btn_" .. unitKey .. "_Close", state.bloccata == true)
        end
    end, 5)
end
-- ============================================================
-- FUNZIONE: move_snapshot(unitKey)
-- Fotografa posizione/rotazione di tutte le basi + i budget
-- residui — usato per Annulla Ultimo/Annulla Tutto. Indicizzato
-- per posizione nell'array state.basiObjs (stabile per tutta la
-- sessione), non per GUID.
-- ============================================================
function move_snapshot(unitKey)
    local state = IEF_MOVE_UNITS[unitKey]
    if not state or not state.basiObjs then return nil end

    local pos, rot = {}, {}
    for i, b in ipairs(state.basiObjs) do
        pos[i] = b.getPosition()
        rot[i] = b.getRotation()
    end

    local amiche = nil
    if state.amicheRotta then
        amiche = {}
        for k, v in pairs(state.amicheRotta) do amiche[k] = v end
    end

    return {
        pos = pos, rot = rot,
        budget      = IEF_MOVE_BUDGET[unitKey],
        pivotBudget = IEF_PIVOT_BUDGET[unitKey],
        amiche      = amiche,
        bloccata    = state.bloccata,
    }
end

-- ============================================================
-- FUNZIONE: move_restoreSnapshot(unitKey, snap)
-- Riapplica una fotografia presa da move_snapshot.
-- ============================================================
function move_restoreSnapshot(unitKey, snap)
    local state = IEF_MOVE_UNITS[unitKey]
    if not state or not state.basiObjs or not snap then return end

    for i, b in ipairs(state.basiObjs) do
        if snap.pos[i] then b.setPosition(snap.pos[i]) end
        if snap.rot[i] then b.setRotation(snap.rot[i]) end
    end

    IEF_MOVE_BUDGET[unitKey]  = snap.budget
    IEF_PIVOT_BUDGET[unitKey] = snap.pivotBudget
    if state.rotta then
        state.amicheRotta = snap.amiche or {}
        state.bloccata = snap.bloccata
    end
end

-- ============================================================
-- FUNZIONE: move_undoLast(unitKey)
-- Annulla solo l'ultima azione (ultimo Avanti o Perno), non tutte.
-- ============================================================ 
function move_undoLast(unitKey)
    local state = IEF_MOVE_UNITS[unitKey]
    if not state or not state.history or #state.history == 0 then return end

    local snap = table.remove(state.history)
    move_restoreSnapshot(unitKey, snap)
    move_redraw(unitKey)
end

-- ============================================================
-- FUNZIONE: move_undoAll(unitKey)
-- Annulla tutte le azioni: torna alla posizione/rotazione/budget
-- dell'apertura del pannello.
-- ============================================================
function move_undoAll(unitKey)
    local state = IEF_MOVE_UNITS[unitKey]
    if not state then return end

    move_restoreSnapshot(unitKey, {
        pos = state.startPos, rot = state.startRot,
        budget = state.startBudget, pivotBudget = state.startPivotBudget,
    })
    state.history = {}
    move_redraw(unitKey)
end
-- ============================================================
-- FUNZIONE: move_avanti_apply(unitKey, distanzaInch)
-- ============================================================
function move_avanti_apply(unitKey, distanzaInch)
    local state = IEF_MOVE_UNITS[unitKey]
    if not state or not state.basiObjs then return false end
    local basiObjs = state.basiObjs

    local residuo = IEF_MOVE_BUDGET[unitKey] or 0
    if residuo <= 0 and not IEF_MOVE_TEST_MODE then return false end
    if distanzaInch > residuo and not IEF_MOVE_TEST_MODE then distanzaInch = residuo end

    -- Prosecuzione della rotta: nemico o intransitabile fermano il
    -- passo (si evitano con perno o contraendo il fronte); le amiche
    -- attraversate si annotano (disordinate a fine mossa).
    if state.rotta then
        local passo = main_routCheckStep(unitKey, distanzaInch)
        if passo.avanza < distanzaInch - 0.01 then
            state.bloccata = true
            local p = state.activePlayer
            if p then
                warningToColor(passo.nemico and "Rotta: nemico davanti, la fuga si ferma qui"
                    or "Rotta: terreno intransitabile davanti, usa il perno o contrai il fronte", p, "Yellow", 5, true)
            end
        else
            state.bloccata = nil
        end
        state.nuoveAmiche = passo.amiche
        distanzaInch = passo.avanza
        if distanzaInch <= 0 then
            move_redraw(unitKey)
            return false
        end
    end
    
    state.history = state.history or {}
    table.insert(state.history, move_snapshot(unitKey))

    if state.rotta then
        for key, tipo in pairs(state.nuoveAmiche or {}) do state.amicheRotta[key] = tipo end
        state.nuoveAmiche = nil
    end
    
    local fwd   = basiObjs[1].getTransformForward()
    local fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()
    local deltaUnits  = distanzaInch * INCH_TO_TTS

    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        main_setPositionOnGround(obj, p.x + fwdXZ.x*deltaUnits, p.z + fwdXZ.z*deltaUnits)
    end

    IEF_MOVE_BUDGET[unitKey] = residuo - distanzaInch

    -- Terreni (non in rotta: la rotta ignora le penalità): il
    -- passo si annulla se finisce in terreno vietato o supera il
    -- movimento consentito dal terreno toccato; se c'è ancora
    -- margine si rifà più corto.
    if not state.rotta and not IEF_MOVE_TEST_MODE and not main_isGeneralKey(unitKey) then
        local meta = main_getUnitMeta(basiObjs[1])
        local tipo = meta and meta.unitType
        local pieno = main_unitFullMove(unitKey)
        local cap, chi = main_terrainMoveCap(unitKey, tipo, pieno)
        local usatoPrima = pieno - residuo
        if cap and (cap < 0 or usatoPrima + distanzaInch > cap + 0.01) then
            move_restoreSnapshot(unitKey, table.remove(state.history))
            local p = state.activePlayer
            if cap < 0 then
                if p then warningToColor(string.format("Terreno %s: non transitabile per questa unita'", chi), p, "Yellow", 5, true) end
                move_redraw(unitKey)
                return false
            end
            local margine = cap - usatoPrima
            if margine > 0.05 then
                if p then warningToColor(string.format("Terreno %s: movimento ridotto a %.1f\"", chi, cap), p, "Yellow", 5, true) end
                return move_avanti_apply(unitKey, margine)
            end
            if p then warningToColor(string.format("Terreno %s: movimento esaurito (massimo %.1f\")", chi, cap), p, "Yellow", 5, true) end
            move_redraw(unitKey)
            return false
        end
    end

    move_redraw(unitKey)
    return true
end
-- ============================================================
-- FUNZIONE: move_perno_apply(unitKey, direction)
-- ============================================================
function move_perno_apply(unitKey, direction)
    local state = IEF_MOVE_UNITS[unitKey]
    if not state or not state.basiObjs or #state.basiObjs < 2 then return false end
    local basiObjs = state.basiObjs

    local moveResiduo  = IEF_MOVE_BUDGET[unitKey]  or 0
    local pivotResiduo = IEF_PIVOT_BUDGET[unitKey] or 0

    move_getGroupAxis(basiObjs)

    local pivotBase, farBase
    if direction == "left" then
        pivotBase, farBase = basiObjs[1], basiObjs[#basiObjs]
    else
        pivotBase, farBase = basiObjs[#basiObjs], basiObjs[1]
    end

    local pivotPos = pivotBase.getPosition()
    local farPos   = farBase.getPosition()
    local radius = (Vector(farPos.x - pivotPos.x, 0, farPos.z - pivotPos.z)):magnitude()
    if radius <= 0 then return false end

    -- Angolo FISSO allo snap di TTS (15°), non più calcolato da
    -- distanzaInch/radius — elimina la discrepanza che causava il
    -- soft-snap al tocco: il nostro perno e quello di TTS coincidono.
    local angoloGradi = (direction == "left") and -ROTATION_SNAP_DEGREES or ROTATION_SNAP_DEGREES
    local angoloSigned = math.rad(angoloGradi)

    -- Regolamento: ogni perno costa 1" di movimento, massimo 3
    -- perni per mossa (IEF_PIVOT_BUDGET parte da 3). L'angolo resta
    -- quello dello snap di TTS.
    local distanzaInch = 1

    if not IEF_MOVE_TEST_MODE then
        if distanzaInch > moveResiduo or distanzaInch > pivotResiduo then
            return false
        end
    end

    state.history = state.history or {}
    table.insert(state.history, move_snapshot(unitKey))

    for _, obj in ipairs(basiObjs) do
        if obj ~= pivotBase then
            local p = obj.getPosition()
            local rel = Vector(p.x - pivotPos.x, 0, p.z - pivotPos.z)
            local rx = rel.x * math.cos(angoloSigned) - rel.z * math.sin(angoloSigned)
            local rz = rel.x * math.sin(angoloSigned) + rel.z * math.cos(angoloSigned)
            main_setPositionOnGround(obj, pivotPos.x + rx, pivotPos.z + rz, angoloSigned)
        else
            main_setPositionOnGround(obj, pivotPos.x, pivotPos.z, angoloSigned)
        end
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y - angoloGradi, rot.z))
    end

    if not IEF_MOVE_TEST_MODE then
        IEF_MOVE_BUDGET[unitKey]  = moveResiduo  - distanzaInch
        IEF_PIVOT_BUDGET[unitKey] = pivotResiduo - distanzaInch
    end

    move_redraw(unitKey)
    return true
end

-- ============================================================
-- FUNZIONE: move_close(unitKey)
-- Chiude il pannello 3D e pulisce lo stato dell'unità.
-- ============================================================
function move_close(unitKey)
    local state = IEF_MOVE_UNITS[unitKey]
    if not state then return end

    -- Disordine/riordino da terreno a fine mossa (non per la rotta)
    if not state.rotta and ENGINE.phase == PHASE.MOVE then
        main_terrainCohesionAfterMove(unitKey)
    end

    if state.lineHost then
        state.lineHost.setVectorLines({})
    end
    if state.panel3DObj and not state.panel3DObj.isDestroyed() then
        state.panel3DObj.UI.setXml("")
    end

    IEF_MOVE_UNITS[unitKey] = nil
end

-- ============================================================
-- FUNZIONE: move_btnMove1(player, value, id)
-- ============================================================
function move_btnMove1(player, value, id)
    local unitKey = id:match("^btn_(.+)_Move1$")
    if unitKey then move_avanti_apply(unitKey, 1) end
end
-- ============================================================
-- FUNZIONE: move_btnMove2(player, value, id)
-- ============================================================
function move_btnMove2(player, value, id)
    local unitKey = id:match("^btn_(.+)_Move2$")
    if unitKey then move_avanti_apply(unitKey, 2) end
end
-- ============================================================
-- FUNZIONE: move_btnMoveMax(player, value, id)
-- ============================================================

function move_btnMoveMax(player, value, id)
    local unitKey = id:match("^btn_(.+)_MoveMax$")
    if not unitKey then return end
    local residuo = IEF_MOVE_BUDGET[unitKey] or 0
    move_avanti_apply(unitKey, residuo)
end
-- ============================================================
-- FUNZIONE: move_btnPivotSx(player, value, id)
-- ============================================================
function move_btnPivotSx(player, value, id)
    local unitKey = id:match("^btn_(.+)_PivotSx$")
    if unitKey then move_perno_apply(unitKey, "left") end
end
-- ============================================================
-- FUNZIONE: move_btnPivotDx(player, value, id)
-- ============================================================
function move_btnPivotDx(player, value, id)
    local unitKey = id:match("^btn_(.+)_PivotDx$")
    if unitKey then move_perno_apply(unitKey, "right") end
end
-- ============================================================
-- FUNZIONE: move_btnClose(player, value, id)
-- ============================================================
function move_btnClose(player, value, id)
    local unitKey = id:match("^btn_(.+)_Close$")
    if not unitKey then return end
    local state = IEF_MOVE_UNITS[unitKey]
    if state and state.rotta then
        if not state.bloccata and (IEF_MOVE_BUDGET[unitKey] or 0) > 0 then
            warningToColor("La rotta è obbligatoria: completa la mossa", player, "Yellow", 5, true)
            return
        end
        main_routContinueDone(unitKey, state)
    end
    move_close(unitKey)
end
-- ============================================================
-- FUNZIONE: move_btnUndoLast(player, value, id)
-- ============================================================
function move_btnUndoLast(player, value, id)
    local unitKey = id:match("^btn_(.+)_UndoLast$")
    if unitKey then move_undoLast(unitKey) end
end

-- ============================================================
-- FUNZIONE: move_btnUndoAll(player, value, id)
-- onClick 3D del pulsante "Annulla Tutto".
-- ============================================================
function move_btnUndoAll(player, value, id)
    local unitKey = id:match("^btn_(.+)_UndoAll$")
    if unitKey then move_undoAll(unitKey) end
end

