-- ============================================================
-- FUNZIONE: move_lineLeft()
-- ============================================================
function move_lineLeft(player, value, id, buttonConfig) return move_applyFormation("lineLeft", player) end
-- ============================================================
-- FUNZIONE: move_lineRight()
-- ============================================================
function move_lineRight(player, value, id, buttonConfig) return move_applyFormation("lineRight", player) end
-- ============================================================
-- FUNZIONE: move_columnUp()
-- ============================================================
function move_columnUp(player, value, id, buttonConfig) return move_applyFormation("columnUp", player) end
-- ============================================================
-- FUNZIONE: move_columnDown()
-- ============================================================
function move_columnDown(player, value, id, buttonConfig) return move_applyFormation("columnDown", player) end
-- ============================================================
-- FUNZIONE: move_skirmish()
-- ============================================================
function move_skirmish(player, value, id, buttonConfig) return move_applyFormation("skirmish", player) end
-- ============================================================
-- FUNZIONE: move_applyFormation()
-- ============================================================
function move_applyFormation(mode, player)

    local selected = main_getSelectedObjects(player)
    if selected == nil or #selected < 2 then
        warningToColor(("Seleziona almeno 2 basi"):upper(), player, "Yellow")
        return false
    end

    local leader = selected[1]
    local right = leader.getTransformRight()
    local forward = leader.getTransformForward()

    local leaderBounds = leader.getBounds()
    local horizontalSpacing = leaderBounds.size.x + 0.05
    local verticalSpacing   = leaderBounds.size.z + 0.05

    for i = 2, #selected do
        local obj = selected[i]
        local index = i - 1
        local pos = nil

        if mode == "lineLeft" then
            pos = leader.getPosition() - right * (horizontalSpacing * index)
        elseif mode == "lineRight" then
            pos = leader.getPosition() + right * (horizontalSpacing * index)
        elseif mode == "columnUp" then
            pos = leader.getPosition() + forward * (verticalSpacing * index)
        elseif mode == "columnDown" then
            pos = leader.getPosition() - forward * (verticalSpacing * index)
        elseif mode == "skirmish" then
            pos = leader.getPosition() + right * (horizontalSpacing * 2 * index)
        end

        if pos ~= nil then
            obj.setPosition(pos)
            obj.setRotation(leader.getRotation())
        end
    end

    return true
end
-- ============================================================
-- FUNZIONE: move_getGroupAxis(basiObjs)
-- Ricalcola fwdXZ/right dalle posizioni/rotazioni attuali,
-- riordina basiObjs lungo l'asse "right".
-- ============================================================
function move_getGroupAxis(basiObjs)
    local fwdRef0 = basiObjs[1].getTransformForward()
    local fwdXZ0  = Vector(fwdRef0.x, 0, fwdRef0.z):normalized()
    local right0  = Vector(-fwdXZ0.z, 0, fwdXZ0.x)

    table.sort(basiObjs, function(a, b)
        local pa, pb = a.getPosition(), b.getPosition()
        return (pa.x*right0.x + pa.z*right0.z) < (pb.x*right0.x + pb.z*right0.z)
    end)

    local pos1, pos2 = basiObjs[1].getPosition(), basiObjs[#basiObjs].getPosition()
    local right, fwdXZ

    if #basiObjs == 1 then
        local fwd = basiObjs[1].getTransformForward()
        fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()
        right = Vector(-fwdXZ.z, 0, fwdXZ.x)
    else
        local dirUnita = Vector(pos2.x - pos1.x, 0, pos2.z - pos1.z):normalized()
        right = dirUnita
        fwdXZ = Vector(dirUnita.z, 0, -dirUnita.x)
    end

    return fwdXZ, right, pos1, pos2
end

-- ============================================================
-- FUNZIONE: move_redraw(player)
-- Ridisegna il rettangolo "avanti" e aggiorna label + stato
-- visibile (active = mostra/nasconde) di TUTTI i pulsanti,
-- in base a budget residuo E main_canManeuver per tipo unità.
-- ============================================================
function move_redraw(player)
    local basiObjs = IEF_MOVE.basiObjs
    local unitKey  = IEF_MOVE.unitKey
    if not basiObjs or not unitKey then return end

    local moveResiduo  = IEF_MOVE_BUDGET[unitKey]  or 0
    local pivotResiduo = IEF_PIVOT_BUDGET[unitKey] or 0
    local reformUsed   = IEF_REFORM_USED[unitKey]  or false

    if moveResiduo <= 0 then
        move_avanti_reset()
        return
    end

    local baseInfo = deployment_parseNickname(basiObjs[1].getName())
    local tipo = baseInfo and baseInfo.unitType

    local fwdXZ, right, pos1, pos2, mover = move_getFrontLine(basiObjs, unitKey)                    

    if IEF_MOVE.lineHost and IEF_MOVE.lineHost ~= mover then
        IEF_MOVE.lineHost.setVectorLines({})
    end

    local INCH_TO_TTS = 1.885
    local rangeUnits  = moveResiduo * INCH_TO_TTS

    local CM_TO_TTS = 0.7423
    local unitTypeData = main_getUnitType(tipo)
    local halfWidth = (unitTypeData and unitTypeData.base_width_cm or 4) * CM_TO_TTS / 2 - 0.06
    local halfDepth = (unitTypeData and unitTypeData.base_depth_cm or 3) * CM_TO_TTS / 2 - 0.06

    local pos = mover.getPosition()

    local startLeft  = Vector(pos1.x - right.x*halfWidth + fwdXZ.x*halfDepth, pos.y+0.3, pos1.z - right.z*halfWidth + fwdXZ.z*halfDepth)
    local startRight = Vector(pos2.x + right.x*halfWidth + fwdXZ.x*halfDepth, pos.y+0.3, pos2.z + right.z*halfWidth + fwdXZ.z*halfDepth)
    local endLeft    = Vector(startLeft.x  + fwdXZ.x*rangeUnits, pos.y+0.3, startLeft.z  + fwdXZ.z*rangeUnits)
    local endRight   = Vector(startRight.x + fwdXZ.x*rangeUnits, pos.y+0.3, startRight.z + fwdXZ.z*rangeUnits)

    mover.setVectorLines({
        {points = {mover.positionToLocal(startLeft),  mover.positionToLocal(endLeft)},  color={0.2,0.6,1}, thickness=0.1},
        {points = {mover.positionToLocal(startRight), mover.positionToLocal(endRight)}, color={0.2,0.6,1}, thickness=0.1},
        {points = {mover.positionToLocal(endLeft),    mover.positionToLocal(endRight)}, color={0.2,0.6,1}, thickness=0.1},
    })
    IEF_MOVE.lineHost = mover

    UI.setAttribute("confirm_panel_move", "active", "true")
    UI.setAttribute("confirm_panel_move", "visibility", player.color)

    local fronteAttuale = IEF_FRONT_WIDTH[unitKey] or #basiObjs
    UI.setAttribute("move_residuo_label", "text",
        string.format("Movimento: %.0f\"   Perno: %.0f\"   Fronte: %d", moveResiduo, pivotResiduo, fronteAttuale))

    local function canDo(manovra)
        return tipo and main_canManeuver(manovra, tipo)
    end

    -- Avanti
    local avantiOk = canDo("avanti")
    UI.setAttribute("btnMove1",   "active", (avantiOk and moveResiduo >= 1) and "true" or "false")
    UI.setAttribute("btnMove2",   "active", (avantiOk and moveResiduo >= 2) and "true" or "false")
    UI.setAttribute("btnMoveMax", "active", avantiOk and "true" or "false")
    UI.setAttribute("btnMoveMax", "text",   string.format("%.0f\"", moveResiduo))

    -- Perno
    local pivotOk = canDo("perno_max3_fermi") and pivotResiduo >= 1 and moveResiduo >= 1
    UI.setAttribute("btnPivotSx", "active", pivotOk and "true" or "false")
    UI.setAttribute("btnPivotDx", "active", pivotOk and "true" or "false")

    -- Espandi/Contrai
    local reformOk = canDo("espandi_contrai_1_2_basi_fermi") and (IEF_MOVE_TEST_MODE or not reformUsed)
    UI.setAttribute("btnFrontMinus2", "active", reformOk and "true" or "false")
    UI.setAttribute("btnFrontMinus1", "active", reformOk and "true" or "false")
    UI.setAttribute("btnFrontPlus1",  "active", reformOk and "true" or "false")
    UI.setAttribute("btnFrontPlus2",  "active", reformOk and "true" or "false")

    -- Dietrofront 180°
    local fronte180Ok = canDo("cambio_fronte_180_fermi") and (IEF_MOVE_TEST_MODE or not reformUsed)
    UI.setAttribute("btnCambio180", "active", fronte180Ok and "true" or "false")

    -- Cambio fronte 90° — richiede ANCHE formazione rettangolare pura
    local isRettangolare = (#basiObjs % fronteAttuale == 0)
    local fronte90Ok = canDo("cambio_fronte_90_fermi") and isRettangolare and (IEF_MOVE_TEST_MODE or not reformUsed)
    UI.setAttribute("btnCambio90Sx", "active", fronte90Ok and "true" or "false")
    UI.setAttribute("btnCambio90Dx", "active", fronte90Ok and "true" or "false")
end

-- ============================================================
-- FUNZIONE: move_avanti_rectangle(player)
-- Trigger iniziale: filtra il gruppo per unitKey, inizializza
-- budget/fronte se serve, apre il pannello.
-- ============================================================
function move_avanti_rectangle(player, value, id, buttonConfig)

    local selected = main_getSelectedObjects(player)
    if not selected or #selected < 1 then
        printToAll("[MOVIMENTO] Seleziona almeno una base", {r=1,g=0.6,b=0})
        return false
    end

    local mover = selected[1]
    local moverSlot = mover.hasTag("Army1") and 1 or (mover.hasTag("Army2") and 2 or nil)
    if moverSlot == nil then return false end

    local playerSlot = main_getArmyByColor(player)
    if playerSlot ~= moverSlot then
        printToColor("[MOVIMENTO] Non è la tua unità", player.color, {r=1,g=0.3,b=0.3})
        return false
    end

    local baseInfo  = deployment_parseNickname(mover.getName())
    local moverUnit = baseInfo and main_findUnit(moverSlot, baseInfo.unitType, baseInfo.unitNumber)
    if not moverUnit or not baseInfo then
        printToColor("[MOVIMENTO] Impossibile leggere le informazioni dell'unità", player.color, {r=1,g=0.6,b=0})
        return false
    end

    local unitKey = moverSlot .. "_" .. baseInfo.unitType .. "_" .. baseInfo.unitNumber

    if IEF_MOVE_BUDGET[unitKey] == nil or IEF_MOVE_TEST_MODE then
        local unitTypesDict = IEF_DATA.unitTypes and (IEF_DATA.unitTypes.unit_types or IEF_DATA.unitTypes)
        local typeData = unitTypesDict and unitTypesDict[baseInfo.unitType]
        IEF_MOVE_BUDGET[unitKey] = typeData and typeData.move_inches or 0
    end
    if IEF_PIVOT_BUDGET[unitKey] == nil or IEF_MOVE_TEST_MODE then
        IEF_PIVOT_BUDGET[unitKey] = 3
    end

    if IEF_MOVE_BUDGET[unitKey] <= 0 then
        printToColor("[MOVIMENTO] Nessun movimento residuo per questa unità", player.color, {r=1,g=0.6,b=0})
        return false
    end

    local basiObjs = {}
    for _, obj in ipairs(selected) do
        local info = deployment_parseNickname(obj.getName())
        if info then
            local objSlot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
            local objKey  = objSlot and (objSlot .. "_" .. info.unitType .. "_" .. info.unitNumber)
            if objKey == unitKey then
                table.insert(basiObjs, obj)
            end
        end
    end
    if #basiObjs == 0 then return false end

    if IEF_FRONT_WIDTH[unitKey] == nil then
        IEF_FRONT_WIDTH[unitKey] = moverUnit.basi_per_rango or #basiObjs
    end

    IEF_MOVE.basiObjs     = basiObjs
    IEF_MOVE.unitKey      = unitKey
    IEF_MOVE.activePlayer = player

    move_redraw(player)
    return true
end

-- ============================================================
-- FUNZIONE: move_avanti_apply(distanzaInch)
-- ============================================================
function move_avanti_apply(distanzaInch)
    local basiObjs = IEF_MOVE.basiObjs
    local unitKey  = IEF_MOVE.unitKey
    local player   = IEF_MOVE.activePlayer
    if not basiObjs or not unitKey then return false end

    local residuo = IEF_MOVE_BUDGET[unitKey] or 0
    if residuo <= 0 then return false end
    if distanzaInch > residuo then distanzaInch = residuo end

    local fwd   = basiObjs[1].getTransformForward()
    local fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()
    local INCH_TO_TTS = 1.885
    local deltaUnits  = distanzaInch * INCH_TO_TTS

    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        obj.setPosition(Vector(p.x + fwdXZ.x*deltaUnits, p.y, p.z + fwdXZ.z*deltaUnits))
    end

    IEF_MOVE_BUDGET[unitKey] = residuo - distanzaInch
    move_redraw(player)
    return true
end

-- ============================================================
-- FUNZIONE: move_perno_apply(direction)
-- Versione confermata funzionante (coordinate mondo dirette).
-- ============================================================
function move_perno_apply(direction)

    local basiObjs = IEF_MOVE.basiObjs
    local unitKey  = IEF_MOVE.unitKey
    local player   = IEF_MOVE.activePlayer
    if not basiObjs or not unitKey or #basiObjs < 2 then return false end

    local moveResiduo  = IEF_MOVE_BUDGET[unitKey]  or 0
    local pivotResiduo = IEF_PIVOT_BUDGET[unitKey] or 0
    local distanzaInch = math.min(1, moveResiduo, pivotResiduo)
    if distanzaInch <= 0 then return false end

    move_getGroupAxis(basiObjs)

    local pivotBase, farBase
    if direction == "left" then
        pivotBase, farBase = basiObjs[1], basiObjs[#basiObjs]
    else
        pivotBase, farBase = basiObjs[#basiObjs], basiObjs[1]
    end

    local pivotPos = pivotBase.getPosition()
    local farPos   = farBase.getPosition()
    local radius = (Vector(farPos.x - pivotPos.x, 0, farPos.z - pivotPos.z)):magnitude()
    if radius <= 0 then return false end

    local INCH_TO_TTS = 1.885
    local dirSegno = (direction == "left") and -1 or 1
    local angoloSigned = dirSegno * (distanzaInch * INCH_TO_TTS) / radius
    local angoloGradi  = math.deg(angoloSigned)

    for _, obj in ipairs(basiObjs) do
        if obj ~= pivotBase then
            local p = obj.getPosition()
            local rel = Vector(p.x - pivotPos.x, 0, p.z - pivotPos.z)
            local rx = rel.x * math.cos(angoloSigned) - rel.z * math.sin(angoloSigned)
            local rz = rel.x * math.sin(angoloSigned) + rel.z * math.cos(angoloSigned)
            local newPos = Vector(pivotPos.x + rx, p.y, pivotPos.z + rz)
            obj.setPosition(newPos)
        end
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y - angoloGradi, rot.z))
    end

    IEF_MOVE_BUDGET[unitKey]  = moveResiduo  - distanzaInch
    IEF_PIVOT_BUDGET[unitKey] = pivotResiduo - distanzaInch

    move_redraw(player)
    return true
end

-- ============================================================
-- FUNZIONE: move_espandiContrai(deltaFronte)
-- ============================================================
function move_espandiContrai(deltaFronte)

    local basiObjs = IEF_MOVE.basiObjs
    local unitKey  = IEF_MOVE.unitKey
    local player   = IEF_MOVE.activePlayer
    if not basiObjs or not unitKey or #basiObjs < 2 then return false end

    local baseInfo = deployment_parseNickname(basiObjs[1].getName())
    if not baseInfo then return false end

    if not IEF_MOVE_TEST_MODE then
        if IEF_REFORM_USED[unitKey] then
            printToColor("[MOVIMENTO] Manovra di riorganizzazione già usata questo turno", player.color, {r=1,g=0.6,b=0})
            return false
        end
        if not main_canManeuver("espandi_contrai_1_2_basi_fermi", baseInfo.unitType) then
            printToColor("[MOVIMENTO] Questa unità non può espandere/contrarre il fronte", player.color, {r=1,g=0.6,b=0})
            return false
        end
    end

    if IEF_FRONT_WIDTH[unitKey] == nil then
        IEF_FRONT_WIDTH[unitKey] = #basiObjs
    end

    local newFront = IEF_FRONT_WIDTH[unitKey] + deltaFronte
    if newFront < 1 then newFront = 1 end
    if newFront > #basiObjs then newFront = #basiObjs end

    table.sort(basiObjs, function(a, b)
        local ia = deployment_parseNickname(a.getName())
        local ib = deployment_parseNickname(b.getName())
        return (ia and ia.baseSeq or 0) < (ib and ib.baseSeq or 0)
    end)

    local anchor     = basiObjs[1]
    local fwd        = anchor.getTransformForward()
    local fwdXZ      = Vector(fwd.x, 0, fwd.z):normalized()
    local right      = Vector(-fwdXZ.z, 0, fwdXZ.x)

    local baseInfoAnchor = deployment_parseNickname(anchor.getName())
    local unitTypeDataAnchor = baseInfoAnchor and main_getUnitType(baseInfoAnchor.unitType)
    local CM_TO_TTS = 0.7423
    local HGAP = 0.25
    local VGAP = 0.1
    local width = (unitTypeDataAnchor and unitTypeDataAnchor.base_width_cm or 4) * CM_TO_TTS + HGAP
    local depth = (unitTypeDataAnchor and unitTypeDataAnchor.base_depth_cm or 3) * CM_TO_TTS + VGAP

    local anchorPos  = anchor.getPosition()
    local anchorRot  = anchor.getRotation()

    local totalBasi   = #basiObjs
    local ranghiPieni = math.floor(totalBasi / newFront)
    local resto       = totalBasi % newFront

    for i, obj in ipairs(basiObjs) do
        local idx  = i - 1
        local rank = math.floor(idx / newFront)
        local col  = idx % newFront

        if resto == 2 and rank == ranghiPieni then
            local posizioneNelResto = idx - (ranghiPieni * newFront)
            col = (posizioneNelResto == 0) and 0 or (newFront - 1)
        end

        local newPos = Vector(
            anchorPos.x + right.x*(col*width) - fwdXZ.x*(rank*depth),
            obj.getPosition().y,
            anchorPos.z + right.z*(col*width) - fwdXZ.z*(rank*depth)
        )
        obj.setPosition(newPos)
        obj.setRotation(anchorRot)
    end

    IEF_FRONT_WIDTH[unitKey] = newFront
    IEF_REFORM_USED[unitKey] = true

    move_redraw(player)
    return true
end

-- ============================================================
-- FUNZIONE: move_cambioFronte180()
-- ============================================================
function move_cambioFronte180(player, value, id, buttonConfig)

    local basiObjs = IEF_MOVE.basiObjs
    local unitKey  = IEF_MOVE.unitKey
    if not basiObjs or not unitKey then return false end

    local activePlayer = IEF_MOVE.activePlayer

    if not IEF_MOVE_TEST_MODE then
        if IEF_REFORM_USED[unitKey] then
            printToColor("[MOVIMENTO] Manovra di riorganizzazione già usata questo turno", activePlayer.color, {r=1,g=0.6,b=0})
            return false
        end
        local baseInfo = deployment_parseNickname(basiObjs[1].getName())
        if not baseInfo or not main_canManeuver("cambio_fronte_180_fermi", baseInfo.unitType) then
            printToColor("[MOVIMENTO] Questa unità non può fare dietrofront", activePlayer.color, {r=1,g=0.6,b=0})
            return false
        end
    end

    local sumX, sumZ, sumY = 0, 0, 0
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        sumX, sumZ, sumY = sumX + p.x, sumZ + p.z, sumY + p.y
    end
    local n = #basiObjs
    local center = Vector(sumX/n, sumY/n, sumZ/n)

    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        obj.setPosition(Vector(2*center.x - p.x, p.y, 2*center.z - p.z))
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y + 180, rot.z))
    end

    IEF_REFORM_USED[unitKey] = true
    move_redraw(activePlayer)
    return true
end

-- ============================================================
-- FUNZIONE: move_cambioFronte90(direction)
-- Scambia fronte<->profondità (solo formazioni rettangolari
-- pure). direction "left"/"right" determina quale colonna
-- diventa il nuovo fronte (rank 0).
-- ============================================================
function move_cambioFronte90(direction)

    local basiObjs = IEF_MOVE.basiObjs
    local unitKey  = IEF_MOVE.unitKey
    local player   = IEF_MOVE.activePlayer
    if not basiObjs or not unitKey or #basiObjs < 2 then return false end

    local fronteAttuale = IEF_FRONT_WIDTH[unitKey] or #basiObjs
    local totalBasi = #basiObjs

    if totalBasi % fronteAttuale ~= 0 then
        printToColor("[MOVIMENTO] Cambio fronte 90° disponibile solo su formazioni rettangolari", player.color, {r=1,g=0.6,b=0})
        return false
    end

    local baseInfo = deployment_parseNickname(basiObjs[1].getName())
    if not baseInfo then return false end

    if not IEF_MOVE_TEST_MODE then
        if IEF_REFORM_USED[unitKey] then
            printToColor("[MOVIMENTO] Manovra di riorganizzazione già usata questo turno", player.color, {r=1,g=0.6,b=0})
            return false
        end
        if not main_canManeuver("cambio_fronte_90_fermi", baseInfo.unitType) then
            printToColor("[MOVIMENTO] Questa unità non può cambiare fronte di 90°", player.color, {r=1,g=0.6,b=0})
            return false
        end
    end

    table.sort(basiObjs, function(a, b)
        local ia = deployment_parseNickname(a.getName())
        local ib = deployment_parseNickname(b.getName())
        return (ia and ia.baseSeq or 0) < (ib and ib.baseSeq or 0)
    end)

    local anchor    = basiObjs[1]
    local fwd       = anchor.getTransformForward()
    local fwdXZ     = Vector(fwd.x, 0, fwd.z):normalized()
    local right     = Vector(-fwdXZ.z, 0, fwdXZ.x)

    local baseInfoAnchor = deployment_parseNickname(anchor.getName())
    local unitTypeDataAnchor = baseInfoAnchor and main_getUnitType(baseInfoAnchor.unitType)
    local CM_TO_TTS = 0.7423
    local HGAP = 0.25
    local VGAP = 0.1
    local width = (unitTypeDataAnchor and unitTypeDataAnchor.base_width_cm or 4) * CM_TO_TTS + HGAP
    local depth = (unitTypeDataAnchor and unitTypeDataAnchor.base_depth_cm or 3) * CM_TO_TTS + VGAP

    local anchorPos = anchor.getPosition()
    local anchorRot = anchor.getRotation()

    local vecchiaProfondita = totalBasi / fronteAttuale
    local nuovoFronte = vecchiaProfondita

    local griglia = {}
    for i, obj in ipairs(basiObjs) do
        local idx  = i - 1
        local rank = math.floor(idx / fronteAttuale)
        local col  = idx % fronteAttuale
        griglia[rank] = griglia[rank] or {}
        griglia[rank][col] = obj
    end

    for rank = 0, vecchiaProfondita - 1 do
        for col = 0, fronteAttuale - 1 do
            local obj = griglia[rank][col]
            if obj then
                local newRank, newCol
                if direction == "left" then
                    newRank = col
                    newCol  = rank
                else
                    newRank = (fronteAttuale - 1) - col
                    newCol  = rank
                end

                local newPos = Vector(
                    anchorPos.x + right.x*(newCol*width) - fwdXZ.x*(newRank*depth),
                    obj.getPosition().y,
                    anchorPos.z + right.z*(newCol*width) - fwdXZ.z*(newRank*depth)
                )
                obj.setPosition(newPos)
                obj.setRotation(anchorRot)
            end
        end
    end

    IEF_FRONT_WIDTH[unitKey] = nuovoFronte
    IEF_REFORM_USED[unitKey] = true

    move_redraw(player)
    return true
end

-- ============================================================
-- Wrapper pulsanti UI
-- ============================================================
function move_apply1()          return move_avanti_apply(1) end
function move_apply2()          return move_avanti_apply(2) end
function move_applyMax()
    local residuo = IEF_MOVE.unitKey and IEF_MOVE_BUDGET[IEF_MOVE.unitKey] or 0
    return move_avanti_apply(residuo)
end
function move_pivotSx()         return move_perno_apply("left") end
function move_pivotDx()         return move_perno_apply("right") end
function move_frontMinus2()     return move_espandiContrai(-2) end
function move_frontMinus1()     return move_espandiContrai(-1) end
function move_frontPlus1()      return move_espandiContrai(1) end
function move_frontPlus2()      return move_espandiContrai(2) end
function move_cambioFronte90Sx() return move_cambioFronte90("left") end
function move_cambioFronte90Dx() return move_cambioFronte90("right") end

-- ============================================================
-- FUNZIONE: move_avanti_reset()
-- ============================================================
function move_avanti_reset(player, value, id)
    if IEF_MOVE.lineHost then
        IEF_MOVE.lineHost.setVectorLines({})
    end
    IEF_MOVE.lineHost     = nil
    IEF_MOVE.basiObjs     = nil
    IEF_MOVE.unitKey      = nil
    IEF_MOVE.activePlayer = nil
    UI.setAttribute("confirm_panel_move", "active", "false")
end
-- ============================================================
-- FUNZIONE: move_ricostruisciFormazione(basiObjs, fronte)
-- Riposiziona/riorienta TUTTE le basi passate secondo una
-- griglia fronte x profondità pulita, usando come riferimento
-- fisso la posizione/rotazione ATTUALE della base seq=1
-- (l'ancora). Gestisce il caso resto==2 (estremi sx/dx),
-- coerente con move_espandiContrai.
-- ============================================================
function move_ricostruisciFormazione(basiObjs, fronte)

    if not basiObjs or #basiObjs < 1 then return false end
    if not fronte or fronte < 1 then fronte = #basiObjs end
    if fronte > #basiObjs then fronte = #basiObjs end

    -- Ordina per baseSeq (griglia stabile di schieramento)
    table.sort(basiObjs, function(a, b)
        local ia = deployment_parseNickname(a.getName())
        local ib = deployment_parseNickname(b.getName())
        return (ia and ia.baseSeq or 0) < (ib and ib.baseSeq or 0)
    end)

    local anchor    = basiObjs[1]
    local fwd       = anchor.getTransformForward()
    local fwdXZ     = Vector(fwd.x, 0, fwd.z):normalized()
    local right     = Vector(-fwdXZ.z, 0, fwdXZ.x)

    local baseInfoAnchor = deployment_parseNickname(anchor.getName())
    local unitTypeDataAnchor = baseInfoAnchor and main_getUnitType(baseInfoAnchor.unitType)
    local CM_TO_TTS = 0.7423
    local HGAP = 0.25
    local VGAP = 0.1
    local width = (unitTypeDataAnchor and unitTypeDataAnchor.base_width_cm or 4) * CM_TO_TTS + HGAP
    local depth = (unitTypeDataAnchor and unitTypeDataAnchor.base_depth_cm or 3) * CM_TO_TTS + VGAP

    local anchorPos = anchor.getPosition()
    local anchorRot = anchor.getRotation()

    local totalBasi   = #basiObjs
    local ranghiPieni = math.floor(totalBasi / fronte)
    local resto       = totalBasi % fronte

    for i, obj in ipairs(basiObjs) do
        local idx  = i - 1
        local rank = math.floor(idx / fronte)
        local col  = idx % fronte

        if resto == 2 and rank == ranghiPieni then
            local posizioneNelResto = idx - (ranghiPieni * fronte)
            col = (posizioneNelResto == 0) and 0 or (fronte - 1)
        end

        local newPos = Vector(
            anchorPos.x + right.x*(col*width) - fwdXZ.x*(rank*depth),
            obj.getPosition().y,
            anchorPos.z + right.z*(col*width) - fwdXZ.z*(rank*depth)
        )
        obj.setPosition(newPos)
        obj.setRotation(anchorRot)
    end

    return true
end

-- ============================================================
-- FUNZIONE: move_sistemaFormazione(player)
-- Wrapper per uso diretto: prende la selezione corrente,
-- filtra per unitKey (come move_avanti_rectangle), e richiama
-- move_ricostruisciFormazione col fronte salvato in
-- IEF_FRONT_WIDTH (o basi_per_rango se non ancora inizializzato).
-- ============================================================
function move_sistemaFormazione(player, value, id, buttonConfig)

    local selected = main_getSelectedObjects(player)
    if not selected or #selected < 1 then
        printToAll("[MOVIMENTO] Seleziona almeno una base", {r=1,g=0.6,b=0})
        return false
    end

    local mover = selected[1]
    local moverSlot = mover.hasTag("Army1") and 1 or (mover.hasTag("Army2") and 2 or nil)
    if moverSlot == nil then return false end

    local baseInfo  = deployment_parseNickname(mover.getName())
    local moverUnit = baseInfo and main_findUnit(moverSlot, baseInfo.unitType, baseInfo.unitNumber)
    if not moverUnit or not baseInfo then return false end

    local unitKey = moverSlot .. "_" .. baseInfo.unitType .. "_" .. baseInfo.unitNumber

    local basiObjs = {}
    for _, obj in ipairs(selected) do
        local info = deployment_parseNickname(obj.getName())
        if info then
            local objSlot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
            local objKey  = objSlot and (objSlot .. "_" .. info.unitType .. "_" .. info.unitNumber)
            if objKey == unitKey then
                table.insert(basiObjs, obj)
            end
        end
    end
    if #basiObjs == 0 then return false end

    local fronte = IEF_FRONT_WIDTH[unitKey] or moverUnit.basi_per_rango or #basiObjs

    move_ricostruisciFormazione(basiObjs, fronte)

    IEF_MOVE.basiObjs     = basiObjs
    IEF_MOVE.unitKey      = unitKey
    IEF_MOVE.activePlayer = player
    move_redraw(player)

    return true
end

-- ============================================================
-- FUNZIONE: move_getFrontLine(basiObjs, unitKey)
-- Individua il rango PIU' AVANZATO per posizione fisica reale
-- (proiezione lungo il fronte), non per baseSeq — così è
-- corretto sia allo spawn iniziale sia dopo qualsiasi manovra.
-- ============================================================
function move_getFrontLine(basiObjs, unitKey)
    local anchorRef = basiObjs[1]
    local fwd    = anchorRef.getTransformForward()
    local fwdXZ  = Vector(fwd.x, 0, fwd.z):normalized()
    local right  = Vector(-fwdXZ.z, 0, fwdXZ.x)

    -- Proiezione di ogni base lungo il fronte: la più alta = rango più avanzato
    local maxProj = -math.huge
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        if proj > maxProj then maxProj = proj end
    end

    local EPS = 0.5
    local frontRank = {}
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x*fwdXZ.x + p.z*fwdXZ.z
        if math.abs(proj - maxProj) < EPS then
            table.insert(frontRank, obj)
        end
    end

    -- Ordina il rango frontale lungo "right" per trovare gli estremi laterali veri
    table.sort(frontRank, function(a, b)
        local pa, pb = a.getPosition(), b.getPosition()
        return (pa.x*right.x + pa.z*right.z) < (pb.x*right.x + pb.z*right.z)
    end)

    local pos1  = frontRank[1].getPosition()
    local pos2  = frontRank[#frontRank].getPosition()
    local mover = frontRank[1]

    return fwdXZ, right, pos1, pos2, mover
end
-- ============================================================
-- FUNZIONE: move_highlightAndOpen(player, unitKey)
-- Trova tutte le basi di unitKey, le evidenzia (highlightOn),
-- inizializza IEF_MOVE.basiObjs direttamente (bypassando la
-- selezione mouse) e apre il pannello movimento via move_redraw.
-- ============================================================
function move_highlightAndOpen(player, unitKey)

    local basiObjs = {}
    for _, obj in ipairs(getAllObjects()) do
        local info = deployment_parseNickname(obj.getName())

        if info then
            local objSlot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
            local objKey  = objSlot and (objSlot .. "_" .. info.unitType .. "_" .. info.unitNumber)
           print(objKey)         
            if objKey == unitKey then
                table.insert(basiObjs, obj)
            end
        end
    end

    if #basiObjs == 0 then
        printToColor("[MOVIMENTO] Nessuna base trovata per " .. unitKey, player.color, {r=1,g=0.6,b=0})
        return false
    end

    -- Pulisci eventuale highlight precedente su un'altra unità
    if IEF_MOVE.basiObjs then
        for _, obj in ipairs(IEF_MOVE.basiObjs) do
            obj.highlightOff()
        end
    end

    for _, obj in ipairs(basiObjs) do
        obj.highlightOn("Yellow")
    end

    -- Parsing dalla prima base per inizializzare budget/fronte come in move_avanti_rectangle
    local baseInfo  = deployment_parseNickname(basiObjs[1].getName())
    local moverSlot = basiObjs[1].hasTag("Army1") and 1 or (basiObjs[1].hasTag("Army2") and 2 or nil)
    local moverUnit = baseInfo and moverSlot and main_findUnit(moverSlot, baseInfo.unitType, baseInfo.unitNumber)

    if IEF_MOVE_BUDGET[unitKey] == nil or IEF_MOVE_TEST_MODE then
        local unitTypesDict = IEF_DATA.unitTypes and (IEF_DATA.unitTypes.unit_types or IEF_DATA.unitTypes)
        local typeData = unitTypesDict and baseInfo and unitTypesDict[baseInfo.unitType]
        IEF_MOVE_BUDGET[unitKey] = typeData and typeData.move_inches or 0
    end
    if IEF_PIVOT_BUDGET[unitKey] == nil or IEF_MOVE_TEST_MODE then
        IEF_PIVOT_BUDGET[unitKey] = 3
    end
    if IEF_FRONT_WIDTH[unitKey] == nil then
        IEF_FRONT_WIDTH[unitKey] = (moverUnit and moverUnit.basi_per_rango) or #basiObjs
    end

    IEF_MOVE.basiObjs     = basiObjs
    IEF_MOVE.unitKey      = unitKey
    IEF_MOVE.activePlayer = player

    move_redraw(player)
    return true
end