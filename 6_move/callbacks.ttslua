-- ============================================================
-- FUNZIONE: roll_btn_all()
-- ============================================================
function move_btn_army1(player, value, id, buttonConfig)
    if main_routBlocksPhase(player, 1) then return false end
    if main_generalMoveBlocksPhase(player, 1) then return false end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY1)
    return true
end
-- ============================================================
-- FUNZIONE: roll_btn_all()
-- ============================================================
function move_btn_army2(player, value, id, buttonConfig)
    if main_routBlocksPhase(player, 2) then return false end
    if main_generalMoveBlocksPhase(player, 2) then return false end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY2)
    return true
end
