-- 2_field/phase.ttslua
function field_phase()
    return {        
            FIELD = {
                title = "CAMPO DI BATTAGLIA",
                desc  = "Prendi visione del numero di elementi terreno a disposizione, poi conferma",
                before = "before_field",
                after  = "after_field",
                allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK },
                render = "2BtnClick",
                enforceOwnership = true,
                inputMode = "OWNER",
                buttons = {
                    BTN_ARMY1 = { action="ARMY1_CLICK", label=orientamentoArmy1 .." (" .. FIELD_ELEMENTS_BY_ORIENTAMENTO[orientamentoArmy1] .. " elementi)", textColor="White", color="Red",   callback="field_readyArmy1" },
                    BTN_ARMY2 = { action="ARMY2_CLICK", label=orientamentoArmy2 .." (" .. FIELD_ELEMENTS_BY_ORIENTAMENTO[orientamentoArmy2] .. " elementi)", textColor="White", color="Green", callback="field_readyArmy2" },
                },
                transitions = {
                    { to="FIELD_ROLL", conditions={ COND.BOTH_PLAYERS_SELECTED } }
                }
            },
            FIELD_ROLL = {
                title = "CAMPO DI BATTAGLIA",
                desc  = "Tira i dadi fisici sul tavolo per ogni tuo elemento di terreno",
                before = "before_field_roll",
                after  = "after_field_roll",
                allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK },
                render = "2BtnClick",
                enforceOwnership = true,
                inputMode = "OWNER",
                buttons = {
                    BTN_ARMY1 = { action="ARMY1_CLICK", label="Tiro", textColor="White", color="Red",   callback="field_rollFieldElement" },
                    BTN_ARMY2 = { action="ARMY2_CLICK", label="Tiro", textColor="White", color="Green", callback="field_rollFieldElement" },
                },
                transitions = {
                    { to="FIELD_DONE", conditions={ COND.BOTH_PLAYERS_SELECTED } }
                }
            },
        FIELD_DONE = {
            title = "CAMPO DI BATTAGLIA",
            desc  = "Posiziona gli elementi sul tavolo",
            before = "before_field_done",
            after  = "after_field_done",
            allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK },
            render = "fieldConfirm",
            enforceOwnership = true,
            inputMode = "OWNER",
            buttons = {
                BTN_ARMY1 = { action="ARMY1_CLICK", label="Fatto", textColor="White", color="Red",   callback="field_btn_army1" },
                BTN_ARMY2 = { action="ARMY2_CLICK", label="Fatto", textColor="White", color="Green", callback="field_btn_army2" },
            },
            transitions = {
                { to="DEPLOY_SPAWN", conditions={ COND.BOTH_PLAYERS_SELECTED } }
            }
        }
    }
end
