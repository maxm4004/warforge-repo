-- 2_field/phase.ttslua
function field_phase()
    return {        
            FIELD = {
                title = "NUMERO ELEMENTI TERRENO STEP 1/5",
                desc  = "Prendi visione del numero di elementi del terreno a disposizione, poi conferma",
                before = "before_field",
                after  = "after_field",
                allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK },
                render = "2BtnClick",
                enforceOwnership = true,
                inputMode = "OWNER",
                buttons = {
                    BTN_ARMY1 = { action="ARMY1_CLICK", label= FIELD_ELEMENTS_BY_ORIENTAMENTO[orientamentoArmy1] .. " ELEMENTI TERRENO", textColor="White", color="Red",   callback="field_readyArmy1" },
                    BTN_ARMY2 = { action="ARMY2_CLICK", label=FIELD_ELEMENTS_BY_ORIENTAMENTO[orientamentoArmy2] .. " ELEMENTI TERRENO", textColor="White", color="Green", callback="field_readyArmy2" },
                },
                transitions = {
                    { to="FIELD_ROLL", conditions={ COND.BOTH_PLAYERS_SELECTED } }
                }
            },
            FIELD_ROLL = {
                title = "TIRA PER SCEGLIERE GLI ELEMENTI STEP 2/5",
                desc  = "Tira i dadi fisici sul tavolo per ogni tuo elemento di terreno",
                before = "before_field_roll",
                after  = "after_field_roll",
                allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK },
                render = "2BtnClick",
                enforceOwnership = true,
                inputMode = "OWNER",
                buttons = {
                    BTN_ARMY1 = { action="ARMY1_CLICK", label=" ", textColor="White", color="Red",   callback="field_rollFieldElement" },
                    BTN_ARMY2 = { action="ARMY2_CLICK", label="", textColor="White", color="Green", callback="field_rollFieldElement" },
                },
                transitions = {
                    { to="FIELD_BLOCK", conditions={ COND.BOTH_PLAYERS_SELECTED } }
                }
            },
            FIELD_BLOCK = {
                title = "TIRA PER SCEGLIERE IL BLOCCO STEP 3/5",
                desc  = "Tira i dadi fisici sul tavolo per piazzare gli elementi nei blocchi",
                before = "before_field_block",
                after  = "after_field_block",
                allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK },
                render = "2BtnClick",
                enforceOwnership = true,
                inputMode = "OWNER",
                buttons = {
                    BTN_ARMY1 = { action="ARMY1_CLICK", label="", textColor="White", color="Red",   callback="field_rollBlockZoom" },
                    BTN_ARMY2 = { action="ARMY2_CLICK", label="", textColor="White", color="Green", callback="field_rollBlockZoom" },
                },
                transitions = {
                    { to="FIELD_DONE", conditions={ COND.BOTH_PLAYERS_SELECTED } }
                }
            },
            FIELD_DONE = {
                title = "CAMPO DI BATTAGLIA STEP 4/5",
                desc  = "Conferma per procedere allo spawn del terreno 3D",
                before = "before_field_done",
                after  = "after_field_done",
                allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK },
                render = "fieldConfirm",
                enforceOwnership = true,
                inputMode = "OWNER",
                buttons = {
                    BTN_ARMY1 = { action="ARMY1_CLICK", label="", textColor="White", color="Red",   callback="field_done_army1" },
                    BTN_ARMY2 = { action="ARMY2_CLICK", label="", textColor="White", color="Green", callback="field_done_army2" },
                },
                transitions = {
                    { to="FIELD_POSITIONING_TERRAIN", conditions={ COND.BOTH_PLAYERS_SELECTED } }
                }
            },
            FIELD_POSITIONING_TERRAIN = {
                title = "POSIZIONAMENTO TERRENO STEP 5/5",
                desc  = "Posiziona liberamente i tuoi elementi di terreno dentro il blocco assegnato, poi conferma",
                before = "before_field_positioning_terrain",
                after  = "after_field_positioning_terrain",
                allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK },
                render = "2BtnClick",
                enforceOwnership = true,
                inputMode = "OWNER",
                buttons = {
                    BTN_ARMY1 = { action="ARMY1_CLICK", label="", textColor="White", color="Red",   callback="field_readyPositioning1" },
                    BTN_ARMY2 = { action="ARMY2_CLICK", label="", textColor="White", color="Green", callback="field_readyPositioning2" },
                },
                transitions = {
                    { to="DEPLOY_SPAWN", conditions={ COND.BOTH_PLAYERS_SELECTED } }
                }
            }
        }
end
