-- ============================================================
-- FUNZIONE: field_readyArmy1(player, value, id)
-- ============================================================
function field_readyArmy1(player, value, id)
    TURN.completed.Army1 = true
    engine_handleAction({ type = ACTION.ARMY1_CLICK })
    return true
end
-- ============================================================
-- FUNZIONE: field_readyArmy2(player, value, id)
-- ============================================================
function field_readyArmy2(player, value, id)
    TURN.completed.Army2 = true
    engine_handleAction({ type = ACTION.ARMY2_CLICK })
    return true
end
-- ============================================================
-- FUNZIONE: field_rollFieldElement(player, value, id)
-- ============================================================
function field_rollFieldElement(player, value, id)
    local slot = main_SlotByColor(player.color)
    engine_diceCameraZoom(player, slot)
    return false
end
-- ============================================================
-- FUNZIONE: deploy_btn_army1()
-- ============================================================
function field_btn_army1(player, value, id)
    TURN.completed.Army1 = true
    engine_handleAction({ type = ACTION.ARMY1_CLICK })
    return true
end
-- ============================================================
-- FUNZIONE: field_btn_army2()
-- ============================================================
function field_btn_army2(player, value, id)
    TURN.completed.Army2 = true
    engine_handleAction({ type = ACTION.ARMY2_CLICK })
    return true
end
-- ============================================================
-- FUNZIONE: field_btnContinue(player, value, id)
-- ============================================================
function field_btnContinue(player, value, id)
    TURN.completed.Army1 = true
    TURN.completed.Army2 = true
    engine_handleAction({ type = ACTION.CONFIRM })
    return true
end
-- ============================================================
-- FUNZIONE: field_btnContinue(player, value, id)
-- ============================================================
function field_doRollBlockClick(player, value, id)
    local slot = main_SlotByColor(player.color)
    field_doRollBlock(player, slot)
end
-- ============================================================
-- FUNZIONE: field_rollBlockZoom(player, value, id)
-- ============================================================
function field_rollBlockZoom(player, value, id)
    local slot = main_SlotByColor(player.color)
    engine_diceCameraZoom(player, slot)
    return false
end
