-- ============================================================
-- FUNZIONE: field_sommaToTipo(somma)
-- ============================================================
function field_sommaToTipo(somma)
    if somma <= 3 then return "Aperto" end
    if somma <= 6 then return "Rotto" end
    if somma <= 9 then return "Difficile" end
    if somma <= 11 then return "Intransitabile" end
    return "Fiume"
end

-- ============================================================
-- FUNZIONE: field_doRollFieldElement(player, slot)
-- ============================================================
function field_doRollFieldElement(player, slot)
    local totale = slot == 1 and FIELD_STATE.army1Elements or FIELD_STATE.army2Elements
    local rolls  = slot == 1 and FIELD_STATE.rolls1 or FIELD_STATE.rolls2
    local btnId  = slot == 1 and BUTTONS.BTN_ARMY1 or BUTTONS.BTN_ARMY2

    if #rolls >= totale then
        printToColor("[FIELD] Hai già completato tutti i tuoi tiri", player.color, {r=0.7,g=0.7,b=0.7})
        return
    end

    IEF_DICE_ROLL_TRY[slot] = { dadi = 2, soglia = nil }

    engine_diceThrowFromBag(slot, nil, function(risultati, successi)

        local somma = risultati[1] + risultati[2]
        table.insert(rolls, somma)

        Wait.time(function()
            printToAll("[FIELD] Slot " .. slot .. " tiro " .. #rolls .. "/" .. totale .. ": " .. somma, {r=0.8,g=0.7,b=0.2})

            local tipo = field_sommaToTipo(somma)
            field_spawnTerrainCard(tipo, slot, #rolls)

            engine_diceCameraReturn(player, slot)

            if #rolls >= totale then
                UI.setAttribute(btnId, "text", "Completato")
                UI.setAttribute(btnId, "textColor", "White")
                UI.setAttribute(btnId, "interactable", "false")

                if slot == 1 then TURN.completed.Army1 = true else TURN.completed.Army2 = true end

                if TURN.completed.Army1 and TURN.completed.Army2 then
                    local action = slot == 1 and ACTION.ARMY1_CLICK or ACTION.ARMY2_CLICK
                    engine_handleAction({ type = action })
                end
            else
                UI.setAttribute(btnId, "text", "Tiro " .. (#rolls + 1) .. "/" .. totale)
                UI.setAttribute(btnId, "textColor", "White")
            end
        end, 2)
  
    end)
end

-- ============================================================
-- FUNZIONE: field_getCardTemplate(tipo, slot)
-- ============================================================

function field_getCardTemplate(tipo, slot)
    IEF_FIELD_CARD_TEMPLATE[slot] = IEF_FIELD_CARD_TEMPLATE[slot] or {}

    if IEF_FIELD_CARD_TEMPLATE[slot][tipo] then
        return IEF_FIELD_CARD_TEMPLATE[slot][tipo]
    end

    local wantedGuid = IEF_FIELD_CARD_BAG[tipo]
    if not wantedGuid then
        print("[FIELD] Nessun GUID configurato per tipo '" .. tipo .. "'")
        return nil
    end

    local bagGuid = IEF_DICE_BAG_GUID[slot]
    local bag = getObjectFromGUID(bagGuid)
    if not bag then
        print("[FIELD] Bag dadi/carte non trovata per slot " .. slot .. " (guid " .. tostring(bagGuid) .. ")")
        return nil
    end

    local data = bag.getData()
    for _, obj in ipairs(data.ContainedObjects or {}) do
        if obj.GUID == wantedGuid then
            IEF_FIELD_CARD_TEMPLATE[slot][tipo] = obj
            return obj
        end
    end

    print("[FIELD] Carta GUID '" .. wantedGuid .. "' (tipo " .. tipo .. ") non trovata dentro la bag slot " .. slot)
    return nil
end
-- ============================================================
-- FUNZIONE: field_spawnTerrainCard(tipo, slot, index)
-- ============================================================
function field_spawnTerrainCard(tipo, slot, index)
    local template = field_getCardTemplate(tipo, slot)
    if not template then return end

    local pos = IEF_FIELD_CARD_POS[slot] and IEF_FIELD_CARD_POS[slot][index]
    if not pos then
        print("[FIELD] Nessuna posizione definita per slot " .. slot .. " indice " .. index)
        return
    end

    local rot = IEF_FIELD_CARD_ROT[slot]

    local card = spawnObjectData({
        data     = template,
        position = pos,
        rotation = rot,
    })

    if card then card.setLock(true) end
end