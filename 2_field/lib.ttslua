-- ============================================================
-- FUNZIONE: field_goToPositioning()
-- Imposta l'UI per la fase di posizionamento (Step 4+5)
-- ============================================================
function field_goToPositioning()

        TURN.completed = { Army1 = false, Army2 = false }
        printToAll("[FIELD] Posizionate i vostri elementi e confermate", {r=0.8,g=0.7,b=0.2})
        main_goToPhase("FIELD_DONE")
end
-- ============================================================
-- FUNZIONE: field_spawnElements()
-- ============================================================
function field_spawnElements()
    printToAll("[FIELD] Tirate i dadi per determinare il terreno dei vostri elementi", {r=0.6,g=0.9,b=0.6})
end
-- ============================================================
-- FUNZIONE: field_spawnTerrain()
-- ============================================================
function field_spawnTerrain(tipo, slot, index, callback)

    local bag = getObjectFromGUID(IEF_TERRAIN_BAG)
    if not bag then
        printToAll("[FIELD] Bag terreno non trovata", {r=1,g=0.3,b=0.3})
        return
    end

    -- Trova tutti gli oggetti nella bag con il tag corrispondente al tipo
    local objects = bag.getObjects()
    local matches = {}
    for _, obj in ipairs(objects) do
        for _, tag in ipairs(obj.tags or {}) do
            if tag == tipo then
                table.insert(matches, obj)
                break
            end
        end
    end

    if #matches == 0 then
        printToAll("[FIELD] Nessun oggetto tipo " .. tipo .. " nella bag", {r=1,g=0.3,b=0.3})
        return
    end

    -- Prende un elemento casuale tra quelli disponibili
    local target = matches[math.random(1, #matches)]

    local zBase  = slot == 1 and -20 or 20
    local xSpawn = -10 + (index - 1) * 20

    printToAll(string.format("[FIELD] Spawn %s slot=%d pos=%.1f,%.1f", tipo, slot, xSpawn, zBase), {r=0.6,g=0.6,b=0.6})

    bag.takeObject({
        guid              = target.guid,
        position          = { x = xSpawn, y = 10.70, z = zBase },
        rotation          = { x = 0, y = 0, z = 0 },
        smooth            = false,
        callback_function = function(obj)
            obj.setPosition({ x = xSpawn, y = 10.70, z = zBase })  
            local clone = obj.clone({ position = { x = xSpawn, y = 10.70, z = zBase } })
            clone.setPosition({ x = xSpawn, y = 10.70, z = zBase })
            Wait.time(function()
                bag.putObject(obj)
            end, 2.5)
            if callback then callback(clone) end
        end
    })
end
-- ============================================================
-- FUNZIONE: field_spawnTerrain()
-- ============================================================
function lockTerrain()

    -- Lock di tutti gli elementi terreno a fine fase FIELD
    for _, obj in ipairs(getAllObjects()) do
        if obj.hasTag and (obj.hasTag("FieldPlaceholder")) then
            --obj.setLock(true)
        end
    end
end
-- ============================================================
-- FUNZIONE: field_placeholderClick(player, value, id)
-- ============================================================
function field_placeholderClick(player, value, id)
    -- placeholder non interagibile, click ignorato
end
-- ============================================================
-- FUNZIONE: field_sommaToTipo(somma)
-- ============================================================
function field_sommaToTipo(somma)
    if somma <= 3 then return "Aperto" end
    if somma <= 6 then return "Rotto" end
    if somma <= 9 then return "Difficile" end
    if somma <= 11 then return "Intransitabile" end
    return "Fiume"
end

-- ============================================================
-- FUNZIONE: field_doRollFieldElement(player, slot)
-- ============================================================
function field_doRollFieldElement(player, slot)

    local totale = slot == 1 and FIELD_STATE.army1Elements or FIELD_STATE.army2Elements
    local rolls  = slot == 1 and FIELD_STATE.rolls1 or FIELD_STATE.rolls2
    local btnId  = slot == 1 and BUTTONS.BTN_ARMY1 or BUTTONS.BTN_ARMY2

    if #rolls >= totale then
        printToColor("[FIELD] Hai già completato tutti i tuoi tiri", player.color, {r=0.7,g=0.7,b=0.7})
        return
    end

    IEF_DICE_ROLL_TRY[slot] = { dadi = 2, soglia = nil }

    engine_diceThrowFromBag(slot, nil, function(risultati, successi)
        if not risultati[1] or not risultati[2] then return end
        local faseCorrente = ENGINE.phase
        local somma = risultati[1] + risultati[2]

        Wait.time(function()
            local tipo = field_sommaToTipo(somma)

            if tipo == "Fiume" and FIELD_STATE.fiumeUsato then
                warningToColor("La carta '" .. tipo:upper() .. "' ha raggiunto il numero massimo consentito, ritira", player, "Orange", 8)
                engine_diceClearLastRoll(slot)
                field_doRollFieldElement(player, slot)
                return
            end

            if tipo == "Fiume" then
                FIELD_STATE.fiumeUsato = true
            end

            table.insert(rolls, somma)
            local categoria = field_tipoToCategoria(tipo)
            local variante = field_scegliVariante(categoria)
            FIELD_STATE.varianti[slot][#rolls] = variante

            field_spawnTerrainCard(tipo, slot, #rolls)
            field_handPreviewShow(slot, #rolls, variante)

            warningToColor("Con un risultato di " .. somma .. " ottieni l'elemento di terreno '".. tipo:upper() .."'", player, "Yellow", 8)

            if #rolls >= totale then
                UI.setAttribute(btnId, "text", "Tiri Dado Esauriti")
                UI.setAttribute(btnId, "Color", "Grey")
                UI.setAttribute(btnId, "textColor", "Black")
                UI.setAttribute(btnId, "interactable", "false")

                if slot == 1 then TURN.completed.Army1 = true else TURN.completed.Army2 = true end
                if TURN.completed.Army1 and TURN.completed.Army2 then
                    local action = slot == 1 and ACTION.ARMY1_CLICK or ACTION.ARMY2_CLICK
                    engine_handleAction({ type = action })
                end
            else
               UI.setAttribute(btnId, "text", "Tira per Carta " .. (#rolls + 1) .. "/" .. totale)
               UI.setAttribute(btnId, "textColor", "White")
            end
            engine_diceCameraReturn(player, slot, faseCorrente)
        end, 2)

        if slot == 1 then FIELD_STATE.rolls1 = rolls else FIELD_STATE.rolls2 = rolls end
    end)
end
-- ============================================================
-- FUNZIONE: field_getCardTemplate(tipo, slot)
-- ============================================================
function field_getCardTemplate(tipo, slot)
    
    IEF_FIELD_CARD_TEMPLATE[slot] = IEF_FIELD_CARD_TEMPLATE[slot] or {}

    if IEF_FIELD_CARD_TEMPLATE[slot][tipo] then
        return IEF_FIELD_CARD_TEMPLATE[slot][tipo]
    end

    local wantedGuid = IEF_FIELD_CARD_BAG[slot][tipo]
    if not wantedGuid then
        print("[FIELD] Nessun GUID configurato per tipo '" .. tipo .. "'")
        return nil
    end

    local bagGuid = IEF_DICE_BAG_GUID[slot]
    local bag = getObjectFromGUID(bagGuid)
    if not bag then
        print("[FIELD] Bag dadi/carte non trovata per slot " .. slot .. " (guid " .. tostring(bagGuid) .. ")")
        return nil
    end

    local data = bag.getData()
    for _, obj in ipairs(data.ContainedObjects or {}) do
        if obj.GUID == wantedGuid then
            IEF_FIELD_CARD_TEMPLATE[slot][tipo] = obj
            return obj
        end
    end

    print("[FIELD] Carta GUID '" .. wantedGuid .. "' (tipo " .. tipo .. ") non trovata dentro la bag slot " .. slot)
    return nil
end
-- ============================================================
-- FUNZIONE: field_spawnTerrainCard(tipo, slot, index)
-- ============================================================
function field_spawnTerrainCard(tipo, slot, index)
    local template = field_getCardTemplate(tipo, slot)
    if not template then return end

    local pos = IEF_FIELD_CARD_POS[slot] and IEF_FIELD_CARD_POS[slot][index]
    if not pos then
        print("[FIELD] Nessuna posizione definita per slot " .. slot .. " indice " .. index)
        return
    end

    local rot = IEF_FIELD_CARD_ROT[slot]

    local card = spawnObjectData({
        data     = template,
        position = pos,
        rotation = rot,
    })

    if card then
        card.setLock(true)
        card.setName("FieldCard_" .. slot .. "_" .. index)
        card.setInvisibleTo({ "Red", "Green" })
        FIELD_STATE.cards[slot][index] = card
    end
end
-- ============================================================
-- FUNZIONE: field_sommaToBlocco(somma)
-- ============================================================
function field_sommaToBlocco(somma)
    if somma <= 5 then return "destro" end
    if somma <= 8 then return "centro" end
    return "sinistro"
end
-- ============================================================
-- FUNZIONE: field_posizioniBlocco(slot,b locco)
-- ============================================================
function field_posizioniBlocco(slot, blocco)

    local center = IEF_FIELD_BLOCK_CENTER[slot][blocco]
    local half = IEF_FIELD_BLOCK_CARD_GAP / 2
    return {
        { x = center.x - half, y = center.y, z = center.z },
        { x = center.x + half, y = center.y, z = center.z },
    }
end
-- ============================================================
-- FUNZIONE: field_blocchiLiberi(slot)
-- Ritorna la lista dei blocchi con meno di 2 carte
-- ============================================================
function field_blocchiLiberi(slot)
    local liberi = {}
    for _, b in ipairs({"destro", "centro", "sinistro"}) do
        if #FIELD_STATE.blockCards[slot][b] < 2 then
            table.insert(liberi, b)
        end
    end
    return liberi
end
-- ============================================================
-- FUNZIONE: field_placeCardInBlock(player, slot, index, blocco, somma)
-- Piazza la carta dell'elemento 'index' nel blocco assegnato,
-- riposizionando anche l'eventuale carta già presente (simmetria).
-- somma = nil se piazzamento automatico (nessun dado tirato).
-- ============================================================

function field_placeCardInBlock(player, slot, index, blocco, somma, faseOrigine)

    faseOrigine = faseOrigine or ENGINE.phase
    local totale = slot == 1 and FIELD_STATE.army1Elements or FIELD_STATE.army2Elements
    local btnId  = slot == 1 and BUTTONS.BTN_ARMY1 or BUTTONS.BTN_ARMY2
    local card   = FIELD_STATE.cards[slot][index]

    table.insert(FIELD_STATE.blockCards[slot][blocco], card)
    local cardsInBlocco = FIELD_STATE.blockCards[slot][blocco]

    Wait.time(function()
        if #cardsInBlocco == 1 then
            local c = IEF_FIELD_BLOCK_CENTER[slot][blocco]
            card.setLock(false)
            card.setInvisibleTo({})
            card.setPositionSmooth({ x = c.x, y = c.y, z = c.z })
        else
            local posizioni = field_posizioniBlocco(slot, blocco)
            for i, c in ipairs(cardsInBlocco) do
                c.setLock(false)
                c.setInvisibleTo({})
                c.setPositionSmooth(posizioni[i])
            end
        end

        Wait.time(function()
            for _, c in ipairs(cardsInBlocco) do
                c.setLock(true)
            end
        end, 1)

        FIELD_STATE.blockPlaced[slot] = index
        field_handPreviewHide(slot, index)
     
        local msg = somma
            and ("[FIELD] Slot " .. slot .. " tira " .. somma .. " → elemento " .. index .. "/" .. totale .. " nel blocco " .. blocco)
            or  ("[FIELD] Slot " .. slot .. " → elemento " .. index .. "/" .. totale .. " assegnato automaticamente al blocco " .. blocco)
        printToAll(msg, {r=0.6,g=0.9,b=0.6})

        if index >= totale then
            UI.setAttribute(btnId, "text", "Assegnazione Completata")
            UI.setAttribute(btnId, "Color", "Grey")
            UI.setAttribute(btnId, "textColor", "Black")
            UI.setAttribute(btnId, "interactable", "false")

            if slot == 1 then TURN.completed.Army1 = true else TURN.completed.Army2 = true end

            if TURN.completed.Army1 and TURN.completed.Army2 then
                local action = slot == 1 and ACTION.ARMY1_CLICK or ACTION.ARMY2_CLICK
                engine_handleAction({ type = action })
            end
        else
            UI.setAttribute(btnId, "text", "Tiro " .. (index + 1) .. "/" .. totale)
            UI.setAttribute(btnId, "textColor", "White")
        end
        engine_diceCameraReturn(player, slot, faseOrigine)
    end, 2)
end
-- ============================================================
-- FUNZIONE: field_doRollBlock(player, slot)
-- Gestisce il tiro 2D6 per il piazzamento nel blocco:
--  - index 1: nessun vincolo extra
--  - index 2: deve differire dal blocco dell'elemento 1, altrimenti ritira
--  - index 3 con totale==3: nessun dado, auto-assegnato al blocco rimasto vuoto
--  - sempre: se il blocco pescato è già a 2 carte e c'è un'alternativa libera, ritira
-- ============================================================
function field_doRollBlock(player, slot)

    local totale = slot == 1 and FIELD_STATE.army1Elements or FIELD_STATE.army2Elements
    local placed = FIELD_STATE.blockPlaced[slot]
    local index  = placed + 1
    local faseOrigine = ENGINE.phase

    if placed >= totale then
        printToColor("[FIELD] Hai già piazzato tutti i tuoi elementi", player.color, {r=0.7,g=0.7,b=0.7})
        return
    end

    IEF_DICE_ROLL_TRY[slot] = { dadi = 2, soglia = nil }

    engine_diceThrowFromBag(slot, nil, function(risultati, successi)
        if not risultati[1] and not risultati[2] then return end
        local somma  = risultati[1] + risultati[2]
        local blocco = field_sommaToBlocco(somma)
        if #FIELD_STATE.blockCards[slot][blocco] >= 2 then
            local liberi = field_blocchiLiberi(slot)
            if #liberi > 0 then
                    warningToColor("Il blocco '" .. blocco:upper() .. "' ha raggiunto il numero massimo di elementi consentiti, ritira", player, "Orange", 8)
                    engine_diceClearLastRoll(slot)
                return
            end
        end
        field_placeCardInBlock(player, slot, index, blocco, somma, faseOrigine)
    end)
end
-- ============================================================
-- FUNZIONE: field_clearTerrainCards()
-- Distrugge tutte le carte terreno presenti sul tavolo (tag
-- "Cards"), indipendentemente dai riferimenti salvati in
-- FIELD_STATE — così funziona anche se quei riferimenti sono
-- andati persi (es. dopo un cambio fase/reload).
-- ============================================================
function field_clearTerrainCards()

    for _, obj in ipairs(getAllObjects()) do
        if obj.hasTag and obj.hasTag("ZoneCardsNumbers") then
            obj.destruct()
        end
    end
    
    for _, obj in ipairs(getAllObjects()) do
        if obj.hasTag and obj.hasTag("Cards") then
            obj.destruct()
        end
    end

    FIELD_STATE.cards = { [1] = {}, [2] = {} }
    FIELD_STATE.blockCards = {
        [1] = { destro = {}, centro = {}, sinistro = {} },
        [2] = { destro = {}, centro = {}, sinistro = {} },
    }
end
-- ============================================================
-- FUNZIONE: field_serializeState()
-- Costruisce una versione di FIELD_STATE SENZA riferimenti
-- oggetto (solo dati semplici, serializzabili in JSON).
-- ============================================================
function field_serializeState()
    if not FIELD_STATE then return nil end

    local blockAssignment = { [1] = {}, [2] = {} }
    for slot = 1, 2 do
        for _, blocco in ipairs({"destro", "centro", "sinistro"}) do
            local lista = FIELD_STATE.blockCards and FIELD_STATE.blockCards[slot] and FIELD_STATE.blockCards[slot][blocco]
            if lista then
                for _, card in ipairs(lista) do
                    if card and not card.isDestroyed() then
                        table.insert(blockAssignment[slot], { nome = card.getName(), blocco = blocco })
                    end
                end
            end
        end
    end

    return {
        army1Elements = FIELD_STATE.army1Elements,
        army2Elements = FIELD_STATE.army2Elements,
        orientamento1 = FIELD_STATE.orientamento1,
        orientamento2 = FIELD_STATE.orientamento2,
        rolls1        = FIELD_STATE.rolls1,
        rolls2        = FIELD_STATE.rolls2,
        blockPlaced   = FIELD_STATE.blockPlaced,
        blockAssignment = blockAssignment,
        fiumeUsato    = FIELD_STATE.fiumeUsato,
        varianti = FIELD_STATE.varianti,
    }
end
-- ============================================================
-- FUNZIONE: field_restoreState(saved)
-- Ripristina FIELD_STATE dai dati semplici salvati, e
-- ricostruisce i riferimenti oggetto (cards/blockCards)
-- ritrovando le carte sul tavolo per Nickname.
-- ============================================================
function field_restoreState(saved)
    if not saved then return end

    FIELD_STATE = FIELD_STATE or {}
    FIELD_STATE.army1Elements = saved.army1Elements
    FIELD_STATE.army2Elements = saved.army2Elements
    FIELD_STATE.orientamento1 = saved.orientamento1
    FIELD_STATE.orientamento2 = saved.orientamento2
    FIELD_STATE.rolls1        = saved.rolls1 or {}
    FIELD_STATE.rolls2        = saved.rolls2 or {}
    FIELD_STATE.blockPlaced = {
        [1] = (saved.blockPlaced and saved.blockPlaced[1]) or 0,
        [2] = (saved.blockPlaced and saved.blockPlaced[2]) or 0,
    }
    FIELD_STATE.varianti = saved.varianti or { [1] = {}, [2] = {} }
    FIELD_STATE.cards = { [1] = {}, [2] = {} }
    FIELD_STATE.blockCards = {
        [1] = { destro = {}, centro = {}, sinistro = {} },
        [2] = { destro = {}, centro = {}, sinistro = {} },
    }

    local tutti = getAllObjects()
    for slot = 1, 2 do
        for i = 1, (saved.army1Elements or 0) + (saved.army2Elements or 0) do
            local nome = "FieldCard_" .. slot .. "_" .. i
            for _, obj in ipairs(tutti) do
                if obj.getName() == nome then
                    FIELD_STATE.cards[slot][i] = obj
                    break
                end
            end
        end
    end

    if saved.blockAssignment then
        for slot = 1, 2 do
            for _, entry in ipairs(saved.blockAssignment[slot] or {}) do
                for _, obj in ipairs(tutti) do
                    if obj.getName() == entry.nome then
                        table.insert(FIELD_STATE.blockCards[slot][entry.blocco], obj)
                        break
                    end
                end
            end
        end
    end

    Wait.time(function()
        for slot = 1, 2 do
            for index, variante in pairs(FIELD_STATE.varianti[slot] or {}) do
                local giaPiazzata = FIELD_STATE.blockPlaced[slot] and index <= FIELD_STATE.blockPlaced[slot]
                if not giaPiazzata then
                    field_handPreviewShow(slot, index, variante)
                end
            end
        end
    end, 2)
end

-- ============================================================
-- FUNZIONE: field_createBlockLabels()
-- ============================================================
function field_createBlockLabels()
    for slot = 1, 2 do
        for _, blocco in ipairs({"destro", "centro", "sinistro"}) do
            local l = IEF_FIELD_BLOCK_LABELS_POS[slot][blocco]

            local obj = spawnObject({
                type     = "3DText",
                position = l.pos,
                rotation = l.rot,
                scale    = { x = 2, y = 2, z = 2 },
            })
            obj.setValue(l.testo)
            obj.setLock(true)
            obj.addTag("ZoneCardsNumbers")
            Wait.frames(function()
                obj.TextTool.setFontSize(200)   -- prova con questo valore, poi regola
            end, 1)

            table.insert(IEF_FIELD_BLOCK_LABELS, obj)
        end
    end
end
-- ============================================================
-- FUNZIONE: field_tipoToCategoria(tipo)
-- ============================================================
function field_tipoToCategoria(tipo)
    return IEF_FIELD_TIPO_TO_CATEGORIA[tipo]
end
-- ============================================================
-- FUNZIONE: field_handPreviewHighlight(slot, index)
-- Aggiunge un outline dorato alla carta in mano che sta per
-- essere spostata nel blocco (chiamata prima del tiro dado).
-- ============================================================
function field_handPreviewHighlight(slot, index)
    local slotId = "hand_slot_" .. slot .. "_" .. index
    UI.setAttribute(slotId, "outline", "#FFD700")
    UI.setAttribute(slotId, "outlineSize", "6")
end
-- ============================================================
-- FUNZIONE: field_scegliVariante(categoria)
-- Sceglie casualmente una variante visiva tra quelle disponibili
-- per la categoria di terreno data (es. "ROTTO" → una tra
-- cespugli/rocce_lievi/campo_coltivato/collina_ripida/fossato).
-- Ritorna l'intera entry {id, nome, immagine_url, spawn}.
-- ============================================================
function field_scegliVariante(categoria)

    local dati = IEF_DATA.fieldTerrainVariants

    

    if not dati or not dati[categoria] then
        print("[FIELD] Nessuna variante configurata per categoria '" .. tostring(categoria) .. "'")
        return nil
    end

    local varianti = dati[categoria].varianti
    if not varianti or #varianti == 0 then
        print("[FIELD] Lista varianti vuota per categoria '" .. tostring(categoria) .. "'")
        return nil
    end

    return varianti[math.random(1, #varianti)]
end
-- ============================================================
-- FUNZIONE: field_handPreviewCover(slot, elements)
-- Mostra nel pannello mano il contenuto reale di
-- FIELD_STATE.varianti[slot] (tutte Cover all'inizio fase,
-- via field_initVarianti). Non sceglie/scrive nulla, riflette
-- solo i dati già presenti.
-- ============================================================
function field_handPreviewCover(slot, elements)

    local panelId = "handPreview" .. slot
    UI.setAttribute(panelId, "active", "true")

    for i = 1, elements do
        local slotId = "hand_slot_" .. slot .. "_" .. i
        local variante = FIELD_STATE.varianti[slot][i]
        if variante and variante.immagine_url then
            UI.setAttribute(slotId, "image", variante.immagine_url)
            UI.setAttribute(slotId, "active", "true")
        else
            print("[FIELD] Variante mancante per slot=" .. slot .. " index=" .. i)
        end
    end

    FIELD_STATE.handVisibleCount[slot] = elements
end
-- ============================================================
-- FUNZIONE: field_handPreviewShow(slot, index, variante)
-- Mostra la carta 'index' con la sua immagine vera. Al primo
-- tiro (index==1), riempie anche le caselle successive ancora
-- da tirare con una variante "Cover" (dorso generico).
-- ============================================================
function field_handPreviewShow(slot, index, variante)
  
    local panelId = "handPreview" .. slot
    local slotId  = "hand_slot_" .. slot .. "_" .. index

    if not variante or not variante.immagine_url then
        print("[FIELD] Variante senza immagine_url, slot=" .. slot .. " index=" .. index)
        return
    end
  
    UI.setAttribute(panelId, "active", "true")
    UI.setAttribute(slotId, "image", variante.immagine_url)
    UI.setAttribute(slotId, "active", "true")
      
    if index == 1 then
        local totale = slot == 1 and FIELD_STATE.army1Elements or FIELD_STATE.army2Elements
        FIELD_STATE.handVisibleCount[slot] = totale or 0
    end
end
-- ============================================================
-- FUNZIONE: field_handPreviewHide(slot, index)
-- Nasconde la carta 'index' dal pannello mano (piazzata nel
-- blocco), decrementa il contatore visibili e aggiorna la
-- larghezza.
-- ============================================================
function field_handPreviewHide(slot, index)
    UI.setAttribute("hand_slot_" .. slot .. "_" .. index, "active", "false")
    FIELD_STATE.handVisibleCount[slot] = math.max(0, (FIELD_STATE.handVisibleCount[slot] or 1) - 1)
end
-- ============================================================
-- FUNZIONE: field_handPreviewReset(slot)
-- Nasconde tutto il pannello mano di uno slot e azzera il
-- contatore visibili (fine fase/reset).
-- ============================================================
function field_handPreviewReset(slot)
    for i = 1, 4 do
        UI.setAttribute("hand_slot_" .. slot .. "_" .. i, "active", "false")
    end
    UI.setAttribute("handPreview" .. slot, "active", "false")
    FIELD_STATE.handVisibleCount[slot] = 0
end
-- ============================================================
-- FUNZIONE: field_handPreviewCard(slot)
-- ============================================================
function field_handPreviewCard(slot)
    local totale = slot == 1 and FIELD_STATE.army1Elements or FIELD_STATE.army2Elements
    local width = totale * 202
    local panelId = "handPreview" .. slot
    UI.setAttribute(panelId, "width", width)
    field_handPreviewCover(slot, totale)
end
-- ============================================================
-- FUNZIONE: field_initVarianti(slot)
-- Inizializza FIELD_STATE.varianti[slot] con 4 entry "Cover",
-- da sovrascrivere una alla volta ad ogni tiro reale.
-- ============================================================
function field_initVarianti(slot)
    local cover = field_scegliVariante("COVER")

    FIELD_STATE.varianti[slot] = {}
    for i = 1, 4 do
        FIELD_STATE.varianti[slot][i] = cover
    end
end

