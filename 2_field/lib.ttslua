-- ============================================================
-- FUNZIONE: field_rollDice()
-- Step 1: tiro dado per determinare numero elementi
-- ============================================================
army1_elements = {}
army2_elements = {}
-- ============================================================
-- FUNZIONE: field_checkTieBreaker()
-- Verifica se entrambi hanno tirato e assegna il terzo elemento
-- ============================================================
function field_checkTieBreaker()

    if FIELD_STATE.tbResult1 == nil or FIELD_STATE.tbResult2 == nil then return end

    if FIELD_STATE.tbResult1 == FIELD_STATE.tbResult2 then
        -- Pareggio: ritiro
        printToAll("[FIELD] Pareggio! Ritiro...", {r=1,g=0.6,b=0})
        FIELD_STATE.tbResult1 = nil
        FIELD_STATE.tbResult2 = nil
        return
    end

    if FIELD_STATE.tbResult1 > FIELD_STATE.tbResult2 then
        FIELD_STATE.army1Elements = FIELD_STATE.army1Elements + 1
        printToAll("[FIELD] Army1 vince il terzo elemento!", {r=0.8,g=0.7,b=0.2})
    else
        FIELD_STATE.army2Elements = FIELD_STATE.army2Elements + 1
        printToAll("[FIELD] Army2 vince il terzo elemento!", {r=0.8,g=0.7,b=0.2})
    end

    field_spawnElements()
end
-- ============================================================
-- FUNZIONE: field_goToPositioning()
-- Imposta l'UI per la fase di posizionamento (Step 4+5)
-- ============================================================
function field_goToPositioning()

        TURN.completed = { Army1 = false, Army2 = false }
        printToAll("[FIELD] Posizionate i vostri elementi e confermate", {r=0.8,g=0.7,b=0.2})
        main_goToPhase("FIELD_DONE")
end

function field_spawnElements()
    printToAll("[FIELD] Tirate i dadi per determinare il terreno dei vostri elementi", {r=0.6,g=0.9,b=0.6})
end
-- ============================================================
-- FUNZIONE: field_spawnTerrain()
-- ============================================================
function field_spawnTerrain(tipo, slot, index, callback)

    local bag = getObjectFromGUID(IEF_TERRAIN_BAG)
    if not bag then
        printToAll("[FIELD] Bag terreno non trovata", {r=1,g=0.3,b=0.3})
        return
    end

    -- Trova tutti gli oggetti nella bag con il tag corrispondente al tipo
    local objects = bag.getObjects()
    local matches = {}
    for _, obj in ipairs(objects) do
        for _, tag in ipairs(obj.tags or {}) do
            if tag == tipo then
                table.insert(matches, obj)
                break
            end
        end
    end

    if #matches == 0 then
        printToAll("[FIELD] Nessun oggetto tipo " .. tipo .. " nella bag", {r=1,g=0.3,b=0.3})
        return
    end

    -- Prende un elemento casuale tra quelli disponibili
    local target = matches[math.random(1, #matches)]

    local zBase  = slot == 1 and -20 or 20
    local xSpawn = -10 + (index - 1) * 20

    printToAll(string.format("[FIELD] Spawn %s slot=%d pos=%.1f,%.1f", tipo, slot, xSpawn, zBase), {r=0.6,g=0.6,b=0.6})

    bag.takeObject({
        guid              = target.guid,
        position          = { x = xSpawn, y = 10.70, z = zBase },
        rotation          = { x = 0, y = 0, z = 0 },
        smooth            = false,
        callback_function = function(obj)
            obj.setPosition({ x = xSpawn, y = 10.70, z = zBase })  
            local clone = obj.clone({ position = { x = xSpawn, y = 10.70, z = zBase } })
            clone.setPosition({ x = xSpawn, y = 10.70, z = zBase })
            Wait.time(function()
                bag.putObject(obj)
            end, 2.5)
            if callback then callback(clone) end
        end
    })
end
-- ============================================================
-- FUNZIONE: field_spawnTerrain()
-- ============================================================
function lockTerrain()

    -- Lock di tutti gli elementi terreno a fine fase FIELD
    for _, obj in ipairs(getAllObjects()) do
        if obj.hasTag and (obj.hasTag("FieldPlaceholder")) then
            --obj.setLock(true)
        end
    end
end

-- ============================================================
-- FUNZIONE: field_spawnTerrain()
-- ============================================================
function field_spawnTerrainPlaceholder(tipo, blocco, slot, index, callback)
    local zBase  = slot == 1 and -20 or 20
    local xSpawn = -10 + (index - 1) * 20

    local color = IEF_FIELD_COLORS[tipo] or {0.5, 0.5, 0.5}

    local tile = spawnObject({
        type     = "BlockSquare",
        position = { x = xSpawn, y = 2.0, z = zBase },
        rotation = { 0, 0, 0 },
        scale    = { 8, 0.2, 8 },
    })
    tile.setColorTint({ r = color[1], g = color[2], b = color[3] })
    tile.setName(tipo .. " — Blocco " .. blocco)
    tile.setLock(true)
    tile.addTag("FieldPlaceholder")

    tile.createButton({
        click_function = "field_placeholderClick",
        function_owner = Global,
        label    = tipo .. "\n" .. blocco,
        position = { 0, 0.6, 0 },
        rotation = { 0, 0, 0 },
        width    = 0, height = 0,
        font_size = 200,
        color    = { 0, 0, 0, 0 },
        font_color = { 1, 1, 1 },
    })

    if callback then callback(tile) end
    return tile
end
-- ============================================================
-- FUNZIONE: field_spawnTerrain()
-- ============================================================
function field_placeholderClick(player, value, id)
    -- placeholder non interagibile, click ignorato
end
-- ============================================================
-- FUNZIONE: field_spawnTerrain()
-- ============================================================
function field_sommaToTipo(somma)
    if somma <= 3 then return "Collina Dolce" end
    if somma <= 6 then return "Rotto" end
    if somma <= 9 then return "Difficile" end
    if somma <= 11 then return "Intransitabile" end
    return "Fiume"
end
-- ============================================================
-- FUNZIONE: field_spawnTerrain()
-- ============================================================
function field_rollTerrainElement(slot)

    local totale = slot == 1 and FIELD_STATE.army1Elements or FIELD_STATE.army2Elements
    local fatti  = FIELD_STATE.elementsRolled[slot]

    if fatti >= totale then
        printToAll("[FIELD] Slot " .. slot .. " ha già tirato tutti i suoi elementi", {r=0.7,g=0.7,b=0.7})
        return
    end

    IEF_DICE_ROLL_TRY[slot] = { dadi = 2, soglia = nil }

    engine_diceThrowFromBag(slot, nil, function(risultati, successi)
        local somma = risultati[1] + risultati[2]
        local tipo  = field_sommaToTipo(somma)

        FIELD_STATE.elementsRolled[slot] = FIELD_STATE.elementsRolled[slot] + 1

        printToAll("[FIELD] Slot " .. slot .. " tira " .. somma .. " → " .. tipo, {r=0.8,g=0.7,b=0.2})

        field_spawnTerrainPlaceholder(tipo, "—", slot, FIELD_STATE.elementsRolled[slot], nil)

        engine_diceCameraReturn(Player[slot == 1 and "Red" or "Green"], slot)

        if FIELD_STATE.elementsRolled[1] >= (FIELD_STATE.army1Elements or 0)
        and FIELD_STATE.elementsRolled[2] >= (FIELD_STATE.army2Elements or 0) then
            field_goToPositioning()
        end
    end)
end