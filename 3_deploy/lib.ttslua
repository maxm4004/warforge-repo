-- terrains: mappa nome → URL texture per diffuseURL = "erba_verde" ecc.
DEPLOYMENT_TERRAINS = {
    terra_fango = "https://steamusercontent-a.akamaihd.net/ugc/1014942732523998487/F1855119665D8199F8E2AD87F6C8DB9ADEC7E6F9/",
    erba_mista  = "https://steamusercontent-a.akamaihd.net/ugc/1014942732523994816/56D1D3CBC31E99107B1BAD94F46FA7B335540040/",
    autunno     = "https://steamusercontent-a.akamaihd.net/ugc/1014942732523990770/9EBBA093EC1C1CA2CEBD5286AB2BEAF40E79FB4E/",
    terra_secca = "https://steamusercontent-a.akamaihd.net/ugc/1014942732523987577/7B0CDDFBEF5CF9960B959A037B0140030E2B05A2/",
    erba_verde  = "https://steamusercontent-a.akamaihd.net/ugc/1014942544699601731/8CA9A0469A8383413D7ED3B2732CC52D29F840C2/",
    sabbia      = "https://steamusercontent-a.akamaihd.net/ugc/1014942732524001712/C11D0581583CC167D7A51ACA1763CBA4EF43E44C/",
}

nomeUnit = {}
basiModel = {}
minisModel = {}

-- ============================================================
-- FUNZIONE: deployment_loadArmySlot()
-- Punto di ingresso dal pulsante spawn.
-- Carica generated/[tag]-army.json e spawna l'esercito.
-- ============================================================
function deployment_loadArmySlot(slot, player)

    slot = tonumber(slot)

    if not deployment_isValidSlot(slot) then
        printToAll("[DEPLOY] slot non valido: " .. tostring(slot), {r=1,g=0.3,b=0.3})
        return false
    end

    if deployment_isArmyLoaded(slot) then
        printToAll("[DEPLOY] Army" .. slot .. " già caricata", {r=1,g=0.8,b=0.2})
        return false
    end

    if deployment_isBusy(slot) then
        printToAll("[DEPLOY] Army" .. slot .. " già in caricamento", {r=1,g=0.8,b=0.2})
        return false
    end

    local url = DEPLOYMENT.urls["army" .. slot]
    if not url or url == "" then
        printToAll("[DEPLOY] URL Army" .. slot .. " non configurata", {r=1,g=0.3,b=0.3})
        return false
    end

    deployment_setBusy(slot, true)
    local playerName  = player and player.steam_name or "---"
    local playerColor = player and player.color      or "---"

    printLog("Download Army" .. slot .. "... " .. url, {r=0.8,g=0.8,b=0.8})

    WebRequest.get(url, function(req)
        
        if req.is_error then
            deployment_setBusy(slot, false)
            printToAll("[DEPLOY] Errore Army" .. slot .. ": " .. tostring(req.error), {r=1,g=0.3,b=0.3})
            return
        end

        local ok, armyData = pcall(JSON.decode, req.text)
        if not ok or type(armyData) ~= "table" then
            deployment_setBusy(slot, false)
            printToAll("[DEPLOY] Parsing Army" .. slot .. " fallito", {r=1,g=0.3,b=0.3})
            return
        end

        -- Verifica formato
        if type(armyData.unita) ~= "table" then
            deployment_setBusy(slot, false)
            printToAll("[DEPLOY] Army" .. slot .. ": campo 'unita' mancante", {r=1,g=0.3,b=0.3})
            return
        end
        if type(armyData.elementi) ~= "table" then
            deployment_setBusy(slot, false)
            printToAll("[DEPLOY] Army" .. slot .. ": campo 'elementi' mancante — usare formato 2.0-IEF", {r=1,g=0.3,b=0.3})
            return
        end

        deployment_applyArmyPlayer(slot, playerName, playerColor)
        deployment_spawnArmy(slot, armyData)
        deployment_markArmyLoaded(slot, true)
        deployment_setBusy(slot, false)
        
        printToAll(string.format("Esercito %s caricato con successo", ARMIES_LABELS[armyData.tag] or "?"), {r=0.4,g=0.9,b=0.4})
        if updateCenterPanel then updateCenterPanel() end
    end)

    return true
end

-- ============================================================
-- FUNZIONE: deployment_spawnArmy()
-- ============================================================
function deployment_spawnArmy(slot, armyData)

    local armyTag  = "Army" .. slot
    local counters = {}

    DEPLOYMENT.armies[slot] = {
        tag         = armyData.tag,
        name        = armyData.nome or armyData.tag,
        displayName = armyData.nome or armyData.tag,
    }

    local startX      = slot == 1 and -50 or 50
    local unitOffsetX = startX
    local unitOffsetZ = -45.00
    local prevModel   = nil

    local prevMaxX  = 0
    local prevMaxZ  = 0
    local prevDepth = 0

    -- Conta basi totali per callback finale
    local totaleBasi  = 0
    local basiSpawnate = 0
    local prevEntry = nil

    for _, unitData in ipairs(armyData.unita) do
        totaleBasi = totaleBasi + #(unitData.basi or {})
    end

    local function onBaseSpawnata()
        basiSpawnate = basiSpawnate + 1
        if basiSpawnate >= totaleBasi then
            -- local function onProgressingBar (s, d, a)
            --     deployment_fillProgress(s, d, a)
            -- end

            Wait.time(function()
                    warning("Attendere che il caricamento sia completo...", "Yellow")
                    -- attach già fatto base per base in deployment_onBaseSpawned
                    --onProgressingBar(slot, 0, 100)
                    Wait.time(function()
                            warning("Attendere che il caricamento sia completo...", "Yellow")
                            callHandler("deployment_scanTable")

                            -- Crea i pulsanti 3D (Formazione + Muovi) sulle basi capitane di questo esercito
                            local capitaneViste = {}
                            for _, obj in ipairs(getAllObjects()) do
                                local objSlot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
                                if objSlot == slot and main_parseNickname(obj.getName()) then
                                    local unitKey = main_getUnitKey(obj)
                                    if unitKey and not capitaneViste[unitKey] then
                                        capitaneViste[unitKey] = true
                                        local basiUnita = {}
                                        for _, o in ipairs(getAllObjects()) do
                                            if main_parseNickname(o.getName()) and main_getUnitKey(o) == unitKey then
                                                table.insert(basiUnita, o)
                                            end
                                        end
                                        main_riposizionaPulsanteFormazione(unitKey, basiUnita)
                                        main_sistemaFormazione(obj)
                                    end
                                end
                            end

                            Wait.time(function()
                                  callHandler("initUI")
                                  callHandler("updateCenterPanel")
                            end, 1)
                            
                    end, 4)
            end, 3)
        end
    end

    for _, unitData in ipairs(armyData.unita) do

        local base = 0
        local rango = tonumber(unitData.basi_per_rango)
        local tipo = unitData.tipo or ""

        -- Ingombro della voce (cm): larghezza e profondità del blocco
        local entryMaxX, entryMaxZ = 0, 0
        for _, b in ipairs(unitData.basi or {}) do
            local bp = b.posizione or {}
            if (bp.x or 0) > entryMaxX then entryMaxX = bp.x end
            if (bp.z or 0) > entryMaxZ then entryMaxZ = bp.z end
        end

        -- Limite di spawn in Z: nessuna base oltre |z| = DEPLOY_SPAWN_Z_LIMIT.
        -- Le basi sono raggruppate per sottounità (basi_per_rango, come la
        -- numerazione): la sottounità che sfora riparte da z = 0 su una
        -- nuova colonna, spostata in X di una larghezza della voce.
        local limiteCm   = (DEPLOY_SPAWN_Z_LIMIT - DEPLOY_SPAWN_Z_BASE) / CM_TO_TTS
        local colonnaCm  = entryMaxX + 4 + GAP_DIVERSO / CM_TO_TTS
        local gruppi     = {}
        local nRango     = (rango and rango > 0) and rango or #(unitData.basi or {})
        for i, b in ipairs(unitData.basi or {}) do
            local g = math.floor((i - 1) / math.max(nRango, 1)) + 1
            local bz = (b.posizione and b.posizione.z) or 0
            local gr = gruppi[g]
            if not gr then
                gr = { minZ = bz, maxZ = bz }
                gruppi[g] = gr
            end
            if bz < gr.minZ then gr.minZ = bz end
            if bz > gr.maxZ then gr.maxZ = bz end
        end
        local col, colZ0 = 0, 0
        for g, gr in ipairs(gruppi) do
            if g > 1 and (gr.maxZ - colZ0) > limiteCm then
                col   = col + 1
                colZ0 = gr.minZ
            end
            gr.dx = col * colonnaCm
            gr.dz = -colZ0
        end
        local basiSpawn = {}
        for i, b in ipairs(unitData.basi or {}) do
            local gr = gruppi[math.floor((i - 1) / math.max(nRango, 1)) + 1]
            local bp = b.posizione or {}
            local copia = {}
            for k, v in pairs(b) do copia[k] = v end
            copia.posizione = { x = (bp.x or 0) + gr.dx, y = bp.y, z = (bp.z or 0) + gr.dz }
            basiSpawn[i] = copia
        end

        -- local gap = 0

        -- if tipo ~= "" then
        --     if tipo == "FP" then 
        --         gap = FP_GAP 
        --     else 
        --         if tipo == "FM" then 
        --             gap = FM_GAP 
        --         else 
        --             if tipo == "CP" then 
        --                 gap = CP_GAP 
        --             else 
        --                 if tipo == "FL" then 
        --                    gap = FL_GAP 
        --                 else 
        --                    gap = 0    
        --                 end
        --             end                
        --         end
        --     end
        -- end
        
            -- Numero dell'unità: contatore PER TIPO in tutto l'esercito
            -- (VIK_BONDI_FP_1, VIK_BONDI_FP_2, VIK_HUSCARL_FP_3...), così
            -- tipo + numero identifica un'unità sola. Una voce dell'Army
            -- Builder con più basi di basi_per_rango forma più unità.
            local unitNumber = nil

            for _, baseData in ipairs(basiSpawn) do
                
                base = base + 1
                if prevEntry == unitData then
                    if rango and base > rango then
                        base = 1
                        counters[tipo] = (counters[tipo] or 0) + 1
                        unitNumber = counters[tipo]
                    end
                else
                    if slot == 1 then
                        unitOffsetX = unitOffsetX + (prevMaxX + 4) * CM_TO_TTS + GAP_DIVERSO
                    else
                        unitOffsetX = unitOffsetX - (prevMaxX + 4) * CM_TO_TTS - GAP_DIVERSO
                    end
                    unitOffsetZ = 0
                    prevEntry = unitData
                    prevModel = unitData.model
                    basi = 1
                    counters[tipo] = (counters[tipo] or 0) + 1
                    unitNumber = counters[tipo]
                end
                -- Unità mista: la seconda metà delle basi di ogni unità
                -- (es. 5-8 su 8) usa il modello del 2° rango (model_2).
                local modelKey = unitData.model
                local perUnita = rango or #(unitData.basi or {})
                if unitData.model_2 and unitData.model_2 ~= "" and base > math.ceil(perUnita / 2) then
                    modelKey = unitData.model_2
                end
                deployment_spawnBase(slot, armyTag, unitData, baseData, unitNumber, armyData.elementi, unitOffsetX, unitOffsetZ, onBaseSpawnata, modelKey)
            end

        -- salva valori per prossima iterazione
        prevMaxX  = 0
        prevMaxZ  = 0

        for _, b in ipairs(basiSpawn) do
            if (b.posizione.x or 0) > prevMaxX then prevMaxX = b.posizione.x end
            if (b.posizione.z or 0) > prevMaxZ then prevMaxZ = b.posizione.z end
        end

        --local utDict  = IEF_DATA.unitTypes and (IEF_DATA.unitTypes.unit_types or IEF_DATA.unitTypes)
        --prevDepth = utDict and utDict[tipo] and utDict[tipo].base_depth_cm or 3
    end
end
-- ============================================================
-- FUNZIONE: deployment_spawnBase()
-- ============================================================
function deployment_spawnBase(slot, armyTag, unitData, baseData, unitNumber, elementi, unitOffsetX, unitOffsetZ, onSpawnata, modelKeyOverride)

    local modelKey     = modelKeyOverride or unitData.model
    local templateData = elementi and elementi[modelKey]

    if not templateData then
        printToAll("[DEPLOY] Modello non trovato: " .. tostring(modelKey), {r=1,g=0.6,b=0})
        if onSpawnata then onSpawnata() end
        return
    end

    local nickname =    deployment_buildBaseNickname(unitData, baseData, unitNumber)
    local utSpawn = main_getUnitType(unitData.tipo)
    local pos =         deployment_buildBasePosition(slot, baseData, unitOffsetX, unitOffsetZ,
                                                     utSpawn and tonumber(utSpawn.base_depth_cm))
    local rot      =    deployment_buildBaseRotation(slot)
    local params   =    deployment_buildSpawnParams(nickname, unitData, templateData, pos, rot)

    if not params then
        if onSpawnata then onSpawnata() end
        return
    end

    spawnObjectJSON({
        json = JSON.encode(params),
        callback_function = function(obj)
            if not obj then
                if onSpawnata then onSpawnata() end
                return
            end
            deployment_onBaseSpawned(obj, slot, armyTag, nickname, unitData, baseData, templateData, pos, rot, onSpawnata)
        end
    })
end
-- ============================================================
-- FUNZIONE: deployment_buildBaseNickname(unitData, baseData, unitNumber)
-- Alcuni model hanno un suffisso extra dopo il tipo unità (es.
-- "VIK_Huscarl_FP_MIX") — lo tolgo troncando subito dopo il
-- segmento del tipo, invece di usare il model per intero.
-- ============================================================
function deployment_buildBaseNickname(unitData, baseData, unitNumber)
    -- unitKey = nome + tipo + numero (es. VIK_BONDI + FP + 1 -> VIK_BONDI_FP_1);
    -- se il nome finisce già con il tipo (VIK_GEN + GEN, VIK_HUSCARL_FP + FP)
    -- il tipo non si ripete.
    local model = unitData.unit_name or unitData.model or ""
    local tipo  = unitData.tipo or ""
    local nome  = model
    if tipo ~= "" and model:sub(-(#tipo + 1)) ~= ("_" .. tipo) then
        nome = model .. "_" .. tipo
    end
    return nome .. "_" .. unitNumber .. "." .. baseData.seq
end
-- ============================================================
-- FUNZIONE: deployment_buildBasePosition()
-- Army1 spawna a Z negativo (zona sopra), Army2 a Z positivo.
-- Offset da posizione nel JSON (coordinate relative in cm * 0.7423)
-- ============================================================
function deployment_buildBasePosition(slot, baseData, unitOffsetX, unitOffsetZ, depthCm)

    local VERDE_LZ  = 50
    local SPAWN_GAP = 2
    local Y         = 1.18
     local sourcePos = baseData.posizione or { x = 0, z = 0 }

    local zOffset   = slot == 1 and -(VERDE_LZ + SPAWN_GAP) or (VERDE_LZ + SPAWN_GAP)
    local zSign = slot == 1 and -1 or 1
    local col = math.floor((sourcePos.x or 0) / 4)
    local horizGap = 0.01
    -- Anche fra i ranghi un piccolo gioco (come fra le colonne):
    -- con le mesh alla misura esatta i ranghi nascevano a contatto e
    -- la fisica, allo sblocco, sollevava qualche base.
    local rank = (depthCm and depthCm > 0) and math.floor((sourcePos.z or 0) / depthCm + 0.5) or 0
    local vertGap = 0.03

    local x1 = ((unitOffsetX or 0) + (sourcePos.x or 0) * CM_TO_TTS + col * horizGap)
    local x2 = ((unitOffsetX or 0) - (sourcePos.x or 0) * CM_TO_TTS - col * horizGap)

    local z1 = zOffset - (sourcePos.z or 0) * CM_TO_TTS - rank * vertGap + (unitOffsetZ or 0) * zSign
    local z2 = zOffset + (unitOffsetZ or 0) + (sourcePos.z or 0) * CM_TO_TTS + rank * vertGap
   
    local x = slot == 1 and x1 or x2
    local z = slot == 1 and z1 or z2
    local y = Y
    
    return {x = x, y = y, z=z}
end
-- ============================================================
-- FUNZIONE: deployment_buildBaseRotation()
-- Army1 guarda verso Z positivo (verso il centro tavolo).
-- Army2 è ruotata di 180°.
-- ============================================================
function deployment_buildBaseRotation(slot)
    return { x = 0, y = slot == 1 and 0 or 180, z = 0 }
end

-- ============================================================
-- FUNZIONE: deployment_buildSpawnParams()
-- Costruisce il JSON per spawnObjectJSON dalla customMesh.
-- Risolve diffuseURL se è un nome terreno (es. "erba_verde").
-- ============================================================
function deployment_buildSpawnParams(nickname, unitData, templateData, pos, rot)

    if templateData.customAssetbundle then
        local ab = templateData.customAssetbundle
        return {
            Name        = "Custom_Assetbundle",
            Nickname    = nickname,
            Description = unitData.nome_display or "",
            Transform   = {
                posX   = pos.x, posY   = pos.y, posZ   = pos.z,
                rotX   = rot.x, rotY   = rot.y, rotZ   = rot.z,
                scaleX = ab.scaleX or 1, scaleY = ab.scaleY or 1, scaleZ = ab.scaleZ or 1
            },
            CustomAssetbundle = {
                AssetbundleURL          = ab.assetBundleURL or "",
                AssetbundleSecondaryURL = ab.assetBundleSecondaryURL or "",
                MaterialIndex = ab.material or 3,
                TypeIndex     = ab.type     or 0
            }
        }
    end

    local mesh = templateData.customMesh
    if not mesh then
        print("[DEPLOY] ATTENZIONE: template senza customMesh né customAssetbundle per " .. nickname)
        return nil
    end

    -- Deep copy per non modificare il template
    local meshCopy = {}
    for k, v in pairs(mesh) do meshCopy[k] = v end

    -- Risolvi diffuseURL se è un nome terreno
    if type(meshCopy.diffuseURL) == "string" and DEPLOYMENT_TERRAINS[meshCopy.diffuseURL] then
        meshCopy.diffuseURL = DEPLOYMENT_TERRAINS[meshCopy.diffuseURL]
    end

    return {
        Name        = "Custom_Model",
        Nickname    = nickname,
        Description = unitData.nome_display or "",
        Transform   = {
            posX   = pos.x, posY   = pos.y, posZ   = pos.z,
            rotX   = rot.x, rotY   = rot.y, rotZ   = rot.z,
            scaleX = 1,     scaleY = 1,     scaleZ = 1
        },
        CustomMesh = {
            MeshURL      = meshCopy.meshURL    or "",
            DiffuseURL   = meshCopy.diffuseURL or "",
            ColliderURL  = meshCopy.colliderURL or "",
            Convex       = true,
            MaterialIndex = meshCopy.material  or 3,
            TypeIndex    = meshCopy.type       or 0,
            CastShadows  = true
        }
    }
end

-- ============================================================
-- FUNZIONE: deployment_onBaseSpawned()
-- Callback dopo spawn base: applica tag, metadata, scale, figure.
-- ============================================================
function deployment_onBaseSpawned(obj, slot, armyTag, nickname, unitData, baseData, templateData, pos, rot, onSpawnata)
   
    Wait.frames(function()
        if not obj then return end

        local collected = {}

        obj.setName(nickname)
        obj.setDescription(unitData.nome_display or "")
        obj.setLock(true)
        obj.auto_raise = true
        obj.addTag(armyTag)

        -- Applica scaleZ dal template (base più sottile per FP, FM, ecc.)
        local mesh = templateData.customMesh
        if mesh and mesh.scaleZ then
            local s = obj.getScale()
            obj.setScale({ s.x, s.y, mesh.scaleZ })
        end

        -- Metadata
        deployment_applyBaseMetadata(obj, slot, armyTag, nickname, unitData, baseData)

        -- Figure figlie (spawnate bloccate)
        local attese = deployment_spawnChildrenRecursive(obj, pos, rot, armyTag, templateData.children, nickname, slot)

        -- La base resta bloccata finché tutte le sue figure non sono
        -- spawnate e caricate: solo allora attach e sblocco. Così base e
        -- figure non sono mai oggetti fisici separati durante il
        -- caricamento (niente compenetrazioni che sollevano la base).
        local function figurePronte()
            if not obj or obj.loading_custom then return false end
            local minis = minisModel[nickname] or {}
            if #minis < attese then return false end
            for _, m in ipairs(minis) do
                if m and m.loading_custom then return false end
            end
            return true
        end

        local function concludi()
            if obj then
                -- Centro reale della mesh della base (prima dell'attach,
                -- quindi senza figure) rispetto al suo punto di posizione,
                -- in assi locali: il pivot delle mesh non è al centro.
                -- Usato da main_baseRectOfType per i rettangoli.
                main_saveBaseCentro(obj)
                for _, m in ipairs(minisModel[nickname] or {}) do
                    if m then pcall(function() obj.addAttachment(m) end) end
                end
                minisModel[nickname] = nil
                Wait.frames(function()
                    if obj then obj.setLock(false) end
                    if onSpawnata then onSpawnata() end
                end, 5)
            elseif onSpawnata then
                onSpawnata()
            end
        end

        Wait.condition(concludi, figurePronte, 30, function()
            printToAll("[DEPLOY] Figure non caricate in tempo: " .. tostring(nickname), {r=1,g=0.6,b=0})
            concludi()
        end)

    end, 2)
end
-- ============================================================
-- FUNZIONE: deployment_applyBaseMetadata()
-- Scrive i dati base in GMNotes (JSON) per recupero runtime.
-- ============================================================
function deployment_applyBaseMetadata(obj, slot, armyTag, nickname, unitData, baseData)
    local metadata = {
        ruleset         = "IEF",
        kind            = "UNIT_BASE",
        armySlot        = slot,
        armyTag         = armyTag,
        nickname        = nickname,
        unitType        = unitData.tipo,
        unitName        = unitData.nome_display,
        model           = unitData.model,
        morale          = unitData.morale,
        armi            = unitData.armi or {},
        capabilities    = unitData.capabilities or {},
        baseSeq         = baseData.seq,
        armamento       = unitData.armamento or "NORMALE",   -- MISTO = ranghi con armi diverse (Army Builder)
        chiave          = unitData.chiave == true,           -- UNITA' CHIAVE (BP: conta 2)
    }
    obj.setGMNotes(JSON.encode(metadata))
end

-- ============================================================
-- FUNZIONE: deployment_applyBaseVisibility()
-- Nasconde la base al giocatore nemico.
-- ============================================================
function deployment_applyBaseVisibility(slot)
    print("deployment_applyBaseVisibility ", slot)
    local enemyColor = slot == 1 and colorArmy2 or colorArmy1
    local listaOggetti = getObjectsWithAllTags({"army" .. slot})

     for _, value in ipairs(listaOggetti) do
        print(value.getName(), " - ", value.guid)
        value.setInvisibleTo({enemyColor})
     end

     print("Army".. slot, " nascosta per il player di colore:", enemyColor)

end
-- ============================================================
-- FUNZIONE: deployment_applyArmyPlayer()
-- ============================================================
function deployment_applyArmyPlayer(slot, playerName, playerColor)
    DEPLOYMENT.armies[slot] = DEPLOYMENT.armies[slot] or {}
    DEPLOYMENT.armies[slot].player = playerName
    DEPLOYMENT.armies[slot].color  = playerColor
end

-- ============================================================
-- FUNZIONE: deployment_spawnChildrenRecursive()
-- Spawna le figure figlie (e loro figli) attaccandole alla base.
-- ============================================================
function deployment_spawnChildrenRecursive(baseObj, basePos, baseRot, armyTag, children, nicknameBase, slot)
    if not children or #children == 0 then return 0 end

    -- Figure attese (stesso filtro di spawnLevel, ricorsivo)
    local function contaFigure(nodi)
        local n = 0
        for _, c in ipairs(nodi or {}) do
            local m = c.customMesh
            if (m and m.meshURL and m.meshURL ~= "") or c.customAssetbundle then
                n = n + 1 + contaFigure(c.children)
            end
        end
        return n
    end
    local attese = contaFigure(children)
    
    if nomeUnit[slot] == nil then nomeUnit[slot] = {} end
    table.insert(nomeUnit[slot], nicknameBase)
    basiModel[nicknameBase] = baseObj
    
    local collected = {}
    local function spawnLevel(nodeChildren, prefix)
        for i, childData in ipairs(nodeChildren) do
            local mesh = childData.customMesh
            if mesh and mesh.meshURL and mesh.meshURL ~= "" or childData.customAssetbundle then
                local childNickname = prefix .. "_" .. i
                if childData.customMesh or childData.customAssetbundle then
                    local params = deployment_buildFigureParams(childNickname, childData, basePos, baseRot)
                    spawnObjectJSON({
                        json = JSON.encode(params),
                        callback_function = function(obj)
                            if obj then
                                obj.addTag(armyTag)
                                table.insert(collected, obj)
                                minisModel[nicknameBase] = collected
                                -- Figli ricorsivi
                                if childData.children and #childData.children > 0 then
                                    spawnLevel(childData.children, childNickname)
                                end
                            end
                        end
                    })
                end    
            end
        end
    end

    spawnLevel(children, nicknameBase)
    return attese
end
function deployment_AttachMinisToBase(slot)
      for _, value in ipairs(nomeUnit[slot]) do
        local base = basiModel[value]
        local minis = minisModel[value]
        if minis ~= nil then
            for _, minisObj in ipairs(minis) do
                if minisObj ~= nil then
                    -- Sostituito addAttachment con jointTo
                    pcall(function() base.addAttachment(minisObj) end)
                end
            end
        end
    end
end
-- ============================================================
-- FUNZIONE: deployment_buildFigureParams()
-- Costruisce i parametri spawn per una figura figlia.
-- ============================================================
function deployment_buildFigureParams(nickname, childData, basePos, baseRot)
    local mesh = childData.customMesh
    local ab   = childData.customAssetbundle

    -- Offset delle figure in coordinate LOCALI della base (come li
    -- restituisce debug_getChildOffsets): ruotati con la rotazione
    -- della base, così valgono per entrambi gli eserciti (slot 2 ha
    -- la base girata di 180°). Y: altezza relativa alla base, senza
    -- aggiunte fisse.
    local a = math.rad((baseRot and baseRot.y) or 0)
    local function posFigura(src)
        local ox, oz = (src.offsetX or 0), (src.offsetZ or 0)
        return basePos.x + ox * math.cos(a) + oz * math.sin(a),
               basePos.y + (src.offsetY or 0),
               basePos.z - ox * math.sin(a) + oz * math.cos(a)
    end

    if ab then
        -- AssetBundle
        local rotY = (baseRot.y + (ab.rotY or 0)) % 360
        local px, py, pz = posFigura(ab)
        return {
            Name      = "Custom_Assetbundle",
            Nickname  = nickname,
            Locked    = true,
            Transform = {
                posX = px,
                posY = py,
                posZ = pz,
                rotX = 0, rotY = rotY, rotZ = 0,
                scaleX = ab.scaleX or 1,
                scaleY = ab.scaleY or 1,
                scaleZ = ab.scaleZ or 1
            },
            CustomAssetbundle = {
                AssetbundleURL          = ab.assetBundleURL or "",
                AssetbundleSecondaryURL = ab.assetBundleSecondaryURL or "",
                MaterialIndex           = ab.material or 3,
                TypeIndex               = ab.type or 0
            }
        }
    elseif mesh then
        -- CustomMesh esistente
        local rotY   = (baseRot.y + (mesh.rotY or 0)) % 360
        local diffuse = mesh.diffuseURL
        if type(diffuse) == "string" and DEPLOYMENT_TERRAINS[diffuse] then
            diffuse = DEPLOYMENT_TERRAINS[diffuse]
        end
        local px, py, pz = posFigura(mesh)
        return {
            Name      = "Custom_Model",
            Nickname  = nickname,
            Locked    = true,
            Transform = {
                posX = px,
                posY = py,
                posZ = pz,
                rotX = 0, rotY = rotY, rotZ = 0,
                scaleX = mesh.scaleX or 1,
                scaleY = mesh.scaleY or 1,
                scaleZ = mesh.scaleZ or 1
            },
            CustomMesh = {
                MeshURL       = mesh.meshURL    or "",
                DiffuseURL    = diffuse         or "",
                ColliderURL   = mesh.colliderURL or "",
                Convex        = true,
                MaterialIndex = mesh.material   or 3,
                TypeIndex     = mesh.type       or 0,
                CastShadows   = true
            }
        }
    end
    return nil
end

-- ============================================================
-- FUNZIONE: deployment_validateDeploy()
-- Verifica che le basi siano nella zona corretta per lo slot.
-- ============================================================
function deployment_validateDeploy(player)
    
    local slot = main_getArmyByColor(player)
    if not slot then
        printToAll("[DEPLOY] Player non associato ad un esercito", {r=1,g=0.3,b=0.3})
        return false
    end

    local LAT_TTS     = 6  * INCH_TO_TTS  -- 11.31 TTS
    local X_MAX       = 66.806 - LAT_TTS  -- 55.50 (con 6 pollici di margine laterale)
    local Z_NEAR      = 44.536 - (12 * INCH_TO_TTS)  -- 44.536 - 22.62 = 21.92
    local Z_FAR       = 44.536

    local fuori     = {}
    local sbagliata = {}
    local basi_err  = {}

    for _, obj in ipairs(getAllObjects()) do
        if deployment_getObjectArmySlot(obj) == slot then
            local p    = obj.getPosition()
            local z_ok = math.abs(p.z) >= Z_NEAR and math.abs(p.z) <= Z_FAR
            local x_ok = math.abs(p.x) <= X_MAX
            local side = slot == 1 and p.z < 0 or p.z > 0

            if not z_ok or not x_ok then
                table.insert(fuori, obj.getName())
                table.insert(basi_err, obj)
            elseif not side then
                table.insert(sbagliata, obj.getName())
                table.insert(basi_err, obj)
            end
        end
    end

    for _, obj in ipairs(basi_err) do
        if obj then obj.highlightOn({ r=1, g=0.1, b=0.1 }, 15) end
    end

    if #fuori + #sbagliata > 0 then
         warningToColor("Posizionare tutte le unità nell'area di DEPLOY", player, "Yellow", 5, true)
         return false
    end

    printToAll("[DEPLOY] Army" .. slot .. " — posizionamento OK!", {r=0.4,g=0.9,b=0.4})
    return true
end

-- ============================================================
-- FUNZIONE: deployment_scanTable()
-- Legge tutte le basi sul tavolo e popola DEPLOYMENT.scanned.
-- ============================================================
function deployment_scanTable()

    local groups = { [1] = {}, [2] = {} }

    for _, obj in ipairs(getAllObjects()) do
        local slot = deployment_getObjectArmySlot(obj)
        if slot then
            local info = main_parseNickname(obj.getName())
            if info then
                local key   = info.unitType .. "_" .. info.unitNumber .. " x"
                local group = groups[slot][key]

                if not group then
                    group = {
                        tipo      = info.unitType,
                        unita_num = info.unitNumber,
                        fazione   = tostring(slot),
                        basi      = {}
                    }

                    -- SEMPRE leggi armi dai GMNotes per ogni base
                    local raw = obj.getGMNotes()
                    if raw and raw ~= "" then
                        local ok, meta = pcall(JSON.decode, raw)
                        if ok and meta and not group.armi then
                            group.morale = meta.morale
                            group.armi   = meta.armi
                            group.model  = meta.model
                        end
                    end
                    
                    groups[slot][key] = group
                end

                table.insert(group.basi, {
                    nickname = obj.getName(),
                    guid     = obj.getGUID(),
                    seq      = info.baseSeq
                })
                obj.highlightOff()
            end
        end
    end

    DEPLOYMENT.scanned[1] = deployment_groupsToList(groups[1])
    DEPLOYMENT.scanned[2] = deployment_groupsToList(groups[2])
    return DEPLOYMENT.scanned[1], DEPLOYMENT.scanned[2]
end

-- ============================================================
-- FUNZIONE: deployment_groupsToList()
-- ============================================================
function deployment_groupsToList(groups)
    local list = {}
    for _, unit in pairs(groups) do
        table.sort(unit.basi, function(a, b) return (a.seq or 0) < (b.seq or 0) end)
        table.insert(list, unit)
    end
    table.sort(list, function(a, b)
        if a.tipo ~= b.tipo then return a.tipo < b.tipo end
        return (a.unita_num or 0) < (b.unita_num or 0)
    end)
    return list
end

-- ============================================================
-- FUNZIONE: deployment_revealAllSpawned()
-- ============================================================
function deployment_revealAllSpawned()
    for _, obj in ipairs(getAllObjects()) do
        if deployment_getObjectArmySlot(obj) then
            obj.setInvisibleTo({})
        end
    end
end

-- ============================================================
-- FUNZIONE: deployment_resetRuntimeOnly()
-- ============================================================
function deployment_resetRuntimeOnly()
    DEPLOYMENT.armies     = { [1] = nil,   [2] = nil   }
    DEPLOYMENT.armyLoaded = { [1] = false, [2] = false }
    DEPLOYMENT.armyBusy   = { [1] = false, [2] = false }
    DEPLOYMENT.scanned    = { [1] = {},    [2] = {}    }
    DEPLOYMENT.errors     = {}
end

-- ============================================================
-- FUNZIONE: deployment_clearSpawnedModels()
-- ============================================================
function deployment_clearSpawnedModels()
    local removed = 0
    for _, obj in ipairs(getAllObjects()) do
        if obj.hasTag and (obj.hasTag("Army1") or obj.hasTag("Army2")) then
            obj.destruct()
            removed = removed + 1
        end
    end
    printToAll("[DEPLOY] Rimossi " .. removed .. " oggetti", {r=0.4,g=0.9,b=0.4})
end

-- ============================================================
-- FUNZIONE: deployment_getObjectArmySlot()
-- ============================================================
function deployment_getObjectArmySlot(obj)
    if not obj then return nil end
    if obj.hasTag and obj.hasTag("Army1") then return 1 end
    if obj.hasTag and obj.hasTag("Army2") then return 2 end
    return nil
end

-- ============================================================
-- FUNZIONE: deployment_findUnit()
-- ============================================================
function deployment_findUnit(slot, tipo, unita_num)
    local esercito = DEPLOYMENT.scanned and DEPLOYMENT.scanned[slot]
    if not esercito then return nil end
    for _, u in ipairs(esercito) do
        if u.tipo == tipo and u.unita_num == unita_num then return u end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: deployment_isValidSlot()
-- ============================================================
function deployment_isValidSlot(slot)
    return slot == 1 or slot == 2
end

-- ============================================================
-- FUNZIONE: deployment_isArmyLoaded()
-- ============================================================
function deployment_isArmyLoaded(slot)
    return DEPLOYMENT.armyLoaded[slot] == true
end

-- ============================================================
-- FUNZIONE: deployment_markArmyLoaded()
-- ============================================================
function deployment_markArmyLoaded(slot, value)
    DEPLOYMENT.armyLoaded[slot] = value ~= false
end

-- ============================================================
-- FUNZIONE: deployment_isBusy()
-- ============================================================
function deployment_isBusy(slot)
    return DEPLOYMENT.armyBusy[slot] == true
end

-- ============================================================
-- FUNZIONE: deployment_setBusy()
-- ============================================================
function deployment_setBusy(slot, value)
    DEPLOYMENT.armyBusy[slot] = value == true
end

-- ============================================================
-- FUNZIONE: deployment_addError()
-- ============================================================
function deployment_addError(msg)
    DEPLOYMENT.errors = DEPLOYMENT.errors or {}
    table.insert(DEPLOYMENT.errors, tostring(msg))
end

-- ============================================================
-- FUNZIONE: deployment_getArmyTag()
-- ============================================================
function deployment_getArmyTag(slot)
    return "Army" .. tostring(slot)
end

-- ============================================================
-- FUNZIONE: deployment_createArmy1HiddenZones()
--=============================================================
function deployment_createArmy1HiddenZones()
    local esistenti = getObjectsWithAllTags({"Army1"})
    for _, obj in ipairs(esistenti) do
        if obj.getName() == "FogOfWarTrigger_Army1" then
            return  -- esiste già, non ricreare
        end
    end
    DEPLOYMENT.army1Hz = spawnObjectJSON({ json = DEPLOYMENT.fogArm1 })
end
-- ============================================================
-- FUNZIONE: deployment_createArmy2HiddenZones()
--=============================================================
function deployment_createArmy2HiddenZones()
    local esistenti = getObjectsWithAllTags({"Army2"})
    for _, obj in ipairs(esistenti) do
        if obj.getName() == "FogOfWarTrigger_Army2" then
            return  -- esiste già, non ricreare
        end
    end
    DEPLOYMENT.army2Hz = spawnObjectJSON({ json = DEPLOYMENT.fogArmy2})
end
-- ============================================================
-- FUNZIONE: deployment_destroyArmy1HiddenZones()
--=============================================================
function deployment_destroyArmy1HiddenZones()
    -- Non fidarti del riferimento runtime: cerca sempre l'oggetto sul tavolo
    local oggetti = getObjectsWithAllTags({"Army1"})   -- o il tag specifico che hai dato al trigger
    for _, obj in ipairs(oggetti) do
        if obj.getName() == "FogOfWarTrigger_Army1" then   -- filtro extra per non colpire altro con tag "Army1"
            obj.destruct()
        end
    end
    DEPLOYMENT.army1Hz = nil
end
-- ============================================================
-- FUNZIONE: deployment_destroyArmy2HiddenZones()
--=============================================================
function deployment_destroyArmy2HiddenZones()
    -- Non fidarti del riferimento runtime: cerca sempre l'oggetto sul tavolo
    local oggetti = getObjectsWithAllTags({"Army2"})   -- o il tag specifico che hai dato al trigger
    for _, obj in ipairs(oggetti) do
        if obj.getName() == "FogOfWarTrigger_Army2" then   -- filtro extra per non colpire altro con tag "Army2"
            obj.destruct()
        end
    end
    DEPLOYMENT.army2Hz = nil
end
-- ============================================================
-- FUNZIONE: deployment_destroyArmy2HiddenZones()
--=============================================================
function deployment_fillProgress(slot, da, a)

    slot = slot or 1
    da = da or 0
    a = a or 100
    local s = tostring(slot)

    UI.setAttribute("loadingPanel_" .. s, "active", "true")

    local pct = da
    local function step()
        pct = pct + 1
        UI.setAttribute("loadingBar_" .. s, "percentage", pct)
        if pct < a then
            Wait.time(step, 0.04)   -- intervallo FISSO, non più "pct"
        elseif a >= 100 then        -- chiude solo se il tratto arriva davvero a 100
            Wait.time(function()
                UI.setAttribute("loadingPanel_" .. s, "active", "false")
            end, 2)
        end
    end
    step()
end