-- ============================================================
-- WARFORGE IEF — 9_recovery/lib.ttslua
-- Fase 6 - Recupero (regolamento p. 25):
-- 1) DISORDINATE nel raggio di comando di un proprio Generale
--    possono tentare il test per riordinarsi;
-- 2) in ROTTA (non andate in rotta in questo turno) con un
--    Generale aggregato possono tentare il test; se falliscono
--    vengono rimosse dal tavolo.
-- Test: main_testMorale(..., "per_riordinare", ...), superato =
-- recupera un livello di coesione.
-- ============================================================

-- Colore di selezione dell'unità in attesa del Roll
RECOVERY_HIGHLIGHT_COLOR = {1, 0.85, 0}

-- ============================================================
-- FUNZIONE: recovery_buttonBaseClick(obj, player_color, alt_click)
-- ============================================================
function recovery_buttonBaseClick(obj, player_color, alt_click)
   local player = Player[player_color]
   warningToColor("Recupero (da implementare)", player, "Yellow", 5)    
end

-- ============================================================
-- FUNZIONE: recovery_resetState()
-- Azzera lo stato della fase e spegne le evidenziazioni.
-- ============================================================
function recovery_resetState()
    for slot = 1, 2 do
        local cur = IEF_RECOVERY_CURRENT[slot]
        if cur then recovery_highlightUnit(cur.key, false) end
    end
    IEF_RECOVERY_DONE    = {}
    IEF_RECOVERY_CURRENT = {}
    IEF_RECOVERY_ROWS    = { [1] = {}, [2] = {} }
end

-- ============================================================
-- FUNZIONE: recovery_highlightUnit(unitKey, acceso)
-- ============================================================
function recovery_highlightUnit(unitKey, acceso)
    if not unitKey then return end
    for _, obj in ipairs(main_getUnitBases(unitKey)) do
        if acceso then
            obj.setColorTint(RECOVERY_HIGHLIGHT_COLOR)
        else
            obj.setColorTint({0, 0, 0})
        end
    end
end

-- ============================================================
-- FUNZIONE: recovery_isEligible(unitKey, slot)
-- Ritorna true se l'unità può tentare il test di recupero ora.
-- ============================================================
function recovery_isEligible(unitKey, slot)
    if not unitKey or main_isGeneralKey(unitKey) then return false end
    if IEF_RECOVERY_DONE[unitKey] then return false end

    local basi = main_getUnitBases(unitKey)
    if #basi == 0 then return false end

    local livello = main_getCohesion(unitKey)

    if livello == COHESION.DIS then
        for _, b in ipairs(basi) do
            if main_isInCommandRange(b, slot) then return true end
        end
        return false
    end

    if livello == COHESION.ROT then
        if main_isRoutedThisTurn(unitKey) then return false end
        return main_getAttachedGeneral(unitKey) ~= nil
    end

    return false
end

-- ============================================================
-- FUNZIONE: recovery_getCandidates(slot)
-- Unità di ARMY{slot} che possono tentare il recupero,
-- ordinate per chiave.
-- ============================================================
function recovery_getCandidates(slot)
    local out = {}
    for key, _ in pairs(main_unitsOfSlot(slot)) do
        if recovery_isEligible(key, slot) then table.insert(out, key) end
    end
    table.sort(out)
    return out
end

-- ============================================================
-- FUNZIONE: recovery_getListPanelXml(slot)
-- Lista delle unità recuperabili di ARMY{slot}. Chiamata da
-- buildUI: fuori dalla fase RECOVERY il pannello è vuoto.
-- ============================================================
function recovery_getListPanelXml(slot)
    local colore = ARMY[slot] and ARMY[slot].color or "White"

    IEF_RECOVERY_ROWS[slot] = {}
    if ENGINE.phase == PHASE.RECOVERY then
        IEF_RECOVERY_ROWS[slot] = recovery_getCandidates(slot)
    end
    local chiavi = IEF_RECOVERY_ROWS[slot]
    local attivo = (#chiavi > 0) and "true" or "false"

    local rows = ""
    for idx, key in ipairs(chiavi) do
        local mod = main_moraleModifier(key, nil)
        rows = rows .. string.format(
            '<Row id="recovery_rowline_%d_%d" preferredHeight="25">' ..
                '<Cell>' ..
                    '<Button id="recovery_row_%d_%d" text="%s - %s (mod %+d)" font="warforge_font" fontSize="11" color="rgba(0,0,0,0.30)" textColor="White" alignment="MiddleLeft" width="475" onClick="recovery_rowClick"/>' ..
                '</Cell>' ..
                '<Cell>' ..
                    '<Button id="recovery_row_btn_%d_%d" text="" fontSize="14" fontStyle="Bold" color="rgba(0.7,0.55,0.1,1)" textColor="White" onClick="recovery_rowClick"/>' ..
                '</Cell>' ..
            '</Row>',
            slot, idx,
            slot, idx, main_decodeExtendedUnitLabel(key), main_getCohesion(key), mod,
            slot, idx
        )
    end

    return string.format(
        '<Panel id="recovery_list_army%d" rectAlignment="LowerRight" color="rgba(0,0,0,0.35)" width="500" height="160" offsetXY="0 110" visibility="%s" active="%s">' ..
        '<Text id="recovery_list_title_army%d" text="RECUPERO %s" font="warforge_font" fontSize="14" fontStyle="Bold" outlineColor="Black" outlineSize="1" color="White" position="0 65 0" alignment="MiddleCenter" width="300" height="22"/>' ..
        '<TableLayout width="500" height="120" cellBackgroundColor="rgba(0,0,0,0.00)" columnWidths="460 40" position="0 -5 0">' ..
        '%s' ..
        '</TableLayout>' ..
        '</Panel>',
        slot, colore, attivo, slot, ARMY[slot].name, rows
    )
end

-- ============================================================
-- FUNZIONE: recovery_rowClick(player, value, id)
-- Seleziona l'unità (highlight) e porta la camera sui dadi:
-- il tiro parte dal pulsante fisico Roll (recovery_doRoll).
-- ============================================================
function recovery_rowClick(player, value, id)
    local slotStr, idxStr = id:match("^recovery_row_btn_(%d)_(%d+)$")
    if not slotStr then
        slotStr, idxStr = id:match("^recovery_row_(%d)_(%d+)$")
    end
    if not slotStr then return end
    local slot, idx = tonumber(slotStr), tonumber(idxStr)

    if ENGINE.phase ~= PHASE.RECOVERY then return end
    if main_getArmyByColor(player) ~= slot then return end

    local key = IEF_RECOVERY_ROWS[slot] and IEF_RECOVERY_ROWS[slot][idx]
    if not key or IEF_RECOVERY_DONE[key] then return end

    local cur = IEF_RECOVERY_CURRENT[slot]
    if cur and cur.inCorso then
        warningToColor("C'è già un test di recupero in corso", player, "Yellow", 5)
        return
    end
    if cur and cur.key ~= key then recovery_highlightUnit(cur.key, false) end

    IEF_RECOVERY_CURRENT[slot] = { key = key, idx = idx, inCorso = false }
    recovery_highlightUnit(key, true)

    engine_diceClearLastRoll(slot)
    engine_diceCameraZoom(player, slot)
end

-- ============================================================
-- FUNZIONE: recovery_doRoll(player, slot)
-- Dispatch da engine_diceRoll_start: test di morale
-- "per_riordinare" dell'unità selezionata.
-- ============================================================
function recovery_doRoll(player, slot)
    local cur = IEF_RECOVERY_CURRENT[slot]
    if not cur or cur.inCorso then return end

    local key = cur.key
    if not recovery_isEligible(key, slot) then
        warningToColor("L'unità non può più tentare il recupero", player, "Yellow", 5)
        recovery_highlightUnit(key, false)
        IEF_RECOVERY_CURRENT[slot] = nil
        engine_diceCameraReturn(player, slot, PHASE.RECOVERY)
        return
    end

    cur.inCorso = true
    local livello = main_getCohesion(key)
    local mod, dettaglio = main_moraleModifier(key, nil)

    printToAll(string.format("[RECUPERO] %s (%s) testa, modificatori: %s",
        main_decodeExtendedUnitLabel(key), livello, main_moraleModifierText(dettaglio)), {r=1,g=0.8,b=0.3})

    main_testMorale(key, player, "per_riordinare", mod, function(esito)
        if IEF_RECOVERY_CURRENT[slot] ~= cur then return end
        if esito == nil then
            cur.inCorso = false
            return
        end

        IEF_RECOVERY_DONE[key] = true
        IEF_RECOVERY_CURRENT[slot] = nil
        recovery_highlightUnit(key, false)
        UI.setAttribute(string.format("recovery_rowline_%d_%d", slot, cur.idx), "active", "false")

        if esito == MORALE_RESULT.OK then
            main_raiseCohesion(key)
        elseif livello == COHESION.ROT then
            printToAll(string.format("[RECUPERO] %s fallisce il recupero dalla rotta: rimossa dal tavolo",
                main_decodeExtendedUnitLabel(key)), {r=1,g=0.4,b=0.4})
            main_removeBases(key, main_getUnitBases(key))
        else
            printToAll(string.format("[RECUPERO] %s non si riordina: resta %s",
                main_decodeExtendedUnitLabel(key), livello), {r=1,g=0.6,b=0.4})
        end
    end)
end

-- ============================================================
-- FUNZIONE: recovery_canComplete(player, slot)
-- "Recupero Completato" bloccato solo da un test in corso;
-- una selezione non tirata viene annullata.
-- ============================================================
function recovery_canComplete(player, slot)
    local cur = IEF_RECOVERY_CURRENT[slot]
    if cur and cur.inCorso then
        warningToColor("C'è un test di recupero in corso", player, "Yellow", 5)
        return false
    end
    if cur then
        recovery_highlightUnit(cur.key, false)
        IEF_RECOVERY_CURRENT[slot] = nil
    end
    return true
end
