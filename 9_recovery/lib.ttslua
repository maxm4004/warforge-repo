-- ============================================================
-- FUNZIONE: recovery_buttonBaseClick(obj, player_color, alt_click)
-- ============================================================
function recovery_buttonBaseClick(obj, player_color, alt_click)
   local player = Player[player_color]
   warningToColor("Recupero (da implementare)", player, "Yellow", 5)    
end

-- ============================================================
-- FUNZIONE: recovery_resetState()
-- Azzera lo stato della fase e spegne le evidenziazioni.
-- ============================================================
function recovery_resetState()
    IEF_RECOVERY_DONE = {}
end
-- ============================================================
-- FUNZIONE: recovery_isEligible(unitKey, slot)
-- Ritorna true se l'unità può tentare il test di recupero ora.
-- ============================================================
function recovery_isEligible(unitKey, slot)
    if not unitKey or main_isGeneralKey(unitKey) then return false end
    if IEF_RECOVERY_DONE[unitKey] then return false end

    local basi = main_getUnitBases(unitKey)
    if #basi == 0 then return false end

    local livello = main_getCohesion(unitKey)

    if livello == COHESION.DIS then
        for _, b in ipairs(basi) do
            if main_isInCommandRange(b, slot) then return true end
        end
        return false
    end

    if livello == COHESION.ROT then
        if main_isRoutedThisTurn(unitKey) then return false end
        return main_getAttachedGeneral(unitKey) ~= nil
    end

    return false
end

-- ============================================================
-- FUNZIONE: recovery_getCandidates(slot)
-- Unità di ARMY{slot} che possono tentare il recupero,
-- ordinate per chiave.
-- ============================================================
function recovery_getCandidates(slot)
    local out = {}
    for key, _ in pairs(main_unitsOfSlot(slot)) do
        if recovery_isEligible(key, slot) then table.insert(out, key) end
    end
    table.sort(out)
    return out
end
-- ============================================================
-- FUNZIONE: recovery_queueTests()
-- Inizio fase: un test "per_riordinare" nel pannello morale per
-- ogni unità di entrambi gli eserciti che può tentare il recupero.
-- ============================================================
function recovery_queueTests()
    for slot = 1, 2 do
        for _, key in ipairs(recovery_getCandidates(slot)) do
            local livello = main_getCohesion(key)
            main_requestMoraleRoll(key, slot, "per_riordinare", nil, "RECUPERO","recovery_onMoraleDone", { key = key, livello = livello })
        end
    end
end
-- ============================================================
-- FUNZIONE: recovery_onResult(key, livello, esito)
-- Esito del test di recupero (callback del pannello morale).
-- Superato -> +1 livello; fallito in ROTTA -> unità rimossa;
-- fallito DISORDINATA -> resta com'è. Un solo tentativo per fase.
-- ============================================================
function recovery_onResult(key, livello, esito)
    IEF_RECOVERY_DONE[key] = true

    if esito == MORALE_RESULT.OK then
        main_raiseCohesion(key)
    elseif livello == COHESION.ROT then
        printToAll(string.format("[RECUPERO] %s fallisce il recupero dalla rotta: rimossa dal tavolo",
            main_decodeExtendedUnitLabel(key)), {r=1,g=0.4,b=0.4})
        main_removeBases(key, main_getUnitBases(key))
    else
        printToAll(string.format("[RECUPERO] %s non si riordina: resta %s",
            main_decodeExtendedUnitLabel(key), livello), {r=1,g=0.6,b=0.4})
    end
end
-- ============================================================
-- FUNZIONE: recovery_onMoraleDone(ctx, esito)
-- onDone del test di recupero (pannello morale).
-- ============================================================
function recovery_onMoraleDone(ctx, esito)
    recovery_onResult(ctx.key, ctx.livello, esito)
end