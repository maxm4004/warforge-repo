-- rulesets/imperifeudi/9_recovery/callbacks.ttslua

-- ============================================================
-- FUNZIONE: recovery_btn_army1(player, value, id, buttonConfig)
-- ============================================================
function recovery_btn_army1(player, value, id, buttonConfig)
    if main_moraleBlocksPhase(player, 1) then return false end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY1)
    return true
end

-- ============================================================
-- FUNZIONE: recovery_btn_army2(player, value, id, buttonConfig)
-- ============================================================
function recovery_btn_army2(player, value, id, buttonConfig)
    if main_moraleBlocksPhase(player, 2) then return false end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY2)
    return true
end
