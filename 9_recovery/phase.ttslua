-- 9_recovery/phase.ttslua
function recovery_phase()
    return {
        RECOVERY = {
            title = "FASE 6: RECUPERO",
            desc  = "I Generali tentano di recuperare i livelli di coesione persi",
            before = "before_recovery",
            after  = "after_recovery",
            allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK, ACTION.CONFIRM },
            render = "2BtnClick",
            enforceOwnership = true,
            inputMode = "INITIATIVE",
            buttons = {
                BTN_ARMY1 = { action="ARMY1_CLICK", label="Recupero Completato", textColor="White", color="Red",   callback="recovery_btn_army1" },
                BTN_ARMY2 = { action="ARMY2_CLICK", label="Recupero Completato", textColor="White", color="Green", callback="recovery_btn_army2" },
            },
            transitions = {
                { to="CHARGE_DECLARE", conditions={ COND.BOTH_PLAYERS_SELECTED } }
            }
        }
    }
end
