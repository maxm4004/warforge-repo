-- ============================================================
-- FUNZIONE: shoot_buttonBaseClick(obj, player_color, alt_click)
-- ============================================================
function shoot_buttonBaseClick(obj, player_color, alt_click)

    local slot = obj.hasTag("Army1") and 1 or (obj.hasTag("Army2") and 2 or nil)
    if not slot then return end

    if shoot_rollPending(slot) then
        warningToColor("C'è un tiro confermato: tira prima i dadi", Player[player_color], "Yellow", 5, true)
        return
    end

    local unitKey = main_getUnitKey(obj)
    if not unitKey then return end

    local basiObjs = {}
    for _, o in ipairs(getAllObjects()) do
        if main_getUnitKey(o) == unitKey then
            table.insert(basiObjs, o)
        end
    end

    if #basiObjs == 0 then return end

    local player = Player[ARMY[slot].color]
    main_cameraToUnitPanel(player, basiObjs, 30, ArmyYaw["ButtonBase"][slot], 15)
    shoot_range_and_target(player, basiObjs)
end
-- ============================================================
-- FUNZIONE: shoot_range_and_target(player, selection)
-- ============================================================
function shoot_range_and_target(player, selection)

    local phase = ENGINE.phases[ENGINE.phase]
    if not phase then print("No phase") return false end
    local selected = selection
        
    if not selected or #selected < 1 then
        printToAll("[TIRO] Seleziona una base", {r=1,g=0.6,b=0})
        return false
    end

    UI.setAttribute("btnAction", "Text", "Fire")
    UI.setAttribute("btnAction", "onClick", "shoot_shootConfirm")
    UI.setAttribute("btnCancelShoot", "onClick", "shoot_shootResetLines")
    UI.setAttribute("btnAction", "textColor", CONFIRMPANEL.actionText)
    UI.setAttribute("btnCancelShoot", "textColor", CONFIRMPANEL.closeText)

    local shooter = selected[1]
    local shooterSlot = nil
    if shooter.hasTag("Army1") then shooterSlot = 1 end
    if shooter.hasTag("Army2") then shooterSlot = 2 end
    if shooterSlot == nil then return false end
    local unitKey = main_getUnitKey(shooter)

    local playerSlot = main_getArmyByColor(player)
    if playerSlot ~= shooterSlot then
        printToColor("[TIRO] Non è la tua unità", player.color, {r=1,g=0.3,b=0.3})
        return false
    end

    local nickname    = shooter.getName()
    local baseInfo    = main_parseNickname(nickname)
    local shooterUnit = baseInfo and main_findUnit(shooterSlot, baseInfo.unitType, baseInfo.unitNumber)

    if not shooterUnit then
        printToColor("[TIRO] Impossibile leggere le informazioni dell'unità", player.color, {r=1,g=0.6,b=0})
        return false
    end

    local weapon = shoot_getWeapon(unitKey)

    if not weapon then
        printToColor("[TIRO] Questa unità non ha armi da tiro", player.color, {r=1,g=0.6,b=0})
        return false
    end

    if not baseInfo then
        printToColor("[TIRO] Impossibile leggere le informazioni della base", player.color, {r=1,g=0.6,b=0})
        return false
    end

    if IEF_FIRED[unitKey] then
        warningToColor("Questa unità ha già effettuato il tiro in questo turno", player, "Yellow", 5, true)
        return false
    end

    local rangeUnits  = weapon.range_inches and (weapon.range_inches * INCH_TO_TTS)
                        or weapon.rangeUnits
                        or (weapon.range and (weapon.range * INCH_TO_TTS))
                        or 20
    local angoloGradi = IEF_SHOOTING.angle
    local pos         = shooter.getPosition()

    -- Tutte le basi dell'unità selezionate (tutti i ranghi)
    local basiObjs = {}
    for _, obj in ipairs(selected) do
        if obj.hasTag and obj.hasTag(shooterSlot == 1 and "Army1" or "Army2") then
            table.insert(basiObjs, obj)
        end
    end

    if #basiObjs == 0 then
        printToColor("[TIRO] Nessuna base valida selezionata", player.color, {r=1,g=0.3,b=0.3})
        return false
    end

    local unitType   = shooterUnit and shooterUnit.tipo or "FP"

    -- Regolamento: "fanno eccezione le CL armate di arco che hanno
    -- un angolo di tiro di 360° gradi"
    local tutto360 = (unitType == "CL" and weapon._arma_key == "ARCO")
    if tutto360 then angoloGradi = 360 end
    local unitTypesDict = IEF_DATA.unitTypes and (IEF_DATA.unitTypes.unit_types or IEF_DATA.unitTypes)
    local utData = unitTypesDict and unitTypesDict[unitType] or {}

    -- Basi tiratrici: primo e secondo rango (regolamento Fase 4)
    local basiFronte = shoot_basiTiratrici(basiObjs, unitType)

    local halfWidth  = ((utData.base_width_cm or 4) / 2) * CM_TO_TTS
    local halfDepth  = ((tonumber(utData.base_depth_cm) or 3) / 2) * CM_TO_TTS
    local y = 1.30

    -- Cono disegnato con la STESSA geometria usata per cercare il
    -- bersaglio (shoot_coneOf sui rettangoli delle basi tiratrici):
    -- linea del fronte = vertice più avanzato, lati dagli angoli
    -- esterni. Vale per qualsiasi formazione (linea, colonna, ecc.).
    local mieRect = {}
    for _, b in ipairs(basiFronte) do
        table.insert(mieRect, main_baseRectOfType(b, unitType))
    end
    local cono = shoot_coneOf(mieRect, angoloGradi)
    -- Coordinate MONDO: il cono si disegna sulle linee globali
    -- (main_aggiornaLinee), non sulla base, così non dipende da
    -- posizione/rotazione/scala dell'oggetto su cui era agganciato.
    local function puntoCono(sv, tv)
        return { cono.fx * sv + cono.rx * tv, y, cono.fz * sv + cono.rz * tv }
    end

    local angolo   = math.rad(math.min(angoloGradi, 89))
    local segmenti = 30
    local cosA, sinA = math.cos(angolo), math.sin(angolo)

    local puntiSinistro, puntiDestro, puntiArco = {}, {}, {}
    for i = 0, segmenti do
        local k = (i / segmenti) * rangeUnits
        table.insert(puntiSinistro, puntoCono(cono.s0 + k * cosA, cono.tL - k * sinA))
        table.insert(puntiDestro,   puntoCono(cono.s0 + k * cosA, cono.tR + k * sinA))
    end
    -- Limite di gittata = tutti i punti a distanza rangeUnits dal
    -- fronte: arco attorno all'angolo sinistro (da -angolo a 0),
    -- segmento dritto davanti al fronte, arco attorno all'angolo
    -- destro (da 0 a +angolo). È la stessa misura bordo-bordo usata
    -- per il bersaglio (main_rectsDistance).
    local meta = math.floor(segmenti / 2)
    for i = 0, meta do
        local ang = -angolo + angolo * (i / meta)
        table.insert(puntiArco, puntoCono(cono.s0 + rangeUnits * math.cos(ang), cono.tL + rangeUnits * math.sin(ang)))
    end
    for i = 0, meta do
        local ang = angolo * (i / meta)
        table.insert(puntiArco, puntoCono(cono.s0 + rangeUnits * math.cos(ang), cono.tR + rangeUnits * math.sin(ang)))
    end

    local nemici = shoot_getNemici(shooter, shooterSlot)

    -- target = una base nemica "rappresentativa" della UNITA' bersaglio scelta
    local target, _ = shoot_trovaBersaglio(basiFronte, nemici, rangeUnits, angoloGradi)

    local conoLines = {
        {points = puntiSinistro, color = {1, 0.8, 0.1}, thickness = 0.1},
        {points = puntiDestro,   color = {1, 0.8, 0.1}, thickness = 0.1},
        {points = puntiArco,     color = {1, 0.8, 0.1}, thickness = 0.1},
    }
    if tutto360 then
        -- Cerchio di gittata attorno all'unità
        local cx, cz, rMax = 0, 0, 0
        for _, b in ipairs(basiFronte) do
            local p = b.getPosition()
            cx, cz = cx + p.x, cz + p.z
        end
        cx, cz = cx / #basiFronte, cz / #basiFronte
        for _, b in ipairs(basiFronte) do
            local p = b.getPosition()
            local d = math.sqrt((p.x - cx)^2 + (p.z - cz)^2) + math.max(halfWidth, halfDepth)
            if d > rMax then rMax = d end
        end
        local cerchio = {}
        for i = 0, 48 do
            local a = 2 * math.pi * i / 48
            table.insert(cerchio, { cx + math.cos(a) * (rMax + rangeUnits), y, cz + math.sin(a) * (rMax + rangeUnits) })
        end
        conoLines = { {points = cerchio, color = {1, 0.8, 0.1}, thickness = 0.1} }
    end

    if target then

        -- Risolve TUTTE le basi dell'unita' bersaglio (non solo "target")
        local targetInfo  = main_parseNickname(target.getName())
        local targetSlot  = shooterSlot == 1 and 2 or 1
        local targetUnit  = targetInfo and main_findUnit(targetSlot, targetInfo.unitType, targetInfo.unitNumber)

        local basiNemiche = {}
        if targetUnit and targetUnit.basi then
            for _, b in ipairs(targetUnit.basi) do
                local o = getObjectFromGUID(b.guid)
                if o then table.insert(basiNemiche, o) end
            end
        end
        if #basiNemiche == 0 then
            table.insert(basiNemiche, target)  -- fallback di sicurezza
        end

        local basiPronte, pronte, raggiunte, motivi = shoot_basiPronte(basiFronte, basiNemiche, rangeUnits, angoloGradi)
        for _, b in ipairs(pronte) do b.highlightOn({1, 0.549, 0}) end
        for _, b in ipairs(raggiunte) do b.highlightOn({0.2, 0.6, 1}) end

        IEF_SHOOT_STATE.shooter      = shooter
        IEF_SHOOT_STATE.target       = target
        IEF_SHOOT_STATE.shooterUnit  = shooterUnit
        IEF_SHOOT_STATE.shooterSlot  = shooterSlot
        IEF_SHOOT_STATE.basiObjs     = basiFronte
        IEF_SHOOT_STATE.rangeUnits   = rangeUnits
        IEF_SHOOT_STATE.targetUnit   = targetUnit
        IEF_SHOOT_STATE.targetSlot   = targetSlot
        IEF_SHOOT_STATE.basiNemiche  = basiNemiche
        IEF_SHOOT_STATE.angoloGradi  = angoloGradi

        -- Distanza mostrata = la stessa usata per trovare il
        -- bersaglio: minima bordo-bordo fra basi tiratrici e unità
        -- bersaglio (non fra la base cliccata e una base qualsiasi).
        -- Solo la parte delle basi nemiche dentro il cono.
        local distInch = math.huge
        for _, n in ipairs(basiNemiche) do
            local info = main_parseNickname(n.getName())
            local d = shoot_distInCone(cono, mieRect, main_baseRectOfType(n, info and info.unitType))
            if d < distInch then distInch = d end
        end
        distInch = distInch / INCH_TO_TTS
        local rangeInch = rangeUnits / INCH_TO_TTS

        shoot_infoShow(player, {
            shooterKey  = unitKey,
            targetKey   = main_getUnitKey(target),
            weapon      = weapon,
            rangeInch   = rangeInch,
            distInch    = distInch,
            basiPronte  = basiPronte,
            basiFronte  = #basiFronte,
            oltreRango  = #basiObjs - #basiFronte,
            motivi      = motivi,
            basiNemiche = basiNemiche,
        })

        UI.setAttribute("confirm_panel_shoot", "active", "true")
        UI.setAttribute("confirm_panel_shoot", "visibility", player.color)

        if phase.title == PHASE.SHOOT then
            UI.setAttribute("btnActionShoot", "active", "true") 
      else
      end
        
     else
        -- Nessun nemico in gittata: niente popup di conferma, solo
        -- l'avviso. Pulisce un eventuale bersaglio precedente, mostra
        -- il cono per qualche secondo e poi lo toglie.
        shoot_ResetLines(player)
        shoot_Reset()
        warningToColor(string.format("Nessun bersaglio entro gittata di %.0f\"", rangeUnits / INCH_TO_TTS), player, "Yellow", 5, true)

        IEF_SHOOTING.activeLines = conoLines
        IEF_SHOOTING.activeShooter = shooter
        callHandler("aggiornaLinee")

        Wait.time(function()
            if IEF_SHOOTING.activeShooter == shooter and not IEF_SHOOT_STATE.target then
                IEF_SHOOTING.activeLines = nil
                IEF_SHOOTING.activeShooter = nil
                callHandler("aggiornaLinee")
            end
        end, 5)
        return false
    end

    IEF_SHOOTING.activeLines = conoLines
    IEF_SHOOTING.conoLines = conoLines
    IEF_SHOOTING.activeShooter = shooter
    callHandler("aggiornaLinee")

    return true
end
-- ============================================================
-- FUNZIONE: shoot_getWeapon(unitKey)
-- Data una unitKey, legge le armi dell'unità (da GMNotes, via
-- main_getUnitMeta — stesso path usato da charge_stopfireDoRoll)
-- e restituisce la prima arma da tiro valida trovata nei dati
-- regolamento (range_inches > 0). Ritorna nil se l'unità non ha
-- basi sul tavolo, non ha armi, o nessuna è da tiro.
-- ============================================================
function shoot_getWeapon(unitKey)
    if not unitKey then return nil end

    local bases = main_getUnitBases(unitKey)
    if #bases == 0 then return nil end

    local meta = main_getUnitMeta(bases[1])
    local armi = meta and meta.armi
    if not armi or #armi == 0 then return nil end

    local weaponsDict = IEF_DATA.weapons and (IEF_DATA.weapons.weapons or IEF_DATA.weapons)
    if not weaponsDict then return nil end

    for _, arma in ipairs(armi) do
        local w = weaponsDict[arma]
        if w and w.range_inches and w.range_inches > 0 then
            w._arma_key = arma
            return w
        end
    end

    return nil
end
-- ============================================================
-- FUNZIONE: shoot_coneOf(rects, angoloGradi)
-- Cono di tiro dell'unità (regolamento: "angolo di tiro di
-- massimo 45° dall'angolo della base più esterna"): parte dalla
-- linea del fronte, fra gli angoli esterni sinistro e destro, e
-- si allarga di angoloGradi per lato. rects = basi tiratrici
-- (main_baseRectOfType).
-- ============================================================
function shoot_coneOf(rects, angoloGradi)
    local r0 = rects[1]
    local c = { fx = r0.fx, fz = r0.fz, rx = r0.rx, rz = r0.rz,
                s0 = -math.huge, tL = math.huge, tR = -math.huge,
                tan = math.tan(math.rad(math.min(angoloGradi or 45, 89))),
                tutto = (angoloGradi or 45) >= 180 }
    for _, r in ipairs(rects) do
        for _, k in ipairs(r.corners) do
            local s = k.x * c.fx + k.z * c.fz
            local t = k.x * c.rx + k.z * c.rz
            if s > c.s0 then c.s0 = s end
            if t < c.tL then c.tL = t end
            if t > c.tR then c.tR = t end
        end
    end
    return c
end
-- ============================================================
-- FUNZIONE: shoot_pointInCone(c, x, z)
-- ============================================================
function shoot_pointInCone(c, x, z)
    if c.tutto then return true end
    local s = x * c.fx + z * c.fz - c.s0
    if s < -0.001 then return false end
    if s < 0 then s = 0 end
    local t = x * c.rx + z * c.rz
    return t >= c.tL - s * c.tan and t <= c.tR + s * c.tan
end
-- ============================================================
-- FUNZIONE: shoot_rectInCone(c, rect)
-- Vero se almeno un angolo (o il centro) della base è nel cono.
-- ============================================================
function shoot_rectInCone(c, rect)
    if shoot_pointInCone(c, rect.x, rect.z) then return true end
    for _, k in ipairs(rect.corners) do
        if shoot_pointInCone(c, k.x, k.z) then return true end
    end
    return false
end
-- ============================================================
-- FUNZIONE: shoot_clipRectToCone(c, rect)
-- Parte della base nemica DENTRO il cono (poligono convesso,
-- lista di {x, z}); vuota se la base è fuori. Ritaglio della
-- base con i 3 semipiani del cono: davanti al fronte e dentro i
-- due lati a angoloGradi.
-- ============================================================
function shoot_clipRectToCone(c, rect)
    local k = rect.corners   -- (-w,-d) (-w,+d) (+w,-d) (+w,+d)
    local poly = { { x = k[1].x, z = k[1].z }, { x = k[2].x, z = k[2].z },
                   { x = k[4].x, z = k[4].z }, { x = k[3].x, z = k[3].z } }
    if c.tutto then return poly end

    local function sOf(p) return p.x * c.fx + p.z * c.fz - c.s0 end
    local function tOf(p) return p.x * c.rx + p.z * c.rz end
    local piani = {
        function(p) return sOf(p) end,
        function(p) return tOf(p) - c.tL + sOf(p) * c.tan end,
        function(p) return c.tR - tOf(p) + sOf(p) * c.tan end,
    }
    for _, h in ipairs(piani) do
        local out = {}
        local n = #poly
        for i = 1, n do
            local a, b = poly[i], poly[(i % n) + 1]
            local ha, hb = h(a), h(b)
            if ha >= 0 then table.insert(out, a) end
            if (ha >= 0) ~= (hb >= 0) then
                local u = ha / (ha - hb)
                table.insert(out, { x = a.x + (b.x - a.x) * u, z = a.z + (b.z - a.z) * u })
            end
        end
        poly = out
        if #poly == 0 then return poly end
    end
    return poly
end
-- ============================================================
-- FUNZIONE: shoot_distRectToPoly(rect, poly)
-- Distanza minima (unità TTS) fra una base (rettangolo) e un
-- poligono convesso: il minimo cade su un vertice dell'uno o
-- sul bordo dell'altro.
-- ============================================================
function shoot_distRectToPoly(rect, poly)
    if #poly == 0 then return math.huge end
    local m = math.huge
    for _, v in ipairs(poly) do
        local d = main_pointRectDistance(v.x, v.z, rect)
        if d < m then m = d end
    end
    local function segDist(px, pz, a, b)
        local dx, dz = b.x - a.x, b.z - a.z
        local l2 = dx * dx + dz * dz
        local u = (l2 > 0) and (((px - a.x) * dx + (pz - a.z) * dz) / l2) or 0
        if u < 0 then u = 0 elseif u > 1 then u = 1 end
        local qx, qz = a.x + dx * u - px, a.z + dz * u - pz
        return math.sqrt(qx * qx + qz * qz)
    end
    for _, k in ipairs(rect.corners) do
        for i = 1, #poly do
            local d = segDist(k.x, k.z, poly[i], poly[(i % #poly) + 1])
            if d < m then m = d end
        end
    end
    return m
end
-- ============================================================
-- FUNZIONE: shoot_distInCone(c, mieRect, rect)
-- Distanza minima fra le basi tiratrici e la sola parte della
-- base nemica dentro il cono (math.huge se è tutta fuori). La
-- gittata si misura così: un angolo della base fuori dal cono
-- non conta.
-- ============================================================
function shoot_distInCone(c, mieRect, rect)
    local poly = shoot_clipRectToCone(c, rect)
    local m = math.huge
    for _, mr in ipairs(mieRect) do
        local d = shoot_distRectToPoly(mr, poly)
        if d < m then m = d end
    end
    return m, poly
end
-- ============================================================
-- LINEA DI VISTA (geometrica, rettangoli dichiarati)
-- Regolamento: tirano le basi "che abbiano la linea di vista
-- libera verso l'unità bersaglio". La vista è bloccata da
-- qualsiasi base di un'altra unità (amica o nemica, Generali
-- esclusi) che il segmento attraversa. Le basi della stessa
-- unità tiratrice non bloccano (il 2° rango tira sopra il 1°).
-- ============================================================
function shoot_ostacoli()
    local out = {}
    for _, o in ipairs(getAllObjects()) do
        if o.hasTag("Army1") or o.hasTag("Army2") then
            local info = main_parseNickname(o.getName())
            if info and info.unitType ~= "GEN" then
                local key = main_getUnitKey(o)
                if key and not main_isGeneralKey(key) then
                    local r = main_baseRectOfType(o, info.unitType)
                    r.key = key
                    table.insert(out, r)
                end
            end
        end
    end
    return out
end

-- Segmento A-B attraversa il rettangolo r (ristretto di un
-- margine, così le basi solo a contatto non bloccano)?
function shoot_segInRect(ax, az, bx, bz, r)
    local MARGINE = 0.02
    local hw, hd = r.hw - MARGINE, r.hd - MARGINE
    if hw <= 0 or hd <= 0 then return false end
    local function loc(x, z)
        local dx, dz = x - r.x, z - r.z
        return dx * r.rx + dz * r.rz, dx * r.fx + dz * r.fz
    end
    local u0, v0 = loc(ax, az)
    local u1, v1 = loc(bx, bz)
    local du, dv = u1 - u0, v1 - v0
    local t0, t1 = 0, 1
    local function taglia(p, q)
        if p == 0 then return q >= 0 end
        local t = q / p
        if p < 0 then
            if t > t1 then return false end
            if t > t0 then t0 = t end
        else
            if t < t0 then return false end
            if t < t1 then t1 = t end
        end
        return true
    end
    return taglia(-du, u0 + hw) and taglia(du, hw - u0)
       and taglia(-dv, v0 + hd) and taglia(dv, hd - v0)
       and t0 <= t1
end

-- Vista libera da una base tiratrice (rettangolo) alla parte di
-- base nemica nel cono (poligono): basta una linea libera fra un
-- punto del fronte della tiratrice e un punto del poligono.
function shoot_losLibera(mioRect, poly, ostacoli, escludi)
    if not poly or #poly == 0 then return false end
    local k = mioRect.corners   -- (-w,-d) (-w,+d) (+w,-d) (+w,+d): fronte = 2 e 4
    local fl, fr = k[2], k[4]
    local da = {
        { x = fl.x * 0.9 + fr.x * 0.1, z = fl.z * 0.9 + fr.z * 0.1 },
        { x = (fl.x + fr.x) / 2,       z = (fl.z + fr.z) / 2 },
        { x = fl.x * 0.1 + fr.x * 0.9, z = fl.z * 0.1 + fr.z * 0.9 },
    }
    local cx, cz = 0, 0
    for _, v in ipairs(poly) do cx, cz = cx + v.x, cz + v.z end
    local a = { { x = cx / #poly, z = cz / #poly } }
    for _, v in ipairs(poly) do table.insert(a, v) end

    for _, p in ipairs(da) do
        for _, q in ipairs(a) do
            local bloccata = false
            for _, r in ipairs(ostacoli) do
                if not escludi[r.key] and shoot_segInRect(p.x, p.z, q.x, q.z, r) then
                    bloccata = true
                    break
                end
            end
            if not bloccata then return true end
        end
    end
    return false
end
-- ============================================================
-- CORRIDOIO DI TIRO (risposta dell'autore, 26/10): "una base per
-- essere pronta al tiro ci deve essere un corridoio libero di
-- 4 cm; se c'è qualcosa in mezzo l'unità non può tirare".
-- Il corridoio è largo quanto il fronte della base (4 cm): è il
-- fronte della base fatto scorrere in linea retta fino a un punto
-- della parte di base nemica dentro il cono. La base è pronta se
-- almeno un corridoio è libero da basi di altre unità (le basi
-- della stessa unità tiratrice non bloccano: il 2° rango tira
-- sopra il 1°; la base bersaglio non blocca).
-- Punti provati sul bersaglio: centro, vertici e metà dei lati
-- della parte nel cono.
-- ============================================================

-- Proiezione di un poligono su un asse
local function proietta(poly, ax, az)
    local mn, mx = math.huge, -math.huge
    for _, v in ipairs(poly) do
        local d = v.x * ax + v.z * az
        if d < mn then mn = d end
        if d > mx then mx = d end
    end
    return mn, mx
end

-- Due poligoni convessi si sovrappongono (assi separatori)?
function shoot_polyOverlap(a, b)
    for _, poly in ipairs({ a, b }) do
        local n = #poly
        for i = 1, n do
            local p1, p2 = poly[i], poly[(i % n) + 1]
            local ax, az = -(p2.z - p1.z), p2.x - p1.x
            local l = math.sqrt(ax * ax + az * az)
            if l > 1e-9 then
                ax, az = ax / l, az / l
                local a1, a2 = proietta(a, ax, az)
                local b1, b2 = proietta(b, ax, az)
                if a2 <= b1 or b2 <= a1 then return false end
            end
        end
    end
    return true
end

-- Rettangolo ostacolo ristretto di un margine (basi solo a contatto non bloccano)
local function rettangoloRistretto(r)
    local M = 0.02
    local hw, hd = r.hw - M, r.hd - M
    if hw <= 0 or hd <= 0 then return nil end
    local out = {}
    for _, s in ipairs({ { -1, -1 }, { -1, 1 }, { 1, 1 }, { 1, -1 } }) do
        table.insert(out, { x = r.x + r.rx * hw * s[1] + r.fx * hd * s[2], z = r.z + r.rz * hw * s[1] + r.fz * hd * s[2] })
    end
    return out
end

-- Corridoi dalla base (mioRect) verso il poligono bersaglio.
-- Ritorna una lista { punto, poligono, libero, blocca = rect }.
-- Ostacoli preparati una volta per tiro: rettangoli ristretti con
-- riquadro (bbox), solo quelli dentro l'area utile (area = bbox di
-- tiratrici e bersaglio). Toglie quasi tutte le basi del tavolo
-- dai controlli: il click sul tiro resta veloce.
function shoot_preparaOstacoli(ostacoli, escludi, area)
    local out = {}
    for _, r in ipairs(ostacoli) do
        if not escludi[r.key] then
            local rr = rettangoloRistretto(r)
            if rr then
                local x1, x2, z1, z2 = math.huge, -math.huge, math.huge, -math.huge
                for _, v in ipairs(rr) do
                    if v.x < x1 then x1 = v.x end
                    if v.x > x2 then x2 = v.x end
                    if v.z < z1 then z1 = v.z end
                    if v.z > z2 then z2 = v.z end
                end
                if not area or not (x2 < area.x1 or x1 > area.x2 or z2 < area.z1 or z1 > area.z2) then
                    table.insert(out, { r = r, poly = rr, x1 = x1, x2 = x2, z1 = z1, z2 = z2 })
                end
            end
        end
    end
    return out
end

-- Riquadro che contiene rettangoli (corners) e poligoni
function shoot_area(rects, polys)
    local a = { x1 = math.huge, x2 = -math.huge, z1 = math.huge, z2 = -math.huge }
    local function add(v)
        if v.x < a.x1 then a.x1 = v.x end
        if v.x > a.x2 then a.x2 = v.x end
        if v.z < a.z1 then a.z1 = v.z end
        if v.z > a.z2 then a.z2 = v.z end
    end
    for _, r in ipairs(rects or {}) do for _, c in ipairs(r.corners) do add(c) end end
    for _, p in ipairs(polys or {}) do for _, v in ipairs(p) do add(v) end end
    -- margine: gli angoli dei corridoi sporgono di mezza base oltre i punti
    local m = 3 * CM_TO_TTS
    a.x1, a.x2, a.z1, a.z2 = a.x1 - m, a.x2 + m, a.z1 - m, a.z2 + m
    return a
end

function shoot_corridoi(mioRect, poly, ostacoli, escludi, prep, soloUno)
    local out = {}
    if not poly or #poly == 0 then return out end
    local k = mioRect.corners          -- fronte = 2 e 4
    local fl, fr = k[2], k[4]
    local mx, mz = (fl.x + fr.x) / 2, (fl.z + fr.z) / 2

    local punti = {}
    local cx, cz = 0, 0
    for _, v in ipairs(poly) do cx, cz = cx + v.x, cz + v.z end
    table.insert(punti, { x = cx / #poly, z = cz / #poly })
    for i, v in ipairs(poly) do
        local w = poly[(i % #poly) + 1]
        table.insert(punti, v)
        table.insert(punti, { x = (v.x + w.x) / 2, z = (v.z + w.z) / 2 })
    end

    local ristretti = prep or shoot_preparaOstacoli(ostacoli, escludi, nil)

    for _, q in ipairs(punti) do
        local vx, vz = q.x - mx, q.z - mz
        -- solo in avanti rispetto al fronte della base
        if vx * mioRect.fx + vz * mioRect.fz > 0 then
            local corr = { { x = fl.x, z = fl.z }, { x = fr.x, z = fr.z },
                           { x = fr.x + vx, z = fr.z + vz }, { x = fl.x + vx, z = fl.z + vz } }
            local cx1, cx2, cz1, cz2 = math.huge, -math.huge, math.huge, -math.huge
            for _, v in ipairs(corr) do
                if v.x < cx1 then cx1 = v.x end
                if v.x > cx2 then cx2 = v.x end
                if v.z < cz1 then cz1 = v.z end
                if v.z > cz2 then cz2 = v.z end
            end
            local blocca = nil
            for _, o in ipairs(ristretti) do
                if not (o.x2 < cx1 or o.x1 > cx2 or o.z2 < cz1 or o.z1 > cz2)
                   and shoot_polyOverlap(corr, o.poly) then
                    blocca = o.r; break
                end
            end
            table.insert(out, { punto = q, poligono = corr, libero = (blocca == nil), blocca = blocca })
            if soloUno and blocca == nil then return out end
        end
    end
    return out
end

function shoot_corridoioLibero(mioRect, poly, ostacoli, escludi, prep)
    for _, c in ipairs(shoot_corridoi(mioRect, poly, ostacoli, escludi, prep, true)) do
        if c.libero then return true end
    end
    return false
end

-- ============================================================
-- FUNZIONE: shoot_trovaBersaglio(basiObjs, nemici, rangeUnits, angoloGradi)
-- Regolamento: "si deve sempre tirare al bersaglio più vicino".
-- Candidate = unità nemiche (non Generali, non in mischia) con
-- almeno una base nel cono e in gittata (distanza bordo-bordo
-- dalle basi tiratrici). Si sceglie la più vicina che almeno una
-- base tiratrice vede (LOS). Ritorna la base nemica più vicina
-- vista dell'unità scelta, o nil.
-- ============================================================
function shoot_trovaBersaglio(basiObjs, nemici, rangeUnits, angoloGradi)
    if not basiObjs or #basiObjs == 0 then return nil, nil end
    local info0 = main_parseNickname(basiObjs[1].getName())
    local tipo0 = info0 and info0.unitType

    local mieRect = {}
    for _, b in ipairs(basiObjs) do
        table.insert(mieRect, main_baseRectOfType(b, tipo0))
    end
    local cono = shoot_coneOf(mieRect, angoloGradi)
    local inMischia = main_unitsInMelee()
    local ostacoli = shoot_ostacoli()

    local unita = {}
    for _, nemico in ipairs(nemici) do
        local info = main_parseNickname(nemico.getName())
        if info and info.unitType ~= "GEN" then
            local key = main_getUnitKey(nemico)
            if not main_isGeneralKey(key) and not inMischia[key] then
                local rect = main_baseRectOfType(nemico, info.unitType)
                local dMin, poly = shoot_distInCone(cono, mieRect, rect)
                do
                    if dMin <= rangeUnits then
                        local u = unita[key]
                        if not u then
                            u = { minDist = math.huge, basi = {} }
                            unita[key] = u
                        end
                        u.key = key
                        table.insert(u.basi, { obj = nemico, dist = dMin, poly = poly })
                        if dMin < u.minDist then u.minDist = dMin end
                    end
                end
            end
        end
    end

    local lista = {}
    for _, u in pairs(unita) do table.insert(lista, u) end
    table.sort(lista, function(a, b) return a.minDist < b.minDist end)

    for _, u in ipairs(lista) do
        table.sort(u.basi, function(a, b) return a.dist < b.dist end)
        local escludi = { [main_getUnitKey(basiObjs[1])] = true, [u.key] = true }
        local polys = {}
        for _, bn in ipairs(u.basi) do table.insert(polys, bn.poly) end
        local prep = shoot_preparaOstacoli(ostacoli, escludi, shoot_area(mieRect, polys))
        for _, bn in ipairs(u.basi) do
            for i, _ in ipairs(basiObjs) do
                -- stessa regola delle basi pronte: corridoio libero di 4 cm
                if shoot_corridoioLibero(mieRect[i], bn.poly, ostacoli, escludi, prep) then
                    return bn.obj, nil
                end
            end
        end
    end
    return nil, nil
end
-- ============================================================
-- FUNZIONE: shoot_checkLOS(shooter, fromPos, toPos, targetObj)
-- Raggio dal centro (getBounds, Y affidabile) della base
-- tiratrice al centro della base nemica (targetObj, se passato),
-- lungo al massimo fino al bersaglio (max_distance). Blocca la
-- prima unità amica incontrata (le basi della stessa unità
-- tiratrice e i Generali no: il secondo rango tira sopra il
-- primo); il primo nemico incontrato libera la vista.
-- ============================================================
function shoot_checkLOS(shooter, fromPos, toPos, targetObj)
    local function centroY(obj, pos)
        local bb = obj and obj.getBounds()
        if bb and bb.center then return math.max(pos.y, bb.center.y) end
        return pos.y
    end
    local fromY = centroY(shooter, fromPos)
    local toY   = targetObj and centroY(targetObj, toPos) or (toPos.y + (fromY - fromPos.y))
    local from = Vector(fromPos.x, fromY, fromPos.z)
    local to   = Vector(toPos.x,   toY,   toPos.z)
    local dir  = to - from
    if dir:magnitude() < 0.0001 then return true end

    local enemyTag  = shooter.hasTag("Army1") and "Army2" or "Army1"
    local friendTag = shooter.hasTag("Army1") and "Army1" or "Army2"
    local myKey     = main_getUnitKey(shooter)

    local hits = Physics.cast({
        origin    = from,
        direction = dir:normalized(),
        max_distance = dir:magnitude(),
        type      = 1,
    }) or {}

    table.sort(hits, function(a, b) return (a.distance or 0) < (b.distance or 0) end)

    for _, hit in ipairs(hits) do
        local o = hit.hit_object
        if o and o ~= shooter then
            local key = main_getUnitKey(o)
            if o.hasTag(friendTag) then
                if key ~= myKey and not main_isGeneralKey(key) then
                    return false
                end
            elseif o.hasTag(enemyTag) then
                return true
            end
        end
    end
    return true
end
-- ============================================================
-- FUNZIONE: shoot_getNemici(shooter, shooterSlot)
-- ============================================================
function shoot_getNemici(shooter, shooterSlot)
    local nemici   = {}
    local enemyTag = shooterSlot == 1 and "Army2" or "Army1"
    for _, obj in ipairs(getAllObjects()) do
        if obj ~= shooter and obj.hasTag and obj.hasTag(enemyTag) then
            table.insert(nemici, obj)
        end
    end
    return nemici
end
-- ============================================================
-- FUNZIONE: shoot_ResetLines(player, value, id)
-- ============================================================
function shoot_ResetLines(player, value, id, tieniInfo)

    if IEF_SHOOTING.activeShooter then
        IEF_SHOOTING.activeShooter.setVectorLines({})
        IEF_SHOOTING.activeShooter = nil
    end

    IEF_SHOOTING.activeLines = nil
    callHandler("aggiornaLinee")
    -- Alla conferma il pannello info resta: diventa il pannello
    -- del tiro dei dadi (si chiude a fine tiro).
    if not tieniInfo then shoot_infoHide() end

    if IEF_SHOOT_STATE.basiNemiche then
        for _, b in ipairs(IEF_SHOOT_STATE.basiNemiche) do
            b.highlightOff()
        end
    elseif IEF_SHOOT_STATE.target then
        IEF_SHOOT_STATE.target.highlightOff()
    end

    if IEF_SHOOT_STATE.basiObjs then
        for _, b in ipairs(IEF_SHOOT_STATE.basiObjs) do
            b.highlightOff()
        end
    end

    UI.setAttribute("confirm_panel_shoot", "active", "false")
    UI.setAttribute("playerGameMessage", "text", "")
    IEF_WARNING_ACTIVE = false
    callHandler("aggiornaLinee")
end
-- ============================================================
-- FUNZIONE: shoot_shootConfirm(player)
-- ============================================================
function shoot_Confirm(player)

    local state = IEF_SHOOT_STATE
    if not state.shooter or not state.target then
        printToColor("[TIRO] Nessun tiro in attesa", player.color, {r=1,g=0.6,b=0})
        return
    end

    if not state.shooterUnit then
        printToColor("[TIRO] Dati tiratore mancanti", player.color, {r=1,g=0.3,b=0.3})
        return
    end

    if not state.targetUnit then
        printToColor("[TIRO] Dati bersaglio mancanti", player.color, {r=1,g=0.3,b=0.3})
        return
    end

    local slot = state.shooterSlot
    if shoot_rollRec(slot) then
        warningToColor("Completa prima il tiro in corso", player, "Yellow", 5, true)
        return
    end

    local shooterKey = main_getUnitKey(state.shooter)
    local targetKey  = main_getUnitKey(state.target)
    local weapon = shoot_getWeapon(shooterKey)
    local basiPronte = shoot_basiPronte(state.basiObjs, state.basiNemiche, state.rangeUnits, state.angoloGradi)
    local scheda, numDadi, soglia = shoot_diceScheda("TIRO", shooterKey, targetKey, weapon, basiPronte, false)

    local ctx = {
        shooterKey   = shooterKey,
        targetKey    = targetKey,
        targetSlot   = state.targetSlot,
        shooterLabel = state.shooterUnit.tipo .. "_" .. state.shooterUnit.unita_num,
        targetLabel  = state.targetUnit.tipo .. "_" .. state.targetUnit.unita_num,
        dadi         = numDadi,
        soglia       = soglia,
        sogliaTesto  = scheda.sogliaTesto,
        scheda       = scheda,
    }

    IEF_FIRED[shooterKey] = true

    shoot_ResetLines(player, nil, nil, true)
    shoot_Reset()

    if not engine_subOpen("SHOOT_ROLL", slot, ctx, nil) then
        shoot_infoHide()
        return
    end

    if numDadi <= 0 then
        ctx.motivo = "Nessuna base in gittata con LOS"
        shoot_infoStato(ctx.motivo, SHOOTINFO.malus)
        engine_subStep("SHOOT_ROLL", slot, "ESCI")
        return
    end

    engine_diceCameraZoom(player, slot)
    shoot_infoStato(string.format("Premi Roll: tira %dD6", numDadi), SHOOTINFO.gold)
end
-- ============================================================
-- FUNZIONE: shoot_basiTiratrici(basiObjs, tipo)
-- Regolamento Fase 4: tirano le basi del primo e del secondo
-- rango. Rango = distanza dal vertice più avanzato lungo il
-- fronte dell'unità, in profondità di base.
-- ============================================================
function shoot_basiTiratrici(basiObjs, tipo)
    if not basiObjs or #basiObjs == 0 then return {} end
    if not tipo then
        local info = main_parseNickname(basiObjs[1].getName())
        tipo = info and info.unitType
    end
    local ut = main_getUnitType(tipo)
    local rankStep = ((ut and tonumber(ut.base_depth_cm)) or 3) * CM_TO_TTS

    local f = basiObjs[1].getTransformForward()
    local fXZ = Vector(f.x, 0, f.z):normalized()
    local maxProj = -math.huge
    for _, b in ipairs(basiObjs) do
        local p = b.getPosition()
        local proj = p.x * fXZ.x + p.z * fXZ.z
        if proj > maxProj then maxProj = proj end
    end

    local out = {}
    for _, b in ipairs(basiObjs) do
        local p = b.getPosition()
        local offset = maxProj - (p.x * fXZ.x + p.z * fXZ.z)
        if math.floor((offset + rankStep * 0.6) / rankStep) < 2 then
            table.insert(out, b)
        end
    end
    if #out == 0 then out = basiObjs end
    return out
end
-- ============================================================
-- FUNZIONE: shoot_basiPronte(basiObjs, basiNemiche, rangeUnits, angoloGradi)
-- Basi pronte al tiro: del 1° e 2° rango, con almeno una base
-- nemica DENTRO il cono dell'unità, entro gittata (bordo-bordo,
-- come la ricerca del bersaglio) e in LOS. angoloGradi di default
-- IEF_SHOOTING.angle (45°).
-- Ritorna: numero, basi pronte, basi nemiche raggiunte.
-- ============================================================
IEF_SHOOT_GITTATA_UNITA = true   -- marcatore di versione (F13), letto da debug_shootBasi
function shoot_basiPronte(basiObjs, basiNemiche, rangeUnits, angoloGradi)
    if not basiObjs or #basiObjs == 0 then return 0, {}, {} end
    if not basiNemiche or #basiNemiche == 0 then return 0, {}, {} end

    local tiratrici = shoot_basiTiratrici(basiObjs)
    local info0 = main_parseNickname(tiratrici[1].getName())
    local tipo0 = info0 and info0.unitType

    local mieRect = {}
    for i, b in ipairs(tiratrici) do mieRect[i] = main_baseRectOfType(b, tipo0) end
    local cono = shoot_coneOf(mieRect, angoloGradi or IEF_SHOOTING.angle or 45)

    local nemRect = {}
    for _, n in ipairs(basiNemiche) do
        local info = main_parseNickname(n.getName())
        local r = main_baseRectOfType(n, info and info.unitType)
        local poly = shoot_clipRectToCone(cono, r)
        if #poly > 0 then
            r.poly = poly
            table.insert(nemRect, r)
        end
    end

    local ostacoli = shoot_ostacoli()
    local escludi = { [main_getUnitKey(tiratrici[1])] = true }
    if basiNemiche[1] then escludi[main_getUnitKey(basiNemiche[1])] = true end
    if IEF_SHOOT_DEBUG then
        local e = {}
        for k in pairs(escludi) do table.insert(e, tostring(k)) end
        print("[TIRO-DBG] gioco: unita' escluse dagli ostacoli: " .. table.concat(e, ", ") .. " - tiratrici " .. #tiratrici .. ", basi nemiche nel cono " .. #nemRect)
    end

    -- Gittata dell'UNITA' (regolamento: le gittate sono "delle
    -- unità"): una base nemica è in gittata se lo è dalla base
    -- tiratrice più vicina; il 2° rango tira se l'unità è in
    -- gittata, anche se lui da solo sarebbe qualche cm più lontano.
    for _, nr in ipairs(nemRect) do
        local m = math.huge
        for i = 1, #tiratrici do
            local d = shoot_distRectToPoly(mieRect[i], nr.poly)
            if d < m then m = d end
        end
        nr.distUnita = m
    end

    local polys = {}
    for _, nr in ipairs(nemRect) do table.insert(polys, nr.poly) end
    local prep = shoot_preparaOstacoli(ostacoli, escludi, shoot_area(mieRect, polys))

    local pronte, raggiunte, visti = {}, {}, {}
    local fuoriGittata, senzaVista = 0, 0
    for i, b in ipairs(tiratrici) do
        local ok, inGittata = false, false
        for _, nr in ipairs(nemRect) do
            if nr.distUnita <= rangeUnits then
                inGittata = true
                if shoot_corridoioLibero(mieRect[i], nr.poly, ostacoli, escludi, prep) then
                    ok = true
                    if not visti[nr.obj] then
                        visti[nr.obj] = true
                        table.insert(raggiunte, nr.obj)
                    end
                end
            end
        end
        if ok then
            table.insert(pronte, b)
        elseif inGittata then
            senzaVista = senzaVista + 1
            if IEF_SHOOT_DEBUG then
                -- Diagnostica: chi blocca le linee di questa base
                local chi = {}
                local k = mieRect[i].corners
                for _, nr in ipairs(nemRect) do
                    if nr.distUnita <= rangeUnits then
                        for _, q in ipairs(nr.poly) do
                            local mid = { x = (k[2].x + k[4].x) / 2, z = (k[2].z + k[4].z) / 2 }
                            for _, r in ipairs(ostacoli) do
                                if not escludi[r.key] and shoot_segInRect(mid.x, mid.z, q.x, q.z, r) then
                                    chi[(r.obj and r.obj.getName() or "?") .. " [" .. tostring(r.key) .. "]"] = true
                                end
                            end
                        end
                    end
                end
                local nomi = {}
                for n in pairs(chi) do table.insert(nomi, n) end
                print(string.format("[TIRO-DBG] gioco: %s senza vista, bloccata da: %s", b.getName(),
                    (#nomi > 0) and table.concat(nomi, ", ") or "nessuna (linee centrali libere)"))
            end
        else
            fuoriGittata = fuoriGittata + 1
        end
    end
    -- motivi delle basi di 1°/2° rango che non tirano
    return #pronte, pronte, raggiunte, { fuoriGittata = fuoriGittata, senzaVista = senzaVista }
end
-- ============================================================
-- FUNZIONE: shoot_shootCancel()
-- ============================================================
function shoot_Cancel(player)
    if IEF_SHOOT_STATE.target then
        IEF_SHOOT_STATE.target.highlightOff()
    end
    shoot_Reset()
    printToColor("[TIRO] Annullato", player.color, {r=0.7,g=0.7,b=0.7})
end
-- ============================================================
-- FUNZIONE: shoot_shootReset()
-- ============================================================
function shoot_Reset()
    IEF_SHOOT_STATE = {
        shooter=nil, 
        target=nil,
        shooterUnit=nil, 
        targetUnit=nil,
        shooterSlot=nil, 
        targetSlot=nil,
        basiObjs=nil,
        rangeUnits=nil
    }
end
-- ============================================================
-- FUNZIONE: shoot_resolveHits(targetObj, targetSlot, hits)
-- Perdite del tiro MARCATE (rimosse a fine fase, after_shoot) e
-- test di morale della tabella (evento LOSS): IMMEDIATO subito,
-- FINE_FASE in IEF_MORALE_END_QUEUE (dopo tutti i tiri).
-- ============================================================
function shoot_resolveHits(targetObj, targetSlot, hits)
    local unitKey = targetObj and main_getUnitKey(targetObj)
    if not unitKey then
        printToAll("[TIRO] Errore: unitKey bersaglio non trovata", {r=1,g=0.3,b=0.3})
        return
    end

    local perse = main_markLosses(unitKey, hits)
    if perse == 0 then return end

    if not main_isAliveAfterMarks(unitKey) then
        printToAll("[TIRO] " .. main_decodeExtendedUnitLabel(unitKey) .. " distrutta", {r=1,g=0.3,b=0.3})
        return
    end
    if main_getCohesion(unitKey) == COHESION.ROT then return end

    local subito = {}
    for _, item in ipairs(main_lossTests(unitKey, targetSlot)) do
        if item.quando == "FINE_FASE" then
            table.insert(IEF_MORALE_END_QUEUE, item)
        else
            table.insert(subito, item)
        end
    end
    if #subito > 0 then
        main_runMoraleQueue(subito)
    end
end
-- ============================================================
-- FUNZIONE: shoot_rollPending(slot)
-- true se ARMY{slot} ha un tiro confermato da lanciare.
-- ============================================================
function shoot_rollPending(slot)
    local rec = shoot_rollRec(slot)
    return rec ~= nil and rec.step == "TIRO"
end


























-- ============================================================
-- FUNZIONE: shoot_numDiceBreakdown(shooterKey, basiPronte, raffica)
-- Numero di dadi del tiro e voci del calcolo per il pannello
-- dadi: { { "voce", "valore" }, ... }.
-- ============================================================
function shoot_numDiceBreakdown(shooterKey, basiPronte, raffica)
    -- Disordinata: perde le capacità tranne SPADA, quindi niente RAFFICA
    local persaRaffica = raffica and main_getCohesion(shooterKey) == COHESION.DIS
    if persaRaffica then raffica = false end
    local bases = main_getUnitBases(shooterKey)
    local meta = bases[1] and main_getUnitMeta(bases[1])
    local tipo = meta and meta.unitType

    local voci = { { "Basi pronte al tiro", tostring(basiPronte) } }
    local n = basiPronte
    if tipo == "FL" then
        n = math.floor(basiPronte / 2)
        table.insert(voci, { "FL: 1D6 ogni 2 basi", tostring(n) })
    elseif tipo == "ART" then
        n = basiPronte * 2
        table.insert(voci, { "ART: 2D6 per base", tostring(n) })
    end

    -- RAFFICA (solo Tiro d'Arresto): +50% dei dadi, per difetto
    -- (6 dadi -> +3, 5 dadi -> +2)
    if raffica then
        n = n + math.floor(n / 2)
        table.insert(voci, { "RAFFICA: +50% dei dadi", tostring(n) })
    end
    if persaRaffica then
        table.insert(voci, { "Disordinata: niente RAFFICA", tostring(n) })
    end

    if main_isMistaMeta(meta) then
        n = math.floor(n / 2)
        table.insert(voci, { "Unita' mista: meta' dei dadi", tostring(n) })
    end

    if main_getCohesion(shooterKey) == COHESION.DIS then
        n = math.floor(n / 2)
        table.insert(voci, { "Disordinata: meta' dei dadi", tostring(n) })
    end
    return n, voci
end

-- ============================================================
-- FUNZIONE: shoot_numDice(shooterKey, basiPronte, raffica)
-- ============================================================
function shoot_numDice(shooterKey, basiPronte, raffica)
    return (shoot_numDiceBreakdown(shooterKey, basiPronte, raffica))
end

-- ============================================================
-- FUNZIONE: shoot_hitBreakdown(weapon, targetKey)
-- Soglia per colpire: hit_threshold dell'arma meno i
-- modificatori di weapons.json (senza scudo, vs_<tipi>).
-- Ritorna: soglia, voci { { "voce", "+1" }, ... }, sogliaBase
-- ============================================================
function shoot_hitBreakdown(weapon, targetKey)
    local base = weapon.hit_threshold or DEFAULT_HIT_THRESHOLD
    local soglia = base
    local mods = weapon.modifiers or {}
    local nomeArma = weapon.label or weapon._arma_key or "Arma"
    local voci = {}

    local bases = main_getUnitBases(targetKey)
    local meta = bases[1] and main_getUnitMeta(bases[1])
    local tipo = meta and meta.unitType

    local haScudo = false
    for _, a in ipairs(meta and meta.armi or {}) do
        if a == "SCUDO" then haScudo = true end
    end
    if not haScudo and mods.vs_bersaglio_senza_scudo then
        soglia = soglia - mods.vs_bersaglio_senza_scudo
        table.insert(voci, { "Bersaglio senza scudo", string.format("%+d", mods.vs_bersaglio_senza_scudo) })
    end

    -- CHIUNQUE contro unità in copertura: -1 (interamente in terreno DIFFICILE)
    if main_unitInCover(targetKey) then
        local v = mods.vs_unita_in_copertura or -1
        soglia = soglia - v
        table.insert(voci, { "Bersaglio in copertura", string.format("%+d", v) })
    end

    for chiave, valore in pairs(mods) do
        local lista = chiave:match("^vs_(.+)$")
        if lista and lista ~= "bersaglio_senza_scudo" and lista ~= "unita_in_copertura" then
            for t in lista:gmatch("[^_]+") do
                if t == tipo then
                    soglia = soglia - valore
                    table.insert(voci, { string.format("%s contro %s", nomeArma, (lista:gsub("_", ", "))), string.format("%+d", valore) })
                    break
                end
            end
        end
    end
    return soglia, voci, base
end

-- ============================================================
-- FUNZIONE: shoot_hitThreshold(weapon, targetKey)
-- ============================================================
function shoot_hitThreshold(weapon, targetKey)
    return (shoot_hitBreakdown(weapon, targetKey))
end

-- ============================================================
-- FUNZIONE: shoot_sogliaTesto(base, soglia)
-- Regolamento: si colpisce con 4+ DOPO aver applicato i
-- modificatori a ogni dado. Si mostra quindi la soglia di
-- partenza e il modificatore al dado, non la soglia ricalcolata
-- (es. "Serve 4+ con +1 a ogni dado", non "Serve 3+").
-- soglia = base - modificatore (usata per contare i successi).
-- ============================================================
function shoot_sogliaTesto(base, soglia)
    local mod = base - soglia
    local testo
    if mod == 0 then
        testo = string.format("Serve %d+ su ogni dado", base)
    else
        testo = string.format("Serve %d+ con %+d a ogni dado", base, mod)
    end
    if soglia <= 1 then
        testo = testo .. " (ogni dado colpisce)"
    elseif soglia > 6 then
        testo = testo .. " (nessun dado puo' colpire)"
    end
    return testo
end
-- ============================================================
-- FUNZIONE: shoot_diceScheda(titolo, shooterKey, targetKey, weapon, basiPronte, raffica)
-- Scheda del pannello dadi per un tiro (Tiro e Tiro d'Arresto).
-- Ritorna: scheda, numDadi, soglia
-- ============================================================
function shoot_diceScheda(titolo, shooterKey, targetKey, weapon, basiPronte, raffica)
    local numDadi, vociDadi = shoot_numDiceBreakdown(shooterKey, basiPronte, raffica)
    local soglia, vociSoglia, base = DEFAULT_HIT_THRESHOLD, {}, DEFAULT_HIT_THRESHOLD
    if weapon then
        soglia, vociSoglia, base = shoot_hitBreakdown(weapon, targetKey)
    end

    local righe = { { "DADI", "", "sezione" } }
    for _, v in ipairs(vociDadi) do table.insert(righe, v) end
    table.insert(righe, { "Totale dadi", numDadi .. "D6" })
    table.insert(righe, { "PER COLPIRE", "", "sezione" })
    table.insert(righe, { (weapon and (weapon.label or weapon._arma_key) or "Tiro") .. ": serve", base .. "+" })
    if #vociSoglia == 0 then
        table.insert(righe, { "Nessun modificatore", "", DICEPANEL.subColor })
    end
    for _, v in ipairs(vociSoglia) do table.insert(righe, { v[1], v[2] .. " al dado" }) end

    local serve = shoot_sogliaTesto(base, soglia)

    local scheda = {
        titolo      = titolo,
        sottotitolo = string.format("%s contro %s",
            main_decodeExtendedUnitLabel(shooterKey), main_decodeExtendedUnitLabel(targetKey)),
        righe       = righe,
        serve       = serve,
        soglia      = soglia,
        sogliaTesto = serve,
    }
    return scheda, numDadi, soglia
end
-- ============================================================
-- PANNELLO INFO TIRO
-- Visibile al giocatore che tira dal clic sul pulsante base
-- (bersaglio trovato) fino al tiro o a Chiudi. Solo
-- informazioni, nessun pulsante: Tiro/Chiudi restano in
-- confirm_panel_shoot. Stile del pannello dadi.
-- ============================================================
SHOOTINFO = SHOOTINFO or {
    width     = 560,
    colWidth  = 262,
    padding   = 12,
    titleH    = 24,
    noteH     = 16,
    rowH      = 17,
    gap       = 6,
    colRows   = 7,     -- righe per colonna (Tiratore / Bersaglio)
    rows      = 8,     -- righe per colonna della parte bassa (Dadi / Per colpire)
    valWidth  = 80,    -- larghezza della colonna valori (Dadi / Per colpire)
    bg        = "rgba(0,0,0,0.70)",
    gold      = "#FFD833",
    grey      = "#BBBBBB",
    bonus     = "#5BD35B",
    malus     = "#FF6B6B",
    statoH    = 22,
    esitoH    = 26,
    maxFaces  = 16,
    faceSize  = 28,
    faceGap   = 4,
    faceKo    = "rgba(1,1,1,0.3)",
}

-- ============================================================
-- FUNZIONE: shoot_infoPanelXml()
-- XML fisso (buildUI): le righe esistono già, il contenuto si
-- scrive con UI.setAttribute (righe vuote disattivate).
-- ============================================================
function shoot_infoPanelXml()
    local S = SHOOTINFO
    local function testo(id, h, size, color, bold, align)
        return string.format('<Text id="%s" text="" font="warforge_font" fontSize="%d" color="%s" fontStyle="%s" alignment="%s" preferredHeight="%d" active="false"/>',
            id, size, color, bold and "Bold" or "Normal", align or "MiddleLeft", h)
    end
    local function colonna(lato)
        local x = string.format('<VerticalLayout spacing="0" childForceExpandHeight="false" childAlignment="UpperLeft" preferredWidth="%d">', S.colWidth)
        for i = 1, S.colRows do x = x .. testo("shootinfo_" .. lato .. i, S.rowH, 11, "White", false) end
        return x .. '</VerticalLayout>'
    end
    local facce = string.format('<HorizontalLayout id="shootinfo_faces" spacing="%d" childAlignment="MiddleCenter" childForceExpandWidth="false" preferredHeight="%d" active="false">',
        S.faceGap, S.faceSize)
    for i = 1, S.maxFaces do
        facce = facce .. string.format('<Image id="shootinfo_f%d" image="d1" color="White" preserveAspect="true" preferredWidth="%d" preferredHeight="%d" active="false"/>',
            i, S.faceSize, S.faceSize)
    end
    facce = facce .. '</HorizontalLayout>'
    -- Parte bassa su due colonne: DADI (D) a sinistra, PER COLPIRE (C) a destra
    local function colonnaVoci(lato)
        local x = string.format('<VerticalLayout spacing="0" childForceExpandHeight="false" childAlignment="UpperLeft" preferredWidth="%d">', S.colWidth)
        for i = 1, S.rows do
            x = x .. string.format(
                '<HorizontalLayout id="shootinfo_%s%d" preferredHeight="%d" childForceExpandWidth="false" active="false">%s%s</HorizontalLayout>',
                lato, i, S.rowH,
                string.format('<Text id="shootinfo_%s%d_l" text="" font="warforge_font" fontSize="11" color="White" alignment="MiddleLeft" preferredWidth="%d"/>', lato, i, S.colWidth - S.valWidth),
                string.format('<Text id="shootinfo_%s%d_v" text="" font="warforge_font" fontSize="11" color="White" fontStyle="Bold" alignment="MiddleRight" preferredWidth="%d"/>', lato, i, S.valWidth))
        end
        return x .. '</VerticalLayout>'
    end
    local basso = '<HorizontalLayout spacing="12" childForceExpandWidth="false" childAlignment="UpperLeft">' ..
        colonnaVoci("D") .. colonnaVoci("C") .. '</HorizontalLayout>'

    return string.format(
        '<Panel id="shoot_info_panel" rectAlignment="LowerCenter" offsetXY="0 50" width="%d" height="200" color="%s" active="false">' ..
        '<VerticalLayout padding="%d %d %d %d" spacing="2" childForceExpandHeight="false" childAlignment="UpperCenter">' ..
        '%s%s' ..
        '<HorizontalLayout spacing="12" childForceExpandWidth="false" childAlignment="UpperLeft" id="shootinfo_cols">%s%s</HorizontalLayout>' ..
        '%s%s%s%s' ..
        '</VerticalLayout></Panel>',
        S.width, S.bg, S.padding, S.padding, S.padding, S.padding,
        testo("shootinfo_title", S.titleH, 15, S.gold, true, "MiddleCenter"),
        testo("shootinfo_note", S.noteH, 10, S.grey, false, "MiddleCenter"),
        colonna("L"), colonna("R"), basso,
        testo("shootinfo_stato", S.statoH, 13, S.gold, true, "MiddleCenter"),
        facce,
        testo("shootinfo_esito", S.esitoH, 16, "White", true, "MiddleCenter"))
end

-- ============================================================
-- FUNZIONE: shoot_infoHide()
-- ============================================================
function shoot_infoHide()
    UI.setAttribute("shoot_info_panel", "active", "false")
end

-- ============================================================
-- FUNZIONE: shoot_infoShow(player, d)
-- d = { shooterKey, targetKey, weapon, rangeInch, distInch,
--       basiPronte, basiFronte, oltreRango, motivi, basiNemiche }
-- ============================================================
function shoot_infoShow(player, d)
    local S = SHOOTINFO
    local function set(id, testo, colore)
        UI.setAttribute(id, "text", testo or "")
        if colore then UI.setAttribute(id, "color", colore) end
        UI.setAttribute(id, "active", (testo and testo ~= "") and "true" or "false")
    end

    local sBase = main_getUnitBases(d.shooterKey)[1]
    local sMeta = (sBase and main_getUnitMeta(sBase)) or {}
    local tBase = d.basiNemiche[1]
    local tMeta = (tBase and main_getUnitMeta(tBase)) or {}
    local nomeArma = (d.weapon and (d.weapon.label or d.weapon._arma_key)) or "?"

    set("shootinfo_title", string.format("%s %s con %s tira su %s", main_decodeUnitTypeLabel(d.shooterKey), main_decodeArmyCodeLabel(d.shooterKey), nomeArma, main_decodeExtendedUnitLabel(d.targetKey)))
    set("shootinfo_note", "Bersaglio obbligato: il piu' vicino nel cono di tiro")

    -- Colonna TIRATORE
    local L = {
        { "TIRATORE", S.gold },
        { string.format("Arma: %s  -  gittata %.0f\"", nomeArma, d.rangeInch) },
        { string.format("Distanza: %.2f\"", d.distInch) },
        { string.format("Basi pronte: %d/%d", d.basiPronte, d.basiFronte) },
    }
    if d.motivi and d.motivi.senzaVista > 0 then table.insert(L, { string.format("  - %d senza vista", d.motivi.senzaVista), S.grey }) end
    if d.motivi and d.motivi.fuoriGittata > 0 then table.insert(L, { string.format("  - %d fuori gittata", d.motivi.fuoriGittata), S.grey }) end
    if d.oltreRango > 0 then table.insert(L, { string.format("  - %d oltre il 2 rango (non tirano)", d.oltreRango), S.grey }) end

    -- Colonna BERSAGLIO
    local scudo = false
    for _, a in ipairs(tMeta.armi or {}) do if a == "SCUDO" then scudo = true end end
    local ut = main_getUnitType(tMeta.unitType)
    local coes = main_getCohesion(d.targetKey) or COHESION.SAL
    local R = {
        { "BERSAGLIO", S.gold },
        { string.format("Tipo: %s  -  %s", tostring(tMeta.unitType or "?"), tostring(tMeta.morale or "?")) },
        { "Coesione: " .. tostring(coes), (coes == COHESION.SAL) and nil or S.malus },
        { "Scudo: " .. (scudo and "si'" or "no") },
        { string.format("Basi in campo: %d", #d.basiNemiche) },
        { string.format("Figure per base: %s", tostring(ut and ut.figures_per_base or "?")) },
    }
    for i = 1, S.colRows do
        local l, r = L[i], R[i]
        set("shootinfo_L" .. i, l and l[1] or "", l and (l[2] or "White") or nil)
        set("shootinfo_R" .. i, r and r[1] or "", r and (r[2] or "White") or nil)
    end
    local righeCol = math.max(math.min(#L, S.colRows), math.min(#R, S.colRows))

     -- Parte bassa: DADI (colonna D) e PER COLPIRE (colonna C)
    local D = { { "DADI", "", S.gold } }
    local nDadi, vociDadi = shoot_numDiceBreakdown(d.shooterKey, d.basiPronte, false)
    for _, v in ipairs(vociDadi) do table.insert(D, { v[1], v[2] }) end
    table.insert(D, { "Totale dadi", nDadi .. "D6" })

    local B = { { "PER COLPIRE", "", S.gold } }
    local base, voci = DEFAULT_HIT_THRESHOLD, {}
    if d.weapon then
        local _
        _, voci, base = shoot_hitBreakdown(d.weapon, d.targetKey)
    end
    table.insert(B, { nomeArma .. ": serve", base .. "+" })
    if #voci == 0 then
        table.insert(B, { "Nessun modificatore", "", S.grey })
    end
    for _, v in ipairs(voci) do
        local malus = tostring(v[2]):sub(1, 1) == "-"
        table.insert(B, { v[1], v[2] .. " al dado", malus and S.malus or S.bonus })
    end

    local function scriviColonna(lato, lista)
        for i = 1, S.rows do
            local b = lista[i]
            local id = "shootinfo_" .. lato .. i
            if b then
                UI.setAttribute(id, "active", "true")
                UI.setAttribute(id .. "_l", "text", b[1])
                UI.setAttribute(id .. "_l", "color", (b[3] and b[2] == "") and b[3] or "White")
                UI.setAttribute(id .. "_v", "text", b[2] or "")
                UI.setAttribute(id .. "_v", "color", b[3] or "White")
            else
                UI.setAttribute(id, "active", "false")
            end
        end
    end
    scriviColonna("D", D)
    scriviColonna("C", B)
    local righeB = math.max(math.min(#D, S.rows), math.min(#B, S.rows))

    -- Parte del tiro (stato, facce, esito) spenta finché non si tira
    UI.setAttribute("shootinfo_stato", "active", "false")
    UI.setAttribute("shootinfo_faces", "active", "false")
    UI.setAttribute("shootinfo_esito", "active", "false")

    S.hBase = 2 * S.padding + S.titleH + S.noteH + righeCol * S.rowH + righeB * S.rowH + 2 * 5 + 8
    UI.setAttribute("shoot_info_panel", "height", tostring(S.hBase))
    UI.setAttribute("shoot_info_panel", "visibility", player.color)
    UI.setAttribute("shoot_info_panel", "active", "true")
end

-- ============================================================
-- FUNZIONE: shoot_infoAltezza(stato, facce, esito)
-- Altezza del pannello con le parti del tiro accese.
-- ============================================================
function shoot_infoAltezza(stato, facce, esito)
    local S = SHOOTINFO
    local h = (S.hBase or 200)
    if stato then h = h + S.statoH + 2 end
    if facce then h = h + S.faceSize + 6 end
    if esito then h = h + S.esitoH + 2 end
    UI.setAttribute("shoot_info_panel", "height", tostring(h))
end

-- ============================================================
-- FUNZIONE: shoot_infoStato(testo, colore)
-- Dopo la conferma: riga di stato del tiro (es. "Premi Roll").
-- Il pannello diventa visibile a entrambi i giocatori, come il
-- pannello dadi che sostituisce.
-- ============================================================
function shoot_infoStato(testo, colore)
    UI.setAttribute("shootinfo_stato", "text", testo or "")
    UI.setAttribute("shootinfo_stato", "color", colore or SHOOTINFO.gold)
    UI.setAttribute("shootinfo_stato", "active", "true")
    UI.setAttribute("shoot_info_panel", "visibility", "")
    shoot_infoAltezza(true, false, false)
end

-- ============================================================
-- FUNZIONE: shoot_infoRisultati(risultati, soglia, colpi)
-- Facce uscite (verde = a segno, sbiadita = mancato) ed esito.
-- soglia = valore minimo del dado già corretto dai modificatori.
-- ============================================================
function shoot_infoRisultati(risultati, soglia, colpi)
    local S = SHOOTINFO
    UI.setAttribute("shootinfo_stato", "active", "false")
    for i = 1, S.maxFaces do
        local v = risultati and risultati[i]
        local id = "shootinfo_f" .. i
        if v then
            UI.setAttribute(id, "image", "d" .. v)
            UI.setAttribute(id, "color", (v >= soglia) and S.bonus or S.faceKo)
            UI.setAttribute(id, "active", "true")
        else
            UI.setAttribute(id, "active", "false")
        end
    end
    UI.setAttribute("shootinfo_faces", "active", "true")
    UI.setAttribute("shootinfo_esito", "text",
        (colpi == 1) and "1 COLPO A SEGNO" or string.format("%d COLPI A SEGNO", colpi or 0))
    UI.setAttribute("shootinfo_esito", "color", ((colpi or 0) > 0) and S.bonus or S.malus)
    UI.setAttribute("shootinfo_esito", "active", "true")
    shoot_infoAltezza(false, true, true)
end
