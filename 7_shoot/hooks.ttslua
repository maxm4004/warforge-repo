-- ============================================================
-- FUNZIONE: before_shoot()
-- ============================================================
function before_shoot(phaseName, phase)
    if TURN.phase ~= phaseName then main_resetTurnForPhase() end
    TURN.phase = phaseName

    UI.setAttribute("morale_queue_list_army1", "active", "true")
    UI.setAttribute("morale_queue_list_army2", "active", "true")

    IEF_MORALE_ROLL_PENDING[1] = {}
    IEF_MORALE_ROLL_PENDING[2] = {}

    IEF_MORALE_END_QUEUE = {}

    TURN.completed = { Army1 = false, Army2 = false }
end
-- ============================================================
-- FUNZIONE: after_shoot()
-- Fine fase: rimozione delle basi perse marcate durante i tiri.
-- ============================================================
function after_shoot(phaseName, phase)
    main_removeMarkedLosses()
end