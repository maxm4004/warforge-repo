-- ============================================================
-- FUNZIONE: charge_declare_btn_army1(player, value, id, buttonConfig)
-- Conferma "Dichiarazioni Completate" per Army1.
-- ============================================================
function charge_declare_btn_army1(player, value, id, buttonConfig)

    if main_moraleBlocksPhase(player, 1) then return false end
    local violazioni = charge_checkMandatoryObligations(1)
    if #violazioni > 0 then
        printToColor("[CARICA] Obbligo di carica non rispettato per: " .. table.concat(violazioni, ", "), player.color, {r=1,g=0.3,b=0.3})
        return false
    end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY1)
    return true
end
-- stessa cosa per charge_declare_btn_army2 con slot=2

-- ============================================================
-- FUNZIONE: charge_declare_btn_army2(player, value, id, buttonConfig)
-- ============================================================
function charge_declare_btn_army2(player, value, id, buttonConfig)

    if main_moraleBlocksPhase(player, 2) then return false end
    local violazioni = charge_checkMandatoryObligations(2)
    if #violazioni > 0 then
        printToColor("[CARICA] Obbligo di carica non rispettato per: " .. table.concat(violazioni, ", "), player.color, {r=1,g=0.3,b=0.3})
        return false
    end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY2)
    return true
end
-- ============================================================
-- FUNZIONE: charge_react_btn_army1(player, value, id, buttonConfig)
-- ============================================================
function charge_react_btn_army1(player, value, id, buttonConfig)

    if main_moraleBlocksPhase(player, 1) then return false end

    if charge_reactQueueHasPending() then
        warningToColor("Ci sono ancora reazioni da scegliere", player, "Yellow", 5)
        return false
    end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY1)
    return true
end

-- ============================================================
-- FUNZIONE: charge_react_btn_army2(player, value, id, buttonConfig)
-- ============================================================
function charge_react_btn_army2(player, value, id, buttonConfig)

    if main_moraleBlocksPhase(player, 2) then return false end

    if charge_reactQueueHasPending() then
        warningToColor("Ci sono ancora reazioni da scegliere", player, "Yellow", 5)
        return false
    end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY2)
    return true
end
-- ============================================================
-- FUNZIONE: charge_auto_btn_army1(player, value, id, buttonConfig)
-- ============================================================
function charge_auto_btn_army1(player, value, id, buttonConfig)

    if main_moraleBlocksPhase(player, 1) then print("morale"); return false end
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_slotStillNeedsAction(e, 1) then
            warningToColor("Ci sono ancora cariche da risolvere per il tuo esercito", player, "Yellow", 5)
            return false
        end
    end
    if #IEF_MORALE_END_QUEUE > 0 then
        local coda = IEF_MORALE_END_QUEUE
        IEF_MORALE_END_QUEUE = {}
        main_runMoraleQueue(coda, nil, true)
        warningToColor("Test di morale di fine fase: tirali dal pannello, poi chiudi la fase", player, "Yellow", 5)
        return false
    end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY1)
    return true
end
-- ============================================================
-- FUNZIONE: charge_auto_btn_army2(player, value, id, buttonConfig)
-- ============================================================
function charge_auto_btn_army2(player, value, id, buttonConfig)

    if main_moraleBlocksPhase(player, 2) then  return false end

    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_slotStillNeedsAction(e, 2) then
            warningToColor("Ci sono ancora cariche da risolvere per il tuo esercito", player, "Yellow", 5)
            return false
        end
    end
    if #IEF_MORALE_END_QUEUE > 0 then
        local coda = IEF_MORALE_END_QUEUE
        IEF_MORALE_END_QUEUE = {}
        main_runMoraleQueue(coda, nil, true)
        warningToColor("Test di morale di fine fase: tirali dal pannello, poi chiudi la fase", player, "Yellow", 5)
        return false
    end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY2)
    return true
end



