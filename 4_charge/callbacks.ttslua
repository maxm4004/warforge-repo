-- ============================================================
-- FUNZIONE: charge_declare_btn_army1(player, value, id, buttonConfig)
-- Conferma "Dichiarazioni Completate" per Army1.
-- ============================================================
function charge_declare_btn_army1(player, value, id, buttonConfig)
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY1)
    return true
end

-- ============================================================
-- FUNZIONE: charge_declare_btn_army2(player, value, id, buttonConfig)
-- Conferma "Dichiarazioni Completate" per Army2.
-- ============================================================
function charge_declare_btn_army2(player, value, id, buttonConfig)
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY2)
    return true
end

-- ============================================================
-- FUNZIONE: charge_react_btn_army1(player, value, id, buttonConfig)
-- "Reazioni Completate" per Army1 — blocca se ci sono ancora
-- righe Difesa senza risposta o un Tiro d'Arresto in corso.
-- ============================================================
function charge_react_btn_army1(player, value, id, buttonConfig)
    if charge_reactQueueHasPending() then
        printToColor("[CARICA] Ci sono ancora reazioni da scegliere", player.color, {r=1,g=0.6,b=0})
        return false
    end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY1)
    return true
end

-- ============================================================
-- FUNZIONE: charge_react_btn_army2(player, value, id, buttonConfig)
-- ============================================================
function charge_react_btn_army2(player, value, id, buttonConfig)
    if charge_reactQueueHasPending() then
        printToColor("[CARICA] Ci sono ancora reazioni da scegliere", player.color, {r=1,g=0.6,b=0})
        return false
    end
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY2)
    return true
end

-- ============================================================
-- FUNZIONE: charge_stopfire_btn_noop(player, value, id, buttonConfig)
-- ============================================================
function charge_stopfire_btn_noop(player, value, id, buttonConfig)
    print("charge_stopfire_btn_noop")
    print(player," ", value," ", id)

    local slot = main_SlotByColor(player.color)
    local cur = IEF_STOPFIRE_CURRENT
    if not cur then return end
    local defenderSlot = cur.slot
    local attackerSlot = (cur.slot == 1) and 2 or 1

    print("defenderSlot: ", defenderSlot)
    print("attackerSlot: ", attackerSlot)

            if slot == defenderSlot then
                charge_stopfireBeginFromClick(player)
            else
                if cur.subStep == "ESCI" then 
                    charge_stopfireExitClick(player)
                else
                    charge_stopfireRollMorale(player)
                end 
            end

    return false
end

-- ============================================================
-- FUNZIONE: charge_auto_btn_army1(player, value, id, buttonConfig)
-- ============================================================
function charge_auto_btn_army1(player, value, id, buttonConfig)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        charge_processAutoForSlot(1, e)
    end
    callHandler("buildUI")
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY1)
    return true
end
-- ============================================================
-- FUNZIONE: charge_auto_btn_army2(player, value, id, buttonConfig)
-- ============================================================
function charge_auto_btn_army2(player, value, id, buttonConfig)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        charge_processAutoForSlot(2, e)
    end
    callHandler("buildUI")
    callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY2)
    return true
    --callHandler("advanceTurnAfterClick", BUTTONS.BTN_ARMY2)
end



