-- ============================================================
-- rulesets/imperifeudi/4_charge/state.ttslua
-- Stato FASE CARICA (CHARGE_DECLARE + CHARGE_RESOLVE)
-- ============================================================

-- ============================================================
-- ENUM: REACTION_TYPE — le 4 risposte possibili a una carica
-- subita (regolamento, "POSSIBILI RISPOSTE ALLE CARICHE").
-- ============================================================
REACTION_TYPE = {
    COC = "ControCarica",
    EVA = "Evasione",
    FER = "Ferma",
    TIR = "TiroArresto",
}

-- ============================================================
-- ENUM: CHARGE_STEP — stato di avanzamento di un elemento in
-- IEF_CHARGE_QUEUE.
--   DEC = accodata, non ancora processata
--   REA = in corso di risoluzione/movimento, o risposta del
--         bersaglio in atto
--   CLO = completamente risolta
-- ============================================================
CHARGE_STEP = {
    DEC  = "Dichiarazione",
    REA  = "Reazione",
    CLO  = "Chiusura",
}

-- ============================================================
-- ENUM: CHARGE_OUTCOME — esito finale di una carica risolta,
-- per le liste Attacco/Difesa.
-- ============================================================
CHARGE_OUTCOME = {
    OK  = "Riuscita",
    EVI = "Evitata",       -- bersaglio ha evaso
    ANN = "Annullata",     -- test morale fallito in dichiarazione/limitazioni
}

-- ============================================================
-- ENUM: UNIT_TYPES — codice (chiave, come nei dati reali:
-- GMNotes/army JSON) -> etichetta italiana per la UI. I confronti
-- nella logica usano SEMPRE il codice breve letterale ("KN",
-- "ART", ecc.), MAI UNIT_TYPES.KN — quello è il valore etichetta,
-- non il codice. Uso corretto: UNIT_TYPES[myTipo] per un testo
-- leggibile, myTipo == "KN" per un confronto.
-- ============================================================
UNIT_TYPES = {
    KN  = "Cavalieri",
    CP  = "Cavalleria Pesante",
    FM  = "Fanteria Media",
    CL  = "Cavalleria Leggera",
    FL  = "Fanteria Leggera",
    FP  = "Fanteria Pesante",
    ART = "Artiglieria",
    EL  = "Elefanti",
    GEN = "Generali e Comandanti",
}

-- Coda cariche dichiarate, una lista indipendente per esercito.
-- Ogni elemento: { attackerKey, targetKey, step, response,
--                   outcome, flankCharge, pivotInches, distInches }
-- step: CHARGE_STEP.DEC | CHARGE_STEP.REA | CHARGE_STEP.CLO
-- response: nil | REACTION_TYPE.COC/.EVA/.FER/.TIR
-- Nessun indice sequenziale: ogni elemento è risolvibile in
-- qualsiasi ordine tramite le liste Attacco/Difesa (righe cliccabili).
IEF_CHARGE_QUEUE = IEF_CHARGE_QUEUE or { [1] = {}, [2] = {} }

-- Lock globale: una sola risposta-nemico alla volta sul tavolo.
-- nil = nessuna risposta in sospeso, altrimenti { slot, index }
IEF_CHARGE_ACTIVE_RESPONSE = IEF_CHARGE_ACTIVE_RESPONSE or nil

-- Proposta di risposta in attesa di scelta nel popup
-- (charge_response_panel), una per esercito:
-- [slot] = { attackerKey, targetKey, elemento }
IEF_CHARGE_RESPONSE_PENDING = IEF_CHARGE_RESPONSE_PENDING or {}

-- Unità che hanno evaso una carica questo turno: non potranno
-- muovere nella successiva fase di Manovra. NOTA: il flag viene
-- impostato qui ma non è ancora letto/applicato da 6_move — da
-- collegare quando si costruirà quel controllo.
IEF_UNIT_NO_MOVE_NEXT_TURN = IEF_UNIT_NO_MOVE_NEXT_TURN or {}

-- Pannelli 3D di risposta attivi, indicizzati per unitKey del bersaglio
IEF_CHARGE_RESPONSE_UNITS = IEF_CHARGE_RESPONSE_UNITS or {}

-- Sessione di dichiarazione interattiva (pannello 3D Perno Sx/Dx
-- + Check Carica, agganciato alla base), una per esercito:
-- [slot] = { attackerKey, myBases, startPos={guid=Vector},
--            startRot={guid=Vector}, pivotUsed, targetKey,
--            distInches, panel3DObj, activePlayer }
IEF_CHARGE_DECLARE_SESSION = IEF_CHARGE_DECLARE_SESSION or {}
-- Coda cariche con Tiro d'Arresto da processare una alla volta in
-- CHARGE_AUTO, popolata da charge_stopfireInit().
IEF_STOPFIRE_QUEUE = IEF_STOPFIRE_QUEUE or {}
-- Carica correntemente in lavorazione sul pannello dinamico:
-- { elemento, slot (del DIFENSORE che spara), subStep = "TIRO"|"MORALE" }
IEF_STOPFIRE_CURRENT = IEF_STOPFIRE_CURRENT or nil