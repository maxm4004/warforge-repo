-- ============================================================
-- rulesets/imperifeudi/4_charge/state.ttslua
-- Stato FASE CARICA (CHARGE_DECLARE + CHARGE_RESOLVE)
-- ============================================================

-- Coda cariche dichiarate, una lista indipendente per esercito.
-- Ogni elemento: { attackerKey, targetKey, step, response, flankCharge }
-- step: "check" | "move" | "awaiting_response" | "stopfire" | "resolved"
IEF_CHARGE_QUEUE = IEF_CHARGE_QUEUE or { [1] = {}, [2] = {} }

-- Indice dell'elemento attualmente in risoluzione per ciascun esercito
IEF_CHARGE_INDEX = IEF_CHARGE_INDEX or { [1] = 1, [2] = 1 }

-- Lock globale: una sola risposta-nemico alla volta sul tavolo.
-- nil = nessuna risposta in sospeso, altrimenti { slot, index }
IEF_CHARGE_ACTIVE_RESPONSE = IEF_CHARGE_ACTIVE_RESPONSE or nil

-- Pannelli 3D di risposta attivi, indicizzati per unitKey del bersaglio
IEF_CHARGE_RESPONSE_UNITS = IEF_CHARGE_RESPONSE_UNITS or {}

-- Sessione di dichiarazione interattiva (pannello 3D Perno Sx/Dx
-- + Check Carica, agganciato alla base), una per esercito:
-- [slot] = { attackerKey, myBases, startPos={guid=Vector},
--            startRot={guid=Vector}, pivotUsed, targetKey,
--            distInches, panel3DObj, activePlayer }
IEF_CHARGE_DECLARE_SESSION = IEF_CHARGE_DECLARE_SESSION or {}
