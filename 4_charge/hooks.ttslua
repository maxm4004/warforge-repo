-- ============================================================
-- FUNZIONE: before_charge_declare(phaseName, phase)
-- ============================================================
function before_charge_declare(phaseName, phase)
    TURN.phase = phaseName
    TURN.completed = { Army1 = false, Army2 = false }

    charge_close(1)
    charge_close(2)

    UI.setAttribute("confirm_panel_charge", "active", "false")

    -- Le liste Attacco/Difesa sono generate dinamicamente da
    -- IEF_CHARGE_QUEUE (appena azzerata sopra): ricostruendo la UI
    -- risultano vuote/nascoste da sole, nessun UI.setAttribute manuale.
    callHandler("buildUI")
end

-- ============================================================
-- FUNZIONE: after_charge_declare(phaseName, phase)
-- ============================================================
function after_charge_declare(phaseName, phase)
    -- stub
end

-- ============================================================
-- FUNZIONE: before_charge_resolve(phaseName, phase)
-- Arbitra i conflitti (charge_resolveConflicts) ora che tutte
-- le dichiarazioni di entrambi gli eserciti sono note, poi
-- ricostruisce la UI: le liste Attacco/Difesa (generate
-- dinamicamente da IEF_CHARGE_QUEUE) compaiono già popolate.
-- ============================================================
function before_charge_resolve(phaseName, phase)
    TURN.phase = phaseName
    TURN.completed = { Army1 = false, Army2 = false }
    charge_resolveConflicts()
    callHandler("buildUI")
end

-- ============================================================
-- FUNZIONE: after_charge_resolve(phaseName, phase)
-- ============================================================
function after_charge_resolve(phaseName, phase)

end
