-- 4_charge/phase.ttslua
function charge_phase()
    return {
        CHARGE_DECLARE = {
            title = "FASE 1: DICHIARAZIONI DI CARICA",
            desc  = "DICHIARA LE CARICHE DELLE TUE UNITÀ",
            before = "before_charge_declare",
            after  = "after_charge_declare",
            allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK },
            render = "2BtnClickChargeList",
            enforceOwnership = true,
            inputMode = "OWNER",
            buttons = {
                BTN_ARMY1 = { action="ARMY1_CLICK", label="Dichiarazioni Completate", textColor="White", color="Red",   callback="charge_declare_btn_army1" },
                BTN_ARMY2 = { action="ARMY2_CLICK", label="Dichiarazioni Completate", textColor="White", color="Green", callback="charge_declare_btn_army2" },
            },
            transitions = {
                { to="CHARGE_REACT",    conditions={ COND.BOTH_PLAYERS_SELECTED } },
                { to="INITIATIVE_ROLL", conditions={ COND.BOTH_PLAYERS_SELECTED } },
            }
        },
        CHARGE_REACT = {
            title = "FASE 1: REAZIONI ALLE CARICHE",
            desc  = "SCEGLI COME REAGIRE ALLE CARICHE SUBITE",
            before = "before_charge_react",
            after  = "after_charge_react",
            allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK },
            render = "chargeReactDynamic",
            enforceOwnership = true,
            inputMode = "OWNER",
            buttons = {
                BTN_ARMY1 = { action="ARMY1_CLICK", label="Reazioni Completate", textColor="White", color="Red",   callback="charge_react_btn_army1" },
                BTN_ARMY2 = { action="ARMY2_CLICK", label="Reazioni Completate", textColor="White", color="Green", callback="charge_react_btn_army2" },
            },
            transitions = {
                { to="CHARGE_AUTO", conditions={ COND.BOTH_PLAYERS_SELECTED } }
            }
        },
        CHARGE_AUTO = {
            title = "FASE 1: ESECUZIONE AUTOMATICA",
            desc  = "CONTRO-CARICHE RECIPROCHE IN RISOLUZIONE",
            before = "before_charge_auto",
            after  = "after_charge_auto",
            allowedActions = { ACTION.ARMY1_CLICK, ACTION.ARMY2_CLICK },
            render = "2BtnClick",
            enforceOwnership = true,
            inputMode = "OWNER",
            buttons = {
                BTN_ARMY1 = { action="ARMY1_CLICK", label="Chiudi Fase", textColor="White", color="Red",   callback="charge_auto_btn_army1" },
                BTN_ARMY2 = { action="ARMY2_CLICK", label="Chiudi Fase", textColor="White", color="Green", callback="charge_auto_btn_army2" },
            },
            transitions = {
                { to="INITIATIVE_ROLL", conditions={ COND.BOTH_PLAYERS_SELECTED } }
            }
        }
    }
end