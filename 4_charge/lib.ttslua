-- ============================================================
-- FUNZIONE: charge_getFrontLine(basiObjs)
-- Isola il rango di fronte (basi con proiezione massima lungo
-- fwdXZ, non le basi estreme di TUTTE le file). Stesso principio
-- di move_getFrontLine (6_move/lib.ttslua), ma ritorna anche gli
-- OGGETTI base d'angolo (sinistro/destro del fronte), non solo
-- le posizioni — servono come pivot fisico per charge_applyPivot.
--
-- Ritorna: fwdXZ, right, frontLeftBase, frontRightBase
-- ============================================================
function charge_getFrontLine(basiObjs)
    local fwd   = basiObjs[1].getTransformForward()
    local fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()
    local right = main_rightOf(fwdXZ)

    local maxProj = -math.huge
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x * fwdXZ.x + p.z * fwdXZ.z
        if proj > maxProj then maxProj = proj end
    end

    local EPS = 0.5
    local frontRank = {}
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x * fwdXZ.x + p.z * fwdXZ.z
        if math.abs(proj - maxProj) < EPS then
            table.insert(frontRank, obj)
        end
    end

    table.sort(frontRank, function(a, b)
        local pa, pb = a.getPosition(), b.getPosition()
        return (pa.x*right.x + pa.z*right.z) < (pb.x*right.x + pb.z*right.z)
    end)

    return fwdXZ, right, frontRank[1], frontRank[#frontRank]
end

-- ============================================================
-- HELPER SIMMETRICI: charge_elementoX(elemento, slot)
-- Un elemento condiviso non ha più "attaccante"/"bersaglio" fissi
-- — ogni campo è duplicato per Army1/Army2. Questi helper
-- nascondono lo switch slot==1/slot==2 al resto del codice.
-- ============================================================
function charge_elementoUnitKey(elemento, slot)
    return (slot == 1) and elemento.unitArmy1Key or elemento.unitArmy2Key
end

function charge_elementoOtherKey(elemento, slot)
    return (slot == 1) and elemento.unitArmy2Key or elemento.unitArmy1Key
end

function charge_elementoOtherSlot(slot)
    return (slot == 1) and 2 or 1
end

function charge_elementoRequest(elemento, slot)
    if slot == 1 then
        return elemento.requestArmy1
    else
        return elemento.requestArmy2
    end
end

function charge_elementoSetRequest(elemento, slot, valore)
    if slot == 1 then elemento.requestArmy1 = valore else elemento.requestArmy2 = valore end
end

function charge_elementoDistInches(elemento, slot)
    return (slot == 1) and elemento.distInchesArmy1 or elemento.distInchesArmy2
end

function charge_elementoSetDeclareData(elemento, slot, pivotInches, distInches)
    if slot == 1 then
        elemento.pivotInchesArmy1 = pivotInches
        elemento.distInchesArmy1  = distInches
    else
        elemento.pivotInchesArmy2 = pivotInches
        elemento.distInchesArmy2  = distInches
    end
end

function charge_elementoResponse(elemento, slot)
    return (slot == 1) and elemento.responseArmy1 or elemento.responseArmy2
end

function charge_elementoSetResponse(elemento, slot, valore)
    if slot == 1 then elemento.responseArmy1 = valore else elemento.responseArmy2 = valore end
end

-- ============================================================
-- FUNZIONE: charge_elementoIsReciprocal(elemento)
-- Vero se ENTRAMBE le unità hanno dichiarato la carica l'una
-- sull'altra — contro-carica derivata, non più un flag scritto a
-- parte (charge_resolveConflicts non deve più impostarlo, solo
-- leggerlo indirettamente tramite questa funzione).
-- ============================================================
function charge_elementoIsReciprocal(elemento)
    return elemento.requestArmy1 == true and elemento.requestArmy2 == true
end

-- ============================================================
-- FUNZIONE: charge_unitReaction(slot, unitKey)
-- Reazione già scelta dall'unità (lato slot) in una qualsiasi
-- carica subita, esclusa FER. Ritorna elemento, reazione o nil.
-- ============================================================
function charge_unitReaction(slot, unitKey)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoUnitKey(e, slot) == unitKey and not charge_elementoIsReciprocal(e) then
            local r = charge_elementoResponse(e, slot)
            if r and r ~= REACTION_TYPE.FER then return e, r end
        end
    end
    return nil
end
-- ============================================================
-- FUNZIONE: charge_setOtherReactions(elemento, slot, reazione)
-- Un'unità che subisce più cariche reagisce con una sola azione
-- (risposta dell'autore):
-- - Contro-carica: vale contro tutti i caricanti. L'unità muove
--   una volta sola (nella carica dove l'ha scelta); nelle altre è
--   segnata come già mossa, così il caricante arriva a contatto
--   con tutta la sua distanza, ma la mischia conta entrambi "in
--   carica".
-- - Tiro d'Arresto: contro un solo caricante, le altre Ferma.
-- - Evasione: vale per tutti (le altre restano Ferma ma sono
--   trattate come evitate, charge_evasionOf).
-- - Ferma: tutte Ferma.
-- ============================================================
function charge_setOtherReactions(elemento, slot, reazione)
    local myKey = charge_elementoUnitKey(elemento, slot)
    local otherSlot = charge_elementoOtherSlot(slot)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if e ~= elemento and charge_elementoUnitKey(e, slot) == myKey
           and charge_elementoRequest(e, otherSlot) and not charge_elementoIsReciprocal(e)
           and charge_elementoResponse(e, slot) == nil then
            if reazione == REACTION_TYPE.COC then
                charge_elementoSetResponse(e, slot, REACTION_TYPE.COC)
                if slot == 1 then e.movedArmy1 = true else e.movedArmy2 = true end
            else
                charge_elementoSetResponse(e, slot, REACTION_TYPE.FER)
            end
            charge_refreshDefenseRowText(slot, e)
        end
    end
end
-- ============================================================
-- FUNZIONE: charge_evasionOf(slot, unitKey)
-- Carica in cui l'unità ha evaso, o nil.
-- ============================================================
function charge_evasionOf(slot, unitKey)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoUnitKey(e, slot) == unitKey
           and charge_elementoResponse(e, slot) == REACTION_TYPE.EVA then
            return e
        end
    end
    return nil
end
-- ============================================================
-- FUNZIONE: charge_findElementByUnits(slotA, keyA, slotB, keyB)
-- Cerca un elemento esistente per la coppia di unità, in
-- QUALSIASI ordine (A può essere in Army1 o Army2 e viceversa).
-- ============================================================
function charge_findElementByUnits(slotA, keyA, slotB, keyB)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoUnitKey(e, slotA) == keyA and charge_elementoUnitKey(e, slotB) == keyB then
            return e
        end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: charge_findOrCreateElement(mySlot, myKey, otherSlot, otherKey)
-- ============================================================
function charge_findOrCreateElement(mySlot, myKey, otherSlot, otherKey)
    if not myKey or not otherKey then
        print("[CARICA] ERRORE: charge_findOrCreateElement chiamata con chiave nil, ignorata")
        return nil
    end

    local existing = charge_findElementByUnits(mySlot, myKey, otherSlot, otherKey)
    if existing then return existing, false end
    
    -- Id univoco: il contatore non è salvato, dopo un caricamento
    -- ripartirebbe da 0 e duplicherebbe gli id della coda salvata
    -- (charge_elementoById tornerebbe l'elemento sbagliato).
    local maxId = IEF_CHARGE_NEXT_ID or 0
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if (e.id or 0) > maxId then maxId = e.id end
    end
    IEF_CHARGE_NEXT_ID = maxId + 1
    local nuovo = {
        id = IEF_CHARGE_NEXT_ID,
        unitArmy1Key = (mySlot == 1) and myKey or otherKey,
        unitArmy2Key = (mySlot == 1) and otherKey or myKey,
        requestArmy1 = false,
        requestArmy2 = false,
        pivotInchesArmy1 = nil, distInchesArmy1 = nil,
        pivotInchesArmy2 = nil, distInchesArmy2 = nil,
        responseArmy1 = nil,
        responseArmy2 = nil,
        step    = CHARGE_STEP.DEC,
        outcome = nil,
        flankCharge = nil,
        movedArmy1 = false,
        movedArmy2 = false,
        stopfireResolved = false,
        moveTargetArmy1 = nil,
        moveTargetArmy2 = nil,
    }
    table.insert(IEF_CHARGE_QUEUE, nuovo)
    return nuovo, true
end

-- ============================================================
-- FUNZIONE: charge_findQueueEntry(slot, unitKey)
-- Trova l'elemento dove l'unità di ARMY{slot} è unitKey — stessa
-- interfaccia di prima (slot, key), ora risolta sulla coda unica.
-- ============================================================
function charge_findQueueEntry(slot, unitKey)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoUnitKey(e, slot) == unitKey then return e end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: charge_queueHasPending()
-- Vero se almeno un elemento della coda cariche non è ancora
-- risolto (step ~= CHARGE_STEP.CLO).
-- ============================================================
function charge_queueHasPending()
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if e.step ~= CHARGE_STEP.CLO then return true end
    end
    return false
end
-- ============================================================
-- FUNZIONE: charge_getUnitMeta(obj)
-- Wrapper su main_getUnitMeta (motore condiviso in 0_main/lib.ttslua).
-- ============================================================
function charge_getUnitMeta(obj)
    return main_getUnitMeta(obj)
end

-- ============================================================
-- FUNZIONE: charge_getUnitBases(unitKey)
-- Wrapper su main_getUnitBases (motore condiviso in 0_main/lib.ttslua).
-- ============================================================
function charge_getUnitBases(unitKey)
    return main_getUnitBases(unitKey)
end

-- ============================================================
-- FUNZIONE: charge_alreadyDeclared(slot, unitKey)
-- Vero se unitKey ha già una carica in coda questo turno
-- (un'unità può dichiarare una sola carica a turno).
-- ============================================================
function charge_alreadyDeclared(slot, unitKey)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoUnitKey(e, slot) == unitKey and charge_elementoRequest(e, slot) then
            return true
        end
    end
    return false
end

-- ============================================================
-- FUNZIONE: charge_baseTouchesCorridor(nemico, startLeft, fwdXZ, right, rangeUnits, corridorWidth)
-- Vero se il bounding box FISICO REALE della base nemica
-- (nemico.getBounds(), non un'approssimazione da unit_types.json)
-- tocca il corridoio di carica — stesso principio di
-- shoot_isToccata (7_shoot/lib.ttslua): si controllano i 4
-- angoli del bounding box, non il solo centro.
-- ============================================================
function charge_baseTouchesCorridor(nemico, startLeft, fwdXZ, right, rangeUnits, corridorWidth)
    if not nemico or not nemico.getBounds then return false end
    local bounds = nemico.getBounds()
    if not bounds or not bounds.size then return false end

    local pos  = nemico.getPosition()
    local xmin = pos.x - bounds.size.x / 2
    local xmax = pos.x + bounds.size.x / 2
    local zmin = pos.z - bounds.size.z / 2
    local zmax = pos.z + bounds.size.z / 2

    local corners = {
        {x = xmin, z = zmin}, {x = xmin, z = zmax},
        {x = xmax, z = zmin}, {x = xmax, z = zmax},
    }

    for _, c in ipairs(corners) do
        local relX = c.x - startLeft.x
        local relZ = c.z - startLeft.z
        local localZ = relX * fwdXZ.x + relZ * fwdXZ.z
        local localX = relX * right.x + relZ * right.z
        if localZ >= 0 and localZ <= rangeUnits and localX >= 0 and localX <= corridorWidth then
            return true
        end
    end
    return false
end
-- ============================================================
-- FUNZIONE: charge_findLineTarget(myKey, slot)
-- ============================================================
function charge_findLineTarget(myKey, slot, pollici)

    local myBases = charge_getUnitBases(myKey)
    if #myBases == 0 then
        return nil, "Impossibile leggere le basi dell'unità caricante"
    end

    local myMeta = charge_getUnitMeta(myBases[1])
    local myTipo = myMeta and myMeta.unitType
    if not myTipo then
        return nil, "GMNotes mancanti sull'unità caricante"
    end

    local unitTypeData = main_getUnitType(myTipo)
    local moveInches = unitTypeData and unitTypeData.move_inches or 0
    -- F41g: lunghezza del corridoio passata dal chiamante (movimento
    -- meno il perno già usato); senza, il movimento pieno come prima
    if pollici then moveInches = math.max(0, pollici) end

    local baseHalfWidth = (unitTypeData and unitTypeData.base_width_cm or 4) * CM_TO_TTS / 2 - 0.06
    local baseHalfDepth = (unitTypeData and unitTypeData.base_depth_cm or 3) * CM_TO_TTS / 2 - 0.06

    local SIDE_TOLERANCE = 0.05 * INCH_TO_TTS
    baseHalfWidth = baseHalfWidth + SIDE_TOLERANCE

    local fwdXZ, right, frontLeft, frontRight = charge_getFrontLine(myBases)
    local p1, p2 = frontLeft.getPosition(), frontRight.getPosition()

    local rangeUnits = moveInches * INCH_TO_TTS
    local y = 1.20

    local startLeft  = Vector(p1.x - right.x*baseHalfWidth + fwdXZ.x*baseHalfDepth, y, p1.z - right.z*baseHalfWidth + fwdXZ.z*baseHalfDepth)
    local startRight = Vector(p2.x + right.x*baseHalfWidth + fwdXZ.x*baseHalfDepth, y, p2.z + right.z*baseHalfWidth + fwdXZ.z*baseHalfDepth)
    local endLeft    = Vector(startLeft.x  + fwdXZ.x*rangeUnits, y, startLeft.z  + fwdXZ.z*rangeUnits)
    local endRight   = Vector(startRight.x + fwdXZ.x*rangeUnits, y, startRight.z + fwdXZ.z*rangeUnits)
    local corridorWidth = Vector(startRight.x - startLeft.x, 0, startRight.z - startLeft.z):magnitude()

    -- Nessun disegno qui: charge_findLineTarget è ora PURA (solo
    -- calcolo). Il disegno del corridoio è responsabilità di chi
    -- chiama, tramite charge_drawCorridor — così chi cerca il
    -- bersaglio senza voler mostrare nulla (dichiarazioni
    -- automatiche, controllo obblighi) non lascia più residui da
    -- pulire dopo.

    local enemyTag = "Army" .. (slot == 1 and 2 or 1)
    local seenKeys = {}
    local best = nil

    for _, o in ipairs(getAllObjects()) do
        if o.hasTag(enemyTag) then
            local ek = main_getUnitKey(o)
            if ek and not seenKeys[ek] then
                seenKeys[ek] = true

                local enemyBases = charge_getUnitBases(ek)
                local enemyMeta  = enemyBases[1] and charge_getUnitMeta(enemyBases[1])
                local enemyTipo  = enemyMeta and enemyMeta.unitType

                local legalTarget = true
                if myTipo == "FL" and enemyTipo ~= "FL" and enemyTipo ~= "ART" and enemyTipo ~= "EL" then
                    legalTarget = false
                end

                if legalTarget then
                    for _, eb in ipairs(enemyBases) do
                        if eb.getBounds then
                            local bounds = eb.getBounds()
                            if bounds and bounds.size then
                                local ep = eb.getPosition()
                                local xmin = ep.x - bounds.size.x / 2
                                local xmax = ep.x + bounds.size.x / 2
                                local zmin = ep.z - bounds.size.z / 2
                                local zmax = ep.z + bounds.size.z / 2

                                local corners = {
                                    {x=xmin,z=zmin}, {x=xmin,z=zmax},
                                    {x=xmax,z=zmin}, {x=xmax,z=zmax},
                                }

                                local anyInside = false
                                local nearestLocalZ = nil
                                for _, c in ipairs(corners) do
                                    local relX = c.x - startLeft.x
                                    local relZ = c.z - startLeft.z
                                    local localZ = relX * fwdXZ.x + relZ * fwdXZ.z
                                    local localX = relX * right.x + relZ * right.z
                                    if localZ >= 0 and localZ <= rangeUnits and localX >= 0 and localX <= corridorWidth then
                                        anyInside = true
                                    end
                                    if not nearestLocalZ or localZ < nearestLocalZ then
                                        nearestLocalZ = localZ
                                    end
                                end

                                if anyInside then
                                    if not best or nearestLocalZ < best.localZ then
                                        best = { targetKey = ek, localZ = nearestLocalZ, distInches = nearestLocalZ / INCH_TO_TTS }
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if not best then
        return nil, "Nessun bersaglio raggiungibile in linea retta", nil, frontLeft, startLeft, startRight, endLeft, endRight
    end

    return best.targetKey, 0, best.distInches, frontLeft, startLeft, startRight, endLeft, endRight
end
-- ============================================================
-- FUNZIONE: charge_drawCorridor(frontLeft, startLeft, startRight, endLeft, endRight)
-- Disegna il corridoio (linee rosse) self-hosted su frontLeft.
-- Chiamata SOLO da chi vuole davvero mostrarlo (charge_checkTarget
-- in CHARGE_DECLARE) — mai da charge_findLineTarget stessa.
-- ============================================================
function charge_drawCorridor(frontLeft, startLeft, startRight, endLeft, endRight)
    if not frontLeft then return end
    frontLeft.setVectorLines({
        {points = {frontLeft.positionToLocal(startLeft),  frontLeft.positionToLocal(endLeft)},  color={1,0.2,0.2}, thickness=0.03},
        {points = {frontLeft.positionToLocal(startRight), frontLeft.positionToLocal(endRight)}, color={1,0.2,0.2}, thickness=0.03},
        {points = {frontLeft.positionToLocal(endLeft),    frontLeft.positionToLocal(endRight)}, color={1,0.2,0.2}, thickness=0.03},
    })
end
-- ============================================================
-- FUNZIONE: charge_buildDeclarePanel3DXml(unitKey, x, z, colore, labelText)
-- Pannello 3D dichiarazione carica: Perno Sx/Dx + Check Carica +
-- Annulla. Stesso schema di main_buildMovementPanel3DXml
-- (0_main/lib.ttslua): agganciato via obj.UI.setXml() sulla base
-- stessa, onClick con prefisso "Global/" (richiesto per XML
-- attaccato a un oggetto, non alla UI globale). ID pulsanti
-- unici per unitKey.
-- ============================================================
function charge_buildDeclarePanel3DXml(unitKey, x, y, z, colore, labelText, infoText)
    local P = MOVEPANEL
    local function btn(suffisso, testo, onClick, larghezza, c)
        return string.format('<Button id="btn_%s_%s" text="%s" font="%s" fontStyle="Bold" fontSize="16" color="%s" textColor="White" preferredWidth="%d" preferredHeight="34" onClick="Global/%s"/>',
            unitKey, suffisso, testo, P.font, c or P.btnOn, larghezza, onClick)
    end
    local function riga(contenuto)
        return '<HorizontalLayout spacing="8" childAlignment="MiddleCenter" childForceExpandWidth="false" preferredHeight="34">' .. contenuto .. '</HorizontalLayout>'
    end
    return string.format([[
        <Panel id="panelCharge_%s" active="true" color="%s" width="%d" height="340" offsetXY="0 320" position="%f %f %f" rotation="-90 0 0" visibility="%s">
            <VerticalLayout spacing="8" padding="20 20 16 16" childAlignment="UpperCenter" childForceExpandHeight="false">
                <Text text="%s" font="%s" fontStyle="Bold" fontSize="22" color="%s" alignment="MiddleCenter" preferredHeight="30"/>
                <Text text="%s" font="%s" fontSize="15" color="%s" alignment="MiddleCenter" preferredHeight="22"/>
                <Text text="DICHIARAZIONE DI CARICA" font="%s" fontStyle="Bold" fontSize="15" color="%s" alignment="MiddleLeft" preferredHeight="22"/>
                <Text id="txtMirino_%s" text="" font="%s" fontStyle="Normal" fontSize="18" color="#FFFFFF" alignment="MiddleCenter" preferredHeight="30"/>
                %s %s
            </VerticalLayout>
        </Panel>
    ]], unitKey, P.bg, P.width, x, y, z, colore,
        labelText, P.font, P.gold,
        infoText or "", P.font, P.grey,
        P.font, P.gold,
        unitKey, P.font,
        (IEF_CHARGE_USA_MIRINO ~= false)
          -- F41c: il controllo lo fa il mirino
          and riga(btn("ChargePivotSx", "Perno Sn", "charge_btnPivotSx", 330) .. btn("ChargePivotDx", "Perno Ds", "charge_btnPivotDx", 330))
          or riga(btn("ChargePivotSx", "Perno Sn", "charge_btnPivotSx", 210) .. btn("ChargePivotDx", "Perno Ds", "charge_btnPivotDx", 210)
          .. btn("ChargeCheck", "Controlla", "charge_btnCheck", 210, "#C8642A")),
        riga(btn("ChargeAbort", "Annulla", "charge_btnAbort", 330, P.undo2) .. btn("ChargeClose", "Chiudi", "charge_btnClose", 330, P.close)))
end
-- ============================================================
-- FUNZIONE: charge_redraw(unitKey)
-- Ricostruisce il pannello 3D di dichiarazione con il testo
-- pollici-di-perno aggiornato. Stesso principio di move_redraw
-- (6_move/lib.ttslua).
-- ============================================================
function charge_redraw(unitKey)

    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if not session or not session.panel3DObj then return end
    if session.panel3DObj.isDestroyed() then return end

    local slot = main_getArmyByColor(session.activePlayer)
    local _, _, _, newHost = charge_findLineTarget(session.attackerKey, slot)
    if newHost then
        if session.lineHost and session.lineHost ~= newHost then
            session.lineHost.setVectorLines({})
        end
        session.lineHost = newHost
    end

    local fronte = main_detectFormation(session.myBases)
    local x, y, z = main_calcolaPosizionePannello(fronte, #session.myBases)

    local labelText = main_decodeExtendedUnitLabel(session.attackerKey)
    local infoText = string.format("Perno usato %.1f&quot; su 2.0&quot;   -   Controlla il bersaglio, poi Dichiara", session.pivotUsed)
    if IEF_CHARGE_USA_MIRINO ~= false then
        -- F41c: perno e movimento totale (il perno si sottrae al movimento)
        local meta = charge_getUnitMeta(session.myBases[1])
        local ut = meta and main_getUnitType(meta.unitType)
        local mov = (ut and ut.move_inches) or 0
        infoText = string.format("Perno %.2f&quot; su %.1f&quot;   -   Movimento %.2f&quot; su %.1f&quot;",
            session.pivotUsed or 0, IEF_CHARGE_PIVOT_MAX or 2, math.max(0, mov - (session.pivotUsed or 0)), mov)
    end
    session.panel3DObj.UI.setXml(charge_buildDeclarePanel3DXml(session.attackerKey, x, y, z, session.activePlayer.color, labelText, infoText))
end

-- ============================================================
-- FUNZIONE: charge_close(unitKey)
-- Chiude il pannello 3D e pulisce la sessione di dichiarazione.
-- Stesso principio di move_close (6_move/lib.ttslua).
-- ============================================================
function charge_close(unitKey, dichiarata)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if not session then return end
    if charge_pernoOff then charge_pernoOff(session, true) end
    if charge_mirinoStop then charge_mirinoStop(session) end
    -- F41h: i perni servono solo a preparare la carica. Se la carica
    -- non viene dichiarata (Chiudi, test fallito, riapertura...)
    -- l'unità torna alla posizione e all'orientamento di partenza.
    if not dichiarata then charge_declareRestorePosition(session) end

    if session.lineHost then
        session.lineHost.setVectorLines({})
    end

    if session.panel3DObj and not session.panel3DObj.isDestroyed() then
        session.panel3DObj.UI.setXml("")
    end

    IEF_CHARGE_DECLARE_SESSION[unitKey] = nil
end

-- ============================================================
-- FUNZIONE: charge_declareOpenFromButton(obj, player_color, alt_click)
-- click_function del pulsante 3D "CARICA". TTS passa sempre
-- (obj, player_color, alt_click) — nessun parametro custom
-- possibile in createButton(). Apre il pannello 3D interattivo
-- (Perno Sx/Dx + Check Carica), agganciato alla base stessa.
-- Nessuna selezione nativa richiesta al giocatore.
-- ============================================================
function charge_declareOpenFromButton(obj, player_color, alt_click)

    local player = Player[player_color]
    if not player then return end

    if ENGINE.phase ~= PHASE.CHARGE_DECLARE then
       -- printToColor("[CARICA] Non è la fase di dichiarazione carica", player.color, {r=1,g=0.6,b=0})
       -- return
    end

    local slot = main_getArmyByColor(player)
    if not slot then
        printToColor("[CARICA] Giocatore non riconosciuto", player.color, {r=1,g=0.6,b=0})
        return
    end

    local myTag = "Army" .. slot
    if not obj.hasTag(myTag) then
        printToColor("[CARICA] Questo pulsante non appartiene a una tua unità", player.color, {r=1,g=0.6,b=0})
        return
    end

    local myKey = main_getUnitKey(obj)
    if not myKey then
        printToColor("[CARICA] Impossibile identificare l'unità caricante", player.color, {r=1,g=0.6,b=0})
        return
    end

    -- Se questa STESSA unità aveva già un pannello aperto (es. il
    -- player riclicca la base), chiude quella sessione prima di
    -- ricrearla — non serve chiudere le sessioni di ALTRE unità:
    -- più pannelli in parallelo (uno per unitKey) sono ammessi,
    -- stesso principio di Move/Formazione.
    if IEF_CHARGE_DECLARE_SESSION[myKey] then
        charge_close(myKey)
    end

    local myMeta = charge_getUnitMeta(obj)
    local myTipo = myMeta and myMeta.unitType
    if myTipo == "ART" then
        printToColor("[CARICA] L'Artiglieria non può mai dichiarare cariche", player.color, {r=1,g=0.6,b=0})
        return
    end

    local myBases = charge_getUnitBases(myKey)
    if #myBases == 0 then
        printToColor("[CARICA] Impossibile leggere le basi dell'unità", player.color, {r=1,g=0.6,b=0})
        return
    end

    local startPos, startRot = {}, {}
    for i, b in ipairs(myBases) do
        startPos[i] = b.getPosition()
        startRot[i] = b.getRotation()
    end

    IEF_CHARGE_DECLARE_SESSION[myKey] = {
        attackerKey  = myKey,
        myBases      = myBases,
        startPos     = startPos,
        startRot     = startRot,
        pivotUsed    = 0,
        targetKey    = nil,
        distInches   = nil,
        panel3DObj   = obj,
        activePlayer = player,
    }

    main_cameraToUnitPanel(player, myBases, 30, main_unitYaw(myBases), 15)
    UI.setAttribute("confirm_panel_charge", "active", "false")
    Wait.time(function ()
        charge_redraw(myKey)
        -- F41: mirino da trascinare sul bersaglio
        if IEF_CHARGE_USA_MIRINO ~= false then charge_mirinoSpawn(myKey) end
    end, 1)
end
-- ============================================================
-- FUNZIONE: charge_pivotApply(player, direzione)
-- direzione: "left" | "right". Applica 1" di perno (o il residuo
-- se minore), fino al budget massimo di 2" per la carica intera.
-- Stessa matrice di rotazione di move_perno_apply, ma pivotBase
-- = angolo di fronte reale (charge_getFrontLine).
-- ============================================================
function charge_pivotApply(player, unitKey, direzione)
    local slot = main_getArmyByColor(player)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if not session then return end

    if charge_alreadyDeclared(slot, session.attackerKey) then
        warning("[CARICA] Questa unità ha già dichiarato una carica questo turno", "Yellow")
        return
    end

    local residuo = 2 - session.pivotUsed
    if residuo <= 0.001 then
        printToColor("[CARICA] Perno massimo (2\") già usato", player.color, {r=1,g=0.6,b=0})
        return
    end

    local myBases = session.myBases
    if #myBases < 2 then
        printToColor("[CARICA] Unità a base singola: perno non applicabile", player.color, {r=1,g=0.6,b=0})
        return
    end

    local distanzaInch = math.min(1, residuo)

    -- Perno sull'angolo anteriore: l'angolo esterno percorre
    -- esattamente distanzaInch (main_pivotFrontCorner)
    if not main_pivotFrontCorner(myBases, direzione, distanzaInch) then return end

    session.pivotUsed = session.pivotUsed + distanzaInch
    charge_redraw(unitKey)
end

-- ============================================================
-- FUNZIONE: charge_btnPivotSx(player, value, id)
-- onClick 3D (prefisso "Global/") del pulsante "Perno Sx".
-- unitKey estratto dall'id (contiene già l'unità del pannello),
-- non più derivato da player/slot — più pannelli possono coesistere
-- in parallelo, uno per unitKey.
-- ============================================================
function charge_btnPivotSx(player, value, id)
    if not player then return end
    local unitKey = id:match("^btn_(.+)_ChargePivotSx$")
    if not unitKey then return end
    if IEF_CHARGE_USA_MIRINO ~= false then return charge_pernoToggle(unitKey, "left") end
    charge_pivotApply(player, unitKey, "left")
end

-- ============================================================
-- FUNZIONE: charge_btnPivotDx(player, value, id)
-- onClick 3D del pulsante "Perno Dx".
-- ============================================================
function charge_btnPivotDx(player, value, id)
    if not player then return end
    local unitKey = id:match("^btn_(.+)_ChargePivotDx$")
    if not unitKey then return end
    if IEF_CHARGE_USA_MIRINO ~= false then return charge_pernoToggle(unitKey, "right") end
    charge_pivotApply(player, unitKey, "right")
end

-- ============================================================
-- FUNZIONE: charge_checkTarget(player, unitKey)
-- Registra anche IEF_CHARGE_ACTIVE_CONFIRM[slot]=unitKey: il popup
-- 2D confirm_panel_charge è condiviso (un solo oggetto UI, non uno
-- per pannello 3D) — serve sapere a quale unità si riferisce
-- l'ultimo Check fatto da questo player, letto poi da
-- charge_declareCancel/charge_declareConfirm.
-- ============================================================
function charge_checkTarget(player, unitKey)
    local slot = main_getArmyByColor(player)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if not session then return end

    local function setTextColor(id)
        Wait.frames(function()
            UI.setAttribute(id, "textColor", (id == "btnActionCharge") and CONFIRMPANEL.actionText or CONFIRMPANEL.closeText)
        end, 1)
    end

    if ENGINE.phase == PHASE.CHARGE_DECLARE then

        local targetKey, a, distInches, newHost, startLeft, startRight, endLeft, endRight =
            charge_findLineTarget(session.attackerKey, slot, (IEF_CHARGE_USA_MIRINO ~= false) and charge_portata(session) or nil)

        if newHost then
            if session.lineHost and session.lineHost ~= newHost then
                session.lineHost.setVectorLines({})
            end
            session.lineHost = newHost
        end

        if charge_alreadyDeclared(slot, session.attackerKey) then
            warningToColor("Questa unità ha già dichiarato una carica questo turno", player, "Yellow", 5, true)
            return
        end

        charge_drawCorridor(newHost, startLeft, startRight, endLeft, endRight)

        if not targetKey then
            warningToColor(string.format(tostring(a)), player, "Yellow", 5, true)
            return
        end

        local attackerMeta = charge_getUnitMeta(charge_getUnitBases(session.attackerKey)[1])
        local attackerTipo = attackerMeta and attackerMeta.unitType
        local attackerCapabilities = main_capabilitiesOf(session.attackerKey, attackerMeta)

        local targetMeta = charge_getUnitMeta(charge_getUnitBases(targetKey)[1])
        local targetTipo = targetMeta and targetMeta.unitType

        local obbligatoria = charge_isMandatoryCharge(attackerTipo, attackerCapabilities, targetTipo)

        if not obbligatoria then
            local myBase = charge_getUnitBases(session.attackerKey)[1]
            if not main_isInCommandRange(myBase, slot) then
                warningToColor(string.format("La %s è fuori dal raggio di comando di un Generale, impossibile caricare", main_decodeExtendedUnitLabel(session.attackerKey)), player, "Yellow", 5, true)
                return
            end
        end

        local myBases = charge_getUnitBases(session.attackerKey)
        local targetBases = charge_getUnitBases(targetKey)
        local _, _, distanzaMinima = charge_closestBasePair(myBases, targetBases)

        session.targetKey  = targetKey
        session.distInches = distInches

        IEF_CHARGE_ACTIVE_CONFIRM[slot] = unitKey

        local testRichiesto = charge_chargeTestFor(session.attackerKey, targetKey) and IEF_CHARGE_TEST_PASSED[session.attackerKey] ~= targetKey

        if testRichiesto then
            charge_openMoralePanel(player)
            return
        end

        UI.setAttribute("btnActionCharge", "text", "Dichiara")
        setTextColor("btnActionCharge")
        warningToColor(string.format("la %s è ad una distanza di %.2f %s dalla %s", main_decodeExtendedUnitLabel(session.attackerKey), distanzaMinima, MEASURE_UNIT, main_decodeExtendedUnitLabel(session.targetKey)), player, "Yellow", 5, true)
        Wait.time(function ()
            warningToColor(string.format("La %s è nel raggio di comando di un Generale", main_decodeExtendedUnitLabel(session.attackerKey)), player, "Yellow", 5, true)
        end, 5)

        UI.setAttribute("confirm_panel_morale", "active", "false")
        UI.setAttribute("confirm_panel_charge", "visibility", player.color)
        UI.setAttribute("confirm_panel_charge", "active", "true")
    end
end

-- ============================================================
-- FUNZIONE: charge_btnCheck(player, value, id)
-- onClick 3D del pulsante "Check Carica".
-- ============================================================
function charge_btnCheck(player, value, id)
    if not player then return end
    local unitKey = id:match("^btn_(.+)_ChargeCheck$")
    if not unitKey then return end
    charge_checkTarget(player, unitKey)
end

-- ============================================================
-- FUNZIONE: charge_declareRestorePosition(session)
-- Riporta le basi dell'unità alla posizione/rotazione salvate
-- all'apertura del pannello (prima di qualsiasi perno).
-- ============================================================
function charge_declareRestorePosition(session)
    if not session then return end
    for i, b in ipairs(session.myBases) do
        if session.startPos[i] then b.setPosition(session.startPos[i]) end
        if session.startRot[i] then b.setRotation(session.startRot[i]) end
    end
    main_syncGeneralsOfBases(session.myBases)
end
-- ============================================================
-- FUNZIONE: charge_declareAbort(player, unitKey)
-- Annulla tutto (compresi i perni), ripristina la posizione di
-- partenza, chiude il pannello 3D e il popup di conferma.
-- ============================================================
function charge_declareAbort(player, unitKey)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if session then
        if charge_pernoOff then charge_pernoOff(session, true) end
        charge_declareRestorePosition(session)
        -- F41: Annulla azzera anche i perni e rimette il mirino
        if IEF_CHARGE_USA_MIRINO ~= false then
            session.pivotUsed = 0
            charge_mirinoStop(session)
            charge_redraw(unitKey)
            charge_dopoSpostamento(unitKey)
        end
    end
end

-- ============================================================
-- FUNZIONE: charge_btnAbort(player, value, id)
-- ============================================================
function charge_btnAbort(player, value, id)
    if not player then return end
    local unitKey = id:match("^btn_(.+)_ChargeAbort$")
    if not unitKey then return end
    charge_declareAbort(player, unitKey)
end
-- ============================================================
-- FUNZIONE: charge_btnClose(player, value, id)
-- ============================================================
function charge_btnClose(player, value, id)
    if not player then return end
    local unitKey = id:match("^btn_(.+)_ChargeClose$")
    if not unitKey then return end
    charge_close(unitKey)
    UI.setAttribute("confirm_panel_charge", "active", "false")
end
-- ============================================================
-- FUNZIONE: charge_declareCancel(player, value, id, buttonConfig)
-- onClick del pulsante "CANCEL" nel popup 2D confirm_panel_charge.
-- Nessun unitKey nell'id (popup condiviso, fisso): letto da
-- IEF_CHARGE_ACTIVE_CONFIRM[slot], impostato dall'ultimo Check
-- fatto da questo player. Annulla tutto (compresi i perni già
-- fatti) e ripristina la posizione di partenza — il pannello 3D
-- resta aperto per riprovare (nuovi perni/check).
-- ============================================================
function charge_declareCancel(player, value, id, buttonConfig)
    local slot = main_getArmyByColor(player)
    local unitKey = slot and IEF_CHARGE_ACTIVE_CONFIRM[slot]
    local session = unitKey and IEF_CHARGE_DECLARE_SESSION[unitKey]
    if session then
        if charge_pernoOff then charge_pernoOff(session, true) end
        charge_declareRestorePosition(session)
        session.pivotUsed  = 0
        session.targetKey  = nil
        session.distInches = nil
        charge_redraw(unitKey)
        if IEF_CHARGE_USA_MIRINO ~= false then
            charge_mirinoStop(session)
            charge_dopoSpostamento(unitKey)
        end
    end
    UI.setAttribute("confirm_panel_charge", "active", "false")
    return true
end

-- ============================================================
-- FUNZIONE: charge_declareConfirm(player, value, id, buttonConfig)
-- "Dichiara" (confirm_panel_charge): registra la carica. Se il
-- regolamento richiede un test per caricare non ancora superato
-- contro questo bersaglio, la carica NON si registra e si apre
-- il pannello del test (confirm_panel_morale).
-- ============================================================
function charge_declareConfirm(player, value, id, buttonConfig)
    local slot = main_getArmyByColor(player)
    local unitKey = slot and IEF_CHARGE_ACTIVE_CONFIRM[slot]
    local session = unitKey and IEF_CHARGE_DECLARE_SESSION[unitKey]

    UI.setAttribute("confirm_panel_charge", "active", "false")

    if not session or not session.targetKey or not session.attackerKey then
        return
    end

    if charge_alreadyDeclared(slot, session.attackerKey) or IEF_CHARGE_TEST_FAILED[session.attackerKey] then
        warningToColor("Questa unità ha già dichiarato (o tentato) una carica questo turno", player, "Yellow", 5, true)
        charge_close(unitKey)
        return
    end

    local attackerKey = session.attackerKey
    local targetKey   = session.targetKey

    if charge_chargeTestFor(attackerKey, targetKey) and IEF_CHARGE_TEST_PASSED[attackerKey] ~= targetKey then
        charge_openMoralePanel(player)
        return
    end

    local otherSlot = charge_elementoOtherSlot(slot)
    local elemento = charge_findOrCreateElement(slot, attackerKey, otherSlot, targetKey)
    charge_elementoSetRequest(elemento, slot, true)
    charge_elementoSetDeclareData(elemento, slot, session.pivotUsed, session.distInches)

    if not elemento.closestBaseArmy1 and not elemento.closestBaseArmy2 then
        local myBases = charge_getUnitBases(attackerKey)
        local targetBases = charge_getUnitBases(targetKey)
        local closestMine, closestTheirs = charge_closestBasePair(myBases, targetBases)
        if closestMine and closestTheirs then
            if slot == 1 then
                elemento.closestBaseArmy1 = closestMine.getGUID()
                elemento.closestBaseArmy2 = closestTheirs.getGUID()
            else
                elemento.closestBaseArmy2 = closestMine.getGUID()
                elemento.closestBaseArmy1 = closestTheirs.getGUID()
            end
        end
    end

    warningToColor(string.format("La %s carica %s", main_decodeExtendedUnitLabel(attackerKey), main_decodeExtendedUnitLabel(targetKey)), player, "Yellow", 5, true)
    charge_close(unitKey, true)   -- dichiarata: il perno resta
    callHandler("buildUI")
    callHandler("updateCenterPanel")
end

-- ============================================================
-- FUNZIONE: charge_openMoralePanel(player)
-- Mostra il pannello "Test Morale / Annulla" al giocatore.
-- ============================================================
function charge_openMoralePanel(player)
    UI.setAttribute("confirm_panel_charge", "active", "false")
    UI.setAttribute("confirm_panel_morale", "visibility", player.color)
    UI.setAttribute("confirm_panel_morale", "active", "true")
    Wait.frames(function()
        UI.setAttribute("btnActionMorale", "textColor", CONFIRMPANEL.actionText)
        UI.setAttribute("btnCancelMorale", "textColor", CONFIRMPANEL.closeText)
    end, 1)
end

-- ============================================================
-- FUNZIONE: charge_moraleConfirm(player, value, id)
-- "Test Morale" (confirm_panel_morale): richiede il test per
-- caricare (camera sui dadi, tiro col Roll del giocatore).
-- Superato -> charge_checkTarget riapre il pannello "Dichiara";
-- fallito -> l'unità non carica in questo turno.
-- ============================================================
function charge_moraleConfirm(player, value, id)
    local slot = main_getArmyByColor(player)
    local unitKey = slot and IEF_CHARGE_ACTIVE_CONFIRM[slot]
    local session = unitKey and IEF_CHARGE_DECLARE_SESSION[unitKey]

    UI.setAttribute("confirm_panel_morale", "active", "false")

    if not session or not session.targetKey or not session.attackerKey then
        return
    end

    if main_moraleQueueCount(slot) > 0 then
        warningToColor("C'è un test di morale in attesa: tiralo dal pannello morale", player, "Yellow", 5, true)
        return
    end

    local attackerKey = session.attackerKey
    local targetKey   = session.targetKey

    local test = charge_chargeTestFor(attackerKey, targetKey)
    if not test or IEF_CHARGE_TEST_PASSED[attackerKey] == targetKey then
        charge_checkTarget(player, unitKey)
        return
    end

    main_requestMoraleRoll(attackerKey, slot, test.def.effetto or "per_caricare", nil, test.nome,
        "charge_declareTestDone",
        { attackerKey = attackerKey, targetKey = targetKey, unitKey = unitKey, slot = slot })
end

-- ============================================================
-- FUNZIONE: charge_declareTestDone(ctx, esito)
-- Esito del test per caricare chiesto da charge_moraleConfirm.
-- ============================================================
function charge_declareTestDone(ctx, esito)
    local slot   = ctx.slot
    local player = Player[ARMY[slot].color]
    local basiObjs = charge_getUnitBases(ctx.attackerKey)

    if player and #basiObjs > 0 then
        main_cameraToUnitPanel(player, basiObjs, 30, main_unitYaw(basiObjs), 15)
    end

    if esito == MORALE_RESULT.OK then
        IEF_CHARGE_TEST_PASSED[ctx.attackerKey] = ctx.targetKey
        warningToColor(string.format("La %s supera il test: conferma la carica", main_decodeExtendedUnitLabel(ctx.attackerKey)), player, "Yellow", 5, true)
        charge_checkTarget(player, ctx.unitKey)
    else
        IEF_CHARGE_TEST_FAILED[ctx.attackerKey] = true
        warningToColor(string.format("La %s non supera il test: non carica", main_decodeExtendedUnitLabel(ctx.attackerKey)), player, "Yellow", 5, true)
        charge_close(ctx.unitKey)
        callHandler("buildUI")
        callHandler("updateCenterPanel")
    end
end
registerHandler("charge_declareTestDone", function(ctx, esito) return charge_declareTestDone(ctx, esito) end)

-- ============================================================
-- FUNZIONE: charge_moraleCancel(player, value, id)
-- "Annulla" del pannello morale: come l'annulla della
-- dichiarazione (ripristina posizione e bersaglio).
-- ============================================================
function charge_moraleCancel(player, value, id)
    UI.setAttribute("confirm_panel_morale", "active", "false")
    charge_declareCancel(player, value, id)
end
-- ============================================================
-- FUNZIONE: charge_determineResponses(myTipo, myArmi, myCapabilities, attackerTipo)
-- Determina le risposte legali per il bersaglio di una carica,
-- in base al proprio tipo/capacità e al tipo dell'attaccante
-- (regolamento, "POSSIBILI RISPOSTE ALLE CARICHE"):
--   - KN caricato > contro-carica obbligatoria
--   - CP con IMPETO > contro-carica obbligatoria
--   - CP senza IMPETO > contro-carica (Ferma solo per chi non
--     ha altre risposte: decisione Max 23/10)
--   - CL > contro-carica / evasione / resta ferma (scelta)
--   - FL caricata da non-FL/EL > evasione obbligatoria
--   - FL caricata da FL/EL > evasione o resta ferma (scelta)
--   - FP/FM con arma da tiro > Tiro d'Arresto o resta ferma
--   - chiunque altro > nessuna risposta
--
-- Ritorna: obbligato (stringa o nil), opzioni (lista di stringhe,
-- vuota se obbligato è impostato — in quel caso c'è una sola
-- scelta, non opzionale).
-- ============================================================
function charge_determineResponses(myTipo, myArmi, myCapabilities, attackerTipo, mista, inMischia)
    -- Unità già in mischia: non può contro-caricare (risposta dell'autore)
    if inMischia then
        local obb, opz = charge_determineResponses(myTipo, myArmi, myCapabilities, attackerTipo, mista, false)
        local filtrate = {}
        for _, r in ipairs(opz) do
            if r ~= REACTION_TYPE.COC then table.insert(filtrate, r) end
        end
        if obb == REACTION_TYPE.COC then obb = nil end
        return obb, filtrate
    end
    
    if myTipo == "KN" then
        return REACTION_TYPE.COC, {}
        
    elseif myTipo == "CP" then
        if charge_hasCapability(myCapabilities, "IMPETO") then
            return REACTION_TYPE.COC, {}
        end
        return REACTION_TYPE.COC, {}
    elseif myTipo == "CL" then
        return nil, { REACTION_TYPE.COC, REACTION_TYPE.EVA, REACTION_TYPE.FER }
    elseif myTipo == "FL" then
        if attackerTipo == "FL" or attackerTipo == "EL" then
            return nil, { REACTION_TYPE.EVA, REACTION_TYPE.FER }
        end
        return REACTION_TYPE.EVA, {}
    elseif (myTipo == "FP" or myTipo == "FM") and charge_hasArmaDaTiro(myArmi) and not mista then
        -- le unità miste (es. Lancia + Arco) non fanno Tiro d'Arresto
        return nil, { REACTION_TYPE.TIR, REACTION_TYPE.FER }
    end
    return nil, {}
end
-- ============================================================
-- FUNZIONE: charge_hasArmaDaTiro(armi)
-- Vero se la lista di armi contiene almeno un'arma da tiro
-- utilizzabile per il Tiro d'Arresto (esclude il GIAVELLOTTO,
-- regolamento: "Può essere usata solo per effettuare un Tiro
-- d'Arresto" — cioè il contrario, è l'UNICA arma che NON dà
-- diritto al Tiro d'Arresto standard qui, verificare comunque
-- la regola esatta se serve).
-- ============================================================
function charge_hasArmaDaTiro(armi)
    if not armi then return false end
    local weaponsDict = IEF_DATA.weapons and (IEF_DATA.weapons.weapons or IEF_DATA.weapons)
    if not weaponsDict then return false end

    for _, nomeArma in ipairs(armi) do
        if nomeArma ~= "GIAVELLOTTO" then
            local w = weaponsDict[nomeArma]
            if w and w.range_inches and w.range_inches > 0 then
                return true
            end
        end
    end
    return false
end
-- ============================================================
-- STILE LISTE LATERALI (nuova grafica, come pannello tiro/dadi)
-- Usato da: liste Cariche/Movimenti di carica e Reazioni.
-- Le righe sono Button (click), con id invariati: i refresh via
-- UI.setAttribute (testo/textColor) continuano a funzionare.
-- ============================================================
LISTPANEL = LISTPANEL or {
    width     = 420,
    offsetXY  = "-10 -330",
    padding   = 10,
    spacing   = 2,
    titleH    = 22,
    noteH     = 16,
    rowH      = 24,
    bg        = "rgba(0,0,0,0.70)",
    rowBg     = "rgba(1,1,1,0.06)",
    gold      = "#FFD833",
    grey      = "#BBBBBB",
    todo      = "White",     -- riga da fare
    done      = "#5BD35B",   -- riga fatta / scelta
    font      = "warforge_font",
    rowFont   = 10,          -- testo delle righe (piccolo: la riga si legge per intero)
}

-- ============================================================
-- FUNZIONE: ui_listPanelXml(o)
-- o = { id, titleId, titolo, nota, visibility, attivo,
--       righe = { { id, testo, colore, onClick }, ... },
--       vuoto = "testo se non ci sono righe",
--       rectAlignment = "UpperRight" (default), offsetXY = LISTPANEL.offsetXY (default) }
-- ============================================================
function ui_listPanelXml(o)
    local S = LISTPANEL
    local function esc(t)
        t = tostring(t or "")
        return (t:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
    end
    local righe = o.righe or {}
    local rows = ""
    for _, r in ipairs(righe) do
        rows = rows .. string.format(
            '<Button id="%s" text="%s" font="%s" fontSize="%d" color="%s" textColor="%s" textAlignment="MiddleCenter" preferredHeight="%d" onClick="%s"/>',
            r.id, esc(r.testo), S.font, S.rowFont or 10, S.rowBg, r.colore or S.todo, S.rowH, r.onClick)
    end
    local n = #righe
    if n == 0 and o.vuoto then
        rows = string.format('<Text text="%s" font="%s" fontSize="11" color="%s" alignment="MiddleCenter" preferredHeight="%d"/>',
            esc(o.vuoto), S.font, S.grey, S.rowH)
        n = 1
    end
    local h = 2 * S.padding + S.titleH + (o.nota and (S.noteH + S.spacing) or 0) + n * (S.rowH + S.spacing)
    return string.format(
        '<Panel id="%s" rectAlignment="%s" color="%s" width="%d" height="%d" offsetXY="%s" visibility="%s" active="%s">' ..
        '<VerticalLayout padding="%d %d %d %d" spacing="%d" childForceExpandHeight="false" childAlignment="UpperCenter">' ..
            '<Text id="%s" text="%s" font="%s" fontSize="14" fontStyle="Bold" color="%s" alignment="MiddleCenter" preferredHeight="%d"/>' ..
            '%s%s' ..
        '</VerticalLayout></Panel>',
        o.id, o.rectAlignment or "UpperRight", S.bg, S.width, h, o.offsetXY or S.offsetXY, o.visibility or "", o.attivo or "false",
        S.padding, S.padding, S.padding, S.padding, S.spacing,
        o.titleId, esc(o.titolo), S.font, S.gold, S.titleH,
        o.nota and string.format('<Text text="%s" font="%s" fontSize="10" color="%s" alignment="MiddleCenter" preferredHeight="%d"/>',
            esc(o.nota), S.font, S.grey, S.noteH) or "",
        rows)
end
-- ============================================================
-- FUNZIONE: charge_getAttackListPanelXml(slot)
-- ============================================================
function charge_getAttackListPanelXml(slot)

    local elementi = {}
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_attackRowShown(slot, e) then table.insert(elementi, e) end
    end

    local auto = ENGINE.phase == PHASE.CHARGE_AUTO
    local attivo = ((ENGINE.phase == PHASE.CHARGE_DECLARE or auto) and #elementi > 0) and "true" or "false"

    local righe = {}
    for _, e in ipairs(elementi) do
        table.insert(righe, {
            id      = string.format("charge_attack_row_%d_%d", slot, e.id),
            testo   = string.format("La %s %s %s",
                main_decodeExtendedUnitLabel(charge_elementoUnitKey(e, slot)),
                charge_attackVerb(slot, e),
                main_decodeExtendedUnitLabel(charge_elementoOtherKey(e, slot))),
            colore  = (auto and charge_attackRowDone(slot, e)) and LISTPANEL.done or LISTPANEL.todo,
            onClick = "charge_attackRowClick",
        })
    end

    return ui_listPanelXml({
        id         = "charge_attack_list_army" .. slot,
        titleId    = "charge_attack_list_title_army" .. slot,
        titolo     = (auto and "MOVIMENTI DI CARICA - " or "CARICHE - ") .. ARMY[slot].name,
        nota       = auto and "Clicca una riga per eseguire il movimento (verde = eseguito)"
                          or "Clicca una riga per controllare la carica",
        visibility = ARMY[slot] and ARMY[slot].color or "",
        attivo     = attivo,
        righe      = righe,
        vuoto      = "Nessuna carica",
    })
end
-- ============================================================
-- FUNZIONE: charge_getDefenseListPanelXml(slot)
-- ============================================================
function charge_getDefenseListPanelXml(slot)

    local otherSlot = charge_elementoOtherSlot(slot)
    local elementi = {}
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoRequest(e, otherSlot) and not charge_elementoIsReciprocal(e) then
            table.insert(elementi, e)
        end
    end

    local attivo = ((ENGINE.phase == PHASE.CHARGE_REACT or ENGINE.phase == PHASE.CHARGE_AUTO) and #elementi > 0) and "true" or "false"

    local righe = {}
    for _, e in ipairs(elementi) do
        table.insert(righe, {
            id      = string.format("charge_defense_row_%d_%d", slot, e.id),
            testo   = charge_defenseRowText(slot, e),
            colore  = (charge_elementoResponse(e, slot) ~= nil) and LISTPANEL.done or LISTPANEL.todo,
            onClick = "charge_defenseRowClick",
        })
    end

    return ui_listPanelXml({
        id         = "charge_defense_list_army" .. slot,
        titleId    = "charge_defense_list_title_army" .. slot,
        titolo     = "REAZIONI - " .. ARMY[slot].name,
        nota       = "Clicca una riga per scegliere la reazione (verde = scelta)",
        visibility = ARMY[slot] and ARMY[slot].color or "",
        attivo     = attivo,
        righe      = righe,
        vuoto      = "Nessuna carica subita",
    })
end

-- ============================================================
-- FUNZIONE: charge_attackRowClick(player, value, id)
-- ============================================================
function charge_attackRowClick(player, value, id)

    local slotStr, idStr = id:match("^charge_attack_row_(%d)_(%d+)$")
    if not slotStr then return end
    local slot = tonumber(slotStr)

    if engine_subPrivate(slot) then
        warningToColor("Completa prima l'azione in corso oppure annulla", player, "Yellow", 3, true)
        return
    end

    local elemento = charge_elementoById(tonumber(idStr))
    if not elemento then return end
    local otherKey = charge_elementoOtherKey(elemento, slot)

    local myKey = charge_elementoUnitKey(elemento, slot)
    local myBases = charge_getUnitBases(myKey)
    local targetBases = charge_getUnitBases(otherKey)
    if myBases[1] and targetBases[1] then
        local p1, p2 = myBases[1].getPosition(), targetBases[1].getPosition()
        main_cameraToPoint(player, slot, Vector((p1.x + p2.x) / 2, (p1.y + p2.y) / 2, (p1.z + p2.z) / 2))
    end

    if ENGINE.phase ~= PHASE.CHARGE_AUTO then return end

    local giaMossoIoStesso = (slot == 1 and elemento.movedArmy1) or (slot == 2 and elemento.movedArmy2) or elemento.step == CHARGE_STEP.CLO
    if giaMossoIoStesso then
        warningToColor(charge_attackDoneText(slot, elemento), player, "Yellow", 5, true)
        return
    end

    engine_subOpen("CHARGE_MOVE", slot, {
        queueId  = elemento.id,
        unitKey  = myKey,
        -- chi ha dichiarato la carica non evade mai
        evasione = not charge_elementoRequest(elemento, slot)
                   and charge_elementoResponse(elemento, slot) == REACTION_TYPE.EVA,
    }, nil)
end
-- ============================================================
-- FUNZIONE: charge_defenseRowClick(player, value, id)
-- ============================================================
function charge_defenseRowClick(player, value, id)
    local slotStr, idStr = id:match("^charge_defense_row_(%d)_(%d+)$")
    if not slotStr then return end
    local slot = tonumber(slotStr)

    if engine_subPrivate(slot) then
        warningToColor("Completa prima l'azione in corso oppure annulla", player, "Yellow", 5, true)
        return
    end

    local elemento = charge_elementoById(tonumber(idStr))
    if not elemento then return end
    local otherKey = charge_elementoOtherKey(elemento, slot)

    if elemento.step == CHARGE_STEP.CLO then
        printToColor("[CARICA] Questa carica è già stata risolta", player.color, {r=1,g=0.6,b=0})
        return
    end

    local myKey = charge_elementoUnitKey(elemento, slot)
    local myBases = charge_getUnitBases(myKey)
    local attackerBases = charge_getUnitBases(otherKey)

    if myBases[1] and attackerBases[1] then
        local p1, p2 = myBases[1].getPosition(), attackerBases[1].getPosition()
        main_cameraToPoint(player, slot, Vector((p1.x + p2.x) / 2, (p1.y + p2.y) / 2, (p1.z + p2.z) / 2))
    end

    if ENGINE.phase ~= PHASE.CHARGE_REACT then return end
    if charge_elementoIsReciprocal(elemento) then return end
    if charge_elementoResponse(elemento, slot) ~= nil then return end

    local myMeta = myBases[1] and charge_getUnitMeta(myBases[1])
    local myTipo = myMeta and myMeta.unitType
    local myArmi = myMeta and myMeta.armi or {}
    local myCapabilities = main_capabilitiesOf(myKey, myMeta)

    local attackerMeta = attackerBases[1] and charge_getUnitMeta(attackerBases[1])
    local attackerTipo = attackerMeta and attackerMeta.unitType

    local obbligato, opzioni = charge_determineResponses(myTipo, myArmi, myCapabilities, attackerTipo,
        main_isMistaMeta(myMeta), main_unitsInMelee()[myKey] == true)

    if not obbligato and #opzioni == 0 then
        printToColor(string.format("[CARICA] %s non ha nessuna risposta disponibile", myKey), player.color, {r=0.7,g=0.7,b=0.7})
        return
    end

    engine_subOpen("REACTION", slot, {
        queueId = elemento.id,
        opzioni = obbligato and { obbligato } or opzioni,
    }, nil)
end
-- ============================================================
-- FUNZIONE: charge_elementoFlanked(elemento, slot)
-- Vero se il lato slot è caricato sul fianco/retro in questa
-- carica (calcolato a fine dichiarazioni).
-- ============================================================
function charge_elementoFlanked(elemento, slot)
    if slot == 1 then return elemento.flankedArmy1 == true end
    return elemento.flankedArmy2 == true
end

-- ============================================================
-- FUNZIONE: charge_isFlankCharge(chargerKey, targetKey)
-- Regolamento, CARICHE SUL FIANCO: "L'unità che carica, per
-- iniziare il movimento, dovrà avere almeno due basi dietro il
-- prolungamento ideale della linea del fronte dell'unità
-- bersaglio". Linea del fronte = bordo anteriore più avanzato
-- delle basi del bersaglio (rettangoli reali delle basi); una
-- base è "dietro" se tutti i suoi 4 angoli lo sono.
-- ============================================================
CHARGE_FLANK_TOL = 0.02
function charge_isFlankCharge(chargerKey, targetKey)
    local d = charge_flankDetails(chargerKey, targetKey)
    return d ~= nil and d.dietro >= 2
end

-- ============================================================
-- FUNZIONE: charge_flankDetails(chargerKey, targetKey)
-- Dati del calcolo del fianco (usati anche da debug_flank):
-- { fronte, fwd, right, basiT={rect}, basiC={ {rect, dietro} },
--   dietro = numero basi del caricante tutte dietro il fronte }
-- nil se una delle due unità non ha basi.
-- ============================================================
function charge_flankDetails(chargerKey, targetKey)
    local basiT = charge_getUnitBases(targetKey)
    local basiC = charge_getUnitBases(chargerKey)
    if #basiT == 0 or #basiC == 0 then return nil end

    local metaT = charge_getUnitMeta(basiT[1])
    local metaC = charge_getUnitMeta(basiC[1])
    local f = basiT[1].getTransformForward()
    local fwd = Vector(f.x, 0, f.z):normalized()

    local d = { fwd = fwd, right = main_rightOf(fwd), fronte = -math.huge,
                basiT = {}, basiC = {}, dietro = 0 }
    for _, b in ipairs(basiT) do
        local r = main_baseRectOfType(b, metaT and metaT.unitType)
        table.insert(d.basiT, r)
        for _, c in ipairs(r.corners) do
            local pr = c.x * fwd.x + c.z * fwd.z
            if pr > d.fronte then d.fronte = pr; d.puntoFronte = c end
        end
    end

    for _, b in ipairs(basiC) do
        local r = main_baseRectOfType(b, metaC and metaC.unitType)
        local tutta = true
        for _, c in ipairs(r.corners) do
            if c.x * fwd.x + c.z * fwd.z > d.fronte + CHARGE_FLANK_TOL then tutta = false; break end
        end
        table.insert(d.basiC, { rect = r, dietro = tutta })
        if tutta then d.dietro = d.dietro + 1 end
    end
    return d
end

-- ============================================================
-- FUNZIONE: charge_resolveConflicts()
-- Fine dichiarazioni. Risposte dell'autore (23/10):
-- 1) la distanza non conta: chi è caricato deve dare la
--    precedenza a chi lo carica, quindi la carica che aveva
--    dichiarato NON parte (reagisce con le risposte del suo tipo,
--    anche se caricato sul fianco);
-- 2) più unità possono caricare lo stesso bersaglio, che
--    reagisce una volta sola verso tutte (charge_setOtherReactions);
-- 3) le cariche sul fianco hanno sempre la precedenza.
-- Una carica è annullata solo se chi la fa è caricato da una
-- carica che a sua volta parte (D carica C, C carica X, X carica
-- B: C non parte, quindi X parte). Le cariche reciproche
-- (contro-carica) partono sempre. Calcola anche il fianco.
-- ============================================================
function charge_resolveConflicts()
    -- Fianco per ogni carica non reciproca (posizioni di partenza)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        e.flankedArmy1, e.flankedArmy2 = false, false
        if not charge_elementoIsReciprocal(e) then
            for slot = 1, 2 do
                local other = charge_elementoOtherSlot(slot)
                if charge_elementoRequest(e, other) then
                    local fianco = charge_isFlankCharge(charge_elementoUnitKey(e, other), charge_elementoUnitKey(e, slot))
                    if slot == 1 then e.flankedArmy1 = fianco else e.flankedArmy2 = fianco end
                end
            end
        end
        e.flankCharge = (e.flankedArmy1 or e.flankedArmy2) or nil
    end

    -- Cariche "pure" (un solo lato ha dichiarato): attaccante e bersaglio
    local pure = {}
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if not charge_elementoIsReciprocal(e) then
            local s = e.requestArmy1 and 1 or (e.requestArmy2 and 2 or nil)
            if s then
                table.insert(pure, { e = e, slot = s,
                    atk = charge_elementoUnitKey(e, s),
                    tgt = charge_elementoUnitKey(e, charge_elementoOtherSlot(s)) })
            end
        end
    end

    -- stato: nil = da decidere, true = parte, false = annullata
    local stato = {}
    local function caricanti(key)
        local l = {}
        for _, p in ipairs(pure) do
            if p.tgt == key then table.insert(l, p) end
        end
        return l
    end
    local cambiato = true
    while cambiato do
        cambiato = false
        for _, p in ipairs(pure) do
            if stato[p] == nil then
                local daDecidere, perChi = false, nil
                for _, q in ipairs(caricanti(p.atk)) do
                    if stato[q] == true then perChi = q; break end
                    if stato[q] == nil then daDecidere = true end
                end
                if perChi then
                    stato[p] = false; p.da = perChi; cambiato = true
                elseif not daDecidere then
                    stato[p] = true; cambiato = true
                end
            end
        end
    end
    -- Ciclo residuo (ognuno caricato da qualcuno ancora indeciso):
    -- tutti caricati, quindi tutti reagiscono e nessuno parte.
    for _, p in ipairs(pure) do
        if stato[p] == nil then
            stato[p] = false
            p.da = caricanti(p.atk)[1]
        end
    end

    local daRimuovere = {}
    for _, p in ipairs(pure) do
        if stato[p] == false then
            daRimuovere[p.e] = true
            local q = p.da
            local fianco = q and charge_elementoFlanked(q.e, p.slot)
            printToAll(string.format("[CARICA] La carica della %s sulla %s non parte: la %s è caricata %sdalla %s",
                main_decodeExtendedUnitLabel(p.atk), main_decodeExtendedUnitLabel(p.tgt),
                main_decodeExtendedUnitLabel(p.atk), fianco and "sul fianco " or "",
                q and main_decodeExtendedUnitLabel(q.atk) or "?"), {r=1,g=0.6,b=0.2})
        end
    end

    local nuova = {}
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if not daRimuovere[e] then table.insert(nuova, e) end
    end
    IEF_CHARGE_QUEUE = nuova

    -- Unità già impegnata in una carica reciproca e caricata anche
    -- da altri: muove una volta sola (verso il nemico reciproco),
    -- gli altri caricanti la raggiungono con tutta la distanza.
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoIsReciprocal(e) then
            for slot = 1, 2 do
                local key = charge_elementoUnitKey(e, slot)
                for _, p in ipairs(pure) do
                    if not daRimuovere[p.e] and p.tgt == key then
                        if p.slot == 1 then p.e.movedArmy2 = true else p.e.movedArmy1 = true end
                    end
                end
            end
        end
    end
end

-- ============================================================
-- FUNZIONE: charge_applyFlankContact(elemento)
-- A carica chiusa con contatto: se il bersaglio era caricato sul
-- fianco e non ha contro-caricato (contatto sul fianco/retro),
-- perde subito un livello di coesione, tranne se chi carica è
-- CL o FL (regolamento, EFFETTI DELLA CARICA SUL FIANCO). Il
-- fianco resta sull'elemento per la mischia (primo turno senza
-- dadi verso quel nemico). Una volta sola per elemento.
-- ============================================================
function charge_applyFlankContact(elemento)
    if elemento.flankApplied then return end
    elemento.flankApplied = true
    for slot = 1, 2 do
        if charge_elementoFlanked(elemento, slot) then
            if charge_elementoResponse(elemento, slot) == REACTION_TYPE.COC then
                if slot == 1 then elemento.flankedArmy1 = false else elemento.flankedArmy2 = false end
            else
                local key = charge_elementoUnitKey(elemento, slot)
                local otherKey = charge_elementoOtherKey(elemento, slot)
                local ob = charge_getUnitBases(otherKey)
                local om = ob[1] and charge_getUnitMeta(ob[1])
                local tipo = om and om.unitType
                if tipo ~= "CL" and tipo ~= "FL" then
                    printToAll(string.format("[CARICA] %s contattata sul fianco: perde un livello di coesione",
                        main_decodeExtendedUnitLabel(key)), {r=1,g=0.5,b=0.2})
                    main_lowerAndCheckRout(key, slot, function(item, quando)
                        if quando == "FINE_FASE" then
                            table.insert(IEF_MORALE_END_QUEUE, item)
                        else
                            main_runMoraleQueue({ item })
                        end
                    end)
                end
            end
        end
    end
end
-- ============================================================
-- FUNZIONE: charge_applyPivot(basiObjs, pivotBase, angoloSigned)
-- ============================================================
function charge_applyPivot(basiObjs, pivotBase, angoloSigned)
    local pivotPos = pivotBase.getPosition()
    local angoloGradi = math.deg(angoloSigned)

    for _, obj in ipairs(basiObjs) do
        if obj ~= pivotBase then
            local p = obj.getPosition()
            local rel = Vector(p.x - pivotPos.x, 0, p.z - pivotPos.z)
            local rx = rel.x * math.cos(angoloSigned) - rel.z * math.sin(angoloSigned)
            local rz = rel.x * math.sin(angoloSigned) + rel.z * math.cos(angoloSigned)
            main_setPositionOnGround(obj, pivotPos.x + rx, pivotPos.z + rz, angoloSigned)
        else
            main_setPositionOnGround(obj, pivotPos.x, pivotPos.z, angoloSigned)
        end

        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y - angoloGradi, rot.z))
    end

    main_syncGeneralsOfBases(basiObjs)
end

-- ============================================================
-- FUNZIONE: charge_turnAround180(basiObjs)
-- ============================================================
function charge_turnAround180(basiObjs)
    for _, obj in ipairs(basiObjs) do
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y + 180, rot.z))
    end
end
-- ============================================================
-- FUNZIONE: charge_reactQueueHasPending()
-- Vero se c'è una risoluzione Tiro d'Arresto in corso, o se
-- almeno una riga NON-reciproca non ha ancora una response.
-- Usata sia dal guard sui bottoni fase CHARGE_REACT sia dalla
-- condizione COND.CHARGE_QUEUE_NOT_EMPTY/EMPTY quando serve.
-- ============================================================
function charge_reactQueueHasPending(slot)

    local sh = engine_subShared()
    if sh and sh.name == "STOPFIRE" then return true end
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if not charge_elementoIsReciprocal(e) and e.step ~= CHARGE_STEP.CLO then
            -- Lato SENZA request=true: chi non ha dichiarato deve
            -- ancora scegliere una reazione, a meno che non l'abbia
            -- già fatto (responseArmy{quel lato} impostata).
            -- Con slot: solo le reazioni di quell'esercito.
            if (slot == nil or slot == 1) and not e.requestArmy1 and not e.responseArmy1 then return true end
            if (slot == nil or slot == 2) and not e.requestArmy2 and not e.responseArmy2 then return true end
        end
    end
    return false
end
-- ============================================================
-- FUNZIONE: charge_defenseRowText(slot, elemento)
-- Testo della riga Difesa: "La X è caricata dalla Y" finché la
-- reazione non è scelta, poi la reazione (anche automatica).
-- ============================================================
function charge_defenseRowText(slot, elemento)
    local myKey = charge_elementoUnitKey(elemento, slot)
    local otherKey = charge_elementoOtherKey(elemento, slot)
    local reazione = charge_elementoResponse(elemento, slot)
    local me, lui = main_decodeExtendedUnitLabel(myKey), main_decodeExtendedUnitLabel(otherKey)

    if reazione == REACTION_TYPE.EVA then
        return string.format("La %s evade la %s", me, lui)
    elseif reazione == REACTION_TYPE.COC then
        return string.format("La %s contro carica la %s", me, lui)
    elseif reazione == REACTION_TYPE.TIR then
        return string.format("La %s fa Tiro di Arresto sulla %s", me, lui)
    elseif charge_elementoFlanked(elemento, slot) then
        return string.format("La %s è caricata sul fianco dalla %s", me, lui)
    else
        return string.format("La %s è caricata dalla %s", me, lui)
    end
end
-- ============================================================
-- FUNZIONE: charge_refreshDefenseRowText(slot, elemento)
-- Aggiorna il testo di UNA riga Difesa dopo che la reazione è
-- stata registrata/annullata — la riga resta sempre visibile.
-- ============================================================
function charge_refreshDefenseRowText(slot, elemento)
    local rowId = string.format("charge_defense_row_%d_%d", slot, elemento.id)
    local scelta = charge_elementoResponse(elemento, slot) ~= nil

    UI.setAttribute(rowId, "text", charge_defenseRowText(slot, elemento))
    Wait.frames(function()
        UI.setAttribute(rowId, "textColor", scelta and LISTPANEL.done or LISTPANEL.todo)
    end, 1)
end
-- ============================================================
-- FUNZIONE: charge_attackVerb(slot, elemento)
-- Verbo della riga Attacco secondo la risposta del lato slot.
-- ============================================================
function charge_attackVerb(slot, elemento)
    local r = charge_elementoResponse(elemento, slot)
    if r == REACTION_TYPE.EVA and not charge_elementoRequest(elemento, slot) then return "evade la" end
    if r == REACTION_TYPE.COC then return "contro carica la" end
    return "carica la"
end
-- ============================================================
-- FUNZIONE: charge_attackDoneText(slot, elemento)
-- Messaggio al click su una riga Attacco già eseguita.
-- ============================================================
function charge_attackDoneText(slot, elemento)
    local me  = main_decodeExtendedUnitLabel(charge_elementoUnitKey(elemento, slot))
    local lui = main_decodeExtendedUnitLabel(charge_elementoOtherKey(elemento, slot))
    local r = charge_elementoResponse(elemento, slot)
    if r == REACTION_TYPE.EVA then
        return string.format("La %s ha già evaso la %s", me, lui)
    end
    local mosso = (slot == 1 and elemento.movedArmy1) or (slot == 2 and elemento.movedArmy2)
    if mosso then
        return string.format("La %s ha già caricato la %s", me, lui)
    end
    return string.format("Carica fra la %s e la %s già risolta", me, lui)
end
-- ============================================================
-- FUNZIONE: charge_refreshAttackRowText(slot, elemento)
-- Aggiorna il testo di UNA riga Attacco esistente via
-- UI.setAttribute (la riga esiste già).
-- ============================================================
function charge_refreshAttackRowText(slot, elemento)
    local myKey = charge_elementoUnitKey(elemento, slot)
    local otherKey = charge_elementoOtherKey(elemento, slot)
    local rowId = string.format("charge_attack_row_%d_%d", slot, elemento.id)

    UI.setAttribute(rowId, "text", string.format("La %s %s %s",
        main_decodeExtendedUnitLabel(myKey),
        charge_attackVerb(slot, elemento),
        main_decodeExtendedUnitLabel(otherKey)))
    local fatta = charge_attackRowDone(slot, elemento)
    Wait.frames(function()
        UI.setAttribute(rowId, "textColor", fatta and CHARGE_ROW_DONE_COLOR or "White")
    end, 1)
end
-- ============================================================
-- FUNZIONE: charge_attackRowDone(slot, elemento)
-- Riga Attacco processata: il lato slot ha già mosso (carica o
-- evasione) o la carica è chiusa.
-- ============================================================
CHARGE_ROW_DONE_COLOR = "#5BD35B"
function charge_attackRowDone(slot, elemento)
    if elemento.step == CHARGE_STEP.CLO then return true end
    return (slot == 1 and elemento.movedArmy1) or (slot == 2 and elemento.movedArmy2) or false
end
-- ============================================================
-- FUNZIONE: charge_attackRowShown(slot, elemento)
-- Stesso filtro di charge_getAttackListPanelXml.
-- ============================================================
function charge_attackRowShown(slot, elemento)
    local r = charge_elementoResponse(elemento, slot)
    return charge_elementoRequest(elemento, slot) or r == REACTION_TYPE.COC or r == REACTION_TYPE.EVA
end
-- ============================================================
-- FUNZIONE: charge_refreshAllAttackRows()
-- Dopo un movimento di carica/evasione: aggiorna testo e colore
-- di tutte le righe Attacco di entrambi gli eserciti (un'azione
-- può chiudere anche altre cariche).
-- ============================================================
function charge_refreshAllAttackRows()
    if ENGINE.phase ~= PHASE.CHARGE_AUTO then return end
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        for slot = 1, 2 do
            if charge_attackRowShown(slot, e) then charge_refreshAttackRowText(slot, e) end
        end
    end
end
-- ============================================================
-- FUNZIONE: charge_executeEvade(slot, elemento)
-- ============================================================
function charge_executeEvade(evadingSlot, elemento)

    local evadingKey = charge_elementoUnitKey(elemento, evadingSlot)
    local chargingKey = charge_elementoOtherKey(elemento, evadingSlot)
    local defenderBases = charge_getUnitBases(evadingKey)

    if #defenderBases > 0 then
        local defenderMeta = charge_getUnitMeta(defenderBases[1])
        local defenderTipo = defenderMeta and defenderMeta.unitType
        local unitTypeData = defenderTipo and main_getUnitType(defenderTipo)
        local moveInches = unitTypeData and unitTypeData.move_inches or 0

        local oldFwd = defenderBases[1].getTransformForward()
        local fleeXZ = Vector(-oldFwd.x, 0, -oldFwd.z):normalized()

        -- F42: l'evasione subisce il terreno (decisione Max): percorso
        -- all'indietro col costo del terreno, calcolato prima del
        -- dietrofront (stessa impronta, direzione di fuga)
        local pianoEva = main_terrainPlan(evadingKey, moveInches, moveInches, fleeXZ)
        local costoTerreno = pianoEva.maxT and pianoEva.maxT < moveInches - 0.01
        if costoTerreno then
            printToAll(string.format("[CARICA] L'evasione della %s nel terreno %s: %.1f\" invece di %.1f\"",
                main_decodeExtendedUnitLabel(evadingKey), tostring(pianoEva.cat or pianoEva.chi), pianoEva.maxT, moveInches), {r=1,g=0.6,b=0.2})
            moveInches = pianoEva.maxT
        end

        charge_turnAround180(defenderBases)

        -- Regolamento: "Se incontrano ostacoli insuperabili (terreni
        -- non transitabili o truppe che non possono interpenetrare)
        -- si fermeranno, a loro rischio e pericolo"; le amiche si
        -- attraversano "se hanno abbastanza movimento".
        -- Decisione Max 27/10: l'evasione RIESCE SEMPRE (chi carica
        -- percorre solo la distanza dichiarata, quindi non la tocca);
        -- può solo essere più corta. Anche ferma sul posto: niente
        -- mischia, chi carica si ferma a filo.
        local passo = main_pathCheck(evadingKey, moveInches, { margineNemico = 0, nonFermarsiSopra = true })
        if passo.avanza < moveInches - 0.01 then
            printToAll(string.format("[CARICA] L'evasione della %s si ferma dopo %.1f\" (%s)",
                main_decodeExtendedUnitLabel(evadingKey), passo.avanza,
                (passo.motivo == "terreno") and "terreno intransitabile"
                or (passo.chi and main_decodeExtendedUnitLabel(passo.chi)) or "ostacolo"), {r=1,g=0.6,b=0.2})
            moveInches = passo.avanza
        end

        local deltaUnits = moveInches * INCH_TO_TTS
        for _, obj in ipairs(defenderBases) do
            local p = obj.getPosition()
            main_setPositionOnGround(obj, p.x + fleeXZ.x*deltaUnits, p.z + fleeXZ.z*deltaUnits)
        end

        main_generalFlipAndMove(evadingKey, fleeXZ.x, fleeXZ.z, deltaUnits)
        main_terrainCohesionAfterMove(evadingKey)   -- F42

        -- Dopo il dietrofront il rango posteriore è cambiato: il
        -- pulsante va sulla nuova base d'angolo (come in formazione).
        -- Qualche frame di attesa: rotazione/posizione già applicate.
        Wait.frames(function()
            main_riposizionaPulsanteFormazione(evadingKey, charge_getUnitBases(evadingKey))
        end, 5)
    end

    IEF_UNIT_NO_MOVE_NEXT_TURN[evadingKey] = true
    elemento.outcome = CHARGE_OUTCOME.EVI

    if evadingSlot == 1 then elemento.movedArmy1 = true else elemento.movedArmy2 = true end
    if elemento.movedArmy1 and elemento.movedArmy2 then
        elemento.step = CHARGE_STEP.CLO
    end

    warning(string.format("[CARICA] %s evade la carica di %s", evadingKey, chargingKey), "Yellow")
end
-- ============================================================
-- FUNZIONE: charge_hasCapability(capabilities, nome)
-- Helper generico: vero se "nome" è fra le capacità dell'unità.
-- ============================================================
function charge_hasCapability(capabilities, nome)
    for _, c in ipairs(capabilities or {}) do
        if c == nome then return true end
    end
    return false
end


-- ============================================================
-- FUNZIONE: charge_isMandatoryCharge(attackerTipo, attackerCapabilities, targetTipo)
-- ============================================================
function charge_isMandatoryCharge(attackerTipo, attackerCapabilities, targetTipo)
    if attackerTipo == "KN" and targetTipo ~= "FL" and targetTipo ~= "EL" then
        return true
    end
    if attackerTipo == "CP" and charge_hasCapability(attackerCapabilities, "IMPETO") and targetTipo ~= "FL" and targetTipo ~= "EL" then
        return true
    end
    if (attackerTipo == "FP" or attackerTipo == "FM") and charge_hasCapability(attackerCapabilities, "IMPETO") then
        if targetTipo == "FP" or targetTipo == "FM" or targetTipo == "FL" then
            return true
        end
    end
    return false
end
-- ============================================================
-- FUNZIONE: charge_checkMandatoryObligations(slot) 
-- ============================================================
function charge_checkMandatoryObligations(slot)
    local violazioni = {}
    local unita = main_listUnits()

    for unitKey, info in pairs(unita) do
        if info.slot == slot and (info.tipo == "KN" or info.tipo == "CP" or info.tipo == "FP" or info.tipo == "FM") then
            if not charge_alreadyDeclared(slot, unitKey) then
                local bases = charge_getUnitBases(unitKey)
                local meta = bases[1] and charge_getUnitMeta(bases[1])
                local capabilities = main_capabilitiesOf(unitKey, meta)

                local targetKey, _, _, lineHost = charge_findLineTarget(unitKey, slot)

                if targetKey then
                    local targetBases = charge_getUnitBases(targetKey)
                    local targetMeta = targetBases[1] and charge_getUnitMeta(targetBases[1])
                    local targetTipo = targetMeta and targetMeta.unitType

                    if charge_isMandatoryCharge(info.tipo, capabilities, targetTipo) then
                        table.insert(violazioni, unitKey)
                    end
                end
            end
        end
    end

    return violazioni
end
-- ============================================================
-- FUNZIONE: charge_chargeTestFor(attackerKey, targetKey)
-- Situazione della tabella del morale che obbliga il caricante a
-- un test prima di caricare (evento CHARGE_DECLARE), o nil.
-- ============================================================
function charge_chargeTestFor(attackerKey, targetKey)
    local myMeta     = charge_getUnitMeta(charge_getUnitBases(attackerKey)[1])
    local targetMeta = charge_getUnitMeta(charge_getUnitBases(targetKey)[1])
    local situazioni = main_moraleSituationsFor("CHARGE_DECLARE", {
        tipo           = myMeta and myMeta.unitType,
        tipoAvversario = targetMeta and targetMeta.unitType,
        lato           = charge_isFlankCharge(attackerKey, targetKey) and "FIANCO" or "FRONTE",
        armi           = myMeta and myMeta.armi or {},
    })
    for _, s in ipairs(situazioni) do
        if s.def.testa == "CARICANTE" then return s end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: charge_runPendingChargeTests()
-- Manda nel pannello morale, tutti insieme, i test per caricare
-- delle cariche obbligatorie in attesa (ognuno nel pannello del
-- suo esercito). Superato -> carica registrata; fallito -> non
-- carica (IEF_CHARGE_TEST_FAILED).
-- ============================================================
function charge_runPendingChargeTests()
    local tests = IEF_CHARGE_PENDING_TESTS
    IEF_CHARGE_PENDING_TESTS = {}

    for _, dati in ipairs(tests) do
        main_requestMoraleRoll(dati.unitKey, dati.slot, dati.test.def.effetto or "per_caricare", nil, dati.test.nome,
            "charge_mandatoryTestDone", dati)
    end

    callHandler("buildUI")
    callHandler("updateCenterPanel")
end
-- ============================================================
-- FUNZIONE: charge_mandatoryTestDone(dati, esito)
-- Esito del test per caricare di una carica obbligatoria.
-- ============================================================
function charge_mandatoryTestDone(dati, esito)
    if esito == MORALE_RESULT.OK then
        charge_registerMandatory(dati)
    else
        IEF_CHARGE_TEST_FAILED[dati.unitKey] = true
        printToAll(string.format("[CARICA] %s non supera il test: non carica", main_decodeExtendedUnitLabel(dati.unitKey)), {r=1,g=0.6,b=0.4})
    end
end
registerHandler("charge_mandatoryTestDone", function(dati, esito) return charge_mandatoryTestDone(dati, esito) end)
-- ============================================================
-- FUNZIONE: charge_autoDeclareMandatory(slot)
-- ============================================================
function charge_autoDeclareMandatory(slot)
    local unita = main_listUnits()

    for unitKey, info in pairs(unita) do
        if info.slot == slot and (info.tipo == "KN" or info.tipo == "CP" or info.tipo == "FP" or info.tipo == "FM") then
            if not charge_alreadyDeclared(slot, unitKey) then
                local bases = charge_getUnitBases(unitKey)
                if #bases > 0 then
                    local meta = charge_getUnitMeta(bases[1])
                    local capabilities = main_capabilitiesOf(unitKey, meta)

                    local targetKey, _, distInches, lineHost = charge_findLineTarget(unitKey, slot)

                    if lineHost then
                        lineHost.setVectorLines({})
                    end

                    if targetKey then
                        local targetBases = charge_getUnitBases(targetKey)
                        local targetMeta = targetBases[1] and charge_getUnitMeta(targetBases[1])
                        local targetTipo = targetMeta and targetMeta.unitType

                        if charge_isMandatoryCharge(info.tipo, capabilities, targetTipo) then
                            local dati = { slot = slot, unitKey = unitKey, targetKey = targetKey, distInches = distInches }
                            local test = charge_chargeTestFor(unitKey, targetKey)
                            if test then
                                dati.test = test
                                table.insert(IEF_CHARGE_PENDING_TESTS, dati)
                            else
                                charge_registerMandatory(dati)
                            end
                        end
                    end
                end
            end
        end
    end
end
-- ============================================================
-- FUNZIONE: charge_registerMandatory(dati)
-- Registra in coda una carica obbligatoria dichiarata in
-- automatico. dati = { slot, unitKey, targetKey, distInches }
-- Salva le basi più vicine (closestBaseArmy1/2) come la
-- dichiarazione manuale (charge_declareConfirm).
-- ============================================================
function charge_registerMandatory(dati)
    local slot, unitKey, targetKey = dati.slot, dati.unitKey, dati.targetKey
    local otherSlot = charge_elementoOtherSlot(slot)
    local elemento = charge_findOrCreateElement(slot, unitKey, otherSlot, targetKey)
    charge_elementoSetRequest(elemento, slot, true)
    charge_elementoSetDeclareData(elemento, slot, 0, dati.distInches)

    if not elemento.closestBaseArmy1 and not elemento.closestBaseArmy2 then
        local myBases = charge_getUnitBases(unitKey)
        local targetBases = charge_getUnitBases(targetKey)
        local closestMine, closestTheirs = charge_closestBasePair(myBases, targetBases)
        if closestMine and closestTheirs then
            if slot == 1 then
                elemento.closestBaseArmy1 = closestMine.getGUID()
                elemento.closestBaseArmy2 = closestTheirs.getGUID()
            else
                elemento.closestBaseArmy2 = closestMine.getGUID()
                elemento.closestBaseArmy1 = closestTheirs.getGUID()
            end
        end
    end

    printToAll(string.format("[CARICA] %s è obbligata a caricare %s (dichiarazione automatica)",
        main_decodeExtendedUnitLabel(unitKey), main_decodeExtendedUnitLabel(targetKey)), {r=1,g=0.7,b=0.2})
end

-- ============================================================
-- FUNZIONE: charge_closestBasePair(basesA, basesB)
-- Trova la coppia di basi (una da basesA, una da basesB) con la
-- distanza bordo-a-bordo minima (main_distanceInches). Ritorna
-- baseA, baseB, distanzaInch.
-- ============================================================
function charge_closestBasePair(basesA, basesB)
    local migliorA, migliorB, migliorDist = nil, nil, nil

    for _, a in ipairs(basesA) do
        for _, b in ipairs(basesB) do
            local d = main_distanceInches(a, b)
            if d and (migliorDist == nil or d < migliorDist) then
                migliorDist = d
                migliorA = a
                migliorB = b
            end
        end
    end

    return migliorA, migliorB, migliorDist
end
-- ============================================================
-- FUNZIONE: charge_alignToEnemy(myKey, enemyKey)
-- Regolamento, MOVIMENTO DI CARICA: "Quando l'unità che carica
-- contatterà il nemico dovrà mettere le basi a contatto,
-- adeguandosi al fronte dell'unità nemica, in modo da mettere
-- sempre una base contro una base".
-- 1) lato del nemico contattato (fronte, fianco sx/dx, retro)
--    dalla posizione dell'unità rispetto al rettangolo nemico;
-- 2) l'unità ruota (formazione rigida) per guardare quel lato;
-- 3) avanza/arretra finché il suo fronte tocca il lato;
-- 4) scorre lateralmente per mettere base contro base (lo
--    spostamento più piccolo che allinea una sua base di fronte
--    con una base nemica di quel lato).
-- Ritorna il lato: "FRONTE" | "FIANCO" | "RETRO" (nil se non fatto).
-- ============================================================
CHARGE_ALIGN_TOL = 0.1

-- Angolo (radianti, -pi..pi) del vettore (x, y): sostituisce
-- math.atan2, deprecata, usando solo math.atan a un argomento.
function charge_angolo(y, x)
    if x > 0 then return math.atan(y / x) end
    if x < 0 then
        if y >= 0 then return math.atan(y / x) + math.pi end
        return math.atan(y / x) - math.pi
    end
    if y > 0 then return math.pi / 2 end
    if y < 0 then return -math.pi / 2 end
    return 0
end
function charge_alignToEnemy(myKey, enemyKey, sulFianco)
    local mie, sue = charge_getUnitBases(myKey), charge_getUnitBases(enemyKey)
    if #mie == 0 or #sue == 0 then return nil end
    local mioTipo = (charge_getUnitMeta(mie[1]) or {}).unitType
    local suoTipo = (charge_getUnitMeta(sue[1]) or {}).unitType

    local function rects(basi, tipo)
        local out = {}
        for _, b in ipairs(basi) do table.insert(out, main_baseRectOfType(b, tipo)) end
        return out
    end
    local function dot(c, v) return c.x * v.x + c.z * v.z end

    -- 1) lato contattato, nel riferimento del nemico
    local f0 = sue[1].getTransformForward()
    local tf = Vector(f0.x, 0, f0.z):normalized()
    local tr = Vector(-tf.z, 0, tf.x)
    local fronte, retro, sx, dx = -math.huge, math.huge, math.huge, -math.huge
    for _, r in ipairs(rects(sue, suoTipo)) do
        for _, c in ipairs(r.corners) do
            local v, u = dot(c, tf), dot(c, tr)
            if v > fronte then fronte = v end
            if v < retro then retro = v end
            if u < sx then sx = u end
            if u > dx then dx = u end
        end
    end
    local cx, cz = 0, 0
    for _, b in ipairs(mie) do local p = b.getPosition(); cx = cx + p.x; cz = cz + p.z end
    local centro = { x = cx / #mie, z = cz / #mie }
    local v, u = dot(centro, tf), dot(centro, tr)

    local lato, dir
    -- distanza fuori dal rettangolo per ciascun lato: il più "fuori" vince
    local fuori = {
        { "FRONTE", v - fronte, Vector(-tf.x, 0, -tf.z) },
        { "RETRO",  retro - v,  Vector(tf.x, 0, tf.z) },
        { "FIANCO", sx - u,     Vector(tr.x, 0, tr.z) },
        { "FIANCO", u - dx,     Vector(-tr.x, 0, -tr.z) },
    }
    -- Carica che NON si qualifica sul fianco: il contatto è sempre
    -- sul fronte (regolamento: "il contatto si qualificherà comunque
    -- come carica sul fronte"). Sul fianco: fianco o retro, secondo
    -- la posizione.
    local migliore = nil
    if sulFianco then
        for i = 2, 4 do
            local o = fuori[i]
            if not migliore or o[2] > migliore[2] then migliore = o end
        end
    else
        migliore = fuori[1]
    end
    lato, dir = migliore[1], migliore[3]

    -- 2) rotazione rigida verso il lato (stessa convenzione di charge_applyPivot)
    local f1 = mie[1].getTransformForward()
    local mf = Vector(f1.x, 0, f1.z):normalized()
    local ang = charge_angolo(mf.x * dir.z - mf.z * dir.x, mf.x * dir.x + mf.z * dir.z)
    if math.abs(ang) > 0.001 then
        local perno = charge_closestBaseToPoint(mie, Vector(centro.x, 0, centro.z)) or mie[1]
        charge_applyPivot(mie, perno, ang)
    end

    -- 3) fronte a contatto con il lato
    local mieR = rects(mie, mioTipo)
    local mioFronte = -math.huge
    for _, r in ipairs(mieR) do
        for _, c in ipairs(r.corners) do mioFronte = math.max(mioFronte, dot(c, dir)) end
    end
    local suoLato = math.huge
    local sueR = rects(sue, suoTipo)
    for _, r in ipairs(sueR) do
        for _, c in ipairs(r.corners) do suoLato = math.min(suoLato, dot(c, dir)) end
    end
    local avanti = suoLato - mioFronte

    -- 4) base contro base: centri laterali delle basi di fronte
    local lat = Vector(-dir.z, 0, dir.x)
    local mieFronte, sueLato = {}, {}
    for _, r in ipairs(mieR) do
        local m = -math.huge
        for _, c in ipairs(r.corners) do m = math.max(m, dot(c, dir)) end
        if m >= mioFronte - CHARGE_ALIGN_TOL then table.insert(mieFronte, r.x * lat.x + r.z * lat.z) end
    end
    for _, r in ipairs(sueR) do
        local m = math.huge
        for _, c in ipairs(r.corners) do m = math.min(m, dot(c, dir)) end
        if m <= suoLato + CHARGE_ALIGN_TOL then table.insert(sueLato, r.x * lat.x + r.z * lat.z) end
    end
    local scorri = nil
    for _, a in ipairs(mieFronte) do
        for _, b in ipairs(sueLato) do
            local d = b - a
            if not scorri or math.abs(d) < math.abs(scorri) then scorri = d end
        end
    end
    scorri = scorri or 0

    for _, o in ipairs(mie) do
        local p = o.getPosition()
        main_setPositionOnGround(o, p.x + dir.x * avanti + lat.x * scorri, p.z + dir.z * avanti + lat.z * scorri)
    end
    main_syncGeneralsOfBases(mie)
    return lato
end

-- ============================================================
-- MOVIMENTO DI CARICA IN LINEA RETTA (regolamento: "sempre in
-- linea retta ed è permesso un solo perno di massimo 2 pollici ad
-- inizio mossa"; il perno è già applicato in dichiarazione).
-- charge_straightContactInches: pollici che l'unità percorre lungo
-- il SUO fronte prima di toccare l'unità bersaglio (rettangoli
-- reali delle basi); nil se andando dritta non la tocca.
-- ============================================================
function charge_straightContactInches(myKey, targetKey)
    local mie, sue = charge_getUnitBases(myKey), charge_getUnitBases(targetKey)
    if #mie == 0 or #sue == 0 then return nil end
    local tm = (charge_getUnitMeta(mie[1]) or {}).unitType
    local ts = (charge_getUnitMeta(sue[1]) or {}).unitType
    local f = mie[1].getTransformForward()
    local dir = Vector(f.x, 0, f.z):normalized()
    local tol = 0.01
    local migliore = nil
    for _, a in ipairs(mie) do
        local ra = main_baseRectOfType(a, tm)
        for _, b in ipairs(sue) do
            local rb = main_baseRectOfType(b, ts)
            local t1, t2 = main_rectSweepInterval(ra, dir.x, dir.z, rb, tol)
            if t1 and t2 > 0 then
                local d = math.max(0, t1)
                if not migliore or d < migliore then migliore = d end
            end
        end
    end
    return migliore and (migliore / INCH_TO_TTS) or nil, dir
end

-- Trasla tutte le basi lungo dir (versore XZ) di "pollici"
function charge_moveStraight(basi, dir, pollici)
    if pollici <= 0 then return end
    local d = pollici * INCH_TO_TTS
    for _, o in ipairs(basi) do
        local p = o.getPosition()
        main_setPositionOnGround(o, p.x + dir.x * d, p.z + dir.z * d)
    end
    main_syncGeneralsOfBases(basi)
end

-- ============================================================
-- FUNZIONE: charge_pendingMoveOf(slot, unitKey, escludi)
-- Carica (diversa da escludi, non chiusa) in cui l'unità deve
-- ancora fare il SUO movimento: carica dichiarata o
-- contro-carica non ancora eseguita. nil se non ne ha.
-- ============================================================
function charge_pendingMoveOf(slot, unitKey, escludi)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if e ~= escludi and e.step ~= CHARGE_STEP.CLO and charge_elementoUnitKey(e, slot) == unitKey then
            local mosso = (slot == 1 and e.movedArmy1) or (slot == 2 and e.movedArmy2)
            local devo = charge_elementoRequest(e, slot) or charge_elementoResponse(e, slot) == REACTION_TYPE.COC
            if devo and not mosso then return e end
        end
    end
    return nil
end
-- ============================================================
-- FUNZIONE: charge_executeChargeMove(player, unitKey)
-- ============================================================
function charge_executeChargeMove(player, unitKey, elementoDato)
    local slot = main_getArmyByColor(player)
    local elemento = elementoDato or charge_findQueueEntry(slot, unitKey)
    if not elemento then
        printToColor("[CARICA] Nessuna carica trovata per " .. unitKey, player.color, {r=1,g=0.6,b=0})
        return
    end
    if elemento.step == CHARGE_STEP.CLO then
        printToColor("[CARICA] Questa carica è già stata risolta", player.color, {r=1,g=0.6,b=0})
        return
    end

    local giaMossoIoStesso = (slot == 1 and elemento.movedArmy1) or (slot == 2 and elemento.movedArmy2)
    if giaMossoIoStesso then
        warningToColor("L'unità ha già eseguito il movimento di carica", player, "Yellow", 5)
        return
    end

    local otherSlot = charge_elementoOtherSlot(slot)
    local reciproca = charge_elementoIsReciprocal(elemento)
    local otherResponse = charge_elementoResponse(elemento, otherSlot)
    local otherMoved = (otherSlot == 1 and elemento.movedArmy1) or (otherSlot == 2 and elemento.movedArmy2)

    -- Il bersaglio ha evaso un'altra carica: anche questa è evitata
    local evasione = charge_evasionOf(otherSlot, charge_elementoUnitKey(elemento, otherSlot))
    if evasione and evasione ~= elemento then
        otherResponse = REACTION_TYPE.EVA
        otherMoved = (otherSlot == 1 and evasione.movedArmy1) or (otherSlot == 2 and evasione.movedArmy2)
    end

    if otherResponse == REACTION_TYPE.EVA and not otherMoved then
        warningToColor(string.format("Attendi l'evasione della %s prima di caricare", main_decodeExtendedUnitLabel(charge_elementoUnitKey(elemento, otherSlot))), player, "Yellow", 5, true)
        return
    end

    -- Ordine dei movimenti (punto 12): chi carica un'unità che ha
    -- ancora un suo movimento di carica/contro-carica da fare in
    -- un'altra carica deve aspettarla, poi la raggiunge dove è
    -- arrivata.
    local otherKey = charge_elementoUnitKey(elemento, otherSlot)
    local ioCarico = charge_elementoRequest(elemento, slot) and not reciproca
    if ioCarico and otherResponse ~= REACTION_TYPE.EVA then
        local attesa = charge_pendingMoveOf(otherSlot, otherKey, elemento)
        if attesa then
            warningToColor(string.format("Attendi il movimento della %s prima di caricarla",
                main_decodeExtendedUnitLabel(otherKey)), player, "Yellow", 5, true)
            return
        end
    end

    local myBases = charge_getUnitBases(unitKey)
    if #myBases == 0 then return end

    if otherResponse == REACTION_TYPE.EVA then
        -- Il bersaglio è già fuggito (o sta per farlo): il
        -- caricante NON deve mai misurare/muoversi verso la sua
        -- posizione live (che si è spostata) — percorre solo la
        -- PROPRIA distanza dichiarata, lungo il proprio fronte
        -- fisso, ignorando dove è finita l'unità evasa.
        local distanzaDichiarata = charge_elementoDistInches(elemento, slot) or 0

        IEF_MOVE_UNITS[unitKey] = { basiObjs = myBases, history = {}, carica = true }
        IEF_MOVE_BUDGET[unitKey] = distanzaDichiarata
        move_avanti_apply(unitKey, distanzaDichiarata)
        main_syncAttachedGeneral(unitKey)
        main_terrainCohesionAfterMove(unitKey)   -- F42: disordine da terreno
        IEF_MOVE_UNITS[unitKey] = nil
        IEF_MOVE_BUDGET[unitKey] = nil

        elemento.outcome = CHARGE_OUTCOME.EVI

        if slot == 1 then elemento.movedArmy1 = true else elemento.movedArmy2 = true end
        IEF_UNIT_NO_MOVE_NEXT_TURN[unitKey] = true
        if (elemento.movedArmy1 and elemento.movedArmy2)
           or charge_elementoResponse(elemento, otherSlot) ~= REACTION_TYPE.EVA then
            elemento.step = CHARGE_STEP.CLO
        end

        warningToColor(string.format("[CARICA] %s percorre %.2f\" (bersaglio evaso, distanza dichiarata)", main_decodeExtendedUnitLabel(unitKey), distanzaDichiarata), player, "Yellow", 5, true)
        return
    end

    local isCounterCharge = reciproca
        or elemento.responseArmy1 == REACTION_TYPE.COC
        or elemento.responseArmy2 == REACTION_TYPE.COC

    local myBaseGUID = (slot == 1) and elemento.closestBaseArmy1 or elemento.closestBaseArmy2
    local otherBaseGUID = (slot == 1) and elemento.closestBaseArmy2 or elemento.closestBaseArmy1
    if not myBaseGUID or not otherBaseGUID then
        warningToColor("[CARICA] Nessuna base di riferimento salvata per " .. main_decodeExtendedUnitLabel(unitKey), player, "Yellow", 5, true)
        return
    end

    local myBase = getObjectFromGUID(myBaseGUID)
    local otherBase = getObjectFromGUID(otherBaseGUID)
    if not myBase or not otherBase then
        printToColor("[CARICA] Base di riferimento non più presente sul tavolo per " .. unitKey, player.color, {r=1,g=0.6,b=0})
        return
    end

    -- In linea retta lungo il proprio fronte se così tocca il
    -- bersaglio; altrimenti (bersaglio spostato: contro-carica verso
    -- un altro, evasione bloccata) verso la base nemica più vicina.
    local dritto, dirDritto = charge_straightContactInches(unitKey, otherKey)
    local distanzaTotaleInch = dritto or main_distanceInchesAlongCenters(myBase, otherBase)
    if not distanzaTotaleInch then return end

    -- print(string.format("[DEBUG CHARGEMOVE] myBase.rot=%.1f otherBase.rot=%.1f distanzaTotaleInch=%.3f",
    --     myBase.getRotation().y, otherBase.getRotation().y, distanzaTotaleInch))

    local distanzaDaPercorrere = distanzaTotaleInch

    if isCounterCharge then
        local otherGiaMosso = (slot == 1 and elemento.movedArmy2) or (slot == 2 and elemento.movedArmy1)
        if not otherGiaMosso then
            distanzaDaPercorrere = distanzaTotaleInch / 2
        end
    elseif elemento.outcome == CHARGE_OUTCOME.ANN then
        distanzaDaPercorrere = math.max(0, distanzaTotaleInch - 2)
    end

    -- Il bersaglio si è già spostato (contro-carica verso un'altra
    -- unità): lo si insegue fino alla nuova posizione, ma non oltre
    -- il proprio movimento massimo; se non lo si raggiunge la carica
    -- fallisce (decisione Max 23/10).
    local nonRaggiunge = false
    if ioCarico and IEF_CHARGE_MOVED[otherKey] then
        local massimo = main_unitFullMove(unitKey)
        if massimo > 0 and distanzaDaPercorrere > massimo then
            distanzaDaPercorrere = massimo
            nonRaggiunge = true
        end
    end

    local myOriginBase = charge_closestBaseToPoint(myBases, otherBase.getPosition())
    if not myOriginBase then return end

    -- print(string.format("[DEBUG CHARGEMOVE] myBase(salvata)=%s myOriginBase(ricalcolata)=%s STESSA=%s",
    --     myBase.getGUID(), myOriginBase.getGUID(), tostring(myBase.getGUID() == myOriginBase.getGUID())))
    -- print(string.format("[DEBUG CHARGEMOVE] distanzaTotaleInch(da myBase fissata)=%.3f distanzaVerificaOra(da myOriginBase)=%.3f",
    --     distanzaTotaleInch, main_distanceInches(myOriginBase, otherBase) or -1))

    if dritto then
        charge_moveStraight(myBases, dirDritto, distanzaDaPercorrere)
    else
        charge_moveTowardPoint(myBases, myOriginBase, otherBase.getPosition(), distanzaDaPercorrere)
    end
    IEF_CHARGE_MOVED[unitKey] = true

    if nonRaggiunge then
        elemento.outcome = CHARGE_OUTCOME.ANN
        elemento.step = CHARGE_STEP.CLO
        if slot == 1 then elemento.movedArmy1 = true else elemento.movedArmy2 = true end
        IEF_UNIT_NO_MOVE_NEXT_TURN[unitKey] = true
        main_terrainCohesionAfterMove(unitKey)   -- F42: disordine da terreno
        warningToColor(string.format("[CARICA] %s percorre %.2f\" (massimo) e non raggiunge la %s: carica fallita",
            main_decodeExtendedUnitLabel(unitKey), distanzaDaPercorrere, main_decodeExtendedUnitLabel(otherKey)), player, "Yellow", 6, true)
        printToAll(string.format("[CARICA] %s non raggiunge la %s: carica fallita",
            main_decodeExtendedUnitLabel(unitKey), main_decodeExtendedUnitLabel(otherKey)), {r=1,g=0.6,b=0.2})
        return
    end

    elemento.outcome = elemento.outcome or CHARGE_OUTCOME.OK
    
    if slot == 1 then elemento.movedArmy1 = true else elemento.movedArmy2 = true end
    IEF_UNIT_NO_MOVE_NEXT_TURN[unitKey] = true
    if isCounterCharge then
        if elemento.movedArmy1 and elemento.movedArmy2 then
            elemento.step = CHARGE_STEP.CLO
        end
    else
        elemento.step = CHARGE_STEP.CLO
    end
    if elemento.step == CHARGE_STEP.CLO and elemento.outcome == CHARGE_OUTCOME.OK then
        -- Base contro base sul lato contattato; il fianco vale solo
        -- se il contatto è davvero sul fianco o sul retro.
        local lato = charge_alignToEnemy(unitKey, otherKey, charge_elementoFlanked(elemento, otherSlot))
        -- Unità in rotta raggiunta: rischio per il Generale aggregato
        main_generalRoutCaught(otherKey)
        if lato == "FRONTE" and charge_elementoFlanked(elemento, otherSlot) then
            if otherSlot == 1 then elemento.flankedArmy1 = false else elemento.flankedArmy2 = false end
            printToAll(string.format("[CARICA] Contatto sul fronte della %s: non è una carica sul fianco",
                main_decodeExtendedUnitLabel(otherKey)), {r=0.8,g=0.8,b=0.8})
        end
        charge_applyFlankContact(elemento)
        charge_elephantContact(elemento)
    end

    -- F42: chi finisce la carica (o la contro-carica) in un terreno
    -- che disordina si disordina
    main_terrainCohesionAfterMove(unitKey)
    warningToColor(string.format("[CARICA] %s percorre %.2f\" (di %.2f\" totali)", main_decodeExtendedUnitLabel(unitKey), distanzaDaPercorrere, distanzaTotaleInch), player, "Yellow", 5, true)
end
-- ============================================================
-- FUNZIONE: charge_moveTowardPoint(unitKey, basiObjs, targetPos, distanzaInch)
-- ============================================================
function charge_moveTowardPoint(basiObjs, originBase, targetPos, distanzaInch)
    if #basiObjs == 0 or not originBase then return end

    -- Difensivo: se targetPos è un oggetto TTS (per un salvataggio
    -- fatto senza .getPosition() da qualche parte) invece di un
    -- Vector, lo converto qui invece di rompere tutto.
    if type(targetPos) == "userdata" and targetPos.getPosition then
        targetPos = targetPos.getPosition()
    end

    local origin = originBase.getPosition()
    local dir = Vector(targetPos.x - origin.x, 0, targetPos.z - origin.z)
    local len = math.sqrt(dir.x*dir.x + dir.z*dir.z)
    if len < 0.0001 then return end

    local dirNorm = Vector(dir.x / len, 0, dir.z / len)
    local deltaUnits = distanzaInch * INCH_TO_TTS

    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        main_setPositionOnGround(obj, p.x + dirNorm.x*deltaUnits, p.z + dirNorm.z*deltaUnits)
    end

    main_syncGeneralsOfBases(basiObjs)
end
-- ============================================================
-- FUNZIONE: charge_closestBaseToPoint(basiObjs, point)
-- ============================================================
function charge_closestBaseToPoint(basiObjs, point)
    local migliore, migliorDist = nil, nil
    for _, obj in ipairs(basiObjs) do
        local d = main_distanceInchesToPoint(obj, point)
        if d and (migliorDist == nil or d < migliorDist) then
            migliorDist = d
            migliore = obj
        end
    end
    return migliore, migliorDist
end
-- ============================================================
-- FUNZIONE: charge_slotStillNeedsAction(elemento, slot)
-- Vero se ARMY{slot} ha ancora un'azione da compiere su questo
-- elemento. Per la reciproca/COC controlla il proprio movedArmy
-- (l'altro lato può restare pendente senza bloccarmi); per gli
-- altri casi (Ferma/Tiro riuscito/Evasione) solo il lato
-- effettivamente coinvolto (caricante o evaso) è bloccante.
-- ============================================================
function charge_slotStillNeedsAction(elemento, slot)
    if elemento.step == CHARGE_STEP.CLO then return false end

    local reciproca = charge_elementoIsReciprocal(elemento)
    local isCounterCharge = reciproca or elemento.responseArmy1 == REACTION_TYPE.COC or elemento.responseArmy2 == REACTION_TYPE.COC

    if isCounterCharge then
        local myMoved = (slot == 1 and elemento.movedArmy1) or (slot == 2 and elemento.movedArmy2)
        return not myMoved
    end

    local myResponse = charge_elementoResponse(elemento, slot)
    local myMoved = (slot == 1 and elemento.movedArmy1) or (slot == 2 and elemento.movedArmy2)
    if myResponse == REACTION_TYPE.EVA and not charge_elementoRequest(elemento, slot) then
        -- l'evasione è l'azione di questo esercito: fatta = libero
        return not myMoved
    end

    local chargingSlot = elemento.requestArmy1 and 1 or (elemento.requestArmy2 and 2 or nil)
    return chargingSlot == slot and not myMoved
end
-- ============================================================
-- FUNZIONE: charge_stopfireMoveToRange(elemento, defenderSlot)
-- Movimento OBBLIGATORIO (regolamento righe 367-370): il
-- caricante si ferma a 2" dal bersaglio PRIMA di ricevere il
-- Tiro d'Arresto — necessario perché la gittata/LOS del tiro
-- (shoot_basiPronte) misura le posizioni ATTUALI, non un valore
-- calcolato a posteriori.
-- ============================================================
function charge_stopfireMoveToRange(elemento, defenderSlot)
    local chargingSlot = charge_elementoOtherSlot(defenderSlot)
    local chargingKey = charge_elementoUnitKey(elemento, chargingSlot)
    local chargingBases = charge_getUnitBases(chargingKey)
    if #chargingBases == 0 then return end

    local myBaseGUID = (chargingSlot == 1) and elemento.closestBaseArmy1 or elemento.closestBaseArmy2
    local otherBaseGUID = (chargingSlot == 1) and elemento.closestBaseArmy2 or elemento.closestBaseArmy1
    if not myBaseGUID or not otherBaseGUID then return end

    local myBase = getObjectFromGUID(myBaseGUID)
    local otherBase = getObjectFromGUID(otherBaseGUID)
    if not myBase or not otherBase then return end

    local defenderKey = charge_elementoUnitKey(elemento, defenderSlot)
    local dritto, dirDritto = charge_straightContactInches(chargingKey, defenderKey)
    local distanzaTotaleInch = dritto or main_distanceInchesAlongCenters(myBase, otherBase)
    if not distanzaTotaleInch then return end

    local distanzaDaPercorrere = math.max(0, distanzaTotaleInch - 2)
    if distanzaDaPercorrere <= 0 then return end

    if dritto then
        charge_moveStraight(chargingBases, dirDritto, distanzaDaPercorrere)
    else
        local myOriginBase = charge_closestBaseToPoint(chargingBases, otherBase.getPosition())
        if not myOriginBase then return end
        charge_moveTowardPoint(chargingBases, myOriginBase, otherBase.getPosition(), distanzaDaPercorrere)
    end
    -- Ha già fatto parte del movimento di carica: in manovra non muove
    -- (anche se poi fallisce il morale dopo il tiro)
    IEF_UNIT_NO_MOVE_NEXT_TURN[chargingKey] = true
end
-- ============================================================
-- FUNZIONE: charge_autoResolveResponses()
-- Ingresso in CHARGE_REACT: per ogni carica NON reciproca, il
-- lato caricato che non ha una vera scelta riceve subito la
-- risposta:
--   - risposta obbligatoria (KN / CP+IMPETO contro-carica,
--     FL evasione) -> applicata;
--   - nessuna opzione disponibile -> Ferma.
-- Così in lista restano solo le unità che devono SCEGLIERE e il
-- gate charge_reactQueueHasPending non resta bloccato.
-- ============================================================
function charge_autoResolveResponses()
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if not charge_elementoIsReciprocal(e) and e.step ~= CHARGE_STEP.CLO then
            for slot = 1, 2 do
                local otherSlot = charge_elementoOtherSlot(slot)
                if charge_elementoRequest(e, otherSlot)
                   and not charge_elementoRequest(e, slot)
                   and charge_elementoResponse(e, slot) == nil then

                    local myKey    = charge_elementoUnitKey(e, slot)
                    local otherKey = charge_elementoUnitKey(e, otherSlot)
                    local myBases    = charge_getUnitBases(myKey)
                    local otherBases = charge_getUnitBases(otherKey)
                    local myMeta     = myBases[1] and charge_getUnitMeta(myBases[1])
                    local otherMeta  = otherBases[1] and charge_getUnitMeta(otherBases[1])

                    local obbligato, opzioni = charge_determineResponses(
                        myMeta and myMeta.unitType,
                        myMeta and myMeta.armi or {},
                        main_capabilitiesOf(myKey, myMeta),
                        otherMeta and otherMeta.unitType,
                        main_isMistaMeta(myMeta),
                        main_unitsInMelee()[myKey] == true)

                    local risposta = obbligato
                    if not risposta and #opzioni == 0 then
                        risposta = REACTION_TYPE.FER
                    end
                    if charge_unitReaction(slot, myKey) then
                        risposta = nil   -- già applicata da charge_setOtherReactions
                    end

                    if risposta then
                        charge_elementoSetResponse(e, slot, risposta)

                        if risposta == REACTION_TYPE.COC and not e.closestBaseArmy1 and not e.closestBaseArmy2 then
                            local closestMine, closestTheirs = charge_closestBasePair(myBases, otherBases)
                            if closestMine and closestTheirs then
                                if slot == 1 then
                                    e.closestBaseArmy1 = closestMine.getGUID()
                                    e.closestBaseArmy2 = closestTheirs.getGUID()
                                else
                                    e.closestBaseArmy2 = closestMine.getGUID()
                                    e.closestBaseArmy1 = closestTheirs.getGUID()
                                end
                            end
                        end

                        charge_setOtherReactions(e, slot, risposta)

                        printToAll(string.format("[CARICA] %s: %s (automatica)",
                            main_decodeExtendedUnitLabel(myKey), risposta), {r=0.8,g=0.8,b=0.8})
                    end
                end
            end
        end
    end
end
-- ============================================================
-- FUNZIONE: charge_chargedTests()
-- Inizio REAZIONI: test di morale delle unità caricate previsti
-- dalla tabella (evento CHARGED, es. FM caricata in terreno
-- aperto da KN o CP). Un test per unità anche se caricata da più
-- nemici; fallito = perde un livello di coesione.
-- ============================================================
function charge_chargedTests()
    local fatti = {}
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        for slot = 1, 2 do
            local other = charge_elementoOtherSlot(slot)
            local key = charge_elementoUnitKey(e, slot)
            if charge_elementoRequest(e, other) and not fatti[key] then
                local mia = charge_getUnitMeta(charge_getUnitBases(key)[1]) or {}
                local sua = charge_getUnitMeta(charge_getUnitBases(charge_elementoUnitKey(e, other))[1]) or {}
                for _, s in ipairs(main_moraleSituationsFor("CHARGED", {
                        tipo = mia.unitType, tipoAvversario = sua.unitType, terreno = main_getUnitTerrain(key) })) do
                    if s.def.testa == "CARICATA" and not fatti[key] then
                        fatti[key] = true
                        printToAll(string.format("[CARICA] %s %s: test di morale",
                            main_decodeExtendedUnitLabel(key), s.def.label or s.nome), {r=1,g=0.8,b=0.3})
                        main_runMoraleQueue({ { key = key, slot = slot, motivo = s.nome, effetto = s.def.effetto } })
                    end
                end
            end
        end
    end
end

-- ============================================================
-- FUNZIONE: charge_elephantContact(elemento)
-- Causa di disordine n. 6: "Contatto con EL di qualsiasi unità
-- montata (KN, CP o CL)": a contatto avvenuto l'unità montata
-- perde un livello di coesione.
-- ============================================================
function charge_elephantContact(elemento)
    if elemento.elephantApplied then return end
    elemento.elephantApplied = true
    local tipi = {}
    for slot = 1, 2 do
        local m = charge_getUnitMeta(charge_getUnitBases(charge_elementoUnitKey(elemento, slot))[1]) or {}
        tipi[slot] = m.unitType
    end
    for slot = 1, 2 do
        local altro = charge_elementoOtherSlot(slot)
        local t = tipi[slot]
        if tipi[altro] == "EL" and (t == "KN" or t == "CP" or t == "CL") then
            local key = charge_elementoUnitKey(elemento, slot)
            printToAll(string.format("[CARICA] %s a contatto con elefanti: perde un livello di coesione",
                main_decodeExtendedUnitLabel(key)), {r=1,g=0.5,b=0.2})
            main_lowerAndCheckRout(key, slot, function(item, quando)
                if quando == "FINE_FASE" then
                    table.insert(IEF_MORALE_END_QUEUE, item)
                else
                    main_runMoraleQueue({ item })
                end
            end)
        end
    end
end

-- ============================================================
-- F41: MIRINO DI CARICA E PERNO A MANIGLIA
-- Clic su CARICA (controlli dell'unità di sempre): pannello con
-- Perno Sn / Perno Ds a maniglia (massimo 2" in tutto) e il
-- mirino (icona "mirino_carica") davanti al fronte, con il
-- corridoio della carica in giallo. Il giocatore trascina il
-- mirino su un'unità nemica; nel pannello:
--   verde   : bersaglio valido (eventuale "Serve un test di
--             morale" / "Carica sul fianco")
--   rosso   : fuori portata
--   arancio : in portata ma non in linea retta, bersaglio più
--             vicino in linea retta, o non caricabile
-- Rilasciato sul verde: charge_checkTarget (conferma Dichiara /
-- Chiudi o il test di morale, come prima). Altrimenti torna.
-- IEF_CHARGE_USA_MIRINO = false: gestione precedente.
-- ============================================================
IEF_CHARGE_USA_MIRINO     = (IEF_CHARGE_USA_MIRINO ~= false)
IEF_CHARGE_MIRINO_SCALA   = IEF_CHARGE_MIRINO_SCALA or 0.20
IEF_CHARGE_MIRINO_DAVANTI = IEF_CHARGE_MIRINO_DAVANTI or 0.8
IEF_CHARGE_MIRINO_ROT     = IEF_CHARGE_MIRINO_ROT or { x = 0, y = 45, z = 0 }
IEF_CHARGE_MIRINO_COLORI  = { ok = "#40FF40", arancio = "#FFA020", rosso = "#FF4040" }
IEF_CHARGE_PIVOT_MAX      = 2
IEF_CHARGE_LINES          = IEF_CHARGE_LINES or {}     -- unitKey -> linee globali
IEF_CHARGE_HANDLES        = IEF_CHARGE_HANDLES or {}   -- guid -> { unitKey, tipo }

local GIALLO = { 1, 0.8, 0.1 }

local function ruotaC(c, x, z, ang)
    local cs, sn = math.cos(ang), math.sin(ang)
    local rx, rz = x - c.x, z - c.z
    return c.x + rx * cs - rz * sn, c.z + rx * sn + rz * cs
end

local function angoloAttornoC(c, ax, az, bx, bz)
    local ux, uz = ax - c.x, az - c.z
    local vx, vz = bx - c.x, bz - c.z
    return charge_angolo(ux * vz - uz * vx, ux * vx + uz * vz)
end

local function quotaC(x, z) return (main_groundY(x, z, 2) or 1.16) + 0.06 end

-- Linee globali della carica (corridoio, perno, filo del mirino)
function charge_mirinoLines()
    local out = {}
    for _, l in pairs(IEF_CHARGE_LINES) do
        for _, x in ipairs(l) do table.insert(out, x) end
    end
    return out
end

function charge_setLines(unitKey)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    local out = {}
    if session then
        for _, l in ipairs(session.lineeCorridoio or {}) do table.insert(out, l) end
        for _, l in ipairs(session.lineePerno or {}) do table.insert(out, l) end
        if session.lineaFilo then table.insert(out, session.lineaFilo) end
    end
    IEF_CHARGE_LINES[unitKey] = (#out > 0) and out or nil
    callHandler("aggiornaLinee")
end

-- Corridoio della carica in giallo (stessa geometria di charge_findLineTarget)
IEF_CHARGE_DEBUG_CORRIDOIO = false  -- F41f: diagnostica del corridoio

-- F42: portata della carica in linea retta: movimento disponibile
-- percorso dritto davanti al fronte, con il costo del terreno
-- (decisione Max: le cariche risentono del terreno). Si ferma prima
-- del terreno vietato.
function charge_portata(session)
    local disp = charge_movimentoDisponibile(session)
    if disp <= 0 then return 0 end
    local piano = main_terrainPlan(session.attackerKey, disp, disp)
    return piano.maxT or disp, piano
end

-- F41g: movimento che resta per la carica (pieno meno il perno usato)
function charge_movimentoDisponibile(session)
    local meta = charge_getUnitMeta(session.myBases[1])
    local ut = meta and main_getUnitType(meta.unitType)
    return math.max(0, ((ut and ut.move_inches) or 0) - (session.pivotUsed or 0))
end
function charge_corridoioGiallo(session, slot)
    local _, _, _, _, sL, sR, eL, eR = charge_findLineTarget(session.attackerKey, slot, charge_portata(session))
    if IEF_CHARGE_DEBUG_CORRIDOIO then
        local b = session.myBases[1]
        local f = b.getTransformForward()
        print(string.format("[CARICA-MIRINO] corridoio: rotY base %.1f  fronte (%.3f, %.3f)  perno usato %.2f",
            b.getRotation().y, f.x, f.z, session.pivotUsed or 0))
    end
    if not sL then session.lineeCorridoio = nil; return end
    local function seg(a, b, n)
        local pts = {}
        for i = 0, n do
            local t = i / n
            local x, z = a.x + (b.x - a.x) * t, a.z + (b.z - a.z) * t
            table.insert(pts, { x, quotaC(x, z), z })
        end
        return { points = pts, color = GIALLO, thickness = 0.04 }
    end
    session.lineeCorridoio = { seg(sL, eL, 12), seg(sR, eR, 12), seg(eL, eR, 4) }
    session.corr = { sL = sL, sR = sR }
end

-- ============================================================
-- Mirino
-- ============================================================
function charge_mirinoSpawn(unitKey)
    local ok, err = pcall(charge_mirinoSpawnCore, unitKey)
    if not ok then
        print("[CARICA-MIRINO] errore all'apertura del mirino: " .. tostring(err))
    end
end

function charge_mirinoSpawnCore(unitKey)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if not session then return end
    charge_mirinoStop(session)
    local player = session.activePlayer
    local slot = main_getArmyByColor(player)
    if not slot then return end
    if charge_alreadyDeclared(slot, session.attackerKey) then return end

    charge_corridoioGiallo(session, slot)
    local fwd, right, fL, fR = charge_getFrontLine(session.myBases)
    local meta = charge_getUnitMeta(session.myBases[1])
    local ut = meta and main_getUnitType(meta.unitType)
    local hd = ((ut and ut.base_depth_cm) or 3) * CM_TO_TTS / 2
    local p1, p2 = fL.getPosition(), fR.getPosition()
    local ox, oz = (p1.x + p2.x) / 2 + fwd.x * hd, (p1.z + p2.z) / 2 + fwd.z * hd
    local d = IEF_CHARGE_MIRINO_DAVANTI * INCH_TO_TTS
    local gx, gz = ox + fwd.x * d, oz + fwd.z * d
    local m = {
        unitKey = unitKey, slot = slot, origine = { x = ox, z = oz },
        start = { x = gx, y = (main_groundY(gx, gz, 2) or 1.0) + 0.15, z = gz },
        rot = { x = IEF_CHARGE_MIRINO_ROT.x, y = session.myBases[1].getRotation().y + IEF_CHARGE_MIRINO_ROT.y, z = IEF_CHARGE_MIRINO_ROT.z },
        cache = {},
    }
    local gK, _, gD = charge_findLineTarget(session.attackerKey, slot, charge_portata(session))
    m.giusto, m.giustoDist = gK, gD
    session.mirino = m
    charge_setLines(unitKey)
    charge_mirinoTesto(session, "Trascina il mirino sul bersaglio", "#FFFFFF")

    local function pronto(o)
        if session.mirino ~= m or IEF_CHARGE_DECLARE_SESSION[unitKey] ~= session then o.destruct(); return end
        o.setName("Mirino carica")
        o.setVelocity(Vector(0, 0, 0))
        m.obj = o
        IEF_CHARGE_HANDLES[o.getGUID()] = { unitKey = unitKey, tipo = "mirino" }
    end
    local url = main_uiIconUrl and main_uiIconUrl("mirino_carica")
    if url then
        spawnObjectData({
            data = {
                Name = "Custom_Token",
                Transform = { posX = m.start.x, posY = m.start.y, posZ = m.start.z,
                              rotX = m.rot.x, rotY = m.rot.y, rotZ = m.rot.z,
                              scaleX = IEF_CHARGE_MIRINO_SCALA, scaleY = 1, scaleZ = IEF_CHARGE_MIRINO_SCALA },
                CustomImage = {
                    ImageURL = url, ImageSecondaryURL = "", ImageScalar = 1, WidthScale = 0,
                    CustomToken = { Thickness = 0.1, MergeDistancePixels = 15, StandUp = false, Stackable = false },
                },
            },
            callback_function = pronto,
        })
    else
        spawnObject({
            type = "Checker_white", position = { m.start.x, m.start.y, m.start.z },
            rotation = { m.rot.x, m.rot.y, m.rot.z }, scale = { 0.45, 0.45, 0.45 }, sound = false,
            callback_function = function(o) o.setColorTint({ 1, 0.4, 0.1 }); pronto(o) end,
        })
    end
end

function charge_mirinoStop(session)
    local m = session and session.mirino
    if not m then return end
    session.mirino = nil
    if m.waitId then Wait.stop(m.waitId) end
    if m.obj and not m.obj.isDestroyed() then
        IEF_CHARGE_HANDLES[m.obj.getGUID()] = nil
        m.obj.destruct()
    end
    charge_mirinoEvidenzia(m, nil)
    session.lineaFilo = nil
    session.lineeCorridoio = nil
    charge_setLines(session.attackerKey)
end

function charge_mirinoTesto(session, testo, colore)
    session.ultimoTesto, session.ultimoColore = testo, colore
    local pan = session.panel3DObj
    if not pan or pan.isDestroyed() then return end
    local id = "txtMirino_" .. session.attackerKey
    -- F41b: il pannello ricostruito da charge_redraw (setXml) è pronto
    -- solo qualche frame dopo: scrivere subito dà "Object reference
    -- not set". Si riprova finché non è caricato.
    local function scrivi()
        if not pan or pan.isDestroyed() then return true end
        if pan.UI.loading then return false end
        local ok = pcall(function()
            pan.UI.setAttribute(id, "text", testo)
            pan.UI.setAttribute(id, "color", colore)
        end)
        return ok
    end
    if not scrivi() then
        Wait.frames(function()
            if not scrivi() then Wait.frames(scrivi, 20) end
        end, 10)
    end
end

function charge_mirinoEvidenzia(m, key, esito)
    if m.sopra and m.sopra ~= key then
        for _, b in ipairs(main_getUnitBases(m.sopra)) do b.highlightOff() end
    end
    m.sopra = key
    if key then
        local col = (esito == "ok" and { 0.2, 0.9, 0.2 }) or (esito == "arancio" and { 1, 0.63, 0.13 }) or { 1, 0.2, 0.2 }
        for _, b in ipairs(main_getUnitBases(key)) do b.highlightOn(col) end
    end
end

-- Unità nemica sotto il mirino (Generali ignorati)
function charge_mirinoUnitaSotto(m, px, pz)
    local tagNemico = "Army" .. (m.slot == 1 and 2 or 1)
    local meglio, dMin = nil, 0.3 * INCH_TO_TTS
    for _, o in ipairs(getAllObjects()) do
        if o.hasTag(tagNemico) then
            local info = main_parseNickname(o.getName())
            local k = info and main_getUnitKey(o)
            if info and info.unitType ~= "GEN" and k and not main_isGeneralKey(k) then
                local d = main_pointRectDistance(px, pz, main_baseRectOfType(o, info.unitType))
                if d <= dMin then meglio, dMin = k, d end
            end
        end
    end
    return meglio
end

-- Esito: "ok" | "arancio" | "rosso", testo (distanza - valido/non valido - causa)
function charge_mirinoValuta(session, key)
    local m = session.mirino
    if m.cache[key] then return m.cache[key].esito, m.cache[key].testo end
    local myBases = charge_getUnitBases(session.attackerKey)
    local myMeta = charge_getUnitMeta(myBases[1])
    local myTipo = myMeta and myMeta.unitType
    local rects = {}
    for _, b in ipairs(myBases) do table.insert(rects, main_baseRectOfType(b, myTipo)) end
    local d = math.huge
    local suoi = charge_getUnitBases(key)
    for _, b in ipairs(suoi) do
        local info = main_parseNickname(b.getName())
        local r = main_baseRectOfType(b, info and info.unitType)
        for _, mr in ipairs(rects) do d = math.min(d, main_rectsDistance(mr, r)) end
    end
    local function esci(esito, causa, nota)
        local testo
        if causa then testo = string.format('%.2f" - Bersaglio non valido - Causa: %s', d / INCH_TO_TTS, causa)
        elseif nota then testo = string.format('%.2f" - Bersaglio valido - %s', d / INCH_TO_TTS, nota)
        else testo = string.format('%.2f" - Bersaglio valido', d / INCH_TO_TTS) end
        m.cache[key] = { esito = esito, testo = testo }
        return esito, testo
    end
    -- F41h: la carica percorre la distanza IN LINEA RETTA lungo il
    -- corridoio (dal fronte all'angolo più vicino del bersaglio dentro
    -- la larghezza dell'unità), con il movimento meno il perno usato
    local disp = charge_movimentoDisponibile(session) * INCH_TO_TTS
    local portataT = charge_portata(session) * INCH_TO_TTS     -- F42: col terreno
    local inLinea, zMin = false, math.huge
    if session.corr then
        local fwd = charge_getFrontLine(myBases)
        local sL, sR = session.corr.sL, session.corr.sR
        local larg = math.sqrt((sR.x - sL.x) ^ 2 + (sR.z - sL.z) ^ 2)
        local ux, uz = (sR.x - sL.x) / larg, (sR.z - sL.z) / larg
        for _, b in ipairs(suoi) do
            local info = main_parseNickname(b.getName())
            for _, c in ipairs(main_baseRectOfType(b, info and info.unitType).corners) do
                local rx, rz = c.x - sL.x, c.z - sL.z
                local lz = rx * fwd.x + rz * fwd.z
                local lx = rx * ux + rz * uz
                if lz >= 0 and lx >= 0 and lx <= larg then
                    inLinea = true
                    if lz < zMin then zMin = lz end
                end
            end
        end
    end
    if not inLinea then
        if d > disp + 0.01 then return esci("rosso", "Fuori portata") end
        return esci("arancio", "Il bersaglio non è in linea retta")
    end
    d = zMin   -- distanza mostrata = quella che la carica percorre
    if zMin > portataT + 0.01 then return esci("rosso", "Fuori portata") end
    if key ~= m.giusto then
        if m.giusto and m.giustoDist and (m.giustoDist * INCH_TO_TTS) < zMin - 0.01 then
            return esci("arancio", "Esiste un bersaglio più vicino in linea retta")
        end
        return esci("arancio", "Il bersaglio non può essere caricato")
    end
    local note = {}
    if charge_chargeTestFor(session.attackerKey, key) and IEF_CHARGE_TEST_PASSED[session.attackerKey] ~= key then
        table.insert(note, "Serve un test di morale")
    end
    if charge_isFlankCharge(session.attackerKey, key) then table.insert(note, "Carica sul fianco") end
    return esci("ok", nil, (#note > 0) and table.concat(note, " - ") or nil)
end

function charge_mirinoTick(unitKey)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    local m = session and session.mirino
    if not m or not m.obj or m.obj.isDestroyed() then return end
    local p = m.obj.getPosition()
    local key = charge_mirinoUnitaSotto(m, p.x, p.z)
    local esito, testo = nil, nil
    if key then esito, testo = charge_mirinoValuta(session, key) end
    local col = (esito == "ok" and { 0.2, 0.9, 0.2 }) or (esito == "arancio" and { 1, 0.63, 0.13 })
             or (esito == "rosso" and { 1, 0.2, 0.2 }) or GIALLO
    local o = m.origine
    session.lineaFilo = { points = { { o.x, quotaC(o.x, o.z), o.z }, { p.x, quotaC(p.x, p.z), p.z } }, color = col, thickness = 0.08 }
    charge_setLines(unitKey)
    m.valido = (esito == "ok")
    m.bersaglio = key
    if not key then
        charge_mirinoEvidenzia(m, nil)
        -- F41f: distanza dal fronte al mirino e movimento disponibile
        -- (movimento pieno meno il perno già usato)
        local meta = charge_getUnitMeta(session.myBases[1])
        local ut = meta and main_getUnitType(meta.unitType)
        local disp = math.max(0, ((ut and ut.move_inches) or 0) - (session.pivotUsed or 0))
        local d = math.sqrt((p.x - o.x) ^ 2 + (p.z - o.z) ^ 2) / INCH_TO_TTS
        charge_mirinoTesto(session, string.format('%.2f" - Movimento disponibile %.2f"', d, disp),
            d > disp + 0.01 and IEF_CHARGE_MIRINO_COLORI.rosso or "#FFFFFF")
        return
    end
    charge_mirinoEvidenzia(m, key, esito)
    charge_mirinoTesto(session, testo, IEF_CHARGE_MIRINO_COLORI[esito] or "#FFFFFF")
end

function charge_mirinoRitorna(session)
    local m = session and session.mirino
    if not m or not m.obj or m.obj.isDestroyed() then return end
    m.obj.setPosition(Vector(m.start.x, m.start.y, m.start.z))
    m.obj.setRotation(Vector(m.rot.x, m.rot.y, m.rot.z))
    m.obj.setVelocity(Vector(0, 0, 0))
    session.lineaFilo = nil
    charge_setLines(session.attackerKey)
    charge_mirinoEvidenzia(m, nil)
    charge_mirinoTesto(session, "Trascina il mirino sul bersaglio", "#FFFFFF")
end

-- ============================================================
-- Perno a maniglia della carica (massimo 2" in tutto)
-- ============================================================
function charge_pernoToggle(unitKey, lato)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if not session then return end
    local era = session.perno and session.perno.lato
    charge_pernoOff(session, false)
    if era == lato then return end
    local residuo = IEF_CHARGE_PIVOT_MAX - (session.pivotUsed or 0)
    local p = session.activePlayer
    if residuo <= 0.01 then
        if p then warningToColor("Perno massimo (2\") già usato", p, "Yellow", 4, true) end
        return
    end
    if #session.myBases < 2 then
        if p then warningToColor("Unità a base singola: perno non applicabile", p, "Yellow", 4, true) end
        return
    end
    local sx, dx, fwd = main_pivotCorners(session.myBases)
    if not sx then return end
    local larghezza = math.sqrt((dx.x - sx.x) ^ 2 + (dx.z - sx.z) ^ 2)
    if larghezza < 0.01 then return end
    -- il mirino si toglie mentre si gira: torna dopo il perno
    charge_mirinoStop(session)
    local pr = { lato = lato, sx = sx, dx = dx, fwd = fwd, larghezza = larghezza, maxIn = residuo,
                 start = {}, rot = {}, bloccate = {} }
    for _, b in ipairs(session.myBases) do
        pr.start[b.getGUID()] = b.getPosition()
        pr.rot[b.getGUID()] = b.getRotation()
        if not b.getLock() then b.setLock(true); table.insert(pr.bloccate, b) end
    end
    session.perno = pr
    -- ventaglio (come nel movimento)
    local segno = (lato == "left") and 1 or -1
    local c = (lato == "left") and sx or dx
    local lontano = (lato == "left") and dx or sx
    local maxAng = (residuo * INCH_TO_TTS) / larghezza
    local cy = quotaC(c.x, c.z)
    local linee = {}
    local function raggio(a, sp)
        local x, z = ruotaC(c, lontano.x, lontano.z, a)
        table.insert(linee, { points = { { c.x, cy, c.z }, { x, quotaC(x, z), z } }, color = GIALLO, thickness = sp })
    end
    raggio(0, 0.04)
    local k = 1
    while k < residuo - 0.05 do raggio(segno * (k * INCH_TO_TTS) / larghezza, 0.025); k = k + 1 end
    raggio(segno * maxAng, 0.04)
    local pts = {}
    for i = 0, 24 do
        local x, z = ruotaC(c, lontano.x, lontano.z, segno * maxAng * i / 24)
        table.insert(pts, { x, quotaC(x, z), z })
    end
    table.insert(linee, { points = pts, color = GIALLO, thickness = 0.04 })
    session.lineePerno = linee
    charge_setLines(unitKey)
    -- maniglia davanti all'angolo che avanza
    local off = 0.4 * INCH_TO_TTS
    local hx, hz = lontano.x + fwd.x * off, lontano.z + fwd.z * off
    pr.hStart = { x = hx, y = (main_groundY(hx, hz, 2) or 1.0) + 0.3, z = hz }
    spawnObject({
        type = "Checker_white", position = { pr.hStart.x, pr.hStart.y, pr.hStart.z }, rotation = { 0, 0, 0 },
        scale = { 0.45, 0.45, 0.45 }, sound = false,
        callback_function = function(o)
            if session.perno ~= pr then o.destruct(); return end
            o.setColorTint(GIALLO)
            o.setName(lato == "left" and "Perno Sn" or "Perno Ds")
            pr.obj = o
            IEF_CHARGE_HANDLES[o.getGUID()] = { unitKey = unitKey, tipo = "perno" }
        end,
    })
    charge_mirinoTesto(session, string.format('Perno %s: trascina la maniglia (massimo %.2f")', lato == "left" and "Sn" or "Ds", residuo), "#FFFFFF")
end

-- Spegne il perno; ripristina se a metà; rimette il mirino se richiesto
function charge_pernoOff(session, senzaMirino)
    local pr = session and session.perno
    if not pr then return end
    session.perno = nil
    if pr.waitId then Wait.stop(pr.waitId) end
    if pr.obj and not pr.obj.isDestroyed() then
        IEF_CHARGE_HANDLES[pr.obj.getGUID()] = nil
        pr.obj.destruct()
    end
    if pr.inMano then
        for _, b in ipairs(session.myBases) do
            local g = b.getGUID()
            if pr.start[g] then b.setPosition(pr.start[g]) end
            if pr.rot[g] then b.setRotation(pr.rot[g]) end
        end
    end
    for _, b in ipairs(pr.bloccate or {}) do
        if b and not b.isDestroyed() then b.setLock(false) end
    end
    session.lineePerno = nil
    charge_setLines(session.attackerKey)
    if not senzaMirino and IEF_CHARGE_DECLARE_SESSION[session.attackerKey] == session then
        charge_mirinoSpawn(session.attackerKey)
    end
end

function charge_pernoMisura(pr, p)
    local c = (pr.lato == "left") and pr.sx or pr.dx
    local ang = angoloAttornoC(c, pr.hStart.x, pr.hStart.z, p.x, p.z)
    if (pr.lato == "left" and ang < 0) or (pr.lato == "right" and ang > 0) then ang = 0 end
    local maxAng = (pr.maxIn * INCH_TO_TTS) / pr.larghezza
    local oltre = math.abs(ang) > maxAng + 1e-4
    if oltre then ang = (ang < 0) and -maxAng or maxAng end
    return ang, math.abs(ang) * pr.larghezza / INCH_TO_TTS, oltre
end

function charge_pernoTick(unitKey)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    local pr = session and session.perno
    if not pr or not pr.obj or pr.obj.isDestroyed() then return end
    local ang, pollici, oltre = charge_pernoMisura(pr, pr.obj.getPosition())
    local c = (pr.lato == "left") and pr.sx or pr.dx
    local gradi = math.deg(ang)
    for _, b in ipairs(session.myBases) do
        local g = b.getGUID()
        local s0, r0 = pr.start[g], pr.rot[g]
        if s0 and r0 then
            local x, z = ruotaC(c, s0.x, s0.z, ang)
            b.setPosition(Vector(x, s0.y, z))
            b.setRotation(Vector(r0.x, r0.y - gradi, r0.z))
        end
    end
    charge_mirinoTesto(session, oltre and string.format('max %.2f"', pr.maxIn)
        or string.format('Perno %s %.2f"', pr.lato == "left" and "Sn" or "Ds", pollici), oltre and "#FF4040" or "#FFFFFF")
end

function charge_pernoFinalizza(unitKey, pollici)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    local pr = session and session.perno
    if not pr then return end
    -- posa di partenza, poi il perno esatto
    for _, b in ipairs(session.myBases) do
        local g = b.getGUID()
        if pr.start[g] then b.setPosition(pr.start[g]) end
        if pr.rot[g] then b.setRotation(pr.rot[g]) end
    end
    pr.inMano = false
    local lato = pr.lato
    if pollici < 0.01 then
        if pr.obj and not pr.obj.isDestroyed() then
            pr.obj.setPosition(Vector(pr.hStart.x, pr.hStart.y, pr.hStart.z))
            pr.obj.setRotation(Vector(0, 0, 0))
        end
        return
    end
    charge_pernoOff(session, true)
    if main_pivotFrontCorner(session.myBases, lato, pollici) then
        session.pivotUsed = (session.pivotUsed or 0) + pollici
    end
    -- F41e: posizione e rotazione nuove delle basi si leggono solo
    -- qualche frame dopo (fisica): corridoio e mirino si ricalcolano
    -- quando l'unità ha davvero girato
    charge_redraw(unitKey)
    charge_dopoSpostamento(unitKey)
end

function charge_dopoSpostamento(unitKey)
    Wait.frames(function()
        if not IEF_CHARGE_DECLARE_SESSION[unitKey] then return end
        charge_redraw(unitKey)
        charge_mirinoSpawn(unitKey)
    end, 5)
end

-- ============================================================
-- F41c: durante il trascinamento (mirino o maniglia del perno) il
-- pannello di dichiarazione lascia il posto a un pannellino con il
-- solo messaggio (stesso id txtMirino_<unità>); al rilascio torna.
-- ============================================================
function charge_pannellino(session)
    local pan = session.panel3DObj
    if not pan or pan.isDestroyed() then return end
    local P = MOVEPANEL
    local fronte = main_detectFormation(session.myBases)
    local x, y, z = main_calcolaPosizionePannello(fronte, #session.myBases)
    pan.UI.setXml(string.format([[
        <Panel id="panelChargeDrag_%s" active="true" color="%s" width="760" height="90" offsetXY="0 320" position="%f %f %f" rotation="-90 0 0" visibility="%s">
            <HorizontalLayout spacing="10" padding="16 16 10 10" childAlignment="MiddleCenter" childForceExpandWidth="false">
                <Text id="txtMirino_%s" text="" font="%s" fontStyle="Normal" fontSize="20" color="#FFFFFF" alignment="MiddleCenter" preferredWidth="560"/>
                <Button id="btnMirinoChiudi_%s" text="Chiudi" font="%s" fontSize="18" color="%s" textColor="White" preferredWidth="140" preferredHeight="50" onClick="Global/charge_mirinoChiudi"/>
            </HorizontalLayout>
        </Panel>
        ]], session.attackerKey, P.bg, x, y, z, session.activePlayer.color, session.attackerKey, P.font,
            session.attackerKey, P.font, P.close))
end

function charge_pannelloTorna(session)
    charge_redraw(session.attackerKey)
    if session.ultimoTesto then
        charge_mirinoTesto(session, session.ultimoTesto, session.ultimoColore or "#FFFFFF")
    end
end

-- ============================================================
-- Eventi (da onObjectPickUp / onObjectDrop in 0_main/general)
-- ============================================================
function charge_mirinoOnPickUp(player_color, obj)
    local h = IEF_CHARGE_HANDLES[obj.getGUID()]
    if not h then return end
    local session = IEF_CHARGE_DECLARE_SESSION[h.unitKey]
    if not session or session.activePlayer.color ~= player_color then return end
    if h.tipo == "mirino" and session.mirino then
        local m = session.mirino
        charge_pannellino(session)
        if m.waitId then Wait.stop(m.waitId) end
        m.waitId = Wait.time(function() charge_mirinoTick(h.unitKey) end, 0.1, -1)
    elseif h.tipo == "perno" and session.perno then
        local pr = session.perno
        charge_pannellino(session)
        pr.inMano = true
        if pr.waitId then Wait.stop(pr.waitId) end
        pr.waitId = Wait.time(function() charge_pernoTick(h.unitKey) end, 0.05, -1)
    end
end

function charge_mirinoOnDrop(player_color, obj)
    local h = IEF_CHARGE_HANDLES[obj.getGUID()]
    if not h then return end
    local session = IEF_CHARGE_DECLARE_SESSION[h.unitKey]
    if not session then return end
    if h.tipo == "mirino" and session.mirino then
        local m = session.mirino
        if m.waitId then Wait.stop(m.waitId); m.waitId = nil end
        charge_mirinoTick(h.unitKey)
        charge_pannelloTorna(session)
        if m.valido then
            -- conferma Dichiara / Chiudi (o test di morale): flusso di sempre
            charge_checkTarget(session.activePlayer, h.unitKey)
        else
            Wait.frames(function() charge_mirinoRitorna(session) end, 2)
        end
    elseif h.tipo == "perno" and session.perno then
        local pr = session.perno
        if pr.waitId then Wait.stop(pr.waitId); pr.waitId = nil end
        local _, pollici = charge_pernoMisura(pr, obj.getPosition())
        Wait.frames(function()
            charge_pernoFinalizza(h.unitKey, pollici)
            -- senza rotazione il pannello torna qui (con il perno torna
            -- già da charge_pernoFinalizza -> charge_redraw)
            if IEF_CHARGE_DECLARE_SESSION[h.unitKey] == session and session.perno then charge_pannelloTorna(session) end
        end, 2)
    end
end

-- Chiudi del pannellino (come nel tiro): chiude la dichiarazione
function charge_mirinoChiudi(player, value, id)
    local unitKey = id and id:match("^btnMirinoChiudi_(.+)$")
    if not unitKey then return end
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if session then
        if charge_pernoOff then charge_pernoOff(session, true) end
        charge_declareRestorePosition(session)
    end
    charge_close(unitKey)
    UI.setAttribute("confirm_panel_charge", "active", "false")
end
