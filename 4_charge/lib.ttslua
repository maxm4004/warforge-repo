-- ============================================================
-- FUNZIONE: charge_getFrontLine(basiObjs)
-- Isola il rango di fronte (basi con proiezione massima lungo
-- fwdXZ, non le basi estreme di TUTTE le file). Stesso principio
-- di move_getFrontLine (6_move/lib.ttslua), ma ritorna anche gli
-- OGGETTI base d'angolo (sinistro/destro del fronte), non solo
-- le posizioni — servono come pivot fisico per charge_applyPivot.
--
-- Ritorna: fwdXZ, right, frontLeftBase, frontRightBase
-- ============================================================
function charge_getFrontLine(basiObjs)
    local fwd   = basiObjs[1].getTransformForward()
    local fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()
    local right = Vector(-fwdXZ.z, 0, fwdXZ.x)

    local maxProj = -math.huge
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x * fwdXZ.x + p.z * fwdXZ.z
        if proj > maxProj then maxProj = proj end
    end

    local EPS = 0.5
    local frontRank = {}
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        local proj = p.x * fwdXZ.x + p.z * fwdXZ.z
        if math.abs(proj - maxProj) < EPS then
            table.insert(frontRank, obj)
        end
    end

    table.sort(frontRank, function(a, b)
        local pa, pb = a.getPosition(), b.getPosition()
        return (pa.x*right.x + pa.z*right.z) < (pb.x*right.x + pb.z*right.z)
    end)

    return fwdXZ, right, frontRank[1], frontRank[#frontRank]
end

-- ============================================================
-- HELPER SIMMETRICI: charge_elementoX(elemento, slot)
-- Un elemento condiviso non ha più "attaccante"/"bersaglio" fissi
-- — ogni campo è duplicato per Army1/Army2. Questi helper
-- nascondono lo switch slot==1/slot==2 al resto del codice.
-- ============================================================
function charge_elementoUnitKey(elemento, slot)
    return (slot == 1) and elemento.unitArmy1Key or elemento.unitArmy2Key
end

function charge_elementoOtherKey(elemento, slot)
    return (slot == 1) and elemento.unitArmy2Key or elemento.unitArmy1Key
end

function charge_elementoOtherSlot(slot)
    return (slot == 1) and 2 or 1
end

function charge_elementoRequest(elemento, slot)
    if slot == 1 then
        return elemento.requestArmy1
    else
        return elemento.requestArmy2
    end
end

function charge_elementoSetRequest(elemento, slot, valore)
    if slot == 1 then elemento.requestArmy1 = valore else elemento.requestArmy2 = valore end
end

function charge_elementoDistInches(elemento, slot)
    return (slot == 1) and elemento.distInchesArmy1 or elemento.distInchesArmy2
end

function charge_elementoSetDeclareData(elemento, slot, pivotInches, distInches)
    if slot == 1 then
        elemento.pivotInchesArmy1 = pivotInches
        elemento.distInchesArmy1  = distInches
    else
        elemento.pivotInchesArmy2 = pivotInches
        elemento.distInchesArmy2  = distInches
    end
end

function charge_elementoResponse(elemento, slot)
    return (slot == 1) and elemento.responseArmy1 or elemento.responseArmy2
end

function charge_elementoSetResponse(elemento, slot, valore)
    if slot == 1 then elemento.responseArmy1 = valore else elemento.responseArmy2 = valore end
end

-- ============================================================
-- FUNZIONE: charge_elementoIsReciprocal(elemento)
-- Vero se ENTRAMBE le unità hanno dichiarato la carica l'una
-- sull'altra — contro-carica derivata, non più un flag scritto a
-- parte (charge_resolveConflicts non deve più impostarlo, solo
-- leggerlo indirettamente tramite questa funzione).
-- ============================================================
function charge_elementoIsReciprocal(elemento)
    return elemento.requestArmy1 == true and elemento.requestArmy2 == true
end

-- ============================================================
-- FUNZIONE: charge_findElementByUnits(slotA, keyA, slotB, keyB)
-- Cerca un elemento esistente per la coppia di unità, in
-- QUALSIASI ordine (A può essere in Army1 o Army2 e viceversa).
-- ============================================================
function charge_findElementByUnits(slotA, keyA, slotB, keyB)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoUnitKey(e, slotA) == keyA and charge_elementoUnitKey(e, slotB) == keyB then
            return e
        end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: charge_findOrCreateElement(mySlot, myKey, otherSlot, otherKey)
-- ============================================================
function charge_findOrCreateElement(mySlot, myKey, otherSlot, otherKey)
    if not myKey or not otherKey then
        print("[CARICA] ERRORE: charge_findOrCreateElement chiamata con chiave nil, ignorata")
        return nil
    end

    local existing = charge_findElementByUnits(mySlot, myKey, otherSlot, otherKey)
    if existing then return existing, false end
    
    IEF_CHARGE_NEXT_ID = (IEF_CHARGE_NEXT_ID or 0) + 1
    local nuovo = {
        id = IEF_CHARGE_NEXT_ID,
        unitArmy1Key = (mySlot == 1) and myKey or otherKey,
        unitArmy2Key = (mySlot == 1) and otherKey or myKey,
        requestArmy1 = false,
        requestArmy2 = false,
        pivotInchesArmy1 = nil, distInchesArmy1 = nil,
        pivotInchesArmy2 = nil, distInchesArmy2 = nil,
        responseArmy1 = nil,
        responseArmy2 = nil,
        step    = CHARGE_STEP.DEC,
        outcome = nil,
        flankCharge = nil,
        movedArmy1 = false,
        movedArmy2 = false,
        stopfireResolved = false,
        moveTargetArmy1 = nil,
        moveTargetArmy2 = nil,
    }
    table.insert(IEF_CHARGE_QUEUE, nuovo)
    return nuovo, true
end

-- ============================================================
-- FUNZIONE: charge_findQueueEntry(slot, unitKey)
-- Trova l'elemento dove l'unità di ARMY{slot} è unitKey — stessa
-- interfaccia di prima (slot, key), ora risolta sulla coda unica.
-- ============================================================
function charge_findQueueEntry(slot, unitKey)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoUnitKey(e, slot) == unitKey then return e end
    end
    return nil
end

-- ============================================================
-- FUNZIONE: charge_queueHasPending()
-- Vero se almeno un elemento della coda cariche non è ancora
-- risolto (step ~= CHARGE_STEP.CLO).
-- ============================================================
function charge_queueHasPending()
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if e.step ~= CHARGE_STEP.CLO then return true end
    end
    return false
end

-- ============================================================
-- FUNZIONE: charge_hasStopfirePending()
-- Vero se almeno una carica ha responseArmy1/2=REACTION_TYPE.TIR
-- e non è ancora chiusa.
-- ============================================================
function charge_hasStopfirePending()
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if (e.responseArmy1 == REACTION_TYPE.TIR or e.responseArmy2 == REACTION_TYPE.TIR) and not e.stopfireResolved then
            return true
        end
    end
    return false
end
-- ============================================================
-- FUNZIONE: charge_getUnitMeta(obj)
-- Wrapper su main_getUnitMeta (motore condiviso in 0_main/lib.ttslua).
-- ============================================================
function charge_getUnitMeta(obj)
    return main_getUnitMeta(obj)
end

-- ============================================================
-- FUNZIONE: charge_getUnitBases(unitKey)
-- Wrapper su main_getUnitBases (motore condiviso in 0_main/lib.ttslua).
-- ============================================================
function charge_getUnitBases(unitKey)
    return main_getUnitBases(unitKey)
end

-- ============================================================
-- FUNZIONE: charge_alreadyDeclared(slot, unitKey)
-- Vero se unitKey ha già una carica in coda questo turno
-- (un'unità può dichiarare una sola carica a turno).
-- ============================================================
function charge_alreadyDeclared(slot, unitKey)
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoUnitKey(e, slot) == unitKey and charge_elementoRequest(e, slot) then
            return true
        end
    end
    return false
end

-- ============================================================
-- FUNZIONE: charge_baseTouchesCorridor(nemico, startLeft, fwdXZ, right, rangeUnits, corridorWidth)
-- Vero se il bounding box FISICO REALE della base nemica
-- (nemico.getBounds(), non un'approssimazione da unit_types.json)
-- tocca il corridoio di carica — stesso principio di
-- shoot_isToccata (7_shoot/lib.ttslua): si controllano i 4
-- angoli del bounding box, non il solo centro.
-- ============================================================
function charge_baseTouchesCorridor(nemico, startLeft, fwdXZ, right, rangeUnits, corridorWidth)
    if not nemico or not nemico.getBounds then return false end
    local bounds = nemico.getBounds()
    if not bounds or not bounds.size then return false end

    local pos  = nemico.getPosition()
    local xmin = pos.x - bounds.size.x / 2
    local xmax = pos.x + bounds.size.x / 2
    local zmin = pos.z - bounds.size.z / 2
    local zmax = pos.z + bounds.size.z / 2

    local corners = {
        {x = xmin, z = zmin}, {x = xmin, z = zmax},
        {x = xmax, z = zmin}, {x = xmax, z = zmax},
    }

    for _, c in ipairs(corners) do
        local relX = c.x - startLeft.x
        local relZ = c.z - startLeft.z
        local localZ = relX * fwdXZ.x + relZ * fwdXZ.z
        local localX = relX * right.x + relZ * right.z
        if localZ >= 0 and localZ <= rangeUnits and localX >= 0 and localX <= corridorWidth then
            return true
        end
    end
    return false
end
-- ============================================================
-- FUNZIONE: charge_findLineTarget(myKey, slot)
-- ============================================================
function charge_findLineTarget(myKey, slot)

    local myBases = charge_getUnitBases(myKey)
    if #myBases == 0 then
        return nil, "Impossibile leggere le basi dell'unità caricante"
    end

    local myMeta = charge_getUnitMeta(myBases[1])
    local myTipo = myMeta and myMeta.unitType
    if not myTipo then
        return nil, "GMNotes mancanti sull'unità caricante"
    end

    local unitTypeData = main_getUnitType(myTipo)
    local moveInches = unitTypeData and unitTypeData.move_inches or 0

    local baseHalfWidth = (unitTypeData and unitTypeData.base_width_cm or 4) * CM_TO_TTS / 2 - 0.06
    local baseHalfDepth = (unitTypeData and unitTypeData.base_depth_cm or 3) * CM_TO_TTS / 2 - 0.06

    local SIDE_TOLERANCE = 0.05 * INCH_TO_TTS
    baseHalfWidth = baseHalfWidth + SIDE_TOLERANCE

    local fwdXZ, right, frontLeft, frontRight = charge_getFrontLine(myBases)
    local p1, p2 = frontLeft.getPosition(), frontRight.getPosition()

    local rangeUnits = moveInches * INCH_TO_TTS
    local y = 1.20

    local startLeft  = Vector(p1.x - right.x*baseHalfWidth + fwdXZ.x*baseHalfDepth, y, p1.z - right.z*baseHalfWidth + fwdXZ.z*baseHalfDepth)
    local startRight = Vector(p2.x + right.x*baseHalfWidth + fwdXZ.x*baseHalfDepth, y, p2.z + right.z*baseHalfWidth + fwdXZ.z*baseHalfDepth)
    local endLeft    = Vector(startLeft.x  + fwdXZ.x*rangeUnits, y, startLeft.z  + fwdXZ.z*rangeUnits)
    local endRight   = Vector(startRight.x + fwdXZ.x*rangeUnits, y, startRight.z + fwdXZ.z*rangeUnits)
    local corridorWidth = Vector(startRight.x - startLeft.x, 0, startRight.z - startLeft.z):magnitude()

    -- Nessun disegno qui: charge_findLineTarget è ora PURA (solo
    -- calcolo). Il disegno del corridoio è responsabilità di chi
    -- chiama, tramite charge_drawCorridor — così chi cerca il
    -- bersaglio senza voler mostrare nulla (dichiarazioni
    -- automatiche, controllo obblighi) non lascia più residui da
    -- pulire dopo.

    local enemyTag = "Army" .. (slot == 1 and 2 or 1)
    local seenKeys = {}
    local best = nil

    local targetiGiaPresi = {}
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if e.requestArmy1 then targetiGiaPresi[e.unitArmy2Key] = true end
        if e.requestArmy2 then targetiGiaPresi[e.unitArmy1Key] = true end
    end

    for _, o in ipairs(getAllObjects()) do
        if o.hasTag(enemyTag) then
            local ek = main_getUnitKey(o)
            if ek and not seenKeys[ek] then
                seenKeys[ek] = true

                local enemyBases = charge_getUnitBases(ek)
                local enemyMeta  = enemyBases[1] and charge_getUnitMeta(enemyBases[1])
                local enemyTipo  = enemyMeta and enemyMeta.unitType

                local legalTarget = true
                if myTipo == "FL" and enemyTipo ~= "FL" and enemyTipo ~= "ART" and enemyTipo ~= "EL" then
                    legalTarget = false
                end

                if targetiGiaPresi[ek] then
                    legalTarget = false
                end

                if legalTarget then
                    for _, eb in ipairs(enemyBases) do
                        if eb.getBounds then
                            local bounds = eb.getBounds()
                            if bounds and bounds.size then
                                local ep = eb.getPosition()
                                local xmin = ep.x - bounds.size.x / 2
                                local xmax = ep.x + bounds.size.x / 2
                                local zmin = ep.z - bounds.size.z / 2
                                local zmax = ep.z + bounds.size.z / 2

                                local corners = {
                                    {x=xmin,z=zmin}, {x=xmin,z=zmax},
                                    {x=xmax,z=zmin}, {x=xmax,z=zmax},
                                }

                                local anyInside = false
                                local nearestLocalZ = nil
                                for _, c in ipairs(corners) do
                                    local relX = c.x - startLeft.x
                                    local relZ = c.z - startLeft.z
                                    local localZ = relX * fwdXZ.x + relZ * fwdXZ.z
                                    local localX = relX * right.x + relZ * right.z
                                    if localZ >= 0 and localZ <= rangeUnits and localX >= 0 and localX <= corridorWidth then
                                        anyInside = true
                                    end
                                    if not nearestLocalZ or localZ < nearestLocalZ then
                                        nearestLocalZ = localZ
                                    end
                                end

                                if anyInside then
                                    if not best or nearestLocalZ < best.localZ then
                                        best = { targetKey = ek, localZ = nearestLocalZ, distInches = nearestLocalZ / INCH_TO_TTS }
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if not best then
        return nil, "Nessun bersaglio raggiungibile in linea retta", nil, frontLeft, startLeft, startRight, endLeft, endRight
    end

    return best.targetKey, 0, best.distInches, frontLeft, startLeft, startRight, endLeft, endRight
end
-- ============================================================
-- FUNZIONE: charge_drawCorridor(frontLeft, startLeft, startRight, endLeft, endRight)
-- Disegna il corridoio (linee rosse) self-hosted su frontLeft.
-- Chiamata SOLO da chi vuole davvero mostrarlo (charge_checkTarget
-- in CHARGE_DECLARE) — mai da charge_findLineTarget stessa.
-- ============================================================
function charge_drawCorridor(frontLeft, startLeft, startRight, endLeft, endRight)
    if not frontLeft then return end
    frontLeft.setVectorLines({
        {points = {frontLeft.positionToLocal(startLeft),  frontLeft.positionToLocal(endLeft)},  color={1,0.2,0.2}, thickness=0.03},
        {points = {frontLeft.positionToLocal(startRight), frontLeft.positionToLocal(endRight)}, color={1,0.2,0.2}, thickness=0.03},
        {points = {frontLeft.positionToLocal(endLeft),    frontLeft.positionToLocal(endRight)}, color={1,0.2,0.2}, thickness=0.03},
    })
end
-- ============================================================
-- FUNZIONE: charge_buildDeclarePanel3DXml(unitKey, x, z, colore, labelText)
-- Pannello 3D dichiarazione carica: Perno Sx/Dx + Check Carica +
-- Annulla. Stesso schema di main_buildMovementPanel3DXml
-- (0_main/lib.ttslua): agganciato via obj.UI.setXml() sulla base
-- stessa, onClick con prefisso "Global/" (richiesto per XML
-- attaccato a un oggetto, non alla UI globale). ID pulsanti
-- unici per unitKey.
-- ============================================================
function charge_buildDeclarePanel3DXml(unitKey, x, y, z, colore, labelText)
    return string.format([[
        <Panel id="panelCharge_%s" active="true" color="rgba(0,0,0,0.99)" width="700" height="300" offsetXY="0 300" position="%f %f %f" rotation="-90 0 0" visibility="%s">
            <VerticalLayout spacing="10" padding="20 20 20 20" childAlignment="MiddleCenter">
                <Text text="%s" fontStyle="Bold" font="warforge_font" fontSize="20" color="Orange" alignment="MiddleCenter" width="660" height="35"/>
                <HorizontalLayout spacing="10" childAlignment="MiddleCenter">
                    <Button id="btn_%s_ChargePivotSx" text="Perno Destro"   font="warforge_font" fontStyle="Bold" fontSize="16" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="150" height="30" onClick="Global/charge_btnPivotSx"/>
                    <Button id="btn_%s_ChargePivotDx" text="Perno Sinistro" font="warforge_font" fontStyle="Bold" fontSize="16" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="150" height="30" onClick="Global/charge_btnPivotDx"/>
                    <Button id="btn_%s_ChargeCheck"   text="Controlla"      font="warforge_font" fontStyle="Bold" fontSize="16" color="rgba(0.6,0.45,0.1,1)"  textColor="White" width="150" height="30" onClick="Global/charge_btnCheck"/>
                </HorizontalLayout>
                <HorizontalLayout spacing="10" childAlignment="MiddleCenter">
                    <Button id="btn_%s_ChargeAbort" text="Annulla" font="warforge_font" fontStyle="Bold" fontSize="18" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="660" height="30" onClick="Global/charge_btnAbort"/>
                    <Button id="btn_%s_ChargeClose" text="Chiudi"  font="warforge_font" fontStyle="Bold" fontSize="18" color="rgba(0.45,0.45,0.45,1)" textColor="White" width="660" height="30" onClick="Global/charge_btnClose"/>
                </HorizontalLayout>
                </VerticalLayout>
        </Panel>
    ]], unitKey, x, y, z, colore, labelText, unitKey, unitKey, unitKey, unitKey, unitKey, unitKey)
end
-- ============================================================
-- FUNZIONE: charge_redraw(unitKey)
-- Ricostruisce il pannello 3D di dichiarazione con il testo
-- pollici-di-perno aggiornato. Stesso principio di move_redraw
-- (6_move/lib.ttslua).
-- ============================================================
function charge_redraw(unitKey)

    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if not session or not session.panel3DObj then return end
    if session.panel3DObj.isDestroyed() then return end

    local slot = main_getArmyByColor(session.activePlayer)
    local _, _, _, newHost = charge_findLineTarget(session.attackerKey, slot)
    if newHost then
        if session.lineHost and session.lineHost ~= newHost then
            session.lineHost.setVectorLines({})
        end
        session.lineHost = newHost
    end

    local fronte = main_detectFormation(session.myBases)
    local x, y, z = main_calcolaPosizionePannello(fronte, #session.myBases)

    local labelText = string.format("%s - Carica: Perno %.1f&quot;/2.0&quot;", session.attackerKey, session.pivotUsed)
    session.panel3DObj.UI.setXml(charge_buildDeclarePanel3DXml(session.attackerKey, x, y, z, session.activePlayer.color, labelText))
end

-- ============================================================
-- FUNZIONE: charge_close(unitKey)
-- Chiude il pannello 3D e pulisce la sessione di dichiarazione.
-- Stesso principio di move_close (6_move/lib.ttslua).
-- ============================================================
function charge_close(unitKey)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if not session then return end

    if session.lineHost then
        session.lineHost.setVectorLines({})
    end

    if session.panel3DObj and not session.panel3DObj.isDestroyed() then
        session.panel3DObj.UI.setXml("")
    end

    IEF_CHARGE_DECLARE_SESSION[unitKey] = nil
end

-- ============================================================
-- FUNZIONE: charge_declareOpenFromButton(obj, player_color, alt_click)
-- click_function del pulsante 3D "CARICA". TTS passa sempre
-- (obj, player_color, alt_click) — nessun parametro custom
-- possibile in createButton(). Apre il pannello 3D interattivo
-- (Perno Sx/Dx + Check Carica), agganciato alla base stessa.
-- Nessuna selezione nativa richiesta al giocatore.
-- ============================================================
function charge_declareOpenFromButton(obj, player_color, alt_click)

    local player = Player[player_color]
    if not player then return end

    if ENGINE.phase ~= PHASE.CHARGE_DECLARE then
       -- printToColor("[CARICA] Non è la fase di dichiarazione carica", player.color, {r=1,g=0.6,b=0})
       -- return
    end

    local slot = main_getArmyByColor(player)
    if not slot then
        printToColor("[CARICA] Giocatore non riconosciuto", player.color, {r=1,g=0.6,b=0})
        return
    end

    local myTag = "Army" .. slot
    if not obj.hasTag(myTag) then
        printToColor("[CARICA] Questo pulsante non appartiene a una tua unità", player.color, {r=1,g=0.6,b=0})
        return
    end

    local myKey = main_getUnitKey(obj)
    if not myKey then
        printToColor("[CARICA] Impossibile identificare l'unità caricante", player.color, {r=1,g=0.6,b=0})
        return
    end

    -- Se questa STESSA unità aveva già un pannello aperto (es. il
    -- player riclicca la base), chiude quella sessione prima di
    -- ricrearla — non serve chiudere le sessioni di ALTRE unità:
    -- più pannelli in parallelo (uno per unitKey) sono ammessi,
    -- stesso principio di Move/Formazione.
    if IEF_CHARGE_DECLARE_SESSION[myKey] then
        charge_close(myKey)
    end

    local myMeta = charge_getUnitMeta(obj)
    local myTipo = myMeta and myMeta.unitType
    if myTipo == "ART" then
        printToColor("[CARICA] L'Artiglieria non può mai dichiarare cariche", player.color, {r=1,g=0.6,b=0})
        return
    end

    local myBases = charge_getUnitBases(myKey)
    if #myBases == 0 then
        printToColor("[CARICA] Impossibile leggere le basi dell'unità", player.color, {r=1,g=0.6,b=0})
        return
    end

    local startPos, startRot = {}, {}
    for i, b in ipairs(myBases) do
        startPos[i] = b.getPosition()
        startRot[i] = b.getRotation()
    end

    IEF_CHARGE_DECLARE_SESSION[myKey] = {
        attackerKey  = myKey,
        myBases      = myBases,
        startPos     = startPos,
        startRot     = startRot,
        pivotUsed    = 0,
        targetKey    = nil,
        distInches   = nil,
        panel3DObj   = obj,
        activePlayer = player,
    }

    main_cameraToUnitPanel(player, myBases, 30, ArmyYaw["ButtonBase"][slot], 15)
    UI.setAttribute("confirm_panel_charge", "active", "false")
    Wait.time(function ()
        charge_redraw(myKey)
    end, 1)
end
-- ============================================================
-- FUNZIONE: charge_pivotApply(player, direzione)
-- direzione: "left" | "right". Applica 1" di perno (o il residuo
-- se minore), fino al budget massimo di 2" per la carica intera.
-- Stessa matrice di rotazione di move_perno_apply, ma pivotBase
-- = angolo di fronte reale (charge_getFrontLine).
-- ============================================================
function charge_pivotApply(player, unitKey, direzione)
    local slot = main_getArmyByColor(player)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if not session then return end

    if charge_alreadyDeclared(slot, session.attackerKey) then
        warning("[CARICA] Questa unità ha già dichiarato una carica questo turno", "Yellow")
        return
    end

    local residuo = 2 - session.pivotUsed
    if residuo <= 0.001 then
        printToColor("[CARICA] Perno massimo (2\") già usato", player.color, {r=1,g=0.6,b=0})
        return
    end

    local myBases = session.myBases
    if #myBases < 2 then
        printToColor("[CARICA] Unità a base singola: perno non applicabile", player.color, {r=1,g=0.6,b=0})
        return
    end

    local distanzaInch = math.min(1, residuo)

    local fwdXZ, right, frontLeft, frontRight = charge_getFrontLine(myBases)
    local p1, p2 = frontLeft.getPosition(), frontRight.getPosition()
    local radius = Vector(p2.x - p1.x, 0, p2.z - p1.z):magnitude()
    if radius <= 0.01 then return end

    local dirSegno = (direzione == "left") and -1 or 1
    local angoloSigned = dirSegno * (distanzaInch * INCH_TO_TTS) / radius

    local pivotBase = (direzione == "left") and frontLeft or frontRight
    charge_applyPivot(myBases, pivotBase, angoloSigned)

    session.pivotUsed = session.pivotUsed + distanzaInch
    charge_redraw(unitKey)
end

-- ============================================================
-- FUNZIONE: charge_btnPivotSx(player, value, id)
-- onClick 3D (prefisso "Global/") del pulsante "Perno Sx".
-- unitKey estratto dall'id (contiene già l'unità del pannello),
-- non più derivato da player/slot — più pannelli possono coesistere
-- in parallelo, uno per unitKey.
-- ============================================================
function charge_btnPivotSx(player, value, id)
    if not player then return end
    local unitKey = id:match("^btn_(.+)_ChargePivotSx$")
    if not unitKey then return end
    charge_pivotApply(player, unitKey, "left")
end

-- ============================================================
-- FUNZIONE: charge_btnPivotDx(player, value, id)
-- onClick 3D del pulsante "Perno Dx".
-- ============================================================
function charge_btnPivotDx(player, value, id)
    if not player then return end
    local unitKey = id:match("^btn_(.+)_ChargePivotDx$")
    if not unitKey then return end
    charge_pivotApply(player, unitKey, "right")
end

-- ============================================================
-- FUNZIONE: charge_checkTarget(player, unitKey)
-- Registra anche IEF_CHARGE_ACTIVE_CONFIRM[slot]=unitKey: il popup
-- 2D confirm_panel_charge è condiviso (un solo oggetto UI, non uno
-- per pannello 3D) — serve sapere a quale unità si riferisce
-- l'ultimo Check fatto da questo player, letto poi da
-- charge_declareCancel/charge_declareConfirm.
-- ============================================================
function charge_checkTarget(player, unitKey)
    local slot = main_getArmyByColor(player)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if not session then return end

    if ENGINE.phase == PHASE.CHARGE_DECLARE then

        local targetKey, a, distInches, newHost, startLeft, startRight, endLeft, endRight = charge_findLineTarget(session.attackerKey, slot)

        if newHost then
            if session.lineHost and session.lineHost ~= newHost then
                session.lineHost.setVectorLines({})
            end
            session.lineHost = newHost
        end

        if charge_alreadyDeclared(slot, session.attackerKey) then
            warningToColor("Questa unità ha già dichiarato una carica questo turno", player.color, "Orange")
            return
        end

        charge_drawCorridor(newHost, startLeft, startRight, endLeft, endRight)

        if not targetKey then
            warningToColor(string.format(tostring(a)), player.color, "Orange", 5)
            return
        end

        local attackerMeta = charge_getUnitMeta(charge_getUnitBases(session.attackerKey)[1])
        local attackerTipo = attackerMeta and attackerMeta.unitType
        local attackerCapabilities = attackerMeta and attackerMeta.capabilities or {}

        local targetMeta = charge_getUnitMeta(charge_getUnitBases(targetKey)[1])
        local targetTipo = targetMeta and targetMeta.unitType

        local obbligatoria = charge_isMandatoryCharge(attackerTipo, attackerCapabilities, targetTipo)

        if not obbligatoria then
            local myBase = charge_getUnitBases(session.attackerKey)[1]
            if not main_isInCommandRange(myBase, slot) then
                warningToColor(string.format("La %s è fuori dal raggio di comando di un Generale", main_decodeExtendedUnitLabel(targetKey)), player.color, "Orange", 5)
                return
            end
        end

        local myBases = charge_getUnitBases(session.attackerKey)
        local targetBases = charge_getUnitBases(targetKey)
        local _, _, distanzaMinima = charge_closestBasePair(myBases, targetBases)

        session.targetKey  = targetKey
        session.distInches = distInches

        IEF_CHARGE_ACTIVE_CONFIRM[slot] = unitKey

        UI.setAttribute("confirm_panel_charge", "visibility", player.color)
        UI.setAttribute("confirm_panel_charge", "active", "true")
        warningToColor(string.format("la %s è ad una distanza di %.2f %s", main_decodeExtendedUnitLabel(targetKey), distanzaMinima, MEASURE_UNIT), player.color, "Yellow", 5)
       Wait.time(function ()
                warningToColor(string.format("La %s è nel raggio di comando di un Generale", main_decodeExtendedUnitLabel(targetKey)), player.color, "Yellow", 5)
       end, 5)
    elseif ENGINE.phase == PHASE.CHARGE_AUTO then
        local myBase = charge_getUnitBases(session.attackerKey)[1]
        local inRange = main_isInCommandRange(myBase, slot)

        local elemento = charge_findQueueEntry(slot, session.attackerKey)
        local distanzaMinima = nil
        if elemento then
            local otherSlot = charge_elementoOtherSlot(slot)
            local elemento = charge_findOrCreateElement(slot, session.attackerKey, otherSlot, session.targetKey)
            charge_elementoSetRequest(elemento, slot, true)
            charge_elementoSetDeclareData(elemento, slot, session.pivotUsed, session.distInches)

            local myBases = charge_getUnitBases(session.attackerKey)
            local targetBases = charge_getUnitBases(session.targetKey)
            local _, closestTargetBase = charge_closestBasePair(myBases, targetBases)
            if closestTargetBase then
                local p = closestTargetBase.getPosition()
                if slot == 1 then elemento.moveTargetArmy1 = Vector(p.x, p.y, p.z)
                else elemento.moveTargetArmy2 = Vector(p.x, p.y, p.z) end
            end
        end
    end
end

-- ============================================================
-- FUNZIONE: charge_btnCheck(player, value, id)
-- onClick 3D del pulsante "Check Carica".
-- ============================================================
function charge_btnCheck(player, value, id)
    if not player then return end
    local unitKey = id:match("^btn_(.+)_ChargeCheck$")
    if not unitKey then return end
    charge_checkTarget(player, unitKey)
end

-- ============================================================
-- FUNZIONE: charge_declareRestorePosition(session)
-- Riporta le basi dell'unità alla posizione/rotazione salvate
-- all'apertura del pannello (prima di qualsiasi perno).
-- ============================================================
function charge_declareRestorePosition(session)
    if not session then return end
    for i, b in ipairs(session.myBases) do
        if session.startPos[i] then b.setPosition(session.startPos[i]) end
        if session.startRot[i] then b.setRotation(session.startRot[i]) end
    end
end
-- ============================================================
-- FUNZIONE: charge_declareAbort(player, unitKey)
-- Annulla tutto (compresi i perni), ripristina la posizione di
-- partenza, chiude il pannello 3D e il popup di conferma.
-- ============================================================
function charge_declareAbort(player, unitKey)
    local session = IEF_CHARGE_DECLARE_SESSION[unitKey]
    if session then
        charge_declareRestorePosition(session)
    end
end

-- ============================================================
-- FUNZIONE: charge_btnAbort(player, value, id)
-- ============================================================
function charge_btnAbort(player, value, id)
    if not player then return end
    local unitKey = id:match("^btn_(.+)_ChargeAbort$")
    if not unitKey then return end
    charge_declareAbort(player, unitKey)
end
-- ============================================================
-- FUNZIONE: charge_btnClose(player, value, id)
-- ============================================================
function charge_btnClose(player, value, id)
    if not player then return end
    local unitKey = id:match("^btn_(.+)_ChargeClose$")
    if not unitKey then return end
    charge_close(unitKey)
    UI.setAttribute("confirm_panel_charge", "active", "false")
end
-- ============================================================
-- FUNZIONE: charge_declareCancel(player, value, id, buttonConfig)
-- onClick del pulsante "CANCEL" nel popup 2D confirm_panel_charge.
-- Nessun unitKey nell'id (popup condiviso, fisso): letto da
-- IEF_CHARGE_ACTIVE_CONFIRM[slot], impostato dall'ultimo Check
-- fatto da questo player. Annulla tutto (compresi i perni già
-- fatti) e ripristina la posizione di partenza — il pannello 3D
-- resta aperto per riprovare (nuovi perni/check).
-- ============================================================
function charge_declareCancel(player, value, id, buttonConfig)
    local slot = main_getArmyByColor(player)
    local unitKey = slot and IEF_CHARGE_ACTIVE_CONFIRM[slot]
    local session = unitKey and IEF_CHARGE_DECLARE_SESSION[unitKey]
    if session then
        charge_declareRestorePosition(session)
        session.pivotUsed  = 0
        session.targetKey  = nil
        session.distInches = nil
        charge_redraw(unitKey)
    end
    UI.setAttribute("confirm_panel_charge", "active", "false")
    return true
end

-- ============================================================
-- FUNZIONE: charge_declareConfirm(player, value, id, buttonConfig)
-- ============================================================
function charge_declareConfirm(player, value, id, buttonConfig)
    local slot = main_getArmyByColor(player)
    local unitKey = slot and IEF_CHARGE_ACTIVE_CONFIRM[slot]
    local session = unitKey and IEF_CHARGE_DECLARE_SESSION[unitKey]

    if not session or not session.targetKey or not session.attackerKey then
        UI.setAttribute("confirm_panel_charge", "active", "false")
        return
    end

    if charge_alreadyDeclared(slot, session.attackerKey) then
        printToColor("[CARICA] Questa unità ha già dichiarato una carica questo turno", player.color, {r=1,g=0.6,b=0})
        charge_close(unitKey)
        UI.setAttribute("confirm_panel_charge", "active", "false")
        return
    end

    local otherSlot = charge_elementoOtherSlot(slot)
    local elemento = charge_findOrCreateElement(slot, session.attackerKey, otherSlot, session.targetKey)
    charge_elementoSetRequest(elemento, slot, true)
    charge_elementoSetDeclareData(elemento, slot, session.pivotUsed, session.distInches)

    local myBases = charge_getUnitBases(session.attackerKey)
    local targetBases = charge_getUnitBases(session.targetKey)

    if not elemento.moveTargetArmy1 and not elemento.moveTargetArmy2 then
        -- Nessuno ha ancora salvato un punto per questo elemento:
        -- lo calcolo ora, UNA SOLA VOLTA, e lo salvo per ENTRAMBI
        -- i lati — non uno snapshot separato a testa.
        local closestMine, closestTheirs = charge_closestBasePair(myBases, targetBases)
        if closestMine and closestTheirs then
            local pMine = closestMine.getPosition()
            local pTheirs = closestTheirs.getPosition()
            if slot == 1 then
                elemento.moveTargetArmy2 = Vector(pMine.x, pMine.y, pMine.z)
                elemento.moveTargetArmy1 = Vector(pTheirs.x, pTheirs.y, pTheirs.z)
            else
                elemento.moveTargetArmy1 = Vector(pMine.x, pMine.y, pMine.z)
                elemento.moveTargetArmy2 = Vector(pTheirs.x, pTheirs.y, pTheirs.z)
            end
        end
    end

    printToColor(string.format("[CARICA] Dichiarazione: %s carica %s", session.attackerKey, session.targetKey), player.color, {r=0.3,g=1,b=0.3})
    UI.setAttribute("confirm_panel_charge", "active", "false")
    charge_close(unitKey)
    callHandler("buildUI")
    callHandler("updateCenterPanel")
end
-- ============================================================
-- FUNZIONE: charge_determineResponses(myTipo, myArmi, myCapabilities, attackerTipo)
-- Determina le risposte legali per il bersaglio di una carica,
-- in base al proprio tipo/capacità e al tipo dell'attaccante
-- (regolamento, "POSSIBILI RISPOSTE ALLE CARICHE"):
--   - KN caricato > contro-carica obbligatoria
--   - CP con IMPETO > contro-carica obbligatoria
--   - CP senza IMPETO > contro-carica o resta ferma (scelta)
--   - CL > contro-carica / evasione / resta ferma (scelta)
--   - FL caricata da non-FL/EL > evasione obbligatoria
--   - FL caricata da FL/EL > stesse opzioni di CL (scelta)
--   - FP/FM con arma da tiro > Tiro d'Arresto o resta ferma
--   - chiunque altro > nessuna risposta
--
-- Ritorna: obbligato (stringa o nil), opzioni (lista di stringhe,
-- vuota se obbligato è impostato — in quel caso c'è una sola
-- scelta, non opzionale).
-- ============================================================
function charge_determineResponses(myTipo, myArmi, myCapabilities, attackerTipo)
    
    if myTipo == "KN" then
        return REACTION_TYPE.COC, {}
        
    elseif myTipo == "CP" then
        if charge_hasCapability(myCapabilities, "IMPETO") then
            return REACTION_TYPE.COC, {}
        end
        return nil, { REACTION_TYPE.COC, REACTION_TYPE.FER }
    elseif myTipo == "CL" then
        return nil, { REACTION_TYPE.COC, REACTION_TYPE.EVA, REACTION_TYPE.FER }
    elseif myTipo == "FL" then
        if attackerTipo == "FL" or attackerTipo == "EL" then
            return nil, { REACTION_TYPE.COC, REACTION_TYPE.EVA, REACTION_TYPE.FER }
        end
        return REACTION_TYPE.EVA, {}
    elseif (myTipo == "FP" or myTipo == "FM") and charge_hasArmaDaTiro(myArmi) then
        return nil, { REACTION_TYPE.TIR, REACTION_TYPE.FER }
    end
    return nil, {}
end
-- ============================================================
-- FUNZIONE: charge_hasArmaDaTiro(armi)
-- Vero se la lista di armi contiene almeno un'arma da tiro
-- utilizzabile per il Tiro d'Arresto (esclude il GIAVELLOTTO,
-- regolamento: "Può essere usata solo per effettuare un Tiro
-- d'Arresto" — cioè il contrario, è l'UNICA arma che NON dà
-- diritto al Tiro d'Arresto standard qui, verificare comunque
-- la regola esatta se serve).
-- ============================================================
function charge_hasArmaDaTiro(armi)
    if not armi then return false end
    local weaponsDict = IEF_DATA.weapons and (IEF_DATA.weapons.weapons or IEF_DATA.weapons)
    if not weaponsDict then return false end

    for _, nomeArma in ipairs(armi) do
        if nomeArma ~= "GIAVELLOTTO" then
            local w = weaponsDict[nomeArma]
            if w and w.range_inches and w.range_inches > 0 then
                return true
            end
        end
    end
    return false
end
-- ============================================================
-- FUNZIONE: charge_cameraToPoint(player, slot, position)
-- Sposta la telecamera del giocatore su un punto qualsiasi del
-- tavolo (punto medio attaccante/bersaglio di una carica). Riusa
-- engine_diceCamera (engine/lib.ttslua), che accetta una
-- posizione libera, non solo le zone camera fisse.
-- ============================================================
function charge_cameraToPoint(player, slot, position)
    local yaw = (slot == 1) and 0 or 180
    engine_diceCamera(player, position, 40, yaw, 15)
end

-- ============================================================
-- FUNZIONE: charge_getAttackListPanelXml(slot)
-- ============================================================
function charge_getAttackListPanelXml(slot)

    local righe = {}
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoRequest(e, slot) then table.insert(righe, e) end
    end

    local colore = ARMY[slot] and ARMY[slot].color or "White"
    local attivo = (ENGINE.phase == PHASE.CHARGE_DECLARE and #righe > 0) and "true" or "false"

    local rows = ""
    for i, e in ipairs(righe) do
        local myKey = charge_elementoUnitKey(e, slot)
        local otherKey = charge_elementoOtherKey(e, slot)
        rows = rows .. string.format(
            '<Row preferredHeight="25">' ..
                '<Cell>' ..
                    '<Button id="charge_attack_row_%d_%s" text="  %s %s carica %s %s" font="warforge_font" fontSize="11" color="rgba(0,0,0,0.30)" textColor="White" alignment="MiddleLeft"/>' ..
                '</Cell>' ..
                '<Cell>' ..
                    '<Button id="charge_attack_row_btn_%d_%s" text="" fontSize="14" fontStyle="Bold" color="rgba(0.7,0.15,0.15,1)" textColor="White" onClick="charge_attackRowClick"/>' ..
                '</Cell>' ..
            '</Row>',
            slot, otherKey,
            main_decodeUnitTypeLabel(myKey),
            main_decodeArmyCodeLabel(myKey),
            main_decodeUnitTypeLabel(otherKey),
            main_decodeArmyCodeLabel(otherKey),
            slot, otherKey
        )
    end

    return string.format(
        '<Panel id="charge_attack_list_army%d" rectAlignment="LowerCenter" color="rgba(0,0,0,0.35)" width="500" height="160" offsetXY="0 110" visibility="%s" active="%s">' ..
        '<Text text="CARICHE %s" font="warforge_font" fontSize="14" fontStyle="Bold" outlineColor="Black" outlineSize="1" color="White" position="0 65 0" alignment="MiddleCenter" width="300" height="22"/>' ..
        '<TableLayout width="500" height="120" cellBackgroundColor="rgba(0,0,0,0.00)" columnWidths="475 25" position="0 -5 0">' ..
        '%s' ..
        '</TableLayout>' ..
        '</Panel>',
        slot, colore, attivo, ARMY[slot].name, rows
    )
end
-- ============================================================
-- FUNZIONE: charge_getDefenseListPanelXml(slot)
-- ============================================================
function charge_getDefenseListPanelXml(slot)

    local otherSlot = charge_elementoOtherSlot(slot)
    local righe = {}
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if charge_elementoRequest(e, otherSlot) then table.insert(righe, e) end
    end

    local colore = ARMY[slot] and ARMY[slot].color or "White"
    local attivo = ((ENGINE.phase == PHASE.CHARGE_REACT or ENGINE.phase == PHASE.CHARGE_AUTO) and #righe > 0) and "true" or "false"

    local rows = ""
    for i, e in ipairs(righe) do
        local myKey = charge_elementoUnitKey(e, slot)
        local otherKey = charge_elementoOtherKey(e, slot)
        local statoReazione = charge_elementoIsReciprocal(e) and REACTION_TYPE.COC or (charge_elementoResponse(e, slot) or "nessuna reazione")
        rows = rows .. string.format(
            '<Row preferredHeight="25">' ..
                '<Cell>' ..
                    '<Button id="charge_defense_row_%d_%s" text="  %s %s è caricata da %s %s | %s" font="warforge_font" fontSize="11" color="rgba(0,0,0,0.30)" textColor="White" alignment="MiddleLeft"/>' ..
                '</Cell>' ..
                '<Cell>' ..
                    '<Button id="charge_defense_row_btn_%d_%s" tooltip="charge_defense_row_btn_%d_%s" fontSize="14" fontStyle="Bold" color="rgba(0.7,0.15,0.15,1)" textColor="White" onClick="charge_defenseRowClick"/>' ..
                '</Cell>' ..
            '</Row>',
            slot, otherKey,
            main_decodeUnitTypeLabel(myKey),
            main_decodeArmyCodeLabel(myKey),
            main_decodeUnitTypeLabel(otherKey),
            main_decodeArmyCodeLabel(otherKey),
            statoReazione,
            slot, otherKey,
            slot, otherKey
        )
    end

    return string.format(
        '<Panel id="charge_defense_list_army%d" rectAlignment="LowerCenter" color="rgba(0,0,0,0.35)" width="500" height="160" offsetXY="0 110" visibility="%s" active="%s">' ..
        '<Text text="REAZIONI %s" font="warforge_font" fontSize="14" fontStyle="Bold" outlineColor="Black" outlineSize="1" color="White" position="0 65 0" alignment="MiddleCenter" width="300" height="22"/>' ..
        '<TableLayout width="500" height="120" cellBackgroundColor="rgba(0,0,0,0.00)" columnWidths="475 25" position="0 -5 0">' ..
        '%s' ..
        '</TableLayout>' ..
        '</Panel>',
        slot, colore, attivo, ARMY[slot].name, rows
    )
end

-- ============================================================
-- FUNZIONE: charge_attackRowClick(player, value, id)
-- ============================================================
function charge_attackRowClick(player, value, id)
    local slotStr, otherKey = id:match("^charge_attack_row_btn_(%d)_(.+)$")

    if not slotStr then return end
    local slot = tonumber(slotStr)
    local otherSlot = charge_elementoOtherSlot(slot)

    local elemento = charge_findQueueEntry(otherSlot, otherKey)
    if not elemento then return end

    local myKey = charge_elementoUnitKey(elemento, slot)
    local myBases = charge_getUnitBases(myKey)
    local targetBases = charge_getUnitBases(otherKey)
    if myBases[1] and targetBases[1] then
        local p1, p2 = myBases[1].getPosition(), targetBases[1].getPosition()
        charge_cameraToPoint(player, slot, Vector((p1.x + p2.x) / 2, (p1.y + p2.y) / 2, (p1.z + p2.z) / 2))
    end

    if ENGINE.phase ~= PHASE.CHARGE_AUTO then return end

    if elemento.step == CHARGE_STEP.CLO then
        printToColor("[CARICA] Questa carica è già stata risolta", player.color, {r=1,g=0.6,b=0})
        return
    end

    IEF_CHARGE_RESPONSE_PENDING[slot] = { elemento = elemento, unitKey = myKey }

    local buttonIds = { "btnResponseCounter", "btnResponseEvade", "btnResponseStopfire", "btnResponseHold" }
    for _, bid in ipairs(buttonIds) do
        UI.setAttribute(bid, "active", "false")
    end
    UI.setAttribute("btnResponseCharge", "active", "true")
    UI.setAttribute("btnResponseCharge", "textColor", "white")
    UI.setAttribute("charge_response_panel", "visibility", player.color)
    UI.setAttribute("charge_response_panel", "active", "true")
end
-- ============================================================
-- FUNZIONE: charge_defenseRowClick(player, value, id)
-- ============================================================
function charge_defenseRowClick(player, value, id)
    local slotStr, otherKey = id:match("^charge_defense_row_btn_(%d)_(.+)$")

    if not slotStr then return end
    local slot = tonumber(slotStr)
    local otherSlot = charge_elementoOtherSlot(slot)

    local elemento = charge_findQueueEntry(otherSlot, otherKey)
    if not elemento then return end

    if elemento.step == CHARGE_STEP.CLO then
        printToColor("[CARICA] Questa carica è già stata risolta", player.color, {r=1,g=0.6,b=0})
        return
    end

    local myKey = charge_elementoUnitKey(elemento, slot)
    local myBases = charge_getUnitBases(myKey)
    local attackerBases = charge_getUnitBases(otherKey)

    if charge_elementoIsReciprocal(elemento) then
        if myBases[1] and attackerBases[1] then
            local p1, p2 = myBases[1].getPosition(), attackerBases[1].getPosition()
            charge_cameraToPoint(player, slot, Vector((p1.x + p2.x) / 2, (p1.y + p2.y) / 2, (p1.z + p2.z) / 2))
        end
        return
    end

    if myBases[1] and attackerBases[1] then
        local p1, p2 = myBases[1].getPosition(), attackerBases[1].getPosition()
        charge_cameraToPoint(player, slot, Vector((p1.x + p2.x) / 2, (p1.y + p2.y) / 2, (p1.z + p2.z) / 2))
    end

    local myMeta = myBases[1] and charge_getUnitMeta(myBases[1])
    local myTipo = myMeta and myMeta.unitType
    local myArmi = myMeta and myMeta.armi or {}
    local myCapabilities = myMeta and myMeta.capabilities or {}

    local attackerMeta = attackerBases[1] and charge_getUnitMeta(attackerBases[1])
    local attackerTipo = attackerMeta and attackerMeta.unitType

    local obbligato, opzioni = charge_determineResponses(myTipo, myArmi, myCapabilities, attackerTipo)

    if not obbligato and #opzioni == 0 then
        printToColor(string.format("[CARICA] %s non ha nessuna risposta disponibile", myKey), player.color, {r=0.7,g=0.7,b=0.7})
        return
    end

    IEF_CHARGE_RESPONSE_PENDING[slot] = { elemento = elemento }

    local disponibili = obbligato and { obbligato } or opzioni
    local buttonIds = {
        [REACTION_TYPE.COC] = "btnResponseCounter",
        [REACTION_TYPE.EVA] = "btnResponseEvade",
        [REACTION_TYPE.TIR] = "btnResponseStopfire",
        [REACTION_TYPE.FER] = "btnResponseHold",
    }

    for _, chiave in ipairs({ REACTION_TYPE.COC, REACTION_TYPE.EVA, REACTION_TYPE.TIR, REACTION_TYPE.FER }) do
        UI.setAttribute(buttonIds[chiave], "active", "false")
    end

    for _, chiave in ipairs({ REACTION_TYPE.COC, REACTION_TYPE.EVA, REACTION_TYPE.TIR, REACTION_TYPE.FER }) do
        local presente = false
        for _, d in ipairs(disponibili) do
            if d == chiave then presente = true end
        end
        UI.setAttribute(buttonIds[chiave], "active", presente and "true" or "false")
        UI.setAttribute(buttonIds[chiave], "textColor", "white")
    end

    UI.setAttribute("btnResponseCancel", "active", "true")
    UI.setAttribute("btnResponseCancel", "textColor", "white")
    UI.setAttribute("charge_response_panel", "visibility", player.color)
    UI.setAttribute("charge_response_panel", "active", "true")
end
-- ============================================================
-- FUNZIONE: charge_resolveConflicts()
-- ============================================================
function charge_resolveConflicts()
    -- Per ogni unitKey: l'elemento dove è richiedente (asAttacker)
    -- e l'elemento dove è bersaglio puro, cioè l'altro lato ha
    -- request=true mentre la sua non ce l'ha (asTarget).
    local asAttacker, asTarget = {}, {}
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if e.requestArmy1 then asAttacker[e.unitArmy1Key] = e end
        if e.requestArmy2 then asAttacker[e.unitArmy2Key] = e end
        if e.requestArmy1 and not e.requestArmy2 then asTarget[e.unitArmy2Key] = e end
        if e.requestArmy2 and not e.requestArmy1 then asTarget[e.unitArmy1Key] = e end
    end

    local unitKeys = {}
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if e.unitArmy1Key and e.unitArmy2Key then
            unitKeys[e.unitArmy1Key] = true
            unitKeys[e.unitArmy2Key] = true
        end
    end

    local daRimuovere = {}
    for uk in pairs(unitKeys) do
        local elAtk = asAttacker[uk]
        local elTgt = asTarget[uk]

        -- Conflitto vero solo se sono due elementi DIVERSI: se
        -- coincidono, uk è coinvolta in un'unica carica reciproca
        -- (nessun doppio ruolo, nulla da arbitrare).
        if elAtk and elTgt and elAtk ~= elTgt then
            local mySlotInAtk = (elAtk.unitArmy1Key == uk) and 1 or 2
            local distComeAttaccante = charge_elementoDistInches(elAtk, mySlotInAtk) or 0

            local mySlotInTgt = (elTgt.unitArmy1Key == uk) and 1 or 2
            local otherSlotInTgt = charge_elementoOtherSlot(mySlotInTgt)
            local distComeBersaglio = charge_elementoDistInches(elTgt, otherSlotInTgt) or 0

            if distComeBersaglio < distComeAttaccante then
                daRimuovere[elAtk] = true
            else
                daRimuovere[elTgt] = true
            end
        end
    end

    local nuova = {}
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if daRimuovere[e] then
            printToAll(string.format("[CARICA] %s <-> %s scartata (conflitto di prossimità)", e.unitArmy1Key, e.unitArmy2Key), {r=1,g=0.6,b=0.2})
        else
            table.insert(nuova, e)
        end
    end
    IEF_CHARGE_QUEUE = nuova
end
function charge_applyPivot(basiObjs, pivotBase, angoloSigned)
    local pivotPos = pivotBase.getPosition()
    local angoloGradi = math.deg(angoloSigned)

    for _, obj in ipairs(basiObjs) do
        if obj ~= pivotBase then
            local p = obj.getPosition()
            local rel = Vector(p.x - pivotPos.x, 0, p.z - pivotPos.z)
            local rx = rel.x * math.cos(angoloSigned) - rel.z * math.sin(angoloSigned)
            local rz = rel.x * math.sin(angoloSigned) + rel.z * math.cos(angoloSigned)
            local newPos = Vector(pivotPos.x + rx, p.y, pivotPos.z + rz)
            obj.setPosition(newPos)
        end
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y - angoloGradi, rot.z))
    end
end

-- ============================================================
-- FUNZIONE: charge_applyStraightMove(basiObjs, distInches)
-- Muove tutte le basi in linea retta lungo la direzione attuale
-- (fronte della prima base). Stesso modello di move_avanti_apply
-- (6_move/lib.ttslua), senza dipendere da IEF_MOVE_UNITS/IEF_MOVE_BUDGET.
-- ============================================================
function charge_applyStraightMove(basiObjs, distInches)
    if #basiObjs == 0 then return end
    local fwd = basiObjs[1].getTransformForward()
    local fwdXZ = Vector(fwd.x, 0, fwd.z):normalized()
    local deltaUnits = distInches * INCH_TO_TTS

    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        obj.setPosition(Vector(p.x + fwdXZ.x*deltaUnits, p.y, p.z + fwdXZ.z*deltaUnits))
    end
end

-- ============================================================
-- FUNZIONE: charge_moveToward(basiObjs, targetPoint, distInches)
-- Muove tutte le basi di distInches pollici verso un punto
-- qualsiasi (non necessariamente lungo il fronte attuale) —
-- usato per la contro-carica, dove le due unità si muovono
-- l'una verso l'altra, non lungo la propria direzione di marcia.
-- ============================================================
function charge_moveToward(basiObjs, targetPoint, distInches)
    if #basiObjs == 0 then return end
    local p0 = basiObjs[1].getPosition()
    local dir = Vector(targetPoint.x - p0.x, 0, targetPoint.z - p0.z):normalized()
    local deltaUnits = distInches * INCH_TO_TTS

    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        obj.setPosition(Vector(p.x + dir.x*deltaUnits, p.y, p.z + dir.z*deltaUnits))
    end
end

-- ============================================================
-- FUNZIONE: charge_turnAround180(basiObjs)
-- ============================================================
function charge_turnAround180(basiObjs)
    for _, obj in ipairs(basiObjs) do
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y + 180, rot.z))
    end
end
-- ============================================================
-- FUNZIONE: charge_responseCounter(player, value, id)
-- ============================================================
function charge_responseCounter(player, value, id)
    local slot = main_getArmyByColor(player)
    local pending = slot and IEF_CHARGE_RESPONSE_PENDING[slot]
    if not pending then return end
    charge_elementoSetResponse(pending.elemento, slot, REACTION_TYPE.COC)

    local elemento = pending.elemento

    if not elemento.moveTargetArmy1 and not elemento.moveTargetArmy2 then
        -- Nessuno ha ancora salvato un punto per questo elemento:
        -- lo calcolo ora, UNA SOLA VOLTA, e lo salvo per ENTRAMBI
        -- i lati — non uno snapshot separato a testa.
        local otherSlot = charge_elementoOtherSlot(slot)
        local myKey = charge_elementoUnitKey(elemento, slot)
        local otherKey = charge_elementoUnitKey(elemento, otherSlot)
        local myBases = charge_getUnitBases(myKey)
        local otherBases = charge_getUnitBases(otherKey)

        local closestMine, closestTheirs = charge_closestBasePair(myBases, otherBases)
        if closestMine and closestTheirs then
            local pMine = closestMine.getPosition()
            local pTheirs = closestTheirs.getPosition()
            if slot == 1 then
                elemento.moveTargetArmy2 = Vector(pMine.x, pMine.y, pMine.z)
                elemento.moveTargetArmy1 = Vector(pTheirs.x, pTheirs.y, pTheirs.z)
            else
                elemento.moveTargetArmy1 = Vector(pMine.x, pMine.y, pMine.z)
                elemento.moveTargetArmy2 = Vector(pTheirs.x, pTheirs.y, pTheirs.z)
            end
        end
    end

    UI.setAttribute("charge_response_panel", "active", "false")
    charge_refreshDefenseRowText(slot, elemento)
    IEF_CHARGE_RESPONSE_PENDING[slot] = nil
end
-- ============================================================
-- FUNZIONE: charge_responseEvade(player, value, id)
-- ============================================================
function charge_responseEvade(player, value, id)
    local slot = main_getArmyByColor(player)
    local pending = slot and IEF_CHARGE_RESPONSE_PENDING[slot]
    if not pending then return end
    charge_elementoSetResponse(pending.elemento, slot, REACTION_TYPE.EVA)
    UI.setAttribute("charge_response_panel", "active", "false")
    charge_refreshDefenseRowText(slot, pending.elemento)
    IEF_CHARGE_RESPONSE_PENDING[slot] = nil
end

-- ============================================================
-- FUNZIONE: charge_responseStopfire(player, value, id)
-- Click "Tiro d'Arresto" nel popup di reazione (fase CHARGE_REACT).
-- Registra SOLO la scelta (responseArmy{slot}=TIR) e chiude il
-- popup: nessuna fisica, nessun pannello dadi qui. Il salto alla
-- fase dedicata CHARGE_STOPFIRE avviene subito con main_goToPhase
-- diretto (stesso pattern dei salti asincroni del motore) — non
-- si aspetta il bottone "Reazioni Completate", la risoluzione del
-- Tiro d'Arresto è immediata.
-- ============================================================
function charge_responseStopfire(player, value, id)
    print("charge_responseStopfire")
    local slot = main_getArmyByColor(player)
    local pending = slot and IEF_CHARGE_RESPONSE_PENDING[slot]
    if not pending then return end
    local elemento = pending.elemento
    local otherKey = charge_elementoOtherKey(elemento, slot)
    charge_elementoSetResponse(elemento, slot, REACTION_TYPE.TIR)
    IEF_CHARGE_RESPONSE_PENDING[slot] = nil

    UI.setAttribute("charge_defense_row_btn_" .. slot .. "_" .. otherKey, "interactable", "false")
    UI.setAttribute("charge_defense_row_btn_" .. slot .. "_" .. otherKey, "color", "Grey")
    UI.setAttribute("charge_response_panel", "active", "false")

    charge_refreshDefenseRowText(slot, elemento)

    main_goToPhase("CHARGE_STOPFIRE")
end
-- ============================================================
-- FUNZIONE: charge_stopfireBeginFromClick(player, value, id)
-- ============================================================
function charge_stopfireBeginFromClick(player, value, id)
    local slot = main_getArmyByColor(player)
    if not slot then return end
    engine_diceCameraZoom(player, slot)
end
-- ============================================================
-- FUNZIONE: charge_responseHold(player, value, id)
-- ============================================================
function charge_responseHold(player, value, id)
    local slot = main_getArmyByColor(player)
    local pending = slot and IEF_CHARGE_RESPONSE_PENDING[slot]
    if not pending then return end
    charge_elementoSetResponse(pending.elemento, slot, REACTION_TYPE.FER)
    UI.setAttribute("charge_response_panel", "active", "false")
    charge_refreshDefenseRowText(slot, pending.elemento)
    IEF_CHARGE_RESPONSE_PENDING[slot] = nil
end
-- ============================================================
-- FUNZIONE: charge_reactQueueHasPending()
-- Vero se c'è una risoluzione Tiro d'Arresto in corso, o se
-- almeno una riga NON-reciproca non ha ancora una response.
-- Usata sia dal guard sui bottoni fase CHARGE_REACT sia dalla
-- condizione COND.CHARGE_QUEUE_NOT_EMPTY/EMPTY quando serve.
-- ============================================================
function charge_reactQueueHasPending()
    if IEF_STOPFIRE_CURRENT ~= nil then return true end
    for _, e in ipairs(IEF_CHARGE_QUEUE) do
        if not charge_elementoIsReciprocal(e) and e.step ~= CHARGE_STEP.CLO then
            -- Lato SENZA request=true: chi non ha dichiarato deve
            -- ancora scegliere una reazione, a meno che non l'abbia
            -- già fatto (responseArmy{quel lato} impostata).
            if not e.requestArmy1 and not e.responseArmy1 then return true end
            if not e.requestArmy2 and not e.responseArmy2 then return true end
        end
    end
    return false
end

-- ============================================================
-- FUNZIONE: charge_refreshDefenseRowText(slot, elemento)
-- Aggiorna il testo di UNA riga Difesa dopo che la reazione è
-- stata registrata/annullata — la riga resta sempre visibile.
-- ============================================================
-- ============================================================
-- FUNZIONE: charge_refreshDefenseRowText(slot, elemento)
-- Aggiorna il testo di UNA riga Difesa dopo che la reazione è
-- stata registrata/annullata — la riga resta sempre visibile.
-- ============================================================
function charge_refreshDefenseRowText(slot, elemento)
    local myKey = charge_elementoUnitKey(elemento, slot)
    local otherKey = charge_elementoOtherKey(elemento, slot)
    local rowId = string.format("charge_defense_row_%d_%s", slot, otherKey)
    local statoReazione = charge_elementoIsReciprocal(elemento) and REACTION_TYPE.COC or (charge_elementoResponse(elemento, slot) or "è caricata da")
    UI.setAttribute(rowId, "text", string.format("  %s %s %s %s %s",
        main_decodeUnitTypeLabel(myKey),
        main_decodeArmyCodeLabel(myKey),
        statoReazione,
        main_decodeUnitTypeLabel(otherKey),
        main_decodeArmyCodeLabel(otherKey)
    ))
    UI.setAttribute(rowId, "textColor", "White")
end
-- ============================================================
-- FUNZIONE: charge_refreshAttackRowText(slot, elemento)
-- Aggiorna il testo di UNA riga Attacco esistente (lo step è
-- cambiato) via UI.setAttribute diretto — la riga esiste già,
-- non serve ricostruire tutta la UI per un cambio di testo.
-- ============================================================
function charge_refreshAttackRowText(slot, elemento)
    local myKey = charge_elementoUnitKey(elemento, slot)
    local otherKey = charge_elementoOtherKey(elemento, slot)
    local rowId = string.format("charge_attack_row_%d_%s", slot, otherKey)
    UI.setAttribute(rowId, "text", string.format("Unità %s carica Unità %s (%s)", myKey, otherKey, elemento.step))
    UI.setAttribute(rowId, "textColor", "white")
end

-- ============================================================
-- FUNZIONE: charge_executeEvade(slot, elemento)
-- ============================================================

function charge_executeEvade(evadingSlot, elemento)

    print("charge_executeEvade")

    local evadingKey = charge_elementoUnitKey(elemento, evadingSlot)
    local chargingKey = charge_elementoOtherKey(elemento, evadingSlot)
    local defenderBases = charge_getUnitBases(evadingKey)

    if #defenderBases > 0 then
        local defenderMeta = charge_getUnitMeta(defenderBases[1])
        local defenderTipo = defenderMeta and defenderMeta.unitType
        local unitTypeData = defenderTipo and main_getUnitType(defenderTipo)
        local moveInches = unitTypeData and unitTypeData.move_inches or 0

        local oldFwd = defenderBases[1].getTransformForward()
        local fleeXZ = Vector(-oldFwd.x, 0, -oldFwd.z):normalized()

        charge_turnAround180(defenderBases)

        local deltaUnits = moveInches * INCH_TO_TTS
        for _, obj in ipairs(defenderBases) do
            local p = obj.getPosition()
            obj.setPosition(Vector(p.x + fleeXZ.x*deltaUnits, p.y, p.z + fleeXZ.z*deltaUnits))
        end
    end

    IEF_UNIT_NO_MOVE_NEXT_TURN[evadingKey] = true
    elemento.outcome = CHARGE_OUTCOME.EVI
    elemento.step = CHARGE_STEP.CLO

    warning(string.format("[CARICA] %s evade la carica di %s", evadingKey, chargingKey), "Yellow")
end

-- ============================================================
-- FUNZIONE: charge_responseCancel(player, value, id)
-- Annulla la reazione scelta: responseArmy{slot} torna a nil.
-- ============================================================
function charge_responseCancel(player, value, id)
    local slot = main_getArmyByColor(player)
    local pending = slot and IEF_CHARGE_RESPONSE_PENDING[slot]
    if not pending then return end

    local myKey = charge_elementoUnitKey(pending.elemento, slot)
    charge_elementoSetResponse(pending.elemento, slot, nil)

    printToColor(string.format("[CARICA] Reazione annullata per %s", myKey), player.color, {r=0.7,g=0.7,b=0.7})

    UI.setAttribute("charge_response_panel", "active", "false")
    charge_refreshDefenseRowText(slot, pending.elemento)

    IEF_CHARGE_RESPONSE_PENDING[slot] = nil
end

-- ============================================================
-- FUNZIONE: charge_stopfireBegin(slot, elemento)
-- Inizializza IEF_STOPFIRE_CURRENT per la carica da risolvere.
-- Chiamata da before_charge_stopfire (ingresso nella fase
-- CHARGE_STOPFIRE), non più da un click diretto.
-- ============================================================
function charge_stopfireBegin(slot, elemento)
    IEF_STOPFIRE_CURRENT = { elemento = elemento, slot = slot, subStep = "TIRO" }
    charge_stopfireRedraw()
    callHandler("updateCenterPanel")
end

-- ============================================================
-- FUNZIONE: charge_stopfireEnd()
-- Chiude la risoluzione della carica corrente e ESCE dalla fase
-- CHARGE_STOPFIRE tornando a CHARGE_REACT (main_goToPhase diretto
-- — il ritorno a CHARGE_REACT rivaluta le condizioni: se c'è
-- un'altra carica TIR pendente, before_charge_stopfire la
-- reintercetta al giro successivo tramite la transizione dedicata).
-- ============================================================
function charge_stopfireEnd()
    print("charge_stopfireEnd")
    local cur = IEF_STOPFIRE_CURRENT
    IEF_STOPFIRE_CURRENT = nil
    print(cur)
    if cur then
        charge_refreshDefenseRowText(cur.slot, cur.elemento)
        charge_refreshAttackRowText((cur.slot == 1) and 2 or 1, cur.elemento)
    end

    main_goToPhase("CHARGE_REACT")
end

-- ============================================================
-- FUNZIONE: charge_stopfireRedraw()
-- Aggiorna testo e ruolo dei 2 bottoni del pannello dinamico in
-- base al subStep: "TIRO" attivo per il DIFENSORE, "MORALE"
-- attivo per l'ATTACCANTE, "ESCI" quando non serve morale (0
-- colpi o 0 basi rimosse) — un click esplicito chiude comunque
-- la sotto-fase, mai una chiusura silenziosa automatica.
-- ============================================================
function charge_stopfireRedraw()

    print("charge_stopfireRedraw")

    local cur = IEF_STOPFIRE_CURRENT
    if not cur then return end
    local elemento = cur.elemento
    local defenderSlot = cur.slot
    local attackerSlot = (cur.slot == 1) and 2 or 1

    local function setTextColor(id)
        Wait.frames(function()
            UI.setAttribute(id, "textColor", "White")
        end, 1)
    end

    if cur.subStep == "ESCI" then
        UI.setAttribute("BTN_ARMY" .. defenderSlot, "text", "Tira i dadi")
        UI.setAttribute("BTN_ARMY" .. defenderSlot, "color", "Grey")
        UI.setAttribute("BTN_ARMY" .. defenderSlot, "textColor", "Black")
        UI.setAttribute("BTN_ARMY" .. defenderSlot, "interactable", "false") 

        UI.setAttribute("BTN_ARMY" .. attackerSlot, "text", "Fine Tiro di Arresto")
        setTextColor("BTN_ARMY"    .. attackerSlot)
        UI.setAttribute("BTN_ARMY" .. attackerSlot, "interactable", "true")
        return
    end

    local labels  = { [1] = "In attesa...", [2] = "In attesa..." }
    local enabled = { [1] = false, [2] = false }

    labels[defenderSlot]  = "Tira i dadi"
    enabled[defenderSlot] = (cur.subStep == "TIRO")
    labels[attackerSlot]  = "Fai Test del Morale"
    enabled[attackerSlot] = (cur.subStep == "MORALE")

    Wait.time(function()
        for slot = 1, 2 do
            local btnId = "BTN_ARMY" .. slot
            print(btnId)
            UI.setAttribute(btnId, "text", labels[slot])
            setTextColor(btnId)
            UI.setAttribute(btnId, "interactable", enabled[slot] and "true" or "false")
        end
    end, 0.5)
end

-- ============================================================
-- FUNZIONE: charge_hasCapability(capabilities, nome)
-- Helper generico: vero se "nome" è fra le capacità dell'unità.
-- ============================================================
function charge_hasCapability(capabilities, nome)
    for _, c in ipairs(capabilities or {}) do
        if c == nome then return true end
    end
    return false
end

-- ============================================================
-- FUNZIONE: charge_stopfireRollMorale(player)
-- ============================================================
function charge_stopfireRollMorale(player)
    local cur = IEF_STOPFIRE_CURRENT
    if not cur or cur.subStep ~= "MORALE" then return end
    local attackerSlot = (cur.slot == 1) and 2 or 1
    if main_SlotByColor(player.color) ~= attackerSlot then return end
    engine_diceCameraZoom(player, attackerSlot)
end
-- ============================================================
-- FUNZIONE: charge_stopfireDoRoll(player)
-- ============================================================
function charge_stopfireDoRoll(player, slot)
    local cur = IEF_STOPFIRE_CURRENT
    if not cur or cur.subStep ~= "TIRO" then return end
    local elemento = cur.elemento
    local faseOrigine = ENGINE.phase

    -- cur.slot = difensore/tiratore, l'altro lato è chi sta caricando
    local defenderKey = charge_elementoUnitKey(elemento, cur.slot)
    local attackerKey = charge_elementoOtherKey(elemento, cur.slot)
    local defenderBases = charge_getUnitBases(defenderKey)
    local attackerBases = charge_getUnitBases(attackerKey)
    if #defenderBases == 0 or #attackerBases == 0 then
        elemento.outcome = CHARGE_OUTCOME.OK
        elemento.stopfireResolved = true
        charge_stopfireEnd()
        return
    end

    local defenderMeta = charge_getUnitMeta(defenderBases[1])
    local armi = defenderMeta and defenderMeta.armi or {}
    local capabilities = defenderMeta and defenderMeta.capabilities or {}

    local weaponsDict = IEF_DATA.weapons and (IEF_DATA.weapons.weapons or IEF_DATA.weapons)
    local weapon = nil
    for _, arma in ipairs(armi) do
        local w = weaponsDict and weaponsDict[arma]
        if w and w.range_inches and w.range_inches > 0 then weapon = w; break end
    end
    if not weapon then
        printToColor("[TIRO D'ARRESTO] Nessuna arma da tiro trovata", player.color, {r=1,g=0.6,b=0})
        elemento.outcome = CHARGE_OUTCOME.OK
        elemento.stopfireResolved = true
        charge_stopfireEnd()
        return
    end

    local rangeUnits = weapon.range_inches * INCH_TO_TTS
    local basiPronte = shoot_basiPronte(defenderBases, attackerBases, rangeUnits)

    local numDadi = basiPronte
    if charge_hasCapability(capabilities, "RAFFICA") then
        local coppie = math.floor(basiPronte / 2)
        local resto  = basiPronte % 2
        numDadi = coppie * 3 + (resto > 0 and 2 or 0)
    end

    if numDadi <= 0 then
        printToColor("[TIRO D'ARRESTO] Nessuna base in gittata con LOS", player.color, {r=0.7,g=0.7,b=0.7})
        elemento.outcome = CHARGE_OUTCOME.OK
        elemento.stopfireResolved = true
        charge_stopfireEnd()
        return
    end

    local soglia = weapon.hit_threshold or 4
    local mods = weapon.modifiers or {}

    local attackerMeta = charge_getUnitMeta(attackerBases[1])
    local attackerArmi = attackerMeta and attackerMeta.armi or {}
    local haScudo = false
    for _, a in ipairs(attackerArmi) do
        if a == "SCUDO" then haScudo = true end
    end
    if not haScudo and mods.vs_bersaglio_senza_scudo then
        soglia = soglia - mods.vs_bersaglio_senza_scudo
    end

    local attackerTipo = attackerMeta and attackerMeta.unitType
    local function tipoInLista(tipo, lista)
        for t in lista:gmatch("[^_]+") do if t == tipo then return true end end
        return false
    end
    for chiave, valore in pairs(mods) do
        local listaTipi = chiave:match("^vs_(.+)$")
        if listaTipi and listaTipi ~= "bersaglio_senza_scudo" and listaTipi ~= "unita_in_copertura" then
            if tipoInLista(attackerTipo, listaTipi) then
                soglia = soglia - valore
            end
        end
    end

    IEF_DICE_ROLL_TRY[slot] = { dadi = numDadi, soglia = soglia }

    warningToColor(string.format("%s tira %d D6 minimo per colpire %d+", defenderKey, numDadi, soglia), player, "Yellow", 7)

    engine_diceThrowFromBag(slot, nil, function(risultati, successi)
        engine_diceCameraReturn(player, slot, faseOrigine)

        local live = IEF_STOPFIRE_CURRENT
        if not live or live.elemento ~= elemento then return end

        if successi and successi > 0 then
            local attackerSlot = (slot == 1) and 2 or 1
            local baseInfo = main_parseNickname(attackerBases[1].getName())
            local attackerUnitPrima = baseInfo and main_findUnit(attackerSlot, baseInfo.unitType, baseInfo.unitNumber)
            local basiPrima = attackerUnitPrima and main_basiPresentiUnita(attackerUnitPrima)

            if attackerUnitPrima then
                shoot_applyHits(attackerUnitPrima, attackerSlot, successi, player, attackerBases[1])
            end

            Wait.time(function()
                callHandler("deployment_scanTable")
                local unitaAgg = baseInfo and main_findUnit(attackerSlot, baseInfo.unitType, baseInfo.unitNumber)
                local basiDopo = unitaAgg and main_basiPresentiUnita(unitaAgg)

                print(string.format("[DEBUG STOPFIRE MORALE] basiPrima=%s basiDopo=%s", tostring(basiPrima), tostring(basiDopo)))

                if basiPrima and basiDopo and basiDopo < basiPrima then
                    live.subStep = "MORALE"
                    charge_stopfireRedraw()
                else
                    elemento.outcome = CHARGE_OUTCOME.OK
                    elemento.stopfireResolved = true
                    live.subStep = "ESCI"
                    charge_stopfireRedraw()
                end
            end, 3)
        else
            printToAll("[TIRO D'ARRESTO] Nessun colpo a segno", {r=0.7,g=0.7,b=0.7})
            elemento.outcome = CHARGE_OUTCOME.OK
            elemento.stopfireResolved = true
            local live2 = IEF_STOPFIRE_CURRENT
            if live2 then
                live2.subStep = "ESCI"
                charge_stopfireRedraw()
            end
        end
    end)
end
-- ============================================================
-- FUNZIONE: charge_stopfireDoMorale(player, slot)
-- ============================================================
function charge_stopfireDoMorale(player, slot)
    local cur = IEF_STOPFIRE_CURRENT
    if not cur or cur.subStep ~= "MORALE" then return end
    local elemento = cur.elemento
    local attackerKey = charge_elementoOtherKey(elemento, cur.slot)

     main_testMorale(attackerKey, player, "per_caricare", 0, function(esito, somma, soglia, effetto)
        local live = IEF_STOPFIRE_CURRENT
        if not live or live.elemento ~= elemento then return end

        if esito == MORALE_RESULT.OK then
            elemento.outcome = CHARGE_OUTCOME.OK
        else
            elemento.outcome = CHARGE_OUTCOME.ANN
        end
        elemento.stopfireResolved = true
        charge_stopfireEnd()
    end)
end
-- ============================================================
-- FUNZIONE: charge_stopfireExitClick(player, slot)
-- ============================================================
function charge_stopfireExitClick(player, value, id)
    print("charge_stopfireExitClick")
    local cur = IEF_STOPFIRE_CURRENT
    printTable(cur)
    if not cur or cur.subStep ~= "ESCI" then return end
    local attackerSlot = (cur.slot == 1) and 2 or 1

    print(attackerSlot, " ", main_SlotByColor(player.color))

    if main_SlotByColor(player.color) ~= attackerSlot then return end
    charge_stopfireEnd()
end
-- ============================================================
-- FUNZIONE: charge_executeCounterHalf(slot, elemento)
-- Contro-carica: muove SOLO le basi di ARMY{slot} verso il punto
-- medio, calcolato al momento del click con le posizioni ATTUALI
-- di entrambe le unità (nessuno snapshot). Chiamata una volta per
-- ciascun esercito, indipendentemente, dal proprio bottone.
-- ============================================================
function charge_executeCounterHalf(slot, elemento)

    print("charge_executeCounterHalf")
    
    local myKey = charge_elementoUnitKey(elemento, slot)
    local otherKey = charge_elementoOtherKey(elemento, slot)
    local myBases = charge_getUnitBases(myKey)
    local otherBases = charge_getUnitBases(otherKey)

    if #myBases > 0 and #otherBases > 0 then
        local _, _, mFrontLeft, mFrontRight = charge_getFrontLine(myBases)
        local _, _, oFrontLeft, oFrontRight = charge_getFrontLine(otherBases)

        local mp1, mp2 = mFrontLeft.getPosition(), mFrontRight.getPosition()
        local op1, op2 = oFrontLeft.getPosition(), oFrontRight.getPosition()

        local myFrontCenter = Vector((mp1.x + mp2.x) / 2, 0, (mp1.z + mp2.z) / 2)
        local otherFrontCenter = Vector((op1.x + op2.x) / 2, 0, (op1.z + op2.z) / 2)

        local midY = myBases[1].getPosition().y
        local midpoint = Vector(
            (myFrontCenter.x + otherFrontCenter.x) / 2,
            midY,
            (myFrontCenter.z + otherFrontCenter.z) / 2
        )
        
        local dir = Vector(myFrontCenter.x - otherFrontCenter.x, 0, myFrontCenter.z - otherFrontCenter.z):normalized()
        local yaw = math.deg(math.atan(dir.x, dir.z))

        for _, obj in ipairs(myBases) do
            local rot = obj.getRotation()
            obj.setRotation(Vector(rot.x, yaw, rot.z))
        end

        local delta = Vector(midpoint.x - myFrontCenter.x, 0, midpoint.z - myFrontCenter.z)
        for _, obj in ipairs(myBases) do
            local p = obj.getPosition()
            obj.setPosition(Vector(p.x + delta.x, p.y, p.z + delta.z))
        end
    end
end

-- ============================================================
-- FUNZIONE: charge_processAutoForSlot(slot, elemento)
-- Elabora UN elemento per conto di ARMY{slot}, agendo solo sulle
-- proprie basi. Chiamata in loop da charge_auto_btn_army1/2, una
-- per esercito. Ogni caso (reciproca/COC, EVA, TIR, Ferma) gestito
-- esplicitamente; chiusura garantita in ogni ramo.
-- ============================================================
function charge_processAutoForSlot(slot, elemento)
    if elemento.step == CHARGE_STEP.CLO then return end

    if charge_elementoIsReciprocal(elemento)
       or elemento.responseArmy1 == REACTION_TYPE.COC
       or elemento.responseArmy2 == REACTION_TYPE.COC then
        if slot == 1 and not elemento.movedArmy1 then
            charge_executeCounterHalf(1, elemento)
            elemento.movedArmy1 = true
        elseif slot == 2 and not elemento.movedArmy2 then
            charge_executeCounterHalf(2, elemento)
            elemento.movedArmy2 = true
        end
        if elemento.movedArmy1 and elemento.movedArmy2 then
            elemento.outcome = CHARGE_OUTCOME.OK
            elemento.step = CHARGE_STEP.CLO
        end
        return
    end

    if elemento.responseArmy1 == REACTION_TYPE.EVA and slot == 1 then
        charge_executeEvade(1, elemento)
        return
    end
    if elemento.responseArmy2 == REACTION_TYPE.EVA and slot == 2 then
        charge_executeEvade(2, elemento)
        return
    end

    if elemento.responseArmy1 == REACTION_TYPE.TIR or elemento.responseArmy2 == REACTION_TYPE.TIR then
        -- Già risolto in CHARGE_STOPFIRE (colpi/morale). Qui resta
        -- solo l'eventuale movimento di contatto, a carico di chi
        -- ha dichiarato (request=true) — se l'esito è OK deve
        -- ancora muoversi fino al bersaglio; se ANN (morale fallito)
        -- resta dov'è, si chiude senza movimento.
        local chargingSlot = elemento.requestArmy1 and 1 or 2
        if slot == chargingSlot then
            if elemento.outcome == CHARGE_OUTCOME.OK then
                charge_executeContact(chargingSlot, elemento)
            else
                elemento.step = CHARGE_STEP.CLO
            end
        end
        return
    end

    -- Ferma (nessuna risposta, o FER esplicito): solo chi ha
    -- dichiarato la carica si muove fino al contatto.
    local chargingSlot = elemento.requestArmy1 and 1 or (elemento.requestArmy2 and 2 or nil)
    if chargingSlot and slot == chargingSlot then
        charge_executeContact(chargingSlot, elemento)
    end
end
-- ============================================================
-- FUNZIONE: charge_rigidRotate(basiObjs, deltaYawDeg)
-- Ruota l'INTERA formazione come corpo rigido di deltaYawDeg,
-- usando basiObjs[1] come ANCORA REALE che non si sposta (stessa
-- tecnica di move_perno_apply — mai un punto calcolato come pivot,
-- sempre una base vera).
-- ============================================================
function charge_rigidRotate(basiObjs, deltaYawDeg)
    if #basiObjs == 0 then return end
    local pivotBase = basiObjs[1]
    local pivotPos = pivotBase.getPosition()
    local deltaRad = math.rad(deltaYawDeg)

    for _, obj in ipairs(basiObjs) do
        if obj ~= pivotBase then
            local p = obj.getPosition()
            local rel = Vector(p.x - pivotPos.x, 0, p.z - pivotPos.z)
            local rx = rel.x * math.cos(deltaRad) - rel.z * math.sin(deltaRad)
            local rz = rel.x * math.sin(deltaRad) + rel.z * math.cos(deltaRad)
            obj.setPosition(Vector(pivotPos.x + rx, p.y, pivotPos.z + rz))
        end
        local rot = obj.getRotation()
        obj.setRotation(Vector(rot.x, rot.y + deltaYawDeg, rot.z))
    end
end

-- ============================================================
-- FUNZIONE: charge_rigidTranslate(basiObjs, deltaX, deltaZ)
-- Trasla l'intera formazione in blocco (stessa tecnica di
-- move_avanti_apply — nessuna rotazione qui, solo spostamento).
-- ============================================================
function charge_rigidTranslate(basiObjs, deltaX, deltaZ)
    for _, obj in ipairs(basiObjs) do
        local p = obj.getPosition()
        obj.setPosition(Vector(p.x + deltaX, p.y, p.z + deltaZ))
    end
end
-- ============================================================
-- FUNZIONE: charge_executeContact(chargingSlot, elemento)
-- ============================================================
function charge_executeContact(chargingSlot, elemento)

    print("charge_executeContact")

    local chargingKey = charge_elementoUnitKey(elemento, chargingSlot)
    local targetSlot  = charge_elementoOtherSlot(chargingSlot)
    local targetKey   = charge_elementoUnitKey(elemento, targetSlot)

    local chargingBases = charge_getUnitBases(chargingKey)
    local targetBases   = charge_getUnitBases(targetKey)

    if #chargingBases > 0 and #targetBases > 0 then
        local _, _, cFrontLeft, cFrontRight = charge_getFrontLine(chargingBases)
        local _, _, tFrontLeft, tFrontRight = charge_getFrontLine(targetBases)

        local cp1, cp2 = cFrontLeft.getPosition(), cFrontRight.getPosition()
        local tp1, tp2 = tFrontLeft.getPosition(), tFrontRight.getPosition()

        local chargingFrontCenter = Vector((cp1.x + cp2.x) / 2, 0, (cp1.z + cp2.z) / 2)
        local targetFrontCenter   = Vector((tp1.x + tp2.x) / 2, 0, (tp1.z + tp2.z) / 2)

        -- FIX: target - charger (non charger - target) per puntare VERSO il bersaglio
        local dir = Vector(
            targetFrontCenter.x - chargingFrontCenter.x,
            0,
            targetFrontCenter.z - chargingFrontCenter.z
        ):normalized()
        local yaw = math.deg(math.atan(dir.x, dir.z))

        for _, obj in ipairs(chargingBases) do
            local rot = obj.getRotation()
            obj.setRotation(Vector(rot.x, yaw, rot.z))
        end

        local delta = Vector(
            targetFrontCenter.x - chargingFrontCenter.x,
            0,
            targetFrontCenter.z - chargingFrontCenter.z
        )
        for _, obj in ipairs(chargingBases) do
            local p = obj.getPosition()
            obj.setPosition(Vector(p.x + delta.x, p.y, p.z + delta.z))
        end

        -- FIX: riallinea la griglia dopo rotazione + traslazione
        --local fronteAttuale = main_detectFormation(chargingBases)
        --main_ricostruisciFormazione(chargingBases, fronteAttuale)
    end

    elemento.outcome = CHARGE_OUTCOME.OK
    elemento.step = CHARGE_STEP.CLO
    warning(string.format("[CARICA] %s raggiunge il contatto con %s", chargingKey, targetKey), "Yellow")
end

-- ============================================================
-- FUNZIONE: charge_executeCounter(elemento)
-- ============================================================
function charge_executeCounter(elemento)
    local army1Bases = charge_getUnitBases(elemento.unitArmy1Key)
    local army2Bases = charge_getUnitBases(elemento.unitArmy2Key)

    if #army1Bases > 0 and #army2Bases > 0 then
        local _, _, a1FrontLeft, a1FrontRight = charge_getFrontLine(army1Bases)
        local _, _, a2FrontLeft, a2FrontRight = charge_getFrontLine(army2Bases)

        local ap1, ap2 = a1FrontLeft.getPosition(), a1FrontRight.getPosition()
        local dp1, dp2 = a2FrontLeft.getPosition(), a2FrontRight.getPosition()

        local army1FrontCenter = Vector((ap1.x + ap2.x) / 2, 0, (ap1.z + ap2.z) / 2)
        local army2FrontCenter = Vector((dp1.x + dp2.x) / 2, 0, (dp1.z + dp2.z) / 2)

        local midY = army1Bases[1].getPosition().y
        local midpoint = Vector(
            (army1FrontCenter.x + army2FrontCenter.x) / 2,
            midY,
            (army1FrontCenter.z + army2FrontCenter.z) / 2
        )

        -- FIX: army1 punta VERSO army2, army2 punta VERSO army1
        local a1ToA2 = Vector(
            army2FrontCenter.x - army1FrontCenter.x,
            0,
            army2FrontCenter.z - army1FrontCenter.z
        ):normalized()
        local a2ToA1 = Vector(-a1ToA2.x, 0, -a1ToA2.z)

        local yawArmy1 = math.deg(math.atan(a1ToA2.x, a1ToA2.z))
        local yawArmy2 = math.deg(math.atan(a2ToA1.x, a2ToA1.z))

        for _, obj in ipairs(army1Bases) do
            local rot = obj.getRotation()
            obj.setRotation(Vector(rot.x, yawArmy1, rot.z))
        end
        for _, obj in ipairs(army2Bases) do
            local rot = obj.getRotation()
            obj.setRotation(Vector(rot.x, yawArmy2, rot.z))
        end

        local army1Delta = Vector(midpoint.x - army1FrontCenter.x, 0, midpoint.z - army1FrontCenter.z)
        local army2Delta = Vector(midpoint.x - army2FrontCenter.x, 0, midpoint.z - army2FrontCenter.z)

        for _, obj in ipairs(army1Bases) do
            local p = obj.getPosition()
            obj.setPosition(Vector(p.x + army1Delta.x, p.y, p.z + army1Delta.z))
        end
        for _, obj in ipairs(army2Bases) do
            local p = obj.getPosition()
            obj.setPosition(Vector(p.x + army2Delta.x, p.y, p.z + army2Delta.z))
        end

        -- FIX: riallinea la griglia di entrambe le unità dopo rotazione + traslazione
        --local fronte1 = main_detectFormation(army1Bases)
        --main_ricostruisciFormazione(army1Bases, fronte1)
        --local fronte2 = main_detectFormation(army2Bases)
        --main_ricostruisciFormazione(army2Bases, fronte2)
    end

    elemento.outcome = CHARGE_OUTCOME.OK
    elemento.step = CHARGE_STEP.CLO
    warning(string.format("[CARICA] %s e %s sono a contatto", elemento.unitArmy1Key, elemento.unitArmy2Key), "Yellow")
end
